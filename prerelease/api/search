ark names on push"},"1962":{"id":"/reference/config-71","page_id":"/reference/config","type":"heading","tags":[],"url":"/reference/config#set-of-private-commits","content":"Set of private commits"},"1963":{"id":"/reference/config-72","page_id":"/reference/config","type":"heading","tags":[],"url":"/reference/config#git-subprocessing-behavior","content":"Git subprocessing behavior"},"1964":{"id":"/reference/config-73","page_id":"/reference/config","type":"heading","tags":[],"url":"/reference/config#merge-settings","content":"Merge settings"},"1965":{"id":"/reference/config-74","page_id":"/reference/config","type":"heading","tags":[],"url":"/reference/config#granularity-of-hunks","content":"Granularity of hunks"},"1966":{"id":"/reference/config-75","page_id":"/reference/config","type":"heading","tags":[],"url":"/reference/config#filesystem-monitor","content":"Filesystem monitor"},"1967":{"id":"/reference/config-76","page_id":"/reference/config","type":"heading","tags":[],"url":"/reference/config#watchman","content":"Watchman"},"1968":{"id":"/reference/config-77","page_id":"/reference/config","type":"heading","tags":[],"url":"/reference/config#snapshot-settings","content":"Snapshot settings"},"1969":{"id":"/reference/config-78","page_id":"/reference/config","type":"heading","tags":[],"url":"/reference/config#paths-to-automatically-track","content":"Paths to automatically track"},"1970":{"id":"/reference/config-79","page_id":"/reference/config","type":"heading","tags":[],"url":"/reference/config#maximum-size-for-new-files","content":"Maximum size for new files"},"1971":{"id":"/reference/config-80","page_id":"/reference/config","type":"heading","tags":[],"url":"/reference/config#working-copy-settings","content":"Working copy settings"},"1972":{"id":"/reference/config-81","page_id":"/reference/config","type":"heading","tags":[],"url":"/reference/config#eol-conversion-settings","content":"EOL conversion settings"},"1973":{"id":"/reference/config-82","page_id":"/reference/config","type":"heading","tags":[],"url":"/reference/config#ways-to-specify-jj-config-details","content":"Ways to specify jj config: details"},"1974":{"id":"/reference/config-83","page_id":"/reference/config","type":"heading","tags":[],"url":"/reference/config#user-config-files","content":"User config files"},"1975":{"id":"/reference/config-84","page_id":"/reference/config","type":"heading","tags":[],"url":"/reference/config#json-schema-support","content":"JSON Schema Support"},"1976":{"id":"/reference/config-85","page_id":"/reference/config","type":"heading","tags":[],"url":"/reference/config#specifying-config-on-the-command-line","content":"Specifying config on the command-line"},"1977":{"id":"/reference/config-86","page_id":"/reference/config","type":"heading","tags":[],"url":"/reference/config#conditional-variables","content":"Conditional variables"},"1978":{"id":"/reference/config-87","page_id":"/reference/config","type":"heading","tags":[],"url":"/reference/config#using---scope-tables","content":"Using [[--scope]] tables"},"1979":{"id":"/reference/config-88","page_id":"/reference/config","type":"heading","tags":[],"url":"/reference/config#using-multiple-files","content":"Using multiple files"},"1980":{"id":"/reference/config-89","page_id":"/reference/config","type":"heading","tags":[],"url":"/reference/config#available-condition-keys","content":"Available condition keys"},"1981":{"id":"/reference/config-90","page_id":"/reference/config","tags":[],"type":"text","url":"/reference/config","content":"These are the config settings available to jj/Jujutsu."},"1982":{"id":"/reference/config-91","page_id":"/reference/config","tags":[],"type":"text","url":"/reference/config#config-files-and-toml","content":"jj loads several types of config settings:"},"1983":{"id":"/reference/config-92","page_id":"/reference/config","tags":[],"type":"text","url":"/reference/config#config-files-and-toml","content":"The built-in settings. These cannot be edited. They can be viewed in the\ncli/src/config/ directory in jj's source repo."},"1984":{"id":"/reference/config-93","page_id":"/reference/config","tags":[],"type":"text","url":"/reference/config#config-files-and-toml","content":"The user settings. These can be edited with jj config edit --user. User\nsettings are located in the user config files, which can be found with jj\nconfig path --user."},"1985":{"id":"/reference/config-94","page_id":"/reference/config","tags":[],"type":"text","url":"/reference/config#config-files-and-toml","content":"The repo settings. These can be edited with jj config edit --repo and are\nlocated in .jj/repo/config.toml."},"1986":{"id":"/reference/config-95","page_id":"/reference/config","tags":[],"type":"text","url":"/reference/config#config-files-and-toml","content":"Settings specified in the command-line."},"1987":{"id":"/reference/config-96","page_id":"/reference/config","tags":[],"type":"text","url":"/reference/config#config-files-and-toml","content":"These are listed in the order they are loaded; the settings from earlier items\nin the list are overridden by the settings from later items if they disagree.\nEvery type of config except for the built-in settings is optional."},"1988":{"id":"/reference/config-97","page_id":"/reference/config","tags":[],"type":"text","url":"/reference/config#config-files-and-toml","content":"You can enable JSON Schema validation in your editor by adding a #:schema\nreference at the top of your TOML config files. See JSON Schema\nSupport for details."},"1989":{"id":"/reference/config-98","page_id":"/reference/config","tags":[],"type":"text","url":"/reference/config#config-files-and-toml","content":"See the TOML site and the syntax guide for a detailed description of the\nsyntax. We cover some of the basics below."},"1990":{"id":"/reference/config-99","page_id":"/reference/config","tags":[],"type":"text","url":"/reference/config#config-files-and-toml","content":"The first thing to remember is that the value of a setting (the part to the\nright of the = sign) should be surrounded in quotes if it's a string."},"1991":{"id":"/reference/config-100","page_id":"/reference/config","tags":[],"type":"text","url":"/reference/config#dotted-style-and-headings","content":"In TOML, anything under a heading can be dotted instead. For example,\nuser.name = \"YOUR NAME\" is equivalent to:"},"1992":{"id":"/reference/config-101","page_id":"/reference/config","tags":[],"type":"text","url":"/reference/config#dotted-style-and-headings","content":"For future reference, here are a couple of more complicated examples,"},"1993":{"id":"/reference/config-102","page_id":"/reference/config","tags":[],"type":"text","url":"/reference/config#dotted-style-and-headings","content":"The docs below refer to keys in text using dotted notation, but example\nblocks will use heading notation to be unambiguous. If you are confident with TOML\nthen use whichever suits you in your config. If you mix dotted keys and headings,\nyou must put the dotted keys before the first heading."},"1994":{"id":"/reference/config-103","page_id":"/reference/config","tags":[],"type":"text","url":"/reference/config#dotted-style-and-headings","content":"That's probably enough TOML to keep you out of trouble but the syntax guide is\nvery short if you ever need to check."},"1995":{"id":"/reference/config-104","page_id":"/reference/config","tags":[],"type":"text","url":"/reference/config#user-settings","content":"Don't forget to change these to your own details!"},"1996":{"id":"/reference/config-105","page_id":"/reference/config","tags":[],"type":"text","url":"/reference/config#colorizing-output","content":"Possible values are always, never, debug and auto (default: auto).\nauto will use color only when writing to a terminal. debug will print the\nactive labels alongside the regular colorized output."},"1997":{"id":"/reference/config-106","page_id":"/reference/config","tags":[],"type":"text","url":"/reference/config#colorizing-output","content":"This setting overrides the NO_COLOR environment variable (if set)."},"1998":{"id":"/reference/config-107","page_id":"/reference/config","tags":[],"type":"text","url":"/reference/config#custom-colors-and-styles","content":"You can customize the colors used for various elements of the UI. For example:"},"1999":{"id":"/reference/config-108","page_id":"/reference/config","tags":[],"type":"text","url":"/reference/config#custom-colors-and-styles","content":"The following colors are available:"},"2000":{"id":"/reference/config-109","page_id":"/reference/config","tags":[],"type":"text","url":"/reference/config#custom-colors-and-styles","content":"black"},"2001":{"id":"/reference/config-110","page_id":"/reference/config","tags":[],"type":"text","url":"/reference/config#custom-colors-and-styles","content":"red"},"2002":{"id":"/reference/config-111","page_id":"/reference/config","tags":[],"type":"text","url":"/reference/config#custom-colors-and-styles","content":"green"},"2003":{"id":"/reference/config-112","page_id":"/reference/config","tags":[],"type":"text","url":"/reference/config#custom-colors-and-styles","content":"yellow"},"2004":{"id":"/reference/config-113","page_id":"/reference/config","tags":[],"type":"text","url":"/reference/config#custom-colors-and-styles","content":"blue"},"2005":{"id":"/reference/config-114","page_id":"/reference/config","tags":[],"type":"text","url":"/reference/config#custom-colors-and-styles","content":"magenta"},"2006":{"id":"/reference/config-115","page_id":"/reference/config","tags":[],"type":"text","url":"/reference/config#custom-colors-and-styles","content":"cyan"},"2007":{"id":"/reference/config-116","page_id":"/reference/config","tags":[],"type":"text","url":"/reference/config#custom-colors-and-styles","content":"white"},"2008":{"id":"/reference/config-117","page_id":"/reference/config","tags":[],"type":"text","url":"/reference/config#custom-colors-and-styles","content":"default"},"2009":{"id":"/reference/config-118","page_id":"/reference/config","tags":[],"type":"text","url":"/reference/config#custom-colors-and-styles","content":"All of them but \"default\" come in a bright version too, e.g. \"bright red\". The\n\"default\" color can be used to override a color defined by a parent style\n(explained below)."},"2010":{"id":"/reference/config-119","page_id":"/reference/config","tags":[],"type":"text","url":"/reference/config#custom-colors-and-styles","content":"You can also use a 6-digit hex code for more control over the exact color used:"},"2011":{"id":"/reference/config-120","page_id":"/reference/config","tags":[],"type":"text","url":"/reference/config#custom-colors-and-styles","content":"jj also supports colors from the ANSI 256-color palette as ansi-color-<N>,\nwhere <N> is a number between 0 and 255:"},"2012":{"id":"/reference/config-121","page_id":"/reference/config","tags":[],"type":"text","url":"/reference/config#custom-colors-and-styles","content":"If you use a string value for a color, as in the examples above, it will be used\nfor the foreground color. You can also set the background color, reverse colors\n(swap foreground and background), or make the text bold, italic, or underlined.\nFor that, you need to use a table:"},"2013":{"id":"/reference/config-122","page_id":"/reference/config","tags":[],"type":"text","url":"/reference/config#custom-colors-and-styles","content":"The key names are called \"labels\". The above used commit_id as label. You can\nalso create rules combining multiple labels. The rules work a bit like CSS\nselectors. For example, if you want to color commit IDs green in general but\nmake the commit ID of the working-copy commit also be underlined, you can do\nthis:"},"2014":{"id":"/reference/config-123","page_id":"/reference/config","tags":[],"type":"text","url":"/reference/config#custom-colors-and-styles","content":"Parts of the style that are not overridden - such as the foreground color in the\nexample above - are inherited from the style of the parent label."},"2015":{"id":"/reference/config-124","page_id":"/reference/config","tags":[],"type":"text","url":"/reference/config#custom-colors-and-styles","content":"Which elements can be colored is not yet documented, but see\nthe default color configuration\nfor some examples of what's possible."},"2016":{"id":"/reference/config-125","page_id":"/reference/config","tags":[],"type":"text","url":"/reference/config#default-command","content":"When jj is run with no explicit subcommand, the value of the\nui.default-command setting will be used instead. Possible values are any valid\nsubcommand name, subcommand alias, or user-defined alias (defaults to \"log\")."},"2017":{"id":"/reference/config-126","page_id":"/reference/config","tags":[],"type":"text","url":"/reference/config#default-description","content":"The editor content of a commit description can be populated by the\ndraft_commit_description template. self is a Commit\nobject."},"2018":{"id":"/reference/config-127","page_id":"/reference/config","tags":[],"type":"text","url":"/reference/config#default-description","content":"You can override only the default_commit_description value if you like, e.g.:"},"2019":{"id":"/reference/config-128","page_id":"/reference/config","tags":[],"type":"text","url":"/reference/config#duplicate-commit-description","content":"By default, jj duplicate copies the descriptions from the original commits.\nYou can customize this behavior by specifying the duplicate_description\ntemplate, which is given a Commit object of the\noriginal commit."},"2020":{"id":"/reference/config-129","page_id":"/reference/config","tags":[],"type":"text","url":"/reference/config#bookmark-listing-order","content":"By default, jj bookmark list displays bookmarks sorted alphabetically by name.\nYou can customize this sorting behavior by specifying sort keys in your config\nfile:"},"2021":{"id":"/reference/config-130","page_id":"/reference/config","tags":[],"type":"text","url":"/reference/config#bookmark-listing-order","content":"The configuration works identically to using the --sort option for\njj bookmark list. The following sort keys are supported: name, author-name,\nauthor-email, author-date, committer-name, committer-email,\ncommitter-date. Suffix the key with - to sort in descending order. Multiple\nkeys can be supplied here, the first key is the most significant."},"2022":{"id":"/reference/config-131","page_id":"/reference/config","tags":[],"type":"text","url":"/reference/config#bookmark-listing-order","content":"When the --sort option is used with jj bookmark list, the configuration\nis ignored."},"2023":{"id":"/reference/config-132","page_id":"/reference/config","tags":[],"type":"text","url":"/reference/config#commit-trailers","content":"You can configure automatic addition of one or more trailers to commit\ndescriptions using the commit_trailers template."},"2024":{"id":"/reference/config-133","page_id":"/reference/config","tags":[],"type":"text","url":"/reference/config#commit-trailers","content":"Each line of the template is an individual trailer, usually in Key: Value\nformat."},"2025":{"id":"/reference/config-134","page_id":"/reference/config","tags":[],"type":"text","url":"/reference/config#commit-trailers","content":"Trailers defined in this template are deduplicated with the existing\ndescription: if the entire line of a trailer is already present, it will not be\nadded again. To deduplicate based only on the trailer key, use the\ntrailers.contains_key(key) method within the template."},"2026":{"id":"/reference/config-135","page_id":"/reference/config","tags":[],"type":"text","url":"/reference/config#commit-trailers","content":"Some ready-to-use trailer templates are available for frequently used trailers:"},"2027":{"id":"/reference/config-136","page_id":"/reference/config","tags":[],"type":"text","url":"/reference/config#commit-trailers","content":"format_signed_off_by_trailer(commit) creates a \"Signed-off-by\" trailer\nusing the committer info."},"2028":{"id":"/reference/config-137","page_id":"/reference/config","tags":[],"type":"text","url":"/reference/config#commit-trailers","content":"format_gerrit_change_id_trailer(commit) creates a \"Change-Id\" trailer\nsuitable to be used with Gerrit. It is based Jujutsu's change id."},"2029":{"id":"/reference/config-138","page_id":"/reference/config","tags":[],"type":"text","url":"/reference/config#commit-trailers","content":"Existing trailers are also accessible via commit.trailers()."},"2030":{"id":"/reference/config-139","page_id":"/reference/config","tags":[],"type":"text","url":"/reference/config#diff-colors-and-styles","content":"In color-words and git diffs, word-level hunks are rendered with underline. You\ncan override the default style with the following keys:"},"2031":{"id":"/reference/config-140","page_id":"/reference/config","tags":[],"type":"text","url":"/reference/config#color-words-diff-options","content":"In color-words diffs, changed words are displayed inline by default. Because\nit's difficult to read a diff line with many removed/added words, there's a\nthreshold to switch to traditional separate-line format. You can also change\nthe default number of lines of context shown."},"2032":{"id":"/reference/config-141","page_id":"/reference/config","tags":[],"type":"text","url":"/reference/config#color-words-diff-options","content":"max-inline-alternation: Maximum number of removed/added word alternation to\ninline. For example, <added> ... <added> sequence has 1 alternation, so the\nline will be inline if max-inline-alternation >= 1. <added> ... <removed>\n... <added> sequence has 3 alternation."},"2033":{"id":"/reference/config-142","page_id":"/reference/config","tags":[],"type":"text","url":"/reference/config#color-words-diff-options","content":"0: disable inlining, making --color-words more similar to --git"},"2034":{"id":"/reference/config-143","page_id":"/reference/config","tags":[],"type":"text","url":"/reference/config#color-words-diff-options","content":"1: inline removes-only or adds-only lines"},"2035":{"id":"/reference/config-144","page_id":"/reference/config","tags":[],"type":"text","url":"/reference/config#color-words-diff-options","content":"2, 3, ..: inline up to 2, 3, .. alternation"},"2036":{"id":"/reference/config-145","page_id":"/reference/config","tags":[],"type":"text","url":"/reference/config#color-words-diff-options","content":"-1: inline all lines"},"2037":{"id":"/reference/config-146","page_id":"/reference/config","tags":[],"type":"text","url":"/reference/config#color-words-diff-options","content":"The default is 3."},"2038":{"id":"/reference/config-147","page_id":"/reference/config","tags":[],"type":"text","url":"/reference/config#color-words-diff-options","content":"This parameter is experimental. The definition is subject to change."},"2039":{"id":"/reference/config-148","page_id":"/reference/config","tags":[],"type":"text","url":"/reference/config#color-words-diff-options","content":"conflict: How conflicts are processed and displayed."},"2040":{"id":"/reference/config-149","page_id":"/reference/config","tags":[],"type":"text","url":"/reference/config#color-words-diff-options","content":"\"materialize\": compare materialized contents (default)"},"2041":{"id":"/reference/config-150","page_id":"/reference/config","tags":[],"type":"text","url":"/reference/config#color-words-diff-options","content":"\"pair\": compare individual pairs"},"2042":{"id":"/reference/config-151","page_id":"/reference/config","tags":[],"type":"text","url":"/reference/config#color-words-diff-options","content":"This parameter is experimental."},"2043":{"id":"/reference/config-152","page_id":"/reference/config","tags":[],"type":"text","url":"/reference/config#color-words-diff-options","content":"context: Number of lines of context to show in the diff. The default is 3."},"2044":{"id":"/reference/config-153","page_id":"/reference/config","tags":[],"type":"text","url":"/reference/config#git-diff-options","content":"In git diffs you can change the default number of lines of context shown."},"2045":{"id":"/reference/config-154","page_id":"/reference/config","tags":[],"type":"text","url":"/reference/config#git-diff-options","content":"context: Number of lines of context to show in the diff. The default is 3."},"2046":{"id":"/reference/config-155","page_id":"/reference/config","tags":[],"type":"text","url":"/reference/config#generating-diffs-by-external-command","content":"If ui.diff-formatter is not a builtin format, the specified diff command will\nbe called."},"2047":{"id":"/reference/config-156","page_id":"/reference/config","tags":[],"type":"text","url":"/reference/config#generating-diffs-by-external-command","content":"The external diff tool can also be enabled by diff --tool <name> argument.\nFor the tool named <name>, command arguments can be configured as follows."},"2048":{"id":"/reference/config-157","page_id":"/reference/config","tags":[],"type":"text","url":"/reference/config#generating-diffs-by-external-command","content":"$left and $right are replaced with the paths to the left and right\ndirectories to diff respectively."},"2049":{"id":"/reference/config-158","page_id":"/reference/config","tags":[],"type":"text","url":"/reference/config#generating-diffs-by-external-command","content":"If diff-args is not specified, [\"$left\", \"$right\"] will be used by default."},"2050":{"id":"/reference/config-159","page_id":"/reference/config","tags":[],"type":"text","url":"/reference/config#generating-diffs-by-external-command","content":"If diff-args = [], jj will refuse to use this tool for diff formatting.\nThis is a way to explicitly state that a certain tool (e.g. mergiraf) does\nnot work for viewing diffs."},"2051":{"id":"/reference/config-160","page_id":"/reference/config","tags":[],"type":"text","url":"/reference/config#generating-diffs-by-external-command","content":"By default jj will invoke external tools with a directory containing the left\nand right sides. The diff-invocation-mode config can change this to file by file\ninvocations as follows:"},"2052":{"id":"/reference/config-161","page_id":"/reference/config","tags":[],"type":"text","url":"/reference/config#generating-diffs-by-external-command","content":"By default jj will display a warning when the command exits with a non-success\nerror code. The diff-expected-exit-codes config can suppress this warning\nmessage for specific exit codes:"},"2053":{"id":"/reference/config-162","page_id":"/reference/config","tags":[],"type":"text","url":"/reference/config#conflict-marker-style","content":"You can configure which style of conflict markers to use when materializing\nconflicts:"},"2054":{"id":"/reference/config-163","page_id":"/reference/config","tags":[],"type":"text","url":"/reference/config#conflict-marker-style","content":"For more details about these conflict marker styles, see the conflicts\npage."},"2055":{"id":"/reference/config-164","page_id":"/reference/config","tags":[],"type":"text","url":"/reference/config#set-of-immutable-commits","content":"You can configure the set of immutable commits via\nrevset-aliases.\"immutable_heads()\". The default set of immutable heads is\nbuiltin_immutable_heads(), which in turn is defined as\npresent(trunk()) | tags() | untracked_remote_bookmarks(). For example, to\nalso consider the release@origin bookmark immutable:"},"2056":{"id":"/reference/config-165","page_id":"/reference/config","tags":[],"type":"text","url":"/reference/config#set-of-immutable-commits","content":"To prevent rewriting commits authored by other users:"},"2057":{"id":"/reference/config-166","page_id":"/reference/config","tags":[],"type":"text","url":"/reference/config#set-of-immutable-commits","content":"Ancestors of the configured set are also immutable. The root commit is always\nimmutable even if the set is empty."},"2058":{"id":"/reference/config-167","page_id":"/reference/config","tags":[],"type":"text","url":"/reference/config#set-of-immutable-commits","content":"Immutable commits (other than the root commit) can be rewritten using the\n--ignore-immutable CLI flag."},"2059":{"id":"/reference/config-168","page_id":"/reference/config","tags":[],"type":"text","url":"/reference/config#set-of-immutable-commits","content":"type: warning"},"2060":{"id":"/reference/config-169","page_id":"/reference/config","tags":[],"type":"text","url":"/reference/config#set-of-immutable-commits","content":"Using --ignore-immutable will allow you to rewrite any commit in the\nhistory, and all descendants, without warning. Use this power wisely, and\nremember jj undo."},"2061":{"id":"/reference/config-170","page_id":"/reference/config","tags":[],"type":"text","url":"/reference/config#behavior-of-prev-and-next-commands","content":"If you prefer using an \"edit-based\" workflow, rather than squashing\nmodifications into parent changes, you may find yourself using the prev and\nnext commands with their --edit flag often to move between your changes. You\ncan avoid having to type the --edit flag every time you need it by actually\nmaking it the default:"},"2062":{"id":"/reference/config-171","page_id":"/reference/config","tags":[],"type":"text","url":"/reference/config#behavior-of-prev-and-next-commands","content":"You can pass the --no-edit flag to prev and next if you find yourself\nneeding the original behavior."},"2063":{"id":"/reference/config-172","page_id":"/reference/config","tags":[],"type":"text","url":"/reference/config#default-template","content":"You can configure the template used when no -T is specified."},"2064":{"id":"/reference/config-173","page_id":"/reference/config","tags":[],"type":"text","url":"/reference/config#default-template","content":"templates.config_list for jj config list"},"2065":{"id":"/reference/config-174","page_id":"/reference/config","tags":[],"type":"text","url":"/reference/config#default-template","content":"If you want to see the config variable origin (type and path) when you do jj config list\nyou can add this to your config:"},"2066":{"id":"/reference/config-175","page_id":"/reference/config","tags":[],"type":"text","url":"/reference/config#default-revisions","content":"You can configure the revisions jj log would show when neither -r nor any paths are specified."},"2067":{"id":"/reference/config-176","page_id":"/reference/config","tags":[],"type":"text","url":"/reference/config#default-revisions","content":"The default value for revsets.log is\n'present(@) | ancestors(immutable_heads().., 2) | present(trunk())'."},"2068":{"id":"/reference/config-177","page_id":"/reference/config","tags":[],"type":"text","url":"/reference/config#prioritize-revsets-in-the-log-over-","content":"In some situations the default graph can be hard to read, for example when working with big merges.\nTo improve this behavior you can configure which revset in the jj log graph is displayed on\nthe left instead of @."},"2069":{"id":"/reference/config-178","page_id":"/reference/config","tags":[],"type":"text","url":"/reference/config#prioritize-revsets-in-the-log-over-","content":"The following example will prioritize the change with the description \"megamerge\" with a fallback\nto trunk() in case no such change exists:"},"2070":{"id":"/reference/config-179","page_id":"/reference/config","tags":[],"type":"text","url":"/reference/config#default-template-1","content":"You can configure the template used when no -T is specified."},"2071":{"id":"/reference/config-180","page_id":"/reference/config","tags":[],"type":"text","url":"/reference/config#default-template-1","content":"templates.evolog for jj evolog"},"2072":{"id":"/reference/config-181","page_id":"/reference/config","tags":[],"type":"text","url":"/reference/config#default-template-1","content":"templates.log for jj log"},"2073":{"id":"/reference/config-182","page_id":"/reference/config","tags":[],"type":"text","url":"/reference/config#default-template-1","content":"templates.show for jj show"},"2074":{"id":"/reference/config-183","page_id":"/reference/config","tags":[],"type":"text","url":"/reference/config#default-template-1","content":"templates.op_log for jj op log"},"2075":{"id":"/reference/config-184","page_id":"/reference/config","tags":[],"type":"text","url":"/reference/config#default-template-1","content":"templates.op_show for jj op show"},"2076":{"id":"/reference/config-185","page_id":"/reference/config","tags":[],"type":"text","url":"/reference/config#default-template-1","content":"If you want to see the full description when you do jj log you can add this to\nyour config:"},"2077":{"id":"/reference/config-186","page_id":"/reference/config","tags":[],"type":"text","url":"/reference/config#node-style","content":"The symbols used to represent commits or operations can be customized via\ntemplates."},"2078":{"id":"/reference/config-187","page_id":"/reference/config","tags":[],"type":"text","url":"/reference/config#node-style","content":"templates.log_node for commits (with Option<Commit> keywords)"},"2079":{"id":"/reference/config-188","page_id":"/reference/config","tags":[],"type":"text","url":"/reference/config#node-style","content":"templates.op_log_node for operations (with Operation keywords)"},"2080":{"id":"/reference/config-189","page_id":"/reference/config","tags":[],"type":"text","url":"/reference/config#node-style","content":"For example:"},"2081":{"id":"/reference/config-190","page_id":"/reference/config","tags":[],"type":"text","url":"/reference/config#wrap-log-content","content":"If enabled, log/evolog/op log content will be wrapped based on\nthe terminal width."},"2082":{"id":"/reference/config-191","page_id":"/reference/config","tags":[],"type":"text","url":"/reference/config#display-of-commit-and-change-ids","content":"Can be customized by the format_short_id() template alias."},"2083":{"id":"/reference/config-192","page_id":"/reference/config","tags":[],"type":"text","url":"/reference/config#display-of-commit-and-change-ids","content":"To customize these separately, use the format_short_commit_id() and\nformat_short_change_id() aliases:"},"2084":{"id":"/reference/config-193","page_id":"/reference/config","tags":[],"type":"text","url":"/reference/config#display-of-commit-and-change-ids","content":"Operation ids can be customized by the format_short_operation_id() alias:"},"2085":{"id":"/reference/config-194","page_id":"/reference/config","tags":[],"type":"text","url":"/reference/config#display-of-commit-and-change-ids","content":"To get shorter prefixes for certain revisions, set revsets.short-prefixes:"},"2086":{"id":"/reference/config-195","page_id":"/reference/config","tags":[],"type":"text","url":"/reference/config#relative-timestamps","content":"Can be customized by the format_timestamp() template alias."},"2087":{"id":"/reference/config-196","page_id":"/reference/config","tags":[],"type":"text","url":"/reference/config#relative-timestamps","content":"jj op log defaults to relative timestamps. To use absolute timestamps, you\nwill need to modify the format_time_range() template alias."},"2088":{"id":"/reference/config-197","page_id":"/reference/config","tags":[],"type":"text","url":"/reference/config#author-format","content":"Can be customized by the format_short_signature() template alias."},"2089":{"id":"/reference/config-198","page_id":"/reference/config","tags":[],"type":"text","url":"/reference/config#commit-timestamp","content":"Commits have both an \"author timestamp\" and \"committer timestamp\". By default,\njj displays the committer timestamp, but can be changed to show the author\ntimestamp instead."},"2090":{"id":"/reference/config-199","page_id":"/reference/config","tags":[],"type":"text","url":"/reference/config#commit-timestamp","content":"The function must return a timestamp because the return value will likely be\nformatted with format_timestamp()."},"2091":{"id":"/reference/config-200","page_id":"/reference/config","tags":[],"type":"text","url":"/reference/config#signature-format","content":"Can be enabled with ui.show-cryptographic-signatures, and\ncustomized with format_short_cryptographic_signature(sig) and\nformat_detailed_cryptographic_signature(sig)."},"2092":{"id":"/reference/config-201","page_id":"/reference/config","tags":[],"type":"text","url":"/reference/config#signature-format","content":"Note that the formatting functions take an Option<CryptographicSignature>.\nThis allows you to emit a custom message if a signature is not present, but\nwill raise an error if you try to access methods on a signature that is not\navailable."},"2093":{"id":"/reference/config-202","page_id":"/reference/config","tags":[],"type":"text","url":"/reference/config#pager","content":"The default pager is can be set via ui.pager or the PAGER environment\nvariable. The priority is as follows (environment variables are marked with\na $):"},"2094":{"id":"/reference/config-203","page_id":"/reference/config","tags":[],"type":"text","url":"/reference/config#pager","content":"ui.pager > $PAGER"},"2095":{"id":"/reference/config-204","page_id":"/reference/config","tags":[],"type":"text","url":"/reference/config#pager","content":"less -FRX is the default pager in the absence of any other setting, except\non Windows where it is :builtin."},"2096":{"id":"/reference/config-205","page_id":"/reference/config","tags":[],"type":"text","url":"/reference/config#pager","content":"The special value :builtin enables usage of the integrated\npager."},"2097":{"id":"/reference/config-206","page_id":"/reference/config","tags":[],"type":"text","url":"/reference/config#pager","content":"If you are using a standard Linux distro, your system likely already has\n$PAGER set and that will be preferred over the built-in. To use the built-in:"},"2098":{"id":"/reference/config-207","page_id":"/reference/config","tags":[],"type":"text","url":"/reference/config#pager","content":"It is possible the default will change to :builtin for all platforms in the\nfuture."},"2099":{"id":"/reference/config-208","page_id":"/reference/config","tags":[],"type":"text","url":"/reference/config#pager","content":"Additionally, paging behavior can be toggled via ui.paginate like so:"},"2100":{"id":"/reference/config-209","page_id":"/reference/config","tags":[],"type":"text","url":"/reference/config#builtin-pager","content":"Our builtin pager is based on\nstreampager but is configured within\njj's config. It is configured via the ui.streampager table."},"2101":{"id":"/reference/config-210","page_id":"/reference/config","tags":[],"type":"text","url":"/reference/config#key-bindings","content":"The built-in pager supports both navigation via arrows and Vim-style navigation.\nBeyond that, here are some useful keybindings for the pager:"},"2102":{"id":"/reference/config-211","page_id":"/reference/config","tags":[],"type":"text","url":"/reference/config#key-bindings","content":"Key"},"2103":{"id":"/reference/config-212","page_id":"/reference/config","tags":[],"type":"text","url":"/reference/config#key-bindings","content":"Action"},"2104":{"id":"/reference/config-213","page_id":"/reference/config","tags":[],"type":"text","url":"/reference/config#key-bindings","content":"Ctrl-c or q"},"2105":{"id":"/reference/config-214","page_id":"/reference/config","tags":[],"type":"text","url":"/reference/config#key-bindings","content":"Quit"},"2106":{"id":"/reference/config-215","page_id":"/reference/config","tags":[],"type":"text","url":"/reference/config#key-bindings","content":"h or F1"},"2107":{"id":"/reference/config-216","page_id":"/reference/config","tags":[],"type":"text","url":"/reference/config#key-bindings","content":"Show all key bindings"},"2108":{"id":"/reference/config-217","page_id":"/reference/config","tags":[],"type":"text","url":"/reference/config#key-bindings","content":"Esc"},"2109":{"id":"/reference/config-218","page_id":"/reference/config","tags":[],"type":"text","url":"/reference/config#key-bindings","content":"Close help or prompt"},"2110":{"id":"/reference/config-219","page_id":"/reference/config","tags":[],"type":"text","url":"/reference/config#key-bindings","content":"\\"},"2111":{"id":"/reference/config-220","page_id":"/reference/config","tags":[],"type":"text","url":"/reference/config#key-bindings","content":"Toggle line wrapping"},"2112":{"id":"/reference/config-221","page_id":"/reference/config","tags":[],"type":"text","url":"/reference/config#key-bindings","content":"#"},"2113":{"id":"/reference/config-222","page_id":"/reference/config","tags":[],"type":"text","url":"/reference/config#key-bindings","content":"Toggle line numbers"},"2114":{"id":"/reference/config-223","page_id":"/reference/config","tags":[],"type":"text","url":"/reference/config#key-bindings","content":"Ctrl-r"},"2115":{"id":"/reference/config-224","page_id":"/reference/config","tags":[],"type":"text","url":"/reference/config#key-bindings","content":"Toggle the ruler"},"2116":{"id":"/reference/config-225","page_id":"/reference/config","tags":[],"type":"text","url":"/reference/config#key-bindings","content":"The built-in pager does not support mouse input."},"2117":{"id":"/reference/config-226","page_id":"/reference/config","tags":[],"type":"text","url":"/reference/config#wrapping-config","content":"Wrapping performed by the pager happens in addition to any\nwrapping that jj itself does."},"2118":{"id":"/reference/config-227","page_id":"/reference/config","tags":[],"type":"text","url":"/reference/config#auto-exit-clearing-the-screen-on-startup-or-exit","content":"You can configure whether the pager clears the screen on startup or exit, and\nwhether it quits automatically on short inputs. When the pager auto-quits,\nfeatures like word-wrapping are disabled."},"2119":{"id":"/reference/config-228","page_id":"/reference/config","tags":[],"type":"text","url":"/reference/config#processing-contents-to-be-paged","content":"If you'd like to pass the output through a formatter e.g.\ndiff-so-fancy before piping it\nthrough a pager you must do it using a subshell as, unlike git or hg, the\ncommand will be executed directly. For example:"},"2120":{"id":"/reference/config-229","page_id":"/reference/config","tags":[],"type":"text","url":"/reference/config#processing-contents-to-be-paged","content":"Some formatters (like delta) require\ngit style diffs for formatting. You can configure this style of\ndiff as the default with the ui.diff-formatter setting. For example:"},"2121":{"id":"/reference/config-230","page_id":"/reference/config","tags":[],"type":"text","url":"/reference/config#aliases","content":"You can define aliases for commands, including their arguments. For example:"},"2122":{"id":"/reference/config-231","page_id":"/reference/config","tags":[],"type":"text","url":"/reference/config#aliases","content":"This alias syntax can only run a single jj command. However, you may want to\nexecute multiple jj commands with a single alias, or run arbitrary scripts that\ncomplement your version control workflow. This can be done, but be aware of the\ndanger:"},"2123":{"id":"/reference/config-232","page_id":"/reference/config","tags":[],"type":"text","url":"/reference/config#aliases","content":"type: warning"},"2124":{"id":"/reference/config-233","page_id":"/reference/config","tags":[],"type":"text","url":"/reference/config#aliases","content":"The following technique just provides a convenient syntax for running\narbitrary code on your system. Using it irresponsibly may cause damage\nranging from breaking the behavior of jj undo to wiping your file system.\nExercise the same amount of caution while writing these aliases as you would\nwhen typing commands into the terminal!"},"2125":{"id":"/reference/config-234","page_id":"/reference/config","tags":[],"type":"text","url":"/reference/config#aliases","content":"This feature may be removed or replaced by an embedded scripting language in\nthe future."},"2126":{"id":"/reference/config-235","page_id":"/reference/config","tags":[],"type":"text","url":"/reference/config#aliases","content":"The command jj util exec will simply run any command you pass to it as an\nargument. Additional arguments are passed through. Here are some examples:"},"2127":{"id":"/reference/config-236","page_id":"/reference/config","tags":[],"type":"text","url":"/reference/config#aliases","content":"Note: Shebangs (e.g. #!/usr/bin/env) aren't necessary since you're already\nexplicitly passing your script into the right shell."},"2128":{"id":"/reference/config-237","page_id":"/reference/config","tags":[],"type":"text","url":"/reference/config#editor","content":"The default editor is set via ui.editor, though there are several places to\nset it. The priority is as follows (environment variables are marked with\na $):"},"2129":{"id":"/reference/config-238","page_id":"/reference/config","tags":[],"type":"text","url":"/reference/config#editor","content":"$JJ_EDITOR > ui.editor > $VISUAL > $EDITOR"},"2130":{"id":"/reference/config-239","page_id":"/reference/config","tags":[],"type":"text","url":"/reference/config#editor","content":"Nano is the default editor (Notepad on Windows) in the absence of any other\nsetting, but you could set it explicitly too."},"2131":{"id":"/reference/config-240","page_id":"/reference/config","tags":[],"type":"text","url":"/reference/config#editor","content":"To use NeoVim instead:"},"2132":{"id":"/reference/config-241","page_id":"/reference/config","tags":[],"type":"text","url":"/reference/config#editor","content":"For GUI editors you possibly need to use a -w or --wait. Some examples:"},"2133":{"id":"/reference/config-242","page_id":"/reference/config","tags":[],"type":"text","url":"/reference/config#editor","content":"Obviously, you would only set one line, don't copy them all in!"},"2134":{"id":"/reference/config-243","page_id":"/reference/config","tags":[],"type":"text","url":"/reference/config#editing-diffs","content":"The ui.diff-editor setting affects the default tool used for editing diffs\n(e.g. jj split, jj squash -i). If it is not set, the special value\n:builtin is used. It launches a built-in TUI tool (known as scm-diff-editor)\nto edit the diff in your terminal."},"2135":{"id":"/reference/config-244","page_id":"/reference/config","tags":[],"type":"text","url":"/reference/config#editing-diffs","content":"You can try a different tool temporarily by doing e.g. jj split --tool meld or\nyou can set the option to change the default. This requires that you have an\nappropriate tool installed, see for example the instructions for using\nMeld."},"2136":{"id":"/reference/config-245","page_id":"/reference/config","tags":[],"type":"text","url":"/reference/config#editing-diffs","content":"Suggestion: If possible, it is recommended to try an external diff tool like\nMeld (see below for some other possibilities)\nfor splitting commits and other diff editing, in addition to the built-in diff\neditor. It is good to know the capabilities of both. The built-in diff editor\ndoes not require external tools to be available, is faster for tasks like\npicking hunks, and does not require leaving the terminal. External tools give\nyou the flexibility of picking out portions of lines from the diff or even\narbitrarily editing the text of the files."},"2137":{"id":"/reference/config-246","page_id":"/reference/config","tags":[],"type":"text","url":"/reference/config#editing-diffs","content":"If ui.diff-editor is a string, e.g. \"meld\", the arguments will be read from\nthe following config keys."},"2138":{"id":"/reference/config-247","page_id":"/reference/config","tags":[],"type":"text","url":"/reference/config#editing-diffs","content":"jj makes the following substitutions:"},"2139":{"id":"/reference/config-248","page_id":"/reference/config","tags":[],"type":"text","url":"/reference/config#editing-diffs","content":"$left and $right are replaced with the paths to the left and right\ndirectories to diff respectively."},"2140":{"id":"/reference/config-249","page_id":"/reference/config","tags":[],"type":"text","url":"/reference/config#editing-diffs","content":"If no edit-args are specified, [\"$left\", \"$right\"] are set by default."},"2141":{"id":"/reference/config-250","page_id":"/reference/config","tags":[],"type":"text","url":"/reference/config#editing-diffs","content":"If edit-args = [], jj will refuse to use this tool for diff editing. This is a way to explicitly state that a certain tool (e.g. mergiraf) does not work for diff editing."},"2142":{"id":"/reference/config-251","page_id":"/reference/config","tags":[],"type":"text","url":"/reference/config#editing-diffs","content":"Finally, ui.diff-editor can be a list that specifies a command and its arguments."},"2143":{"id":"/reference/config-252","page_id":"/reference/config","tags":[],"type":"text","url":"/reference/config#editing-diffs","content":"Some examples:"},"2144":{"id":"/reference/config-253","page_id":"/reference/config","tags":[],"type":"text","url":"/reference/config#experimental-3-pane-diff-editing","content":"We offer two special \"3-pane\" diff editor configs:"},"2145":{"id":"/reference/config-254","page_id":"/reference/config","tags":[],"type":"text","url":"/reference/config#experimental-3-pane-diff-editing","content":"meld-3, which requires installing Meld, and"},"2146":{"id":"/reference/config-255","page_id":"/reference/config","tags":[],"type":"text","url":"/reference/config#experimental-3-pane-diff-editing","content":"diffedit3, which requires installing diffedit3."},"2147":{"id":"/reference/config-256","page_id":"/reference/config","tags":[],"type":"text","url":"/reference/config#experimental-3-pane-diff-editing","content":"Meld is a graphical application that is recommended, but can be difficult to\ninstall in some situations. diffedit3 is designed to be easy to install and to\nbe usable in environments where Meld is difficult to use (e.g. over SSH via port\nforwarding). diffedit3 starts a local server that can be accessed via a web\nbrowser, similarly to Jupyter."},"2148":{"id":"/reference/config-257","page_id":"/reference/config","tags":[],"type":"text","url":"/reference/config#experimental-3-pane-diff-editing","content":"There is also the diffedit3-ssh which is similar to diffedit3 but does not\ntry to open the web browser pointing to the local server (the URL\nprinted to the terminal) automatically. diffedit3-ssh also always uses ports in between\n17376-17380 and fails if they are all busy. This can be useful when working\nover SSH. Open the fold below for more details of how to set that up."},"2149":{"id":"/reference/config-258","page_id":"/reference/config","tags":[],"type":"text","url":"/reference/config#experimental-3-pane-diff-editing","content":"To use diffedit3 over SSH, you need to set up port forwarding. One way to do\nthis is to start SSH as follows (copy-paste the relevant lines):"},"2150":{"id":"/reference/config-259","page_id":"/reference/config","tags":[],"type":"text","url":"/reference/config#experimental-3-pane-diff-editing","content":"diffedit3-ssh is set up to use these 5 ports by default. Usually, only the\nfirst of them will be used. The rest are used if another program happens to use\none of them, or if you run multiple instances of diffedit3 at the same time."},"2151":{"id":"/reference/config-260","page_id":"/reference/config","tags":[],"type":"text","url":"/reference/config#experimental-3-pane-diff-editing","content":"Another way is to add a snippet to ~/.ssh/config:"},"2152":{"id":"/reference/config-261","page_id":"/reference/config","tags":[],"type":"text","url":"/reference/config#experimental-3-pane-diff-editing","content":"With that configuration, you should be able to simply ssh myhost."},"2153":{"id":"/reference/config-262","page_id":"/reference/config","tags":[],"type":"text","url":"/reference/config#experimental-3-pane-diff-editing","content":"Setting either ui.diff-editor = \"meld-3\" or ui.diff-editor = \"diffedit3\"\nwill result in the diff editor showing 3 panes: the diff on the left and right,\nand an editing pane in the middle. This allow you to see both sides of the\noriginal diff while editing."},"2154":{"id":"/reference/config-263","page_id":"/reference/config","tags":[],"type":"text","url":"/reference/config#experimental-3-pane-diff-editing","content":"If you use ui.diff-editor = \"meld-3\", note that you can still get the 2-pane\nMeld view using jj diff --tool meld. diffedit3 has a button you can use to\nswitch to a 2-pane view."},"2155":{"id":"/reference/config-264","page_id":"/reference/config","tags":[],"type":"text","url":"/reference/config#experimental-3-pane-diff-editing","content":"To configure other diff editors in this way, you can include $output together\nwith $left and $right in merge-tools.TOOL.edit-args. jj will replace\n$output with the directory where the diff editor will be expected to put the\nresult of the user's edits. Initially, the contents of $output will be the\nsame as the contents of $right."},"2156":{"id":"/reference/config-265","page_id":"/reference/config","tags":[],"type":"text","url":"/reference/config#jj-instructions","content":"When editing a diff, jj will include a synthetic file called JJ-INSTRUCTIONS\nin the diff with instructions on how to edit the diff. Any changes you make to\nthis file will be ignored. To suppress the creation of this file, set\nui.diff-instructions = false."},"2157":{"id":"/reference/config-266","page_id":"/reference/config","tags":[],"type":"text","url":"/reference/config#using-meld-as-a-diff-editor","content":"Meld is a nice and polished free diff editor. It can be\nobtained as follows:"},"2158":{"id":"/reference/config-267","page_id":"/reference/config","tags":[],"type":"text","url":"/reference/config#using-meld-as-a-diff-editor","content":"Linux: use your favorite package manager, e.g. sudo apt install meld."},"2159":{"id":"/reference/config-268","page_id":"/reference/config","tags":[],"type":"text","url":"/reference/config#using-meld-as-a-diff-editor","content":"Windows: Meld can be downloaded from https://meldmerge.org/."},"2160":{"id":"/reference/config-269","page_id":"/reference/config","tags":[],"type":"text","url":"/reference/config#using-meld-as-a-diff-editor","content":"Mac OS: Install Homebrew and run brew install --cask meld.\nThis will install both an app in /Applications/Meld.app and the command-line\nmeld command that jj uses. You can read about more details and other\noptions but,\nas of this writing, this is by far the easiest."},"2161":{"id":"/reference/config-270","page_id":"/reference/config","tags":[],"type":"text","url":"/reference/config#using-meld-as-a-diff-editor","content":"jj has two diff editing configurations that use Meld: meld for a 2-pane view\nand meld-3 for a three-pane view."},"2162":{"id":"/reference/config-271","page_id":"/reference/config","tags":[],"type":"text","url":"/reference/config#using-meld-as-a-diff-editor","content":"There is also a meld merge tool\nthat can be useful, but does not support displaying the merge base while\nmerging."},"2163":{"id":"/reference/config-272","page_id":"/reference/config","tags":[],"type":"text","url":"/reference/config#using-vim-as-a-diff-editor","content":"Using ui.diff-editor = \"vimdiff\" is possible but not recommended. For a better\nexperience, you can follow instructions from the Wiki to configure the\nDirDiff Vim plugin and/or the vimtabdiff Python script."},"2164":{"id":"/reference/config-273","page_id":"/reference/config","tags":[],"type":"text","url":"/reference/config#3-way-merge-tools-for-conflict-resolution","content":"The ui.merge-editor key specifies the tool used for three-way merge tools\nby jj resolve. For example:"},"2165":{"id":"/reference/config-274","page_id":"/reference/config","tags":[],"type":"text","url":"/reference/config#3-way-merge-tools-for-conflict-resolution","content":"The following tools can be used out of the box, as long as they are installed:"},"2166":{"id":"/reference/config-275","page_id":"/reference/config","tags":[],"type":"text","url":"/reference/config#3-way-merge-tools-for-conflict-resolution","content":"\"kdiff3\""},"2167":{"id":"/reference/config-276","page_id":"/reference/config","tags":[],"type":"text","url":"/reference/config#3-way-merge-tools-for-conflict-resolution","content":"\"meld\""},"2168":{"id":"/reference/config-277","page_id":"/reference/config","tags":[],"type":"text","url":"/reference/config#3-way-merge-tools-for-conflict-resolution","content":"\"mergiraf\""},"2169":{"id":"/reference/config-278","page_id":"/reference/config","tags":[],"type":"text","url":"/reference/config#3-way-merge-tools-for-conflict-resolution","content":"\"smerge\""},"2170":{"id":"/reference/config-279","page_id":"/reference/config","tags":[],"type":"text","url":"/reference/config#3-way-merge-tools-for-conflict-resolution","content":"\"vimdiff\""},"2171":{"id":"/reference/config-280","page_id":"/reference/config","tags":[],"type":"text","url":"/reference/config#3-way-merge-tools-for-conflict-resolution","content":"\"vscode\""},"2172":{"id":"/reference/config-281","page_id":"/reference/config","tags":[],"type":"text","url":"/reference/config#3-way-merge-tools-for-conflict-resolution","content":"\"vscodium\""},"2173":{"id":"/reference/config-282","page_id":"/reference/config","tags":[],"type":"text","url":"/reference/config#3-way-merge-tools-for-conflict-resolution","content":"Using VS Code as a merge tool works well with VS Code's Remote\nDevelopment\nfunctionality, as long as jj is called from VS Code's terminal."},"2174":{"id":"/reference/config-283","page_id":"/reference/config","tags":[],"type":"text","url":"/reference/config#setting-up-a-custom-merge-tool","content":"To use a different tool named TOOL, the arguments to pass to the tool MUST be\nspecified either inline or in the merge-tools.TOOL.merge-args key. As an\nexample of how to set this key and other tool configuration options, here is\nthe out-of-the-box configuration of the three default tools. (There is no need\nto copy it to your config file verbatim, but you are welcome to customize it.)"},"2175":{"id":"/reference/config-284","page_id":"/reference/config","tags":[],"type":"text","url":"/reference/config#setting-up-a-custom-merge-tool","content":"jj makes the following substitutions:"},"2176":{"id":"/reference/config-285","page_id":"/reference/config","tags":[],"type":"text","url":"/reference/config#setting-up-a-custom-merge-tool","content":"$output (REQUIRED) is replaced with the name of the file that the merge tool\nshould output. jj will read this file after the merge tool exits."},"2177":{"id":"/reference/config-286","page_id":"/reference/config","tags":[],"type":"text","url":"/reference/config#setting-up-a-custom-merge-tool","content":"$left and $right are replaced with the paths to two files containing the\ncontent of each side of the conflict."},"2178":{"id":"/reference/config-287","page_id":"/reference/config","tags":[],"type":"text","url":"/reference/config#setting-up-a-custom-merge-tool","content":"$base is replaced with the path to a file containing the contents of the\nconflicted file in the last common ancestor of the two sides of the conflict."},"2179":{"id":"/reference/config-288","page_id":"/reference/config","tags":[],"type":"text","url":"/reference/config#setting-up-a-custom-merge-tool","content":"$marker_length is replaced with the length of the conflict markers which\nshould be used for the file. This can be useful if the merge tool parses\nand/or generates conflict markers. Usually, jj uses conflict markers of\nlength 7, but they can be longer if necessary to make parsing unambiguous."},"2180":{"id":"/reference/config-289","page_id":"/reference/config","tags":[],"type":"text","url":"/reference/config#setting-up-a-custom-merge-tool","content":"Unlike diff-args or edit-args, there is no default value for merge-args.\nIf merge-args are not specified, the tool cannot be used for conflict\nresolution."},"2181":{"id":"/reference/config-290","page_id":"/reference/config","tags":[],"type":"text","url":"/reference/config#editing-conflict-markers-with-a-tool-or-a-text-editor","content":"By default, the merge tool starts with an empty output file. If the tool puts\nanything into the output file and exits with the 0 exit code,\njj assumes that the conflict is fully resolved, while if the tool exits with\na non-zero exit code, jj assumes that the merge should be canceled.\nThis is appropriate for most graphical merge tools."},"2182":{"id":"/reference/config-291","page_id":"/reference/config","tags":[],"type":"text","url":"/reference/config#editing-conflict-markers-with-a-tool-or-a-text-editor","content":"For merge tools which try to automatically resolve conflicts without user input,\nthis behavior may not be desired. For instance, some automatic merge tools use\nan exit code of 1 to indicate that some conflicts were unable to be resolved and\nthat the output file should contain conflict markers. In that case, you could\nset the config option merge-tools.TOOL.merge-conflict-exit-codes = [1] to tell\njj to expect conflict markers in the output file if the exit code is 1. If a\nmerge tool produces output using Git's \"diff3\" conflict style, jj should be\nable to parse it correctly, so many Git merge drivers should be usable with jj\nas well."},"2183":{"id":"/reference/config-292","page_id":"/reference/config","tags":[],"type":"text","url":"/reference/config#editing-conflict-markers-with-a-tool-or-a-text-editor","content":"Some tools (e.g. vimdiff) can present a multi-way diff but don't resolve\nconflict themselves. When using such tools, jj\ncan help you by populating the output file with conflict markers before starting\nthe merge tool (instead of leaving the output file empty and letting the merge\ntool fill it in). To do that, set the\nmerge-tools.vimdiff.merge-tool-edits-conflict-markers = true option."},"2184":{"id":"/reference/config-293","page_id":"/reference/config","tags":[],"type":"text","url":"/reference/config#editing-conflict-markers-with-a-tool-or-a-text-editor","content":"With this option set, if the output file still contains conflict markers after\nthe conflict is done, jj assumes that the conflict was only partially resolved\nand parses the conflict markers to get the new state of the conflict. The\nconflict is considered fully resolved when there are no conflict markers left.\nThe conflict marker style can also be customized per tool using the\nmerge-tools.TOOL.conflict-marker-style option, which takes the same values as\nui.conflict-marker-style."},"2185":{"id":"/reference/config-294","page_id":"/reference/config","tags":[],"type":"text","url":"/reference/config#code-formatting-and-other-file-content-transformations","content":"The jj fix command allows you to efficiently rewrite files in complex commit\ngraphs with no risk of introducing conflicts, using tools like clang-format or\nprettier. The tools run as subprocesses that take file content on standard\ninput and repeat it, with any desired changes, on standard output. The file is\nonly rewritten if the subprocess produces a successful exit code."},"2186":{"id":"/reference/config-295","page_id":"/reference/config","tags":[],"type":"text","url":"/reference/config#enforce-coding-style-rules","content":"Suppose you want to use clang-format to format your *.c and *.h files,\nas well as sorting their #include directives."},"2187":{"id":"/reference/config-296","page_id":"/reference/config","tags":[],"type":"text","url":"/reference/config#enforce-coding-style-rules","content":"jj fix provides the file content anonymously on standard input, but the name\nof the file being formatted may be important for include sorting or other output\nlike error messages. To address this, you can use the $path substitution to\nprovide the name of the file in a command argument."},"2188":{"id":"/reference/config-297","page_id":"/reference/config","tags":[],"type":"text","url":"/reference/config#sort-and-remove-duplicate-lines-from-a-file","content":"jj fix can also be used with tools that are not considered code formatters."},"2189":{"id":"/reference/config-298","page_id":"/reference/config","tags":[],"type":"text","url":"/reference/config#sort-and-remove-duplicate-lines-from-a-file","content":"Suppose you have a list of words in a text file in your repository, and you want\nto keep the file sorted alphabetically and remove any duplicate words."},"2190":{"id":"/reference/config-299","page_id":"/reference/config","tags":[],"type":"text","url":"/reference/config#tools-stored-inside-the-workspace","content":"Some fix tools may be stored inside the workspace. For example, a binary may be\nstored inside node_modules. Use the $root variable to create an absolute\npath to such a program:"},"2191":{"id":"/reference/config-300","page_id":"/reference/config","tags":[],"type":"text","url":"/reference/config#execution-order-of-tools","content":"If two or more tools affect the same file, they are executed in the ascending\nlexicographical order of their configured names. This will remain as a tie\nbreaker if other ordering mechanisms are introduced in the future. If you use\nnumbers in tool names to control execution order, remember to include enough\nleading zeros so that, for example, 09 sorts before 10."},"2192":{"id":"/reference/config-301","page_id":"/reference/config","tags":[],"type":"text","url":"/reference/config#execution-order-of-tools","content":"Suppose you want to keep only the 10 smallest numbers in a text file that\ncontains one number on each line. This can be accomplished with sort and\nhead, but execution order is important."},"2193":{"id":"/reference/config-302","page_id":"/reference/config","tags":[],"type":"text","url":"/reference/config#disabling-and-enabling-tools","content":"Tools can be disabled and enabled with the optional enabled config. This\nallows you to define tools globally but enable them only for specific\nrepositories."},"2194":{"id":"/reference/config-303","page_id":"/reference/config","tags":[],"type":"text","url":"/reference/config#disabling-and-enabling-tools","content":"In the user configuration, define a disabled tool for running rustfmt:"},"2195":{"id":"/reference/config-304","page_id":"/reference/config","tags":[],"type":"text","url":"/reference/config#disabling-and-enabling-tools","content":"Then to use the tool in a specific repository, set the enabled config:"},"2196":{"id":"/reference/config-305","page_id":"/reference/config","tags":[],"type":"text","url":"/reference/config#commit-signing","content":"jj can be configured to sign and verify the commits it creates using either\nGnuPG or SSH signing keys."},"2197":{"id":"/reference/config-306","page_id":"/reference/config","tags":[],"type":"text","url":"/reference/config#commit-signing","content":"To do this you need to configure a signing backend."},"2198":{"id":"/reference/config-307","page_id":"/reference/config","tags":[],"type":"text","url":"/reference/config#commit-signing","content":"Setting the backend to \"none\" disables signing."},"2199":{"id":"/reference/config-308","page_id":"/reference/config","tags":[],"type":"text","url":"/reference/config#gnupg-signing","content":"By default the gpg backend will look for a gpg binary on your path. If you want\nto change the program used or specify a path to gpg explicitly you can set:"},"2200":{"id":"/reference/config-309","page_id":"/reference/config","tags":[],"type":"text","url":"/reference/config#gnupg-signing","content":"Also by default the gpg backend will consider key expiry when verifying commit signatures.\nTo consider expired keys as valid you can set:"},"2201":{"id":"/reference/config-310","page_id":"/reference/config","tags":[],"type":"text","url":"/reference/config#pkcs12-certificates","content":"PKCS#12 certificates can be used to sign commits using the gpgsm backend."},"2202":{"id":"/reference/config-311","page_id":"/reference/config","tags":[],"type":"text","url":"/reference/config#pkcs12-certificates","content":"By default the gpgsm backend will look for a gpgsm binary on your path. If you want\nto change the program used or specify a path to gpgsm explicitly you can set:"},"2203":{"id":"/reference/config-312","page_id":"/reference/config","tags":[],"type":"text","url":"/reference/config#pkcs12-certificates","content":"Also by default the gpgsm backend will consider key expiry when verifying commit signatures.\nTo consider expired keys as valid you can set:"},"2204":{"id":"/reference/config-313","page_id":"/reference/config","tags":[],"type":"text","url":"/reference/config#ssh-signing","content":"By default the ssh backend will look for a ssh-keygen binary on your path. If you want\nto change the program used or specify a path to ssh-keygen explicitly you can set:"},"2205":{"id":"/reference/config-314","page_id":"/reference/config","tags":[],"type":"text","url":"/reference/config#ssh-signing","content":"When verifying commit signatures the ssh backend needs to be provided with an allowed-signers\nfile containing the public keys of authors whose signatures you want to be able to verify."},"2206":{"id":"/reference/config-315","page_id":"/reference/config","tags":[],"type":"text","url":"/reference/config#ssh-signing","content":"You can find the format for this file in the\nssh-keygen man page. This can be provided\nas follows:"},"2207":{"id":"/reference/config-316","page_id":"/reference/config","tags":[],"type":"text","url":"/reference/config#ssh-signing","content":"Additionally, an SSH KRL or list of revoked public keys (see\nssh-keygen man page) can be provided\nwith the revocation-list option. If a public key is found in this file then any signature\nrelating to it is marked as invalid."},"2208":{"id":"/reference/config-317","page_id":"/reference/config","tags":[],"type":"text","url":"/reference/config#manually-signing-commits","content":"You can use jj sign/jj unsign\nto sign/unsign commits manually."},"2209":{"id":"/reference/config-318","page_id":"/reference/config","tags":[],"type":"text","url":"/reference/config#manually-signing-commits","content":"type: warning"},"2210":{"id":"/reference/config-319","page_id":"/reference/config","tags":[],"type":"text","url":"/reference/config#manually-signing-commits","content":"jj sign always signs commits, even if they are already signed by the user.\nWhile this is cumbersome for users signing via hardware devices, we cannot\nreliably check if a commit is already signed without creating a signature (see\nthis issue)."},"2211":{"id":"/reference/config-320","page_id":"/reference/config","tags":[],"type":"text","url":"/reference/config#automatically-signing-commits","content":"The signing.behavior configuration option has four different options for what\nto do with signing commits on modification of a change (e.g., rebasing or edits)."},"2212":{"id":"/reference/config-321","page_id":"/reference/config","tags":[],"type":"text","url":"/reference/config#automatically-signing-commits","content":"drop: do not automatically sign; if a change was signed before\nmodification, drop that signing after modification."},"2213":{"id":"/reference/config-322","page_id":"/reference/config","tags":[],"type":"text","url":"/reference/config#automatically-signing-commits","content":"keep: if a change was signed before modification, and it was authored by\nyou, attempt to sign it again after the modification."},"2214":{"id":"/reference/config-323","page_id":"/reference/config","tags":[],"type":"text","url":"/reference/config#automatically-signing-commits","content":"own: sign all commits that were authored by you when you modify them."},"2215":{"id":"/reference/config-324","page_id":"/reference/config","tags":[],"type":"text","url":"/reference/config#automatically-signing-commits","content":"force: sign all commits after modification, always, even if you are not the\nauthor."},"2216":{"id":"/reference/config-325","page_id":"/reference/config","tags":[],"type":"text","url":"/reference/config#automatically-signing-commits","content":"Instead of signing all commits during creation when signing.behavior is\nset to own, the git.sign-on-push configuration can be used to sign\ncommits only upon running jj git push. All mutable unsigned commits\nbeing pushed will be signed prior to pushing. This might be preferred if the\nsigning backend requires user interaction or is slow, so that signing is\nperformed in a single batch operation."},"2217":{"id":"/reference/config-326","page_id":"/reference/config","tags":[],"type":"text","url":"/reference/config#commit-signature-verification","content":"By default signature verification and display is disabled as it incurs a\nperformance cost when rendering medium to large change logs. You can enable it\nby setting ui.show-cryptographic-signatures to true in your configuration."},"2218":{"id":"/reference/config-327","page_id":"/reference/config","tags":[],"type":"text","url":"/reference/config#commit-signature-verification","content":"If you want to display commit signatures in your templates, you can use\ncommit.signature() (see Commit type). The\nreturned CryptographicSignature\nType provides methods to retrieve\nsignature details."},"2219":{"id":"/reference/config-328","page_id":"/reference/config","tags":[],"type":"text","url":"/reference/config#default-colocation","content":"When creating a git-backed Jujutsu repository, you can disable colocation which\nplaces the .git directory next to the .jj directory. Colocation allows some\namount of two-way interoperability, but it can perform worse in large repos."},"2220":{"id":"/reference/config-329","page_id":"/reference/config","tags":[],"type":"text","url":"/reference/config#default-colocation","content":"The setting git.colocate is a boolean option that controls whether or not the\njj git init and jj git clone commands should create colocated repositories\nby default. By default, git.colocate is set to true."},"2221":{"id":"/reference/config-330","page_id":"/reference/config","tags":[],"type":"text","url":"/reference/config#default-colocation","content":"See Colocated Jujutsu/Git repos for more information."},"2222":{"id":"/reference/config-331","page_id":"/reference/config","tags":[],"type":"text","url":"/reference/config#default-remotes-for-jj-git-fetch-and-jj-git-push","content":"By default, if a single remote exists it is used for jj git fetch and jj git\npush; however if multiple remotes exist, the default remote is assumed to be\nnamed \"origin\", just like in Git. Sometimes this is undesirable, e.g. when you\nwant to fetch from a different remote than you push to, such as a GitHub fork."},"2223":{"id":"/reference/config-332","page_id":"/reference/config","tags":[],"type":"text","url":"/reference/config#default-remotes-for-jj-git-fetch-and-jj-git-push","content":"To change this behavior, you can modify the repository\nconfiguration variable git.fetch, which can be a\nsingle remote, or a list of remotes to fetch from multiple places:"},"2224":{"id":"/reference/config-333","page_id":"/reference/config","tags":[],"type":"text","url":"/reference/config#default-remotes-for-jj-git-fetch-and-jj-git-push","content":"By default, the specified remote names matches exactly. You can also use a\nstring pattern to select remotes using patterns:"},"2225":{"id":"/reference/config-334","page_id":"/reference/config","tags":[],"type":"text","url":"/reference/config#default-remotes-for-jj-git-fetch-and-jj-git-push","content":"Similarly, you can also set the variable git.push to cause jj git push to\npush to a different remote:"},"2226":{"id":"/reference/config-335","page_id":"/reference/config","tags":[],"type":"text","url":"/reference/config#default-remotes-for-jj-git-fetch-and-jj-git-push","content":"Note that unlike git.fetch, git.push can currently only be a single remote.\nThis is not a hard limitation, and could be changed in the future if there is\ndemand."},"2227":{"id":"/reference/config-336","page_id":"/reference/config","tags":[],"type":"text","url":"/reference/config#automatic-local-bookmark-creation","content":"When jj imports a new remote-tracking bookmark from Git, it can also create a\nlocal bookmark with the same name. This feature is disabled by default because it\nmay be undesirable in some repositories, e.g.:"},"2228":{"id":"/reference/config-337","page_id":"/reference/config","tags":[],"type":"text","url":"/reference/config#automatic-local-bookmark-creation","content":"There is a remote with a lot of historical bookmarks that you don't\nwant to be exported to the colocated Git repo."},"2229":{"id":"/reference/config-338","page_id":"/reference/config","tags":[],"type":"text","url":"/reference/config#automatic-local-bookmark-creation","content":"There are multiple remotes with conflicting views of that bookmark,\nresulting in an unhelpful conflicted state."},"2230":{"id":"/reference/config-339","page_id":"/reference/config","tags":[],"type":"text","url":"/reference/config#automatic-local-bookmark-creation","content":"You can enable this behavior by setting git.auto-local-bookmark like so,"},"2231":{"id":"/reference/config-340","page_id":"/reference/config","tags":[],"type":"text","url":"/reference/config#automatic-local-bookmark-creation","content":"This setting is applied only to new remote bookmarks. Existing remote bookmarks\ncan be tracked individually by using jj bookmark track/untrack commands."},"2232":{"id":"/reference/config-341","page_id":"/reference/config","tags":[],"type":"text","url":"/reference/config#automatic-local-bookmark-creation-on-jj-git-clone","content":"When cloning a new Git repository, jj by default creates a local bookmark\ntracking the default remote bookmark (such as main for main@origin.) If you\naren't going to update the main bookmark locally, the tracking bookmark isn't\nnecessary."},"2233":{"id":"/reference/config-342","page_id":"/reference/config","tags":[],"type":"text","url":"/reference/config#automatic-local-bookmark-creation-on-jj-git-clone","content":"This behavior can be disabled by"},"2234":{"id":"/reference/config-343","page_id":"/reference/config","tags":[],"type":"text","url":"/reference/config#abandon-commits-that-became-unreachable-in-git","content":"By default, when jj imports refs from Git, it will look for commits that used\nto be reachable but no longer are reachable. Those commits will\nthen be abandoned, and any descendant commits will be rebased off of them (as\nusual when commits are abandoned). You can disable this behavior and instead\nleave the Git-unreachable commits in your repo by setting:"},"2235":{"id":"/reference/config-344","page_id":"/reference/config","tags":[],"type":"text","url":"/reference/config#allow-pushing-new-bookmarks","content":"jj git push does not push newly-created bookmarks by default.\nIf you do not want to specify --allow-new every time you have created a new\nbookmark, you may want to allow new bookmarks to be pushed by default:"},"2236":{"id":"/reference/config-345","page_id":"/reference/config","tags":[],"type":"text","url":"/reference/config#generated-bookmark-names-on-push","content":"jj git push --change generates bookmark names with a prefix of \"push-\" by\ndefault. You can pick a different prefix and formatting by setting the\ntemplates.git_push_bookmark template. For example:"},"2237":{"id":"/reference/config-346","page_id":"/reference/config","tags":[],"type":"text","url":"/reference/config#generated-bookmark-names-on-push","content":"This template should include expressions like change_id to generate unique and\nstable bookmark."},"2238":{"id":"/reference/config-347","page_id":"/reference/config","tags":[],"type":"text","url":"/reference/config#set-of-private-commits","content":"You can configure the set of private commits by setting git.private-commits to\na revset. The value is a revset of commits that Jujutsu will refuse to push. If\nunset, all commits are eligible to be pushed."},"2239":{"id":"/reference/config-348","page_id":"/reference/config","tags":[],"type":"text","url":"/reference/config#set-of-private-commits","content":"If a commit is in git.private-commits but is already on the remote, then it is\nnot considered a private commit. Commits that are immutable are also excluded\nfrom the private set."},"2240":{"id":"/reference/config-349","page_id":"/reference/config","tags":[],"type":"text","url":"/reference/config#set-of-private-commits","content":"Private commits prevent their descendants from being pushed, since doing so\nwould require pushing the private commit as well."},"2241":{"id":"/reference/config-350","page_id":"/reference/config","tags":[],"type":"text","url":"/reference/config#git-subprocessing-behavior","content":"Git remote interactions are handled by spawning a git subprocess.\nIf git is not on your OS path, or you want to specify a particular binary,\nyou can:"},"2242":{"id":"/reference/config-351","page_id":"/reference/config","tags":[],"type":"text","url":"/reference/config#granularity-of-hunks","content":"jj by default resolves content conflicts by splitting text into line-level\nhunks and merge them. This can be configured to split hunks further into\nword-level hunks."},"2243":{"id":"/reference/config-352","page_id":"/reference/config","tags":[],"type":"text","url":"/reference/config#granularity-of-hunks","content":"line: split into line hunks (default)"},"2244":{"id":"/reference/config-353","page_id":"/reference/config","tags":[],"type":"text","url":"/reference/config#granularity-of-hunks","content":"word: split into word hunks"},"2245":{"id":"/reference/config-354","page_id":"/reference/config","tags":[],"type":"text","url":"/reference/config#filesystem-monitor","content":"In large repositories, it may be beneficial to use a \"filesystem monitor\" to\ntrack changes to the working copy. This allows jj to take working copy\nsnapshots without having to rescan the entire working copy."},"2246":{"id":"/reference/config-355","page_id":"/reference/config","tags":[],"type":"text","url":"/reference/config#filesystem-monitor","content":"This is governed by the fsmonitor.backend option. Currently, the valid values\nare \"none\" or \"watchman\"."},"2247":{"id":"/reference/config-356","page_id":"/reference/config","tags":[],"type":"text","url":"/reference/config#watchman","content":"To configure the Watchman filesystem monitor, set\nfsmonitor.backend = \"watchman\". Ensure that you have installed the Watchman\nexecutable on your system."},"2248":{"id":"/reference/config-357","page_id":"/reference/config","tags":[],"type":"text","url":"/reference/config#watchman","content":"You can configure jj to use watchman triggers to automatically create\nsnapshots on filesystem changes by setting\nfsmonitor.watchman.register-snapshot-trigger = true."},"2249":{"id":"/reference/config-358","page_id":"/reference/config","tags":[],"type":"text","url":"/reference/config#watchman","content":"You can check whether Watchman is enabled and whether it is installed correctly\nusing jj debug watchman status."},"2250":{"id":"/reference/config-359","page_id":"/reference/config","tags":[],"type":"text","url":"/reference/config#watchman","content":"Note: watchman heavily uses inotify and sets up a user watch per-file. On\nlarge repositories, this may cause watchman to fail and commands like\njj status to take longer than expected. If you experience this run\njj debug watchman status and tune your inotify limits."},"2251":{"id":"/reference/config-360","page_id":"/reference/config","tags":[],"type":"text","url":"/reference/config#paths-to-automatically-track","content":"All new files in the working copy that don't match the ignore patterns are\ntracked by default. You can set the snapshot.auto-track to set which paths\nget automatically tracked when they're added to the working copy. See the\nfileset documentation for the syntax. Files with paths matching\nignore files are never tracked automatically."},"2252":{"id":"/reference/config-361","page_id":"/reference/config","tags":[],"type":"text","url":"/reference/config#paths-to-automatically-track","content":"If you set snapshot.auto-track to a non-default value, untracked files can be\ntracked with jj file track."},"2253":{"id":"/reference/config-362","page_id":"/reference/config","tags":[],"type":"text","url":"/reference/config#paths-to-automatically-track","content":"You can use jj file untrack to untrack a file while keeping it in the working\ncopy. However, first ignore them or remove them\nfrom the snapshot.auto-track patterns; otherwise they will be immediately\ntracked again."},"2254":{"id":"/reference/config-363","page_id":"/reference/config","tags":[],"type":"text","url":"/reference/config#maximum-size-for-new-files","content":"By default, as an anti-footgun measure, jj will refuse to add new files to the\nsnapshot that are larger than a certain size; the default is 1MiB. This can be\nchanged by setting snapshot.max-new-file-size to a different value. For\nexample:"},"2255":{"id":"/reference/config-364","page_id":"/reference/config","tags":[],"type":"text","url":"/reference/config#maximum-size-for-new-files","content":"The value can be specified using a human readable string with typical suffixes;\nB, MiB, GB, etc. By default, if no suffix is provided, or the value is a\nraw integer literal, the value is interpreted as if it were specified in bytes."},"2256":{"id":"/reference/config-365","page_id":"/reference/config","tags":[],"type":"text","url":"/reference/config#maximum-size-for-new-files","content":"Files that already exist in the working copy are not subject to this limit."},"2257":{"id":"/reference/config-366","page_id":"/reference/config","tags":[],"type":"text","url":"/reference/config#maximum-size-for-new-files","content":"Setting this value to zero will disable the limit entirely."},"2258":{"id":"/reference/config-367","page_id":"/reference/config","tags":[],"type":"text","url":"/reference/config#eol-conversion-settings","content":"This settings serves the same purpose as the core.autocrlf git\nconfig."},"2259":{"id":"/reference/config-368","page_id":"/reference/config","tags":[],"type":"text","url":"/reference/config#eol-conversion-settings","content":"The line endings conversion won't be applied to files detected as binary files\nvia a heuristics regardless of the settings. This is similar to git."},"2260":{"id":"/reference/config-369","page_id":"/reference/config","tags":[],"type":"text","url":"/reference/config#eol-conversion-settings","content":"To detect if a file is binary, Jujutsu currently checks if there is NULL\nbyte in the file which is different from the algorithm of\ngitoxide or git. Jujutsu\ndoesn't plan to align the binary detection logic with git."},"2261":{"id":"/reference/config-370","page_id":"/reference/config","tags":[],"type":"text","url":"/reference/config#user-config-files","content":"An easy way to find the user config file/directory is:"},"2262":{"id":"/reference/config-371","page_id":"/reference/config","tags":[],"type":"text","url":"/reference/config#user-config-files","content":"On all platforms, the user's global jj configurations are by default loaded in\nthe following precedence order (with later configs overriding earlier ones):"},"2263":{"id":"/reference/config-372","page_id":"/reference/config","tags":[],"type":"text","url":"/reference/config#user-config-files","content":"$HOME/.jjconfig.toml"},"2264":{"id":"/reference/config-373","page_id":"/reference/config","tags":[],"type":"text","url":"/reference/config#user-config-files","content":"<PLATFORM_SPECIFIC>/jj/config.toml (preferred)"},"2265":{"id":"/reference/config-374","page_id":"/reference/config","tags":[],"type":"text","url":"/reference/config#user-config-files","content":"<PLATFORM_SPECIFIC>/jj/conf.d/*.toml"},"2266":{"id":"/reference/config-375","page_id":"/reference/config","tags":[],"type":"text","url":"/reference/config#user-config-files","content":"where $HOME represents the user's home directory (%USERPROFILE% on Windows),\nand <PLATFORM_SPECIFIC> represents the platform-specific configuration\ndirectory shown in the table below. The platform-specific location is\nrecommended for better integration with platform services."},"2267":{"id":"/reference/config-376","page_id":"/reference/config","tags":[],"type":"text","url":"/reference/config#user-config-files","content":"The files in the conf.d directory are loaded in lexicographic order. This allows\nconfigs to be split across multiple files and combines well\nwith Conditional Variables."},"2268":{"id":"/reference/config-377","page_id":"/reference/config","tags":[],"type":"text","url":"/reference/config#user-config-files","content":"Platform"},"2269":{"id":"/reference/config-378","page_id":"/reference/config","tags":[],"type":"text","url":"/reference/config#user-config-files","content":"Location of <PLATFORM_SPECIFIC> dir"},"2270":{"id":"/reference/config-379","page_id":"/reference/config","tags":[],"type":"text","url":"/reference/config#user-config-files","content":"Example config file location"},"2271":{"id":"/reference/config-380","page_id":"/reference/config","tags":[],"type":"text","url":"/reference/config#user-config-files","content":"Linux and macOS"},"2272":{"id":"/reference/config-381","page_id":"/reference/config","tags":[],"type":"text","url":"/reference/config#user-config-files","content":"$XDG_CONFIG_HOME or $HOME/.config"},"2273":{"id":"/reference/config-382","page_id":"/reference/config","tags":[],"type":"text","url":"/reference/config#user-config-files","content":"/home/alice/.config/jj/config.toml"},"2274":{"id":"/reference/config-383","page_id":"/reference/config","tags":[],"type":"text","url":"/reference/config#user-config-files","content":"Windows"},"2275":{"id":"/reference/config-384","page_id":"/reference/config","tags":[],"type":"text","url":"/reference/config#user-config-files","content":"{FOLDERID_RoamingAppData}"},"2276":{"id":"/reference/config-385","page_id":"/reference/config","tags":[],"type":"text","url":"/reference/config#user-config-files","content":"C:\\Users\\Alice\\AppData\\Roaming\\jj\\config.toml"},"2277":{"id":"/reference/config-386","page_id":"/reference/config","tags":[],"type":"text","url":"/reference/config#user-config-files","content":"On macOS, jj used to put the user config in ~/Library/Application Support,\nand jj will still look there for backwards compatibility purposes; this is\nconsidered a deprecated location, and you should use the new default\nXDG_CONFIG_HOME."},"2278":{"id":"/reference/config-387","page_id":"/reference/config","tags":[],"type":"text","url":"/reference/config#user-config-files","content":"The location of the jj user config files/directories can also be overridden with the\nJJ_CONFIG environment variable. If it is not empty, it will be used instead\nof any configuration files in the default locations. If it is a path to a TOML\nfile, then that file will be loaded instead. If it is a path to a directory,\nthen all the TOML files in that directory will be loaded in lexicographic order\nand merged. Multiple paths can be specified by separating them with a\nplatform-specific path separator (: on Unix-like systems, ; on Windows)."},"2279":{"id":"/reference/config-388","page_id":"/reference/config","tags":[],"type":"text","url":"/reference/config#user-config-files","content":"For example, the following could be used to run jj without loading any user configs:"},"2280":{"id":"/reference/config-389","page_id":"/reference/config","tags":[],"type":"text","url":"/reference/config#json-schema-support","content":"Many popular editors support TOML file syntax highlighting and validation. To\nenable schema validation in your editor, add this line at the top of your TOML\nconfig files:"},"2281":{"id":"/reference/config-390","page_id":"/reference/config","tags":[],"type":"text","url":"/reference/config#json-schema-support","content":"This enables features like:"},"2282":{"id":"/reference/config-391","page_id":"/reference/config","tags":[],"type":"text","url":"/reference/config#json-schema-support","content":"Autocomplete for config keys"},"2283":{"id":"/reference/config-392","page_id":"/reference/config","tags":[],"type":"text","url":"/reference/config#json-schema-support","content":"Type checking of values"},"2284":{"id":"/reference/config-393","page_id":"/reference/config","tags":[],"type":"text","url":"/reference/config#json-schema-support","content":"Documentation on hover"},"2285":{"id":"/reference/config-394","page_id":"/reference/config","tags":[],"type":"text","url":"/reference/config#json-schema-support","content":"Validation of settings"},"2286":{"id":"/reference/config-395","page_id":"/reference/config","tags":[],"type":"text","url":"/reference/config#json-schema-support","content":"Here are some popular editors with TOML schema validation support:"},"2287":{"id":"/reference/config-396","page_id":"/reference/config","tags":[],"type":"text","url":"/reference/config#json-schema-support","content":"VS Code"},"2288":{"id":"/reference/config-397","page_id":"/reference/config","tags":[],"type":"text","url":"/reference/config#json-schema-support","content":"Install Even Better TOML"},"2289":{"id":"/reference/config-398","page_id":"/reference/config","tags":[],"type":"text","url":"/reference/config#json-schema-support","content":"Neovim/Vim"},"2290":{"id":"/reference/config-399","page_id":"/reference/config","tags":[],"type":"text","url":"/reference/config#json-schema-support","content":"Use with nvim-lspconfig and taplo"},"2291":{"id":"/reference/config-400","page_id":"/reference/config","tags":[],"type":"text","url":"/reference/config#json-schema-support","content":"Helix"},"2292":{"id":"/reference/config-401","page_id":"/reference/config","tags":[],"type":"text","url":"/reference/config#json-schema-support","content":"Install taplo"},"2293":{"id":"/reference/config-402","page_id":"/reference/config","tags":[],"type":"text","url":"/reference/config#json-schema-support","content":"JetBrains IDEs (IntelliJ, PyCharm, etc)"},"2294":{"id":"/reference/config-403","page_id":"/reference/config","tags":[],"type":"text","url":"/reference/config#json-schema-support","content":"Install TOML plugin"},"2295":{"id":"/reference/config-404","page_id":"/reference/config","tags":[],"type":"text","url":"/reference/config#json-schema-support","content":"Emacs"},"2296":{"id":"/reference/config-405","page_id":"/reference/config","tags":[],"type":"text","url":"/reference/config#json-schema-support","content":"Install lsp-mode and toml-mode"},"2297":{"id":"/reference/config-406","page_id":"/reference/config","tags":[],"type":"text","url":"/reference/config#json-schema-support","content":"Configure taplo as the LSP server"},"2298":{"id":"/reference/config-407","page_id":"/reference/config","tags":[],"type":"text","url":"/reference/config#specifying-config-on-the-command-line","content":"You can use one or more --config/--config-file options on the command line\nto specify additional configuration settings. This overrides settings defined in\nconfig files or environment variables. For example,"},"2299":{"id":"/reference/config-408","page_id":"/reference/config","tags":[],"type":"text","url":"/reference/config#specifying-config-on-the-command-line","content":"Config value should be specified as a TOML expression. If string value isn't\nenclosed by any TOML constructs (such as array notation), quotes can be omitted.\nHere is an example with more advanced TOML constructs:"},"2300":{"id":"/reference/config-409","page_id":"/reference/config","tags":[],"type":"text","url":"/reference/config#specifying-config-on-the-command-line","content":"To load an entire TOML document, use --config-file:"},"2301":{"id":"/reference/config-410","page_id":"/reference/config","tags":[],"type":"text","url":"/reference/config#conditional-variables","content":"You can conditionally enable config variables by using --when."},"2302":{"id":"/reference/config-411","page_id":"/reference/config","tags":[],"type":"text","url":"/reference/config#using---scope-tables","content":"Variables defined in [[--scope]] tables are expanded to the root table.\n--when specifies the condition to enable the scope table."},"2303":{"id":"/reference/config-412","page_id":"/reference/config","tags":[],"type":"text","url":"/reference/config#using---scope-tables","content":"If no conditions are specified, the table is always enabled. If multiple\nconditions are specified, their intersection is used."},"2304":{"id":"/reference/config-413","page_id":"/reference/config","tags":[],"type":"text","url":"/reference/config#using-multiple-files","content":"--when can also be used on the top level of a TOML file, which is convenient\nwhen splitting your config across multiple files.\nThe behavior of conditions are the same as when using [[--scope]] tables."},"2305":{"id":"/reference/config-414","page_id":"/reference/config","tags":[],"type":"text","url":"/reference/config#available-condition-keys","content":"--when.repositories: List of paths to match the repository path prefix."},"2306":{"id":"/reference/config-415","page_id":"/reference/config","tags":[],"type":"text","url":"/reference/config#available-condition-keys","content":"Paths should be absolute. Each path component (directory or file name, drive\nletter, etc.) is compared case-sensitively on all platforms. A path starting\nwith ~ is expanded to the home directory. On Windows, directory separator may\nbe either \\ or /. (Beware that \\ needs escape in double-quoted strings.)"},"2307":{"id":"/reference/config-416","page_id":"/reference/config","tags":[],"type":"text","url":"/reference/config#available-condition-keys","content":"Use jj root to see the workspace root directory. Note that the repository path\nis in the main workspace if you're using multiple workspaces with jj\nworkspace."},"2308":{"id":"/reference/config-417","page_id":"/reference/config","tags":[],"type":"text","url":"/reference/config#available-condition-keys","content":"--when.commands: List of subcommands to match."},"2309":{"id":"/reference/config-418","page_id":"/reference/config","tags":[],"type":"text","url":"/reference/config#available-condition-keys","content":"Subcommands are space-separated and matched by prefix."},"2310":{"id":"/reference/filesets","page_id":"/reference/filesets","type":"page","content":"Filesets","tags":[],"url":"/reference/filesets"},"2311":{"id":"/reference/filesets-0","page_id":"/reference/filesets","type":"heading","tags":[],"url":"/reference/filesets#quoting-file-names","content":"Quoting file names"},"2312":{"id":"/reference/filesets-1","page_id":"/reference/filesets","type":"heading","tags":[],"url":"/reference/filesets#file-patterns","content":"File patterns"},"2313":{"id":"/reference/filesets-2","page_id":"/reference/filesets","type":"heading","tags":[],"url":"/reference/filesets#operators","content":"Operators"},"2314":{"id":"/reference/filesets-3","page_id":"/reference/filesets","type":"heading","tags":[],"url":"/reference/filesets#functions","content":"Functions"},"2315":{"id":"/reference/filesets-4","page_id":"/reference/filesets","type":"heading","tags":[],"url":"/reference/filesets#examples","content":"Examples"},"2316":{"id":"/reference/filesets-5","page_id":"/reference/filesets","tags":[],"type":"text","url":"/reference/filesets","content":"Jujutsu supports a functional language for selecting a set of files.\nExpressions in this language are called \"filesets\" (the idea comes from\nMercurial). The language\nconsists of file patterns, operators, and functions."},"2317":{"id":"/reference/filesets-6","page_id":"/reference/filesets","tags":[],"type":"text","url":"/reference/filesets#quoting-file-names","content":"Many jj commands accept fileset expressions as positional arguments. File\nnames passed to these commands must be quoted if they contain\nwhitespace or meta characters. However, as a special case, quotes can be omitted\nif the expression has no operators nor function calls. For example:"},"2318":{"id":"/reference/filesets-7","page_id":"/reference/filesets","tags":[],"type":"text","url":"/reference/filesets#quoting-file-names","content":"jj diff 'Foo Bar' (shell quotes are required, but inner quotes are optional)"},"2319":{"id":"/reference/filesets-8","page_id":"/reference/filesets","tags":[],"type":"text","url":"/reference/filesets#quoting-file-names","content":"jj diff '~\"Foo Bar\"' (both shell and inner quotes are required)"},"2320":{"id":"/reference/filesets-9","page_id":"/reference/filesets","tags":[],"type":"text","url":"/reference/filesets#quoting-file-names","content":"jj diff '\"Foo(1)\"' (both shell and inner quotes are required)"},"2321":{"id":"/reference/filesets-10","page_id":"/reference/filesets","tags":[],"type":"text","url":"/reference/filesets#quoting-file-names","content":"Glob characters aren't considered meta characters, but shell quotes are still\nrequired:"},"2322":{"id":"/reference/filesets-11","page_id":"/reference/filesets","tags":[],"type":"text","url":"/reference/filesets#quoting-file-names","content":"jj diff '~glob:**/*.rs'"},"2323":{"id":"/reference/filesets-12","page_id":"/reference/filesets","tags":[],"type":"text","url":"/reference/filesets#file-patterns","content":"The following patterns are supported. In all cases, we do not mention any shell\nquoting that might be necessary, and the quotes around \"path\" are optional if\nthe path has no special characters."},"2324":{"id":"/reference/filesets-13","page_id":"/reference/filesets","tags":[],"type":"text","url":"/reference/filesets#file-patterns","content":"\"path\" or cwd:\"path\": Matches cwd-relative path prefix (file or files\nunder directory recursively.)"},"2325":{"id":"/reference/filesets-14","page_id":"/reference/filesets","tags":[],"type":"text","url":"/reference/filesets#file-patterns","content":"file:\"path\" or cwd-file:\"path\": Matches cwd-relative file (or exact) path."},"2326":{"id":"/reference/filesets-15","page_id":"/reference/filesets","tags":[],"type":"text","url":"/reference/filesets#file-patterns","content":"glob:\"pattern\" or cwd-glob:\"pattern\": Matches file paths with cwd-relative\nUnix-style shell wildcard pattern. For example, glob:\"*.c\" will\nmatch all .c files in the current working directory non-recursively."},"2327":{"id":"/reference/filesets-16","page_id":"/reference/filesets","tags":[],"type":"text","url":"/reference/filesets#file-patterns","content":"glob-i:\"pattern\" or cwd-glob-i:\"pattern\": Like glob: but\ncase-insensitive. For example, glob-i:\"*.TXT\" will match both file.txt\nand FILE.TXT."},"2328":{"id":"/reference/filesets-17","page_id":"/reference/filesets","tags":[],"type":"text","url":"/reference/filesets#file-patterns","content":"root:\"path\": Matches workspace-relative path prefix (file or files under\ndirectory recursively.)"},"2329":{"id":"/reference/filesets-18","page_id":"/reference/filesets","tags":[],"type":"text","url":"/reference/filesets#file-patterns","content":"root-file:\"path\": Matches workspace-relative file (or exact) path."},"2330":{"id":"/reference/filesets-19","page_id":"/reference/filesets","tags":[],"type":"text","url":"/reference/filesets#file-patterns","content":"root-glob:\"pattern\": Matches file paths with workspace-relative Unix-style\nshell wildcard pattern."},"2331":{"id":"/reference/filesets-20","page_id":"/reference/filesets","tags":[],"type":"text","url":"/reference/filesets#file-patterns","content":"root-glob-i:\"pattern\": Like root-glob: but case-insensitive."},"2332":{"id":"/reference/filesets-21","page_id":"/reference/filesets","tags":[],"type":"text","url":"/reference/filesets#operators","content":"The following operators are supported. x and y below can be any fileset\nexpressions."},"2333":{"id":"/reference/filesets-22","page_id":"/reference/filesets","tags":[],"type":"text","url":"/reference/filesets#operators","content":"~x: Matches everything but x."},"2334":{"id":"/reference/filesets-23","page_id":"/reference/filesets","tags":[],"type":"text","url":"/reference/filesets#operators","content":"x & y: Matches both x and y."},"2335":{"id":"/reference/filesets-24","page_id":"/reference/filesets","tags":[],"type":"text","url":"/reference/filesets#operators","content":"x ~ y: Matches x but not y."},"2336":{"id":"/reference/filesets-25","page_id":"/reference/filesets","tags":[],"type":"text","url":"/reference/filesets#operators","content":"x | y: Matches either x or y (or both)."},"2337":{"id":"/reference/filesets-26","page_id":"/reference/filesets","tags":[],"type":"text","url":"/reference/filesets#operators","content":"(listed in order of binding strengths)"},"2338":{"id":"/reference/filesets-27","page_id":"/reference/filesets","tags":[],"type":"text","url":"/reference/filesets#operators","content":"You can use parentheses to control evaluation order, such as (x & y) | z or\nx & (y | z)."},"2339":{"id":"/reference/filesets-28","page_id":"/reference/filesets","tags":[],"type":"text","url":"/reference/filesets#functions","content":"You can also specify patterns by using functions."},"2340":{"id":"/reference/filesets-29","page_id":"/reference/filesets","tags":[],"type":"text","url":"/reference/filesets#functions","content":"all(): Matches everything."},"2341":{"id":"/reference/filesets-30","page_id":"/reference/filesets","tags":[],"type":"text","url":"/reference/filesets#functions","content":"none(): Matches nothing."},"2342":{"id":"/reference/filesets-31","page_id":"/reference/filesets","tags":[],"type":"text","url":"/reference/filesets#examples","content":"Show diff excluding Cargo.lock."},"2343":{"id":"/reference/filesets-32","page_id":"/reference/filesets","tags":[],"type":"text","url":"/reference/filesets#examples","content":"List files in src excluding Rust sources."},"2344":{"id":"/reference/filesets-33","page_id":"/reference/filesets","tags":[],"type":"text","url":"/reference/filesets#examples","content":"Split a revision in two, putting foo into the second commit."},"2345":{"id":"/reference/revsets","page_id":"/reference/revsets","type":"page","content":"Revsets","tags":[],"url":"/reference/revsets"},"2346":{"id":"/reference/revsets-0","page_id":"/reference/revsets","type":"heading","tags":[],"url":"/reference/revsets#hidden-revisions","content":"Hidden revisions"},"2347":{"id":"/reference/revsets-1","page_id":"/reference/revsets","type":"heading","tags":[],"url":"/reference/revsets#symbols","content":"Symbols"},"2348":{"id":"/reference/revsets-2","page_id":"/reference/revsets","type":"heading","tags":[],"url":"/reference/revsets#priority","content":"Priority"},"2349":{"id":"/reference/revsets-3","page_id":"/reference/revsets","type":"heading","tags":[],"url":"/reference/revsets#operators","content":"Operators"},"2350":{"id":"/reference/revsets-4","page_id":"/reference/revsets","type":"heading","tags":[],"url":"/reference/revsets#functions","content":"Functions"},"2351":{"id":"/reference/revsets-5","page_id":"/reference/revsets","type":"heading","tags":[],"url":"/reference/revsets#string-patterns","content":"String patterns"},"2352":{"id":"/reference/revsets-6","page_id":"/reference/revsets","type":"heading","tags":[],"url":"/reference/revsets#date-patterns","content":"Date patterns"},"2353":{"id":"/reference/revsets-7","page_id":"/reference/revsets","type":"heading","tags":[],"url":"/reference/revsets#aliases","content":"Aliases"},"2354":{"id":"/reference/revsets-8","page_id":"/reference/revsets","type":"heading","tags":[],"url":"/reference/revsets#built-in-aliases","content":"Built-in Aliases"},"2355":{"id":"/reference/revsets-9","page_id":"/reference/revsets","type":"heading","tags":[],"url":"/reference/revsets#the-all-modifier","content":"The all: modifier"},"2356":{"id":"/reference/revsets-10","page_id":"/reference/revsets","type":"heading","tags":[],"url":"/reference/revsets#examples","content":"Examples"},"2357":{"id":"/reference/revsets-11","page_id":"/reference/revsets","tags":[],"type":"text","url":"/reference/revsets","content":"Jujutsu supports a functional language for selecting a set of revisions.\nExpressions in this language are called \"revsets\" (the idea comes from\nMercurial). The language\nconsists of symbols, operators, and functions."},"2358":{"id":"/reference/revsets-12","page_id":"/reference/revsets","tags":[],"type":"text","url":"/reference/revsets","content":"Most jj commands accept a revset (or multiple). Many commands, such as\njj edit <revset> expect the revset to resolve to a single commit; it is an\nerror to pass a revset that resolves to more than one commit (or zero commits)\nto such commands."},"2359":{"id":"/reference/revsets-13","page_id":"/reference/revsets","tags":[],"type":"text","url":"/reference/revsets","content":"The words \"revisions\" and \"commits\" are used interchangeably in this document."},"2360":{"id":"/reference/revsets-14","page_id":"/reference/revsets","tags":[],"type":"text","url":"/reference/revsets#hidden-revisions","content":"Most revsets search only the visible commits.\nOther commits are only included if you explicitly mention them (e.g. by commit\nID, <name>@<remote> symbol, or at_operation() function)."},"2361":{"id":"/reference/revsets-15","page_id":"/reference/revsets","tags":[],"type":"text","url":"/reference/revsets#hidden-revisions","content":"If hidden commits are specified, their ancestors also become available to the\nsearch space. They are included in all(), x.., ~x, etc., but not in\n..visible_heads(), etc. For example, hidden_id | all() is equivalent to\nhidden_id | ::(hidden_id | visible_heads())."},"2362":{"id":"/reference/revsets-16","page_id":"/reference/revsets","tags":[],"type":"text","url":"/reference/revsets#symbols","content":"The @ expression refers to the working copy commit in the current workspace.\nUse <workspace name>@ to refer to the working-copy commit in another\nworkspace. Use <name>@<remote> to refer to a remote-tracking bookmark."},"2363":{"id":"/reference/revsets-17","page_id":"/reference/revsets","tags":[],"type":"text","url":"/reference/revsets#symbols","content":"A full commit ID refers to a single commit. A unique prefix of the full commit\nID can also be used. It is an error to use a non-unique prefix."},"2364":{"id":"/reference/revsets-18","page_id":"/reference/revsets","tags":[],"type":"text","url":"/reference/revsets#symbols","content":"A full change ID refers to a visible commit with that change ID. A unique prefix\nof the full change ID can also be used. It is an error to use a non-unique\nprefix or a divergent change ID."},"2365":{"id":"/reference/revsets-19","page_id":"/reference/revsets","tags":[],"type":"text","url":"/reference/revsets#symbols","content":"Use single or double quotes to prevent a symbol from being\ninterpreted as an expression. For example, \"x-\" is the symbol x-, not the\nparents of symbol x. Taking shell quoting into account, you may need to use\nsomething like jj log -r '\"x-\"'."},"2366":{"id":"/reference/revsets-20","page_id":"/reference/revsets","tags":[],"type":"text","url":"/reference/revsets#priority","content":"Jujutsu attempts to resolve a symbol in the following order:"},"2367":{"id":"/reference/revsets-21","page_id":"/reference/revsets","tags":[],"type":"text","url":"/reference/revsets#priority","content":"Tag name"},"2368":{"id":"/reference/revsets-22","page_id":"/reference/revsets","tags":[],"type":"text","url":"/reference/revsets#priority","content":"Bookmark name"},"2369":{"id":"/reference/revsets-23","page_id":"/reference/revsets","tags":[],"type":"text","url":"/reference/revsets#priority","content":"Git ref"},"2370":{"id":"/reference/revsets-24","page_id":"/reference/revsets","tags":[],"type":"text","url":"/reference/revsets#priority","content":"Commit ID or change ID"},"2371":{"id":"/reference/revsets-25","page_id":"/reference/revsets","tags":[],"type":"text","url":"/reference/revsets#priority","content":"To override the priority, use the appropriate revset function. For\nexample, to resolve abc as a commit ID even if there happens to be a bookmark\nby the same name, use commit_id(abc). This is particularly useful in scripts."},"2372":{"id":"/reference/revsets-26","page_id":"/reference/revsets","tags":[],"type":"text","url":"/reference/revsets#operators","content":"The following operators are supported. x and y below can be any revset, not\nonly symbols."},"2373":{"id":"/reference/revsets-27","page_id":"/reference/revsets","tags":[],"type":"text","url":"/reference/revsets#operators","content":"x-: Parents of x, can be empty."},"2374":{"id":"/reference/revsets-28","page_id":"/reference/revsets","tags":[],"type":"text","url":"/reference/revsets#operators","content":"x+: Children of x, can be empty."},"2375":{"id":"/reference/revsets-29","page_id":"/reference/revsets","tags":[],"type":"text","url":"/reference/revsets#operators","content":"x::: Descendants of x, including the commits in x itself. Equivalent to\nx::visible_heads() if no hidden revisions are mentioned."},"2376":{"id":"/reference/revsets-30","page_id":"/reference/revsets","tags":[],"type":"text","url":"/reference/revsets#operators","content":"x..: Revisions that are not ancestors of x. Equivalent to ~::x, and\nx..visible_heads() if no hidden revisions are mentioned."},"2377":{"id":"/reference/revsets-31","page_id":"/reference/revsets","tags":[],"type":"text","url":"/reference/revsets#operators","content":"::x: Ancestors of x, including the commits in x itself. Shorthand for\nroot()::x."},"2378":{"id":"/reference/revsets-32","page_id":"/reference/revsets","tags":[],"type":"text","url":"/reference/revsets#operators","content":"..x: Ancestors of x, including the commits in x itself, but excluding\nthe root commit. Shorthand for root()..x. Equivalent to ::x ~ root()."},"2379":{"id":"/reference/revsets-33","page_id":"/reference/revsets","tags":[],"type":"text","url":"/reference/revsets#operators","content":"x::y: Descendants of x that are also ancestors of y. Equivalent\nto x:: & ::y. This is what git log calls --ancestry-path x..y."},"2380":{"id":"/reference/revsets-34","page_id":"/reference/revsets","tags":[],"type":"text","url":"/reference/revsets#operators","content":"x..y: Ancestors of y that are not also ancestors of x. Equivalent to\n::y ~ ::x. This is what git log calls x..y (i.e. the same as we call it)."},"2381":{"id":"/reference/revsets-35","page_id":"/reference/revsets","tags":[],"type":"text","url":"/reference/revsets#operators","content":"::: All visible commits in the repo. Equivalent to all(), and\nroot()::visible_heads() if no hidden revisions are mentioned."},"2382":{"id":"/reference/revsets-36","page_id":"/reference/revsets","tags":[],"type":"text","url":"/reference/revsets#operators","content":"..: All visible commits in the repo, but excluding the root commit.\nEquivalent to ~root(), and root()..visible_heads() if no hidden revisions\nare mentioned."},"2383":{"id":"/reference/revsets-37","page_id":"/reference/revsets","tags":[],"type":"text","url":"/reference/revsets#operators","content":"~x: Revisions that are not in x."},"2384":{"id":"/reference/revsets-38","page_id":"/reference/revsets","tags":[],"type":"text","url":"/reference/revsets#operators","content":"x & y: Revisions that are in both x and y."},"2385":{"id":"/reference/revsets-39","page_id":"/reference/revsets","tags":[],"type":"text","url":"/reference/revsets#operators","content":"x ~ y: Revisions that are in x but not in y."},"2386":{"id":"/reference/revsets-40","page_id":"/reference/revsets","tags":[],"type":"text","url":"/reference/revsets#operators","content":"x | y: Revisions that are in either x or y (or both)."},"2387":{"id":"/reference/revsets-41","page_id":"/reference/revsets","tags":[],"type":"text","url":"/reference/revsets#operators","content":"(listed in order of binding strengths)"},"2388":{"id":"/reference/revsets-42","page_id":"/reference/revsets","tags":[],"type":"text","url":"/reference/revsets#operators","content":"You can use parentheses to control evaluation order, such as (x & y) | z or\nx & (y | z)."},"2389":{"id":"/reference/revsets-43","page_id":"/reference/revsets","tags":[],"type":"text","url":"/reference/revsets#operators","content":"??? examples"},"2390":{"id":"/reference/revsets-44","page_id":"/reference/revsets","tags":[],"type":"text","url":"/reference/revsets#operators","content":"Given this history:"},"2391":{"id":"/reference/revsets-45","page_id":"/reference/revsets","tags":[],"type":"text","url":"/reference/revsets#operators","content":"Operator x-"},"2392":{"id":"/reference/revsets-46","page_id":"/reference/revsets","tags":[],"type":"text","url":"/reference/revsets#operators","content":"D- ⇒ {C,B}"},"2393":{"id":"/reference/revsets-47","page_id":"/reference/revsets","tags":[],"type":"text","url":"/reference/revsets#operators","content":"B- ⇒ {A}"},"2394":{"id":"/reference/revsets-48","page_id":"/reference/revsets","tags":[],"type":"text","url":"/reference/revsets#operators","content":"A- ⇒ {root()}"},"2395":{"id":"/reference/revsets-49","page_id":"/reference/revsets","tags":[],"type":"text","url":"/reference/revsets#operators","content":"root()- ⇒ {} (empty set)"},"2396":{"id":"/reference/revsets-50","page_id":"/reference/revsets","tags":[],"type":"text","url":"/reference/revsets#operators","content":"none()- ⇒ {} (empty set)"},"2397":{"id":"/reference/revsets-51","page_id":"/reference/revsets","tags":[],"type":"text","url":"/reference/revsets#operators","content":"(D|A)- ⇒ {C,B,root()}"},"2398":{"id":"/reference/revsets-52","page_id":"/reference/revsets","tags":[],"type":"text","url":"/reference/revsets#operators","content":"(C|B)- ⇒ {A}"},"2399":{"id":"/reference/revsets-53","page_id":"/reference/revsets","tags":[],"type":"text","url":"/reference/revsets#operators","content":"Operator x+"},"2400":{"id":"/reference/revsets-54","page_id":"/reference/revsets","tags":[],"type":"text","url":"/reference/revsets#operators","content":"D+ ⇒ {} (empty set)"},"2401":{"id":"/reference/revsets-55","page_id":"/reference/revsets","tags":[],"type":"text","url":"/reference/revsets#operators","content":"B+ ⇒ {D}"},"2402":{"id":"/reference/revsets-56","page_id":"/reference/revsets","tags":[],"type":"text","url":"/reference/revsets#operators","content":"A+ ⇒ {B,C}"},"2403":{"id":"/reference/revsets-57","page_id":"/reference/revsets","tags":[],"type":"text","url":"/reference/revsets#operators","content":"root()+ ⇒ {A}"},"2404":{"id":"/reference/revsets-58","page_id":"/reference/revsets","tags":[],"type":"text","url":"/reference/revsets#operators","content":"none()+ ⇒ {} (empty set)"},"2405":{"id":"/reference/revsets-59","page_id":"/reference/revsets","tags":[],"type":"text","url":"/reference/revsets#operators","content":"(C|B)+ ⇒ {D}"},"2406":{"id":"/reference/revsets-60","page_id":"/reference/revsets","tags":[],"type":"text","url":"/reference/revsets#operators","content":"(B|root())+ ⇒ {D,A}"},"2407":{"id":"/reference/revsets-61","page_id":"/reference/revsets","tags":[],"type":"text","url":"/reference/revsets#operators","content":"Operator x::"},"2408":{"id":"/reference/revsets-62","page_id":"/reference/revsets","tags":[],"type":"text","url":"/reference/revsets#operators","content":"D:: ⇒ {D}"},"2409":{"id":"/reference/revsets-63","page_id":"/reference/revsets","tags":[],"type":"text","url":"/reference/revsets#operators","content":"B:: ⇒ {D,B}"},"2410":{"id":"/reference/revsets-64","page_id":"/reference/revsets","tags":[],"type":"text","url":"/reference/revsets#operators","content":"A:: ⇒ {D,C,B,A}"},"2411":{"id":"/reference/revsets-65","page_id":"/reference/revsets","tags":[],"type":"text","url":"/reference/revsets#operators","content":"root():: ⇒ {D,C,B,A,root()}"},"2412":{"id":"/reference/revsets-66","page_id":"/reference/revsets","tags":[],"type":"text","url":"/reference/revsets#operators","content":"none():: ⇒ {} (empty set)"},"2413":{"id":"/reference/revsets-67","page_id":"/reference/revsets","tags":[],"type":"text","url":"/reference/revsets#operators","content":"(C|B):: ⇒ {D,C,B}"},"2414":{"id":"/reference/revsets-68","page_id":"/reference/revsets","tags":[],"type":"text","url":"/reference/revsets#operators","content":"Operator x.."},"2415":{"id":"/reference/revsets-69","page_id":"/reference/revsets","tags":[],"type":"text","url":"/reference/revsets#operators","content":"D.. ⇒ {} (empty set)"},"2416":{"id":"/reference/revsets-70","page_id":"/reference/revsets","tags":[],"type":"text","url":"/reference/revsets#operators","content":"B.. ⇒ {D,C} (note that, unlike B::, this includes C)"},"2417":{"id":"/reference/revsets-71","page_id":"/reference/revsets","tags":[],"type":"text","url":"/reference/revsets#operators","content":"A.. ⇒ {D,C,B}"},"2418":{"id":"/reference/revsets-72","page_id":"/reference/revsets","tags":[],"type":"text","url":"/reference/revsets#operators","content":"root().. ⇒ {D,C,B,A}"},"2419":{"id":"/reference/revsets-73","page_id":"/reference/revsets","tags":[],"type":"text","url":"/reference/revsets#operators","content":"none().. ⇒ {D,C,B,A,root()}"},"2420":{"id":"/reference/revsets-74","page_id":"/reference/revsets","tags":[],"type":"text","url":"/reference/revsets#operators","content":"(C|B).. ⇒ {D}"},"2421":{"id":"/reference/revsets-75","page_id":"/reference/revsets","tags":[],"type":"text","url":"/reference/revsets#operators","content":"Operator ::x"},"2422":{"id":"/reference/revsets-76","page_id":"/reference/revsets","tags":[],"type":"text","url":"/reference/revsets#operators","content":"::D ⇒ {D,C,B,A,root()}"},"2423":{"id":"/reference/revsets-77","page_id":"/reference/revsets","tags":[],"type":"text","url":"/reference/revsets#operators","content":"::B ⇒ {B,A,root()}"},"2424":{"id":"/reference/revsets-78","page_id":"/reference/revsets","tags":[],"type":"text","url":"/reference/revsets#operators","content":"::A ⇒ {A,root()}"},"2425":{"id":"/reference/revsets-79","page_id":"/reference/revsets","tags":[],"type":"text","url":"/reference/revsets#operators","content":"::root() ⇒ {root()}"},"2426":{"id":"/reference/revsets-80","page_id":"/reference/revsets","tags":[],"type":"text","url":"/reference/revsets#operators","content":"::none() ⇒ {} (empty set)"},"2427":{"id":"/reference/revsets-81","page_id":"/reference/revsets","tags":[],"type":"text","url":"/reference/revsets#operators","content":"::(C|B) ⇒ {C,B,A,root()}"},"2428":{"id":"/reference/revsets-82","page_id":"/reference/revsets","tags":[],"type":"text","url":"/reference/revsets#operators","content":"Operator ..x"},"2429":{"id":"/reference/revsets-83","page_id":"/reference/revsets","tags":[],"type":"text","url":"/reference/revsets#operators","content":"..D ⇒ {D,C,B,A}"},"2430":{"id":"/reference/revsets-84","page_id":"/reference/revsets","tags":[],"type":"text","url":"/reference/revsets#operators","content":"..B ⇒ {B,A}"},"2431":{"id":"/reference/revsets-85","page_id":"/reference/revsets","tags":[],"type":"text","url":"/reference/revsets#operators","content":"..A ⇒ {A}"},"2432":{"id":"/reference/revsets-86","page_id":"/reference/revsets","tags":[],"type":"text","url":"/reference/revsets#operators","content":"..root() ⇒ {} (empty set)"},"2433":{"id":"/reference/revsets-87","page_id":"/reference/revsets","tags":[],"type":"text","url":"/reference/revsets#operators","content":"..none() ⇒ {} (empty set)"},"2434":{"id":"/reference/revsets-88","page_id":"/reference/revsets","tags":[],"type":"text","url":"/reference/revsets#operators","content":"..(C|B) ⇒ {C,B,A}"},"2435":{"id":"/reference/revsets-89","page_id":"/reference/revsets","tags":[],"type":"text","url":"/reference/revsets#operators","content":"Operator x::y"},"2436":{"id":"/reference/revsets-90","page_id":"/reference/revsets","tags":[],"type":"text","url":"/reference/revsets#operators","content":"D::D ⇒ {D}"},"2437":{"id":"/reference/revsets-91","page_id":"/reference/revsets","tags":[],"type":"text","url":"/reference/revsets#operators","content":"B::D ⇒ {D,B} (note that, unlike B..D, this includes B and excludes C)"},"2438":{"id":"/reference/revsets-92","page_id":"/reference/revsets","tags":[],"type":"text","url":"/reference/revsets#operators","content":"B::C ⇒ {} (empty set) (note that, unlike B..C, this excludes C)"},"2439":{"id":"/reference/revsets-93","page_id":"/reference/revsets","tags":[],"type":"text","url":"/reference/revsets#operators","content":"A::D ⇒ {D,C,B,A}"},"2440":{"id":"/reference/revsets-94","page_id":"/reference/revsets","tags":[],"type":"text","url":"/reference/revsets#operators","content":"root()::D ⇒ {D,C,B,A,root()}"},"2441":{"id":"/reference/revsets-95","page_id":"/reference/revsets","tags":[],"type":"text","url":"/reference/revsets#operators","content":"none()::D ⇒ {} (empty set)"},"2442":{"id":"/reference/revsets-96","page_id":"/reference/revsets","tags":[],"type":"text","url":"/reference/revsets#operators","content":"D::B ⇒ {} (empty set)"},"2443":{"id":"/reference/revsets-97","page_id":"/reference/revsets","tags":[],"type":"text","url":"/reference/revsets#operators","content":"(C|B)::(C|B) ⇒ {C,B}"},"2444":{"id":"/reference/revsets-98","page_id":"/reference/revsets","tags":[],"type":"text","url":"/reference/revsets#operators","content":"Operator x..y"},"2445":{"id":"/reference/revsets-99","page_id":"/reference/revsets","tags":[],"type":"text","url":"/reference/revsets#operators","content":"D..D ⇒ {} (empty set)"},"2446":{"id":"/reference/revsets-100","page_id":"/reference/revsets","tags":[],"type":"text","url":"/reference/revsets#operators","content":"B..D ⇒ {D,C} (note that, unlike B::D, this includes C and excludes B)"},"2447":{"id":"/reference/revsets-101","page_id":"/reference/revsets","tags":[],"type":"text","url":"/reference/revsets#operators","content":"B..C ⇒ {C} (note that, unlike B::C, this includes C)"},"2448":{"id":"/reference/revsets-102","page_id":"/reference/revsets","tags":[],"type":"text","url":"/reference/revsets#operators","content":"A..D ⇒ {D,C,B}"},"2449":{"id":"/reference/revsets-103","page_id":"/reference/revsets","tags":[],"type":"text","url":"/reference/revsets#operators","content":"root()..D ⇒ {D,C,B,A}"},"2450":{"id":"/reference/revsets-104","page_id":"/reference/revsets","tags":[],"type":"text","url":"/reference/revsets#operators","content":"none()..D ⇒ {D,C,B,A,root()}"},"2451":{"id":"/reference/revsets-105","page_id":"/reference/revsets","tags":[],"type":"text","url":"/reference/revsets#operators","content":"D..B ⇒ {} (empty set)"},"2452":{"id":"/reference/revsets-106","page_id":"/reference/revsets","tags":[],"type":"text","url":"/reference/revsets#operators","content":"(C|B)..(C|B) ⇒ {} (empty set)"},"2453":{"id":"/reference/revsets-107","page_id":"/reference/revsets","tags":[],"type":"text","url":"/reference/revsets#functions","content":"You can also specify revisions by using functions. Some functions take other\nrevsets (expressions) as arguments."},"2454":{"id":"/reference/revsets-108","page_id":"/reference/revsets","tags":[],"type":"text","url":"/reference/revsets#functions","content":"??? note \"Function argument syntax\""},"2455":{"id":"/reference/revsets-109","page_id":"/reference/revsets","tags":[],"type":"text","url":"/reference/revsets#functions","content":"In this documentation, optional arguments are indicated with square\nbrackets like [arg]. Some arguments also have an optional label which can\nbe used to specify that argument without specifying all previous arguments."},"2456":{"id":"/reference/revsets-110","page_id":"/reference/revsets","tags":[],"type":"text","url":"/reference/revsets#functions","content":"For instance, remote_bookmarks([bookmark_pattern], [[remote=]remote_pattern])\nindicates that all of the following usages are valid:"},"2457":{"id":"/reference/revsets-111","page_id":"/reference/revsets","tags":[],"type":"text","url":"/reference/revsets#functions","content":"remote_bookmarks()"},"2458":{"id":"/reference/revsets-112","page_id":"/reference/revsets","tags":[],"type":"text","url":"/reference/revsets#functions","content":"remote_bookmarks(\"main\")"},"2459":{"id":"/reference/revsets-113","page_id":"/reference/revsets","tags":[],"type":"text","url":"/reference/revsets#functions","content":"remote_bookmarks(\"main\", \"origin\")"},"2460":{"id":"/reference/revsets-114","page_id":"/reference/revsets","tags":[],"type":"text","url":"/reference/revsets#functions","content":"remote_bookmarks(\"main\", remote=\"origin\")"},"2461":{"id":"/reference/revsets-115","page_id":"/reference/revsets","tags":[],"type":"text","url":"/reference/revsets#functions","content":"remote_bookmarks(remote=\"origin\")"},"2462":{"id":"/reference/revsets-116","page_id":"/reference/revsets","tags":[],"type":"text","url":"/reference/revsets#functions","content":"parents(x, [depth]): parents(x) is the same as x-.\nparents(x, depth) returns the parents of x at the given depth. For\ninstance, parents(x, 3) is equivalent to x---."},"2463":{"id":"/reference/revsets-117","page_id":"/reference/revsets","tags":[],"type":"text","url":"/reference/revsets#functions","content":"children(x, [depth]): children(x) is the same as x+.\nchildren(x, depth) returns the children of x at the given depth. For\ninstance, children(x, 3) is equivalent to x+++."},"2464":{"id":"/reference/revsets-118","page_id":"/reference/revsets","tags":[],"type":"text","url":"/reference/revsets#functions","content":"ancestors(x, [depth]): ancestors(x) is the same as ::x.\nancestors(x, depth) returns the ancestors of x limited to the given\ndepth."},"2465":{"id":"/reference/revsets-119","page_id":"/reference/revsets","tags":[],"type":"text","url":"/reference/revsets#functions","content":"descendants(x, [depth]): descendants(x) is the same as x::.\ndescendants(x, depth) returns the descendants of x limited to the given\ndepth."},"2466":{"id":"/reference/revsets-120","page_id":"/reference/revsets","tags":[],"type":"text","url":"/reference/revsets#functions","content":"first_parent(x, [depth]): first_parent(x) is similar to parents(x), but\nfor merges, it only returns the first parent instead of returning all parents.\nThe depth argument also works similarly, so first_parent(x, 2) is\nequivalent to first_parent(first_parent(x))."},"2467":{"id":"/reference/revsets-121","page_id":"/reference/revsets","tags":[],"type":"text","url":"/reference/revsets#functions","content":"first_ancestors(x, [depth]): Similar to ancestors(x, [depth]), but only\ntraverses the first parent of each commit. In Git, the first parent of a merge\ncommit is conventionally the branch into which changes are being merged, so\nfirst_ancestors() can be used to exclude changes made on other branches."},"2468":{"id":"/reference/revsets-122","page_id":"/reference/revsets","tags":[],"type":"text","url":"/reference/revsets#functions","content":"reachable(srcs, domain): All commits reachable from srcs within\ndomain, traversing all parent and child edges."},"2469":{"id":"/reference/revsets-123","page_id":"/reference/revsets","tags":[],"type":"text","url":"/reference/revsets#functions","content":"connected(x): Same as x::x. Useful when x includes several commits."},"2470":{"id":"/reference/revsets-124","page_id":"/reference/revsets","tags":[],"type":"text","url":"/reference/revsets#functions","content":"all(): All visible commits and ancestors of commits explicitly mentioned."},"2471":{"id":"/reference/revsets-125","page_id":"/reference/revsets","tags":[],"type":"text","url":"/reference/revsets#functions","content":"none(): No commits. This function is rarely useful; it is provided for\ncompleteness."},"2472":{"id":"/reference/revsets-126","page_id":"/reference/revsets","tags":[],"type":"text","url":"/reference/revsets#functions","content":"change_id(prefix): Commits with the given change ID prefix. If the specified\nchange is divergent, this resolves to multiple commits. It is an error to use a\nnon-unique prefix. Unmatched prefix isn't an error."},"2473":{"id":"/reference/revsets-127","page_id":"/reference/revsets","tags":[],"type":"text","url":"/reference/revsets#functions","content":"commit_id(prefix): Commits with the given commit ID prefix. It is an error\nto use a non-unique prefix. Unmatched prefix isn't an error."},"2474":{"id":"/reference/revsets-128","page_id":"/reference/revsets","tags":[],"type":"text","url":"/reference/revsets#functions","content":"bookmarks([pattern]): All local bookmark targets. If pattern is specified,\nthis selects the bookmarks whose name match the given string\npattern. For example, bookmarks(push) would match the\nbookmarks push-123 and repushed but not the bookmark main. If a bookmark is\nin a conflicted state, all its possible targets are included."},"2475":{"id":"/reference/revsets-129","page_id":"/reference/revsets","tags":[],"type":"text","url":"/reference/revsets#functions","content":"remote_bookmarks([bookmark_pattern], [[remote=]remote_pattern]): All remote\nbookmarks targets across all remotes. If just the bookmark_pattern is\nspecified, the bookmarks whose names match the given string\npattern across all remotes are selected. If both\nbookmark_pattern and remote_pattern are specified, the selection is\nfurther restricted to just the remotes whose names match remote_pattern."},"2476":{"id":"/reference/revsets-130","page_id":"/reference/revsets","tags":[],"type":"text","url":"/reference/revsets#functions","content":"For example, remote_bookmarks(push, ri) would match the bookmarks\npush-123@origin and repushed@private but not push-123@upstream or\nmain@origin or main@upstream. If a bookmark is in a conflicted state, all\nits possible targets are included."},"2477":{"id":"/reference/revsets-131","page_id":"/reference/revsets","tags":[],"type":"text","url":"/reference/revsets#functions","content":"While Git-tracking bookmarks can be selected by <name>@git, these bookmarks\naren't included in remote_bookmarks()."},"2478":{"id":"/reference/revsets-132","page_id":"/reference/revsets","tags":[],"type":"text","url":"/reference/revsets#functions","content":"tracked_remote_bookmarks([bookmark_pattern], [[remote=]remote_pattern]): All\ntargets of tracked remote bookmarks. Supports the same optional arguments as\nremote_bookmarks()."},"2479":{"id":"/reference/revsets-133","page_id":"/reference/revsets","tags":[],"type":"text","url":"/reference/revsets#functions","content":"untracked_remote_bookmarks([bookmark_pattern], [[remote=]remote_pattern]):\nAll targets of untracked remote bookmarks. Supports the same optional arguments\nas remote_bookmarks()."},"2480":{"id":"/reference/revsets-134","page_id":"/reference/revsets","tags":[],"type":"text","url":"/reference/revsets#functions","content":"tags([pattern]): All tag targets. If pattern is specified,\nthis selects the tags whose name match the given string\npattern. For example, tags(v1) would match the\ntags v123 and rev1 but not the tag v2. If a tag is\nin a conflicted state, all its possible targets are included."},"2481":{"id":"/reference/revsets-135","page_id":"/reference/revsets","tags":[],"type":"text","url":"/reference/revsets#functions","content":"git_refs(): All Git ref targets as of the last import. If a Git ref\nis in a conflicted state, all its possible targets are included."},"2482":{"id":"/reference/revsets-136","page_id":"/reference/revsets","tags":[],"type":"text","url":"/reference/revsets#functions","content":"git_head(): The Git HEAD target as of the last import."},"2483":{"id":"/reference/revsets-137","page_id":"/reference/revsets","tags":[],"type":"text","url":"/reference/revsets#functions","content":"visible_heads(): All visible heads (same as heads(all()) if no hidden\nrevisions are mentioned)."},"2484":{"id":"/reference/revsets-138","page_id":"/reference/revsets","tags":[],"type":"text","url":"/reference/revsets#functions","content":"root(): The virtual commit that is the oldest ancestor of all other commits."},"2485":{"id":"/reference/revsets-139","page_id":"/reference/revsets","tags":[],"type":"text","url":"/reference/revsets#functions","content":"heads(x): Commits in x that are not ancestors of other commits in x.\nEquivalent to x ~ ::x-. Note that this is different from\nMercurial's heads(x)\nfunction, which is equivalent to x ~ x-."},"2486":{"id":"/reference/revsets-140","page_id":"/reference/revsets","tags":[],"type":"text","url":"/reference/revsets#functions","content":"roots(x): Commits in x that are not descendants of other commits in x.\nEquivalent to x ~ x+::. Note that this is different from\nMercurial's roots(x)\nfunction, which is equivalent to x ~ x+."},"2487":{"id":"/reference/revsets-141","page_id":"/reference/revsets","tags":[],"type":"text","url":"/reference/revsets#functions","content":"latest(x, [count]): Latest count commits in x, based on committer\ntimestamp. The default count is 1."},"2488":{"id":"/reference/revsets-142","page_id":"/reference/revsets","tags":[],"type":"text","url":"/reference/revsets#functions","content":"fork_point(x): The fork point of all commits in x. The fork point is the\ncommon ancestor(s) of all commits in x which do not have any descendants\nthat are also common ancestors of all commits in x. It is equivalent to\nthe revset heads(::x_1 & ::x_2 & ... & ::x_N), where x_{1..N} are commits\nin x. If x resolves to a single commit, fork_point(x) resolves to x."},"2489":{"id":"/reference/revsets-143","page_id":"/reference/revsets","tags":[],"type":"text","url":"/reference/revsets#functions","content":"bisect(x): Finds commits in the input set for which about half of the input\nset are descendants. The current implementation deals somewhat poorly with\nnon-linear history."},"2490":{"id":"/reference/revsets-144","page_id":"/reference/revsets","tags":[],"type":"text","url":"/reference/revsets#functions","content":"merges(): Merge commits."},"2491":{"id":"/reference/revsets-145","page_id":"/reference/revsets","tags":[],"type":"text","url":"/reference/revsets#functions","content":"description(pattern): Commits that have a description matching the given\nstring pattern."},"2492":{"id":"/reference/revsets-146","page_id":"/reference/revsets","tags":[],"type":"text","url":"/reference/revsets#functions","content":"A non-empty description is usually terminated with newline character. For\nexample, description(exact:\"\") matches commits without description, and\ndescription(exact:\"foo\\n\") matches commits with description \"foo\\n\"."},"2493":{"id":"/reference/revsets-147","page_id":"/reference/revsets","tags":[],"type":"text","url":"/reference/revsets#functions","content":"subject(pattern): Commits that have a subject matching the given string\npattern. A subject is the first line of the description\n(without newline character.)"},"2494":{"id":"/reference/revsets-148","page_id":"/reference/revsets","tags":[],"type":"text","url":"/reference/revsets#functions","content":"author(pattern): Commits with the author's name or email matching the given\nstring pattern. Equivalent to author_name(pattern) |\nauthor_email(pattern)."},"2495":{"id":"/reference/revsets-149","page_id":"/reference/revsets","tags":[],"type":"text","url":"/reference/revsets#functions","content":"author_name(pattern): Commits with the author's name matching the given\nstring pattern."},"2496":{"id":"/reference/revsets-150","page_id":"/reference/revsets","tags":[],"type":"text","url":"/reference/revsets#functions","content":"author_email(pattern): Commits with the author's email matching the given\nstring pattern."},"2497":{"id":"/reference/revsets-151","page_id":"/reference/revsets","tags":[],"type":"text","url":"/reference/revsets#functions","content":"author_date(pattern): Commits with author dates matching the specified date\npattern."},"2498":{"id":"/reference/revsets-152","page_id":"/reference/revsets","tags":[],"type":"text","url":"/reference/revsets#functions","content":"mine(): Commits where the author's email matches the email of the current\nuser. Equivalent to author_email(exact-i:<user-email>)"},"2499":{"id":"/reference/revsets-153","page_id":"/reference/revsets","tags":[],"type":"text","url":"/reference/revsets#functions","content":"committer(pattern): Commits with the committer's name or email matching the\ngiven string pattern. Equivalent to\ncommitter_name(pattern) | committer_email(pattern)."},"2500":{"id":"/reference/revsets-154","page_id":"/reference/revsets","tags":[],"type":"text","url":"/reference/revsets#functions","content":"committer_name(pattern): Commits with the committer's name matching the\ngiven string pattern."},"2501":{"id":"/reference/revsets-155","page_id":"/reference/revsets","tags":[],"type":"text","url":"/reference/revsets#functions","content":"committer_email(pattern): Commits with the committer's email matching the\ngiven string pattern."},"2502":{"id":"/reference/revsets-156","page_id":"/reference/revsets","tags":[],"type":"text","url":"/reference/revsets#functions","content":"committer_date(pattern): Commits with committer dates matching the specified\ndate pattern."},"2503":{"id":"/reference/revsets-157","page_id":"/reference/revsets","tags":[],"type":"text","url":"/reference/revsets#functions","content":"signed(): Commits that are cryptographically signed."},"2504":{"id":"/reference/revsets-158","page_id":"/reference/revsets","tags":[],"type":"text","url":"/reference/revsets#functions","content":"empty(): Commits modifying no files. This also includes merges() without\nuser modifications and root()."},"2505":{"id":"/reference/revsets-159","page_id":"/reference/revsets","tags":[],"type":"text","url":"/reference/revsets#functions","content":"files(expression): Commits modifying paths matching the given fileset\nexpression."},"2506":{"id":"/reference/revsets-160","page_id":"/reference/revsets","tags":[],"type":"text","url":"/reference/revsets#functions","content":"Paths are relative to the directory jj was invoked from. A directory name\nwill match all files in that directory and its subdirectories."},"2507":{"id":"/reference/revsets-161","page_id":"/reference/revsets","tags":[],"type":"text","url":"/reference/revsets#functions","content":"For example, files(foo) will match files foo, foo/bar, foo/bar/baz.\nIt will not match foobar or bar/foo."},"2508":{"id":"/reference/revsets-162","page_id":"/reference/revsets","tags":[],"type":"text","url":"/reference/revsets#functions","content":"Some file patterns might need quoting because the expression must also be\nparsable as a revset. For example, . has to be quoted in files(\".\")."},"2509":{"id":"/reference/revsets-163","page_id":"/reference/revsets","tags":[],"type":"text","url":"/reference/revsets#functions","content":"diff_contains(text, [files]): Commits containing diffs matching the given\ntext pattern line by line."},"2510":{"id":"/reference/revsets-164","page_id":"/reference/revsets","tags":[],"type":"text","url":"/reference/revsets#functions","content":"The search paths can be narrowed by the files expression. All modified files\nare scanned by default, but it is likely to change in future version to\nrespect the command line path arguments."},"2511":{"id":"/reference/revsets-165","page_id":"/reference/revsets","tags":[],"type":"text","url":"/reference/revsets#functions","content":"For example, diff_contains(\"TODO\", \"src\") will search revisions where \"TODO\"\nis added to or removed from files under \"src\"."},"2512":{"id":"/reference/revsets-166","page_id":"/reference/revsets","tags":[],"type":"text","url":"/reference/revsets#functions","content":"conflicts(): Commits with conflicts."},"2513":{"id":"/reference/revsets-167","page_id":"/reference/revsets","tags":[],"type":"text","url":"/reference/revsets#functions","content":"present(x): Same as x, but evaluated to none() if any of the commits\nin x doesn't exist (e.g. is an unknown bookmark name.)"},"2514":{"id":"/reference/revsets-168","page_id":"/reference/revsets","tags":[],"type":"text","url":"/reference/revsets#functions","content":"coalesce(revsets...): Commits in the first revset in the list of revsets\nwhich does not evaluate to none(). If all revsets evaluate to none(), then\nthe result of coalesce will also be none()."},"2515":{"id":"/reference/revsets-169","page_id":"/reference/revsets","tags":[],"type":"text","url":"/reference/revsets#functions","content":"working_copies(): The working copy commits across all the workspaces."},"2516":{"id":"/reference/revsets-170","page_id":"/reference/revsets","tags":[],"type":"text","url":"/reference/revsets#functions","content":"at_operation(op, x): Evaluates x at the specified operation. For\nexample, at_operation(@-, visible_heads()) will return all heads which were\nvisible at the previous operation."},"2517":{"id":"/reference/revsets-171","page_id":"/reference/revsets","tags":[],"type":"text","url":"/reference/revsets#functions","content":"Since at_operation(op, x) brings all commits that were visible at the\noperation to the search space, at_operation(op, x) | all() is equivalent to\nat_operation(op, x) | ::(at_operation(op, x | visible_heads()) |\nvisible_heads())."},"2518":{"id":"/reference/revsets-172","page_id":"/reference/revsets","tags":[],"type":"text","url":"/reference/revsets#functions","content":"??? examples"},"2519":{"id":"/reference/revsets-173","page_id":"/reference/revsets","tags":[],"type":"text","url":"/reference/revsets#functions","content":"Given this history:"},"2520":{"id":"/reference/revsets-174","page_id":"/reference/revsets","tags":[],"type":"text","url":"/reference/revsets#functions","content":"function reachable()"},"2521":{"id":"/reference/revsets-175","page_id":"/reference/revsets","tags":[],"type":"text","url":"/reference/revsets#functions","content":"reachable(E, A..) ⇒ {E,D,C,B}"},"2522":{"id":"/reference/revsets-176","page_id":"/reference/revsets","tags":[],"type":"text","url":"/reference/revsets#functions","content":"reachable(D, A..) ⇒ {E,D,C,B}"},"2523":{"id":"/reference/revsets-177","page_id":"/reference/revsets","tags":[],"type":"text","url":"/reference/revsets#functions","content":"reachable(C, A..) ⇒ {E,D,C,B}"},"2524":{"id":"/reference/revsets-178","page_id":"/reference/revsets","tags":[],"type":"text","url":"/reference/revsets#functions","content":"reachable(B, A..) ⇒ {E,D,C,B}"},"2525":{"id":"/reference/revsets-179","page_id":"/reference/revsets","tags":[],"type":"text","url":"/reference/revsets#functions","content":"reachable(A, A..) ⇒ {} (empty set)"},"2526":{"id":"/reference/revsets-180","page_id":"/reference/revsets","tags":[],"type":"text","url":"/reference/revsets#functions","content":"function connected()"},"2527":{"id":"/reference/revsets-181","page_id":"/reference/revsets","tags":[],"type":"text","url":"/reference/revsets#functions","content":"connected(E|A) ⇒ {E,B,A}"},"2528":{"id":"/reference/revsets-182","page_id":"/reference/revsets","tags":[],"type":"text","url":"/reference/revsets#functions","content":"connected(D|A) ⇒ {D,C,B,A}"},"2529":{"id":"/reference/revsets-183","page_id":"/reference/revsets","tags":[],"type":"text","url":"/reference/revsets#functions","content":"connected(A) ⇒ {A}"},"2530":{"id":"/reference/revsets-184","page_id":"/reference/revsets","tags":[],"type":"text","url":"/reference/revsets#functions","content":"function heads()"},"2531":{"id":"/reference/revsets-185","page_id":"/reference/revsets","tags":[],"type":"text","url":"/reference/revsets#functions","content":"heads(E|D) ⇒ {E,D}"},"2532":{"id":"/reference/revsets-186","page_id":"/reference/revsets","tags":[],"type":"text","url":"/reference/revsets#functions","content":"heads(E|C) ⇒ {E,C}"},"2533":{"id":"/reference/revsets-187","page_id":"/reference/revsets","tags":[],"type":"text","url":"/reference/revsets#functions","content":"heads(E|B) ⇒ {E}"},"2534":{"id":"/reference/revsets-188","page_id":"/reference/revsets","tags":[],"type":"text","url":"/reference/revsets#functions","content":"heads(E|A) ⇒ {E}"},"2535":{"id":"/reference/revsets-189","page_id":"/reference/revsets","tags":[],"type":"text","url":"/reference/revsets#functions","content":"heads(A) ⇒ {A}"},"2536":{"id":"/reference/revsets-190","page_id":"/reference/revsets","tags":[],"type":"text","url":"/reference/revsets#functions","content":"function roots()"},"2537":{"id":"/reference/revsets-191","page_id":"/reference/revsets","tags":[],"type":"text","url":"/reference/revsets#functions","content":"roots(E|D) ⇒ {E,D}"},"2538":{"id":"/reference/revsets-192","page_id":"/reference/revsets","tags":[],"type":"text","url":"/reference/revsets#functions","content":"roots(E|C) ⇒ {E,C}"},"2539":{"id":"/reference/revsets-193","page_id":"/reference/revsets","tags":[],"type":"text","url":"/reference/revsets#functions","content":"roots(E|B) ⇒ {B}"},"2540":{"id":"/reference/revsets-194","page_id":"/reference/revsets","tags":[],"type":"text","url":"/reference/revsets#functions","content":"roots(E|A) ⇒ {A}"},"2541":{"id":"/reference/revsets-195","page_id":"/reference/revsets","tags":[],"type":"text","url":"/reference/revsets#functions","content":"roots(A) ⇒ {A}"},"2542":{"id":"/reference/revsets-196","page_id":"/reference/revsets","tags":[],"type":"text","url":"/reference/revsets#functions","content":"function fork_point()"},"2543":{"id":"/reference/revsets-197","page_id":"/reference/revsets","tags":[],"type":"text","url":"/reference/revsets#functions","content":"fork_point(E|D) ⇒ {B}"},"2544":{"id":"/reference/revsets-198","page_id":"/reference/revsets","tags":[],"type":"text","url":"/reference/revsets#functions","content":"fork_point(E|C) ⇒ {A}"},"2545":{"id":"/reference/revsets-199","page_id":"/reference/revsets","tags":[],"type":"text","url":"/reference/revsets#functions","content":"fork_point(E|B) ⇒ {B}"},"2546":{"id":"/reference/revsets-200","page_id":"/reference/revsets","tags":[],"type":"text","url":"/reference/revsets#functions","content":"fork_point(E|A) ⇒ {A}"},"2547":{"id":"/reference/revsets-201","page_id":"/reference/revsets","tags":[],"type":"text","url":"/reference/revsets#functions","content":"fork_point(D|C) ⇒ {C}"},"2548":{"id":"/reference/revsets-202","page_id":"/reference/revsets","tags":[],"type":"text","url":"/reference/revsets#functions","content":"fork_point(D|B) ⇒ {B}"},"2549":{"id":"/reference/revsets-203","page_id":"/reference/revsets","tags":[],"type":"text","url":"/reference/revsets#functions","content":"fork_point(B|C) ⇒ {A}"},"2550":{"id":"/reference/revsets-204","page_id":"/reference/revsets","tags":[],"type":"text","url":"/reference/revsets#functions","content":"fork_point(A) ⇒ {A}"},"2551":{"id":"/reference/revsets-205","page_id":"/reference/revsets","tags":[],"type":"text","url":"/reference/revsets#functions","content":"fork_point(none()) ⇒ {}"},"2552":{"id":"/reference/revsets-206","page_id":"/reference/revsets","tags":[],"type":"text","url":"/reference/revsets#string-patterns","content":"Functions that perform string matching support the following pattern syntax (the\nquotes are optional):"},"2553":{"id":"/reference/revsets-207","page_id":"/reference/revsets","tags":[],"type":"text","url":"/reference/revsets#string-patterns","content":"\"string\" or substring:\"string\": Matches strings that contain string."},"2554":{"id":"/reference/revsets-208","page_id":"/reference/revsets","tags":[],"type":"text","url":"/reference/revsets#string-patterns","content":"exact:\"string\": Matches strings exactly equal to string."},"2555":{"id":"/reference/revsets-209","page_id":"/reference/revsets","tags":[],"type":"text","url":"/reference/revsets#string-patterns","content":"glob:\"pattern\": Matches strings with Unix-style shell wildcard\npattern."},"2556":{"id":"/reference/revsets-210","page_id":"/reference/revsets","tags":[],"type":"text","url":"/reference/revsets#string-patterns","content":"regex:\"pattern\": Matches substrings with regular\nexpression pattern."},"2557":{"id":"/reference/revsets-211","page_id":"/reference/revsets","tags":[],"type":"text","url":"/reference/revsets#string-patterns","content":"You can append -i after the kind to match case‐insensitively (e.g.\nglob-i:\"fix*jpeg*\")."},"2558":{"id":"/reference/revsets-212","page_id":"/reference/revsets","tags":[],"type":"text","url":"/reference/revsets#date-patterns","content":"Functions that perform date matching support the following pattern syntax:"},"2559":{"id":"/reference/revsets-213","page_id":"/reference/revsets","tags":[],"type":"text","url":"/reference/revsets#date-patterns","content":"after:\"string\": Matches dates exactly at or after the given date."},"2560":{"id":"/reference/revsets-214","page_id":"/reference/revsets","tags":[],"type":"text","url":"/reference/revsets#date-patterns","content":"before:\"string\": Matches dates before, but not including, the given date."},"2561":{"id":"/reference/revsets-215","page_id":"/reference/revsets","tags":[],"type":"text","url":"/reference/revsets#date-patterns","content":"Date strings can be specified in several forms, including:"},"2562":{"id":"/reference/revsets-216","page_id":"/reference/revsets","tags":[],"type":"text","url":"/reference/revsets#date-patterns","content":"2024-02-01"},"2563":{"id":"/reference/revsets-217","page_id":"/reference/revsets","tags":[],"type":"text","url":"/reference/revsets#date-patterns","content":"2024-02-01T12:00:00"},"2564":{"id":"/reference/revsets-218","page_id":"/reference/revsets","tags":[],"type":"text","url":"/reference/revsets#date-patterns","content":"2024-02-01T12:00:00-08:00"},"2565":{"id":"/reference/revsets-219","page_id":"/reference/revsets","tags":[],"type":"text","url":"/reference/revsets#date-patterns","content":"2024-02-01 12:00:00"},"2566":{"id":"/reference/revsets-220","page_id":"/reference/revsets","tags":[],"type":"text","url":"/reference/revsets#date-patterns","content":"2 days ago"},"2567":{"id":"/reference/revsets-221","page_id":"/reference/revsets","tags":[],"type":"text","url":"/reference/revsets#date-patterns","content":"5 minutes ago"},"2568":{"id":"/reference/revsets-222","page_id":"/reference/revsets","tags":[],"type":"text","url":"/reference/revsets#date-patterns","content":"yesterday"},"2569":{"id":"/reference/revsets-223","page_id":"/reference/revsets","tags":[],"type":"text","url":"/reference/revsets#date-patterns","content":"yesterday 5pm"},"2570":{"id":"/reference/revsets-224","page_id":"/reference/revsets","tags":[],"type":"text","url":"/reference/revsets#date-patterns","content":"yesterday 10:30"},"2571":{"id":"/reference/revsets-225","page_id":"/reference/revsets","tags":[],"type":"text","url":"/reference/revsets#date-patterns","content":"yesterday 15:30"},"2572":{"id":"/reference/revsets-226","page_id":"/reference/revsets","tags":[],"type":"text","url":"/reference/revsets#aliases","content":"New symbols and functions can be defined in the config file, by using any\ncombination of the predefined symbols/functions and other aliases."},"2573":{"id":"/reference/revsets-227","page_id":"/reference/revsets","tags":[],"type":"text","url":"/reference/revsets#aliases","content":"Alias functions can be overloaded by the number of parameters. However, builtin\nfunction will be shadowed by name, and can't co-exist with aliases."},"2574":{"id":"/reference/revsets-228","page_id":"/reference/revsets","tags":[],"type":"text","url":"/reference/revsets#aliases","content":"For example:"},"2575":{"id":"/reference/revsets-229","page_id":"/reference/revsets","tags":[],"type":"text","url":"/reference/revsets#built-in-aliases","content":"The following aliases are built-in and used for certain operations. These functions\nare defined as aliases in order to allow you to overwrite them as needed.\nSee revsets.toml\nfor a comprehensive list."},"2576":{"id":"/reference/revsets-230","page_id":"/reference/revsets","tags":[],"type":"text","url":"/reference/revsets#built-in-aliases","content":"trunk(): Resolves to the head commit for the default bookmark of the default\nremote, or the remote named upstream or origin. This is set at the\nrepository level upon initialization of a Jujutsu repository."},"2577":{"id":"/reference/revsets-231","page_id":"/reference/revsets","tags":[],"type":"text","url":"/reference/revsets#built-in-aliases","content":"If the default bookmark cannot be resolved during initialization, the default\nglobal configuration tries the bookmarks main, master, and trunk on the\nupstream and origin remotes. If more than one potential trunk commit\nexists, the newest one is chosen. If none of the bookmarks exist, the revset\nevaluates to root()."},"2578":{"id":"/reference/revsets-232","page_id":"/reference/revsets","tags":[],"type":"text","url":"/reference/revsets#built-in-aliases","content":"You can override this as appropriate. If you do, make sure it\nalways resolves to exactly one commit. For example:"},"2579":{"id":"/reference/revsets-233","page_id":"/reference/revsets","tags":[],"type":"text","url":"/reference/revsets#built-in-aliases","content":"builtin_immutable_heads(): Resolves to\npresent(trunk()) | tags() | untracked_remote_bookmarks(). It is used as the\ndefault definition for immutable_heads() below. It is not recommended to\nredefine this alias. Prefer to redefine immutable_heads() instead."},"2580":{"id":"/reference/revsets-234","page_id":"/reference/revsets","tags":[],"type":"text","url":"/reference/revsets#built-in-aliases","content":"immutable_heads(): Resolves to\npresent(trunk()) | tags() | untracked_remote_bookmarks() by default. It is\nactually defined as builtin_immutable_heads(), and can be overridden as\nrequired. See here for details."},"2581":{"id":"/reference/revsets-235","page_id":"/reference/revsets","tags":[],"type":"text","url":"/reference/revsets#built-in-aliases","content":"immutable(): The set of commits that jj treats as immutable. This is\nequivalent to ::(immutable_heads() | root()). It is not recommended to redefine\nthis alias. Note that modifying this will not change whether a commit is immutable.\nTo do that, edit immutable_heads()."},"2582":{"id":"/reference/revsets-236","page_id":"/reference/revsets","tags":[],"type":"text","url":"/reference/revsets#built-in-aliases","content":"mutable(): The set of commits that jj treats as mutable. This is\nequivalent to ~immutable(). It is not recommended to redefined this alias.\nNote that modifying this will not change whether a commit is immutable.\nTo do that, edit immutable_heads()."},"2583":{"id":"/reference/revsets-237","page_id":"/reference/revsets","tags":[],"type":"text","url":"/reference/revsets#the-all-modifier","content":"Certain commands (such as jj rebase) can take multiple revset arguments, and\neach of these may resolve to one-or-many revisions."},"2584":{"id":"/reference/revsets-238","page_id":"/reference/revsets","tags":[],"type":"text","url":"/reference/revsets#the-all-modifier","content":"If you set the ui.always-allow-large-revsets option to false, jj will not\nallow revsets that resolve to more than one revision — a so-called \"large\nrevset\" — and will ask you to confirm that you want to proceed by\nprefixing it with the all: modifier. This option is planned to be removed."},"2585":{"id":"/reference/revsets-239","page_id":"/reference/revsets","tags":[],"type":"text","url":"/reference/revsets#the-all-modifier","content":"An all: modifier before a revset expression does not otherwise change its\nmeaning. Strictly speaking, it is not part of the revset language. The notation\nis similar to the modifiers like glob: allowed before string\npatterns."},"2586":{"id":"/reference/revsets-240","page_id":"/reference/revsets","tags":[],"type":"text","url":"/reference/revsets#the-all-modifier","content":"For example, jj rebase -r w -d xyz+ will rebase w on top of the child of\nxyz as long as xyz has exactly one child."},"2587":{"id":"/reference/revsets-241","page_id":"/reference/revsets","tags":[],"type":"text","url":"/reference/revsets#the-all-modifier","content":"If xyz has more than one child, the all: modifier is not specified, and\nui.always-allow-large-revsets is false, jj rebase -r w -d xyz+ will return\nan error."},"2588":{"id":"/reference/revsets-242","page_id":"/reference/revsets","tags":[],"type":"text","url":"/reference/revsets#the-all-modifier","content":"If ui.always-allow-large-revsets was true (the default), the above command\nwould act as if all: was set (see the next paragraph)."},"2589":{"id":"/reference/revsets-243","page_id":"/reference/revsets","tags":[],"type":"text","url":"/reference/revsets#the-all-modifier","content":"With the all: modifier, jj rebase -r w -d all:xyz+ will make w into a merge\ncommit if xyz has more than one child. The all: modifier confirms that the\nuser expected xyz to have more than one child."},"2590":{"id":"/reference/revsets-244","page_id":"/reference/revsets","tags":[],"type":"text","url":"/reference/revsets#the-all-modifier","content":"A more useful example: if w is a merge commit, jj rebase -s w -d all:w- -d\nxyz will add xyz to the list of w's parents."},"2591":{"id":"/reference/revsets-245","page_id":"/reference/revsets","tags":[],"type":"text","url":"/reference/revsets#examples","content":"Show the parent(s) of the working-copy commit (like git log -1 HEAD):"},"2592":{"id":"/reference/revsets-246","page_id":"/reference/revsets","tags":[],"type":"text","url":"/reference/revsets#examples","content":"Show all ancestors of the working copy (like plain git log)"},"2593":{"id":"/reference/revsets-247","page_id":"/reference/revsets","tags":[],"type":"text","url":"/reference/revsets#examples","content":"Show commits not on any remote bookmark:"},"2594":{"id":"/reference/revsets-248","page_id":"/reference/revsets","tags":[],"type":"text","url":"/reference/revsets#examples","content":"Show commits not on origin (if you have other remotes like fork):"},"2595":{"id":"/reference/revsets-249","page_id":"/reference/revsets","tags":[],"type":"text","url":"/reference/revsets#examples","content":"Show the initial commits in the repo (the ones Git calls \"root commits\"):"},"2596":{"id":"/reference/revsets-250","page_id":"/reference/revsets","tags":[],"type":"text","url":"/reference/revsets#examples","content":"Show some important commits (like git --simplify-by-decoration):"},"2597":{"id":"/reference/revsets-251","page_id":"/reference/revsets","tags":[],"type":"text","url":"/reference/revsets#examples","content":"Show local commits leading up to the working copy, as well as descendants of\nthose commits:"},"2598":{"id":"/reference/revsets-252","page_id":"/reference/revsets","tags":[],"type":"text","url":"/reference/revsets#examples","content":"Show commits authored by \"martinvonz\" and containing the word \"reset\" in the\ndescription:"},"2599":{"id":"/reference/templates","page_id":"/reference/templates","type":"page","content":"Templates","tags":[],"url":"/reference/templates"},"2600":{"id":"/reference/templates-0","page_id":"/reference/templates","type":"heading","tags":[],"url":"/reference/templates#keywords","content":"Keywords"},"2601":{"id":"/reference/templates-1","page_id":"/reference/templates","type":"heading","tags":[],"url":"/reference/templates#commit-keywords","content":"Commit keywords"},"2602":{"id":"/reference/templates-2","page_id":"/reference/templates","type":"heading","tags":[],"url":"/reference/templates#operation-keywords","content":"Operation keywords"},"2603":{"id":"/reference/templates-3","page_id":"/reference/templates","type":"heading","tags":[],"url":"/reference/templates#operators","content":"Operators"},"2604":{"id":"/reference/templates-4","page_id":"/reference/templates","type":"heading","tags":[],"url":"/reference/templates#global-functions","content":"Global functions"},"2605":{"id":"/reference/templates-5","page_id":"/reference/templates","type":"heading","tags":[],"url":"/reference/templates#built-in-aliases","content":"Built-in Aliases"},"2606":{"id":"/reference/templates-6","page_id":"/reference/templates","type":"heading","tags":[],"url":"/reference/templates#types","content":"Types"},"2607":{"id":"/reference/templates-7","page_id":"/reference/templates","type":"heading","tags":[],"url":"/reference/templates#annotationline-type","content":"AnnotationLine type"},"2608":{"id":"/reference/templates-8","page_id":"/reference/templates","type":"heading","tags":[],"url":"/reference/templates#boolean-type","content":"Boolean type"},"2609":{"id":"/reference/templates-9","page_id":"/reference/templates","type":"heading","tags":[],"url":"/reference/templates#commit-type","content":"Commit type"},"2610":{"id":"/reference/templates-10","p