mplates","tags":[],"type":"text","url":"/reference/templates#treeentry-type","content":".conflict() -> Boolean: True if the entry is a merge conflict."},"2898":{"id":"/reference/templates-298","page_id":"/reference/templates","tags":[],"type":"text","url":"/reference/templates#treeentry-type","content":".file_type() -> String: One of \"file\", \"symlink\", \"tree\",\n\"git-submodule\", or \"conflict\"."},"2899":{"id":"/reference/templates-299","page_id":"/reference/templates","tags":[],"type":"text","url":"/reference/templates#treeentry-type","content":".executable() -> Boolean: True if the entry is an executable file."},"2900":{"id":"/reference/templates-300","page_id":"/reference/templates","tags":[],"type":"text","url":"/reference/templates#workspaceref-type","content":"Conversion: Boolean: no, Serialize: yes, Template: yes"},"2901":{"id":"/reference/templates-301","page_id":"/reference/templates","tags":[],"type":"text","url":"/reference/templates#workspaceref-type","content":"The following methods are defined."},"2902":{"id":"/reference/templates-302","page_id":"/reference/templates","tags":[],"type":"text","url":"/reference/templates#workspaceref-type","content":".name() -> RefSymbol: Returns the workspace name as a symbol."},"2903":{"id":"/reference/templates-303","page_id":"/reference/templates","tags":[],"type":"text","url":"/reference/templates#workspaceref-type","content":".target() -> Commit: Returns the working-copy commit of this workspace."},"2904":{"id":"/reference/templates-304","page_id":"/reference/templates","tags":[],"type":"text","url":"/reference/templates#color-labels","content":"Template fragments are usually labeled with the command name, the context (or\nthe top-level object), and the method names. You can customize the output\ncolors by using these labels."},"2905":{"id":"/reference/templates-305","page_id":"/reference/templates","tags":[],"type":"text","url":"/reference/templates#color-labels","content":"For example, the following template is labeled as op_log operation id short:"},"2906":{"id":"/reference/templates-306","page_id":"/reference/templates","tags":[],"type":"text","url":"/reference/templates#color-labels","content":"In addition to that, you can insert arbitrary labels by label(label, content)\nfunction."},"2907":{"id":"/reference/templates-307","page_id":"/reference/templates","tags":[],"type":"text","url":"/reference/templates#color-labels","content":"To inspect how output fragments are labeled, use --color=debug option."},"2908":{"id":"/reference/templates-308","page_id":"/reference/templates","tags":[],"type":"text","url":"/reference/templates#configuration","content":"The default templates and aliases() are defined in the [templates] and\n[template-aliases] sections of the config respectively. The exact definitions\ncan be seen in the cli/src/config/templates.toml file in jj's source\ntree."},"2909":{"id":"/reference/templates-309","page_id":"/reference/templates","tags":[],"type":"text","url":"/reference/templates#configuration","content":"New keywords and functions can be defined as aliases, by using any\ncombination of the predefined keywords/functions and other aliases."},"2910":{"id":"/reference/templates-310","page_id":"/reference/templates","tags":[],"type":"text","url":"/reference/templates#configuration","content":"Alias functions can be overloaded by the number of parameters. However, builtin\nfunctions will be shadowed by name, and can't co-exist with aliases."},"2911":{"id":"/reference/templates-311","page_id":"/reference/templates","tags":[],"type":"text","url":"/reference/templates#configuration","content":"For example:"},"2912":{"id":"/reference/templates-312","page_id":"/reference/templates","tags":[],"type":"text","url":"/reference/templates#examples","content":"Get short commit IDs of the working-copy parents:"},"2913":{"id":"/reference/templates-313","page_id":"/reference/templates","tags":[],"type":"text","url":"/reference/templates#examples","content":"Show machine-readable list of full commit and change IDs:"},"2914":{"id":"/technical-details/architecture","page_id":"/technical-details/architecture","type":"page","content":"Architecture","tags":[],"url":"/technical-details/architecture"},"2915":{"id":"/technical-details/architecture-0","page_id":"/technical-details/architecture","type":"heading","tags":[],"url":"/technical-details/architecture#data-model","content":"Data model"},"2916":{"id":"/technical-details/architecture-1","page_id":"/technical-details/architecture","type":"heading","tags":[],"url":"/technical-details/architecture#separation-of-library-from-ui","content":"Separation of library from UI"},"2917":{"id":"/technical-details/architecture-2","page_id":"/technical-details/architecture","type":"heading","tags":[],"url":"/technical-details/architecture#storage-independent-apis","content":"Storage-independent APIs"},"2918":{"id":"/technical-details/architecture-3","page_id":"/technical-details/architecture","type":"heading","tags":[],"url":"/technical-details/architecture#design-of-the-library-crate","content":"Design of the library crate"},"2919":{"id":"/technical-details/architecture-4","page_id":"/technical-details/architecture","type":"heading","tags":[],"url":"/technical-details/architecture#overview","content":"Overview"},"2920":{"id":"/technical-details/architecture-5","page_id":"/technical-details/architecture","type":"heading","tags":[],"url":"/technical-details/architecture#backend","content":"Backend"},"2921":{"id":"/technical-details/architecture-6","page_id":"/technical-details/architecture","type":"heading","tags":[],"url":"/technical-details/architecture#gitbackend","content":"GitBackend"},"2922":{"id":"/technical-details/architecture-7","page_id":"/technical-details/architecture","type":"heading","tags":[],"url":"/technical-details/architecture#simplebackend","content":"SimpleBackend"},"2923":{"id":"/technical-details/architecture-8","page_id":"/technical-details/architecture","type":"heading","tags":[],"url":"/technical-details/architecture#store","content":"Store"},"2924":{"id":"/technical-details/architecture-9","page_id":"/technical-details/architecture","type":"heading","tags":[],"url":"/technical-details/architecture#readonlyrepo","content":"ReadonlyRepo"},"2925":{"id":"/technical-details/architecture-10","page_id":"/technical-details/architecture","type":"heading","tags":[],"url":"/technical-details/architecture#mutablerepo","content":"MutableRepo"},"2926":{"id":"/technical-details/architecture-11","page_id":"/technical-details/architecture","type":"heading","tags":[],"url":"/technical-details/architecture#transaction","content":"Transaction"},"2927":{"id":"/technical-details/architecture-12","page_id":"/technical-details/architecture","type":"heading","tags":[],"url":"/technical-details/architecture#repoloader","content":"RepoLoader"},"2928":{"id":"/technical-details/architecture-13","page_id":"/technical-details/architecture","type":"heading","tags":[],"url":"/technical-details/architecture#treestate","content":"TreeState"},"2929":{"id":"/technical-details/architecture-14","page_id":"/technical-details/architecture","type":"heading","tags":[],"url":"/technical-details/architecture#workingcopy","content":"WorkingCopy"},"2930":{"id":"/technical-details/architecture-15","page_id":"/technical-details/architecture","type":"heading","tags":[],"url":"/technical-details/architecture#workspace","content":"Workspace"},"2931":{"id":"/technical-details/architecture-16","page_id":"/technical-details/architecture","type":"heading","tags":[],"url":"/technical-details/architecture#git","content":"Git"},"2932":{"id":"/technical-details/architecture-17","page_id":"/technical-details/architecture","type":"heading","tags":[],"url":"/technical-details/architecture#revsets","content":"Revsets"},"2933":{"id":"/technical-details/architecture-18","page_id":"/technical-details/architecture","type":"heading","tags":[],"url":"/technical-details/architecture#stackedtable","content":"StackedTable"},"2934":{"id":"/technical-details/architecture-19","page_id":"/technical-details/architecture","type":"heading","tags":[],"url":"/technical-details/architecture#design-of-the-cli-crate","content":"Design of the CLI crate"},"2935":{"id":"/technical-details/architecture-20","page_id":"/technical-details/architecture","type":"heading","tags":[],"url":"/technical-details/architecture#templates","content":"Templates"},"2936":{"id":"/technical-details/architecture-21","page_id":"/technical-details/architecture","type":"heading","tags":[],"url":"/technical-details/architecture#diff-editing","content":"Diff-editing"},"2937":{"id":"/technical-details/architecture-22","page_id":"/technical-details/architecture","tags":[],"type":"text","url":"/technical-details/architecture#data-model","content":"The commit data model is similar\nto Git's object model\n, but with some differences."},"2938":{"id":"/technical-details/architecture-23","page_id":"/technical-details/architecture","tags":[],"type":"text","url":"/technical-details/architecture#separation-of-library-from-ui","content":"The jj binary consists of two Rust crates: the library crate (jj-lib) and\nthe CLI crate (jj-cli). The library crate is currently only used by the CLI\ncrate, but it is meant to also be usable from a GUI or TUI, or in a server\nserving requests from multiple users. As a result, the library should avoid\ninteracting directly with the user via the terminal or by other means; all\ninput/output is handled by the CLI crate . Since the library crate is meant\nto usable in a server, it also cannot read configuration from the user's home\ndirectory, or from user-specific environment variables."},"2939":{"id":"/technical-details/architecture-24","page_id":"/technical-details/architecture","tags":[],"type":"text","url":"/technical-details/architecture#separation-of-library-from-ui","content":"There are a few exceptions, such as for messages printed during automatic\nupgrades of the repo format"},"2940":{"id":"/technical-details/architecture-25","page_id":"/technical-details/architecture","tags":[],"type":"text","url":"/technical-details/architecture#separation-of-library-from-ui","content":"A lot of thought has gone into making the library crate's API easy to use, but\nnot much has gone into \"details\" such as which collection types are used, or\nwhich symbols are exposed in the API."},"2941":{"id":"/technical-details/architecture-26","page_id":"/technical-details/architecture","tags":[],"type":"text","url":"/technical-details/architecture#storage-independent-apis","content":"One overarching principle in the design is that it should be easy to change\nwhere data is stored. The goal was to be able to put storage on local-disk by\ndefault but also be able to move storage to the cloud at Google\n(and for anyone). To that end, commits (and trees, files, etc.) are stored by\nthe commit backend, operations (and views) are stored by the operation backend,\nthe heads of the operation log are stored by the \"op heads\" backend, the commit\nindex is stored by the index backend, and the working copy is stored by the\nworking copy backend. The interfaces are defined in terms of plain Rust data\ntypes, not tied to a specific format. The working copy doesn't have its own\ntrait defined yet, but its interface is small and easy to create traits for when\nneeded."},"2942":{"id":"/technical-details/architecture-27","page_id":"/technical-details/architecture","tags":[],"type":"text","url":"/technical-details/architecture#storage-independent-apis","content":"The commit backend to use when loading a repo is specified in\nthe .jj/repo/store/type file. There are similar files for the other backends\n(.jj/repo/index/type, .jj/repo/op_store/type, .jj/repo/op_heads/type)."},"2943":{"id":"/technical-details/architecture-28","page_id":"/technical-details/architecture","tags":[],"type":"text","url":"/technical-details/architecture#overview","content":"Here's a diagram showing some important types in the library crate, and how they\nrelate. For example, given a Workspace, you can use it to get a WorkingCopy\nor a RepoLoader. A Transaction is required to acquire a MutableRepo, etc.\nThe following sections describe each component."},"2944":{"id":"/technical-details/architecture-29","page_id":"/technical-details/architecture","tags":[],"type":"text","url":"/technical-details/architecture#overview","content":"This diagram was created with Excalidraw. You can get a copy of it at this\nlocation, and Right Click > \"Copy to Clipboard as SVG\"."},"2945":{"id":"/technical-details/architecture-30","page_id":"/technical-details/architecture","tags":[],"type":"text","url":"/technical-details/architecture#backend","content":"The Backend trait defines the interface each\ncommit backend needs to implement. The current in-tree commit backends\nare GitBackend\nand SimpleBackend."},"2946":{"id":"/technical-details/architecture-31","page_id":"/technical-details/architecture","tags":[],"type":"text","url":"/technical-details/architecture#backend","content":"Since there are non-commit backends, the Backend trait should probably be\nrenamed to CommitBackend."},"2947":{"id":"/technical-details/architecture-32","page_id":"/technical-details/architecture","tags":[],"type":"text","url":"/technical-details/architecture#gitbackend","content":"The GitBackend stores commits in a Git repository. It uses libgit2 to read\nand write commits and refs."},"2948":{"id":"/technical-details/architecture-33","page_id":"/technical-details/architecture","tags":[],"type":"text","url":"/technical-details/architecture#gitbackend","content":"To prevent GC from deleting commits that are still reachable from the operation\nlog, the GitBackend stores a ref for each commit in the operation log in\nthe refs/jj/keep/ namespace."},"2949":{"id":"/technical-details/architecture-34","page_id":"/technical-details/architecture","tags":[],"type":"text","url":"/technical-details/architecture#gitbackend","content":"Commit data that is available in Jujutsu's model but not in Git's model is\nstored in a StackedTable in .jj/repo/store/extra/. That is currently the\nchange ID and the list of predecessors. For commits that don't have any data in\nthat table, which is any commit created by git, we use an empty list as\npredecessors, and the bit-reversed commit ID as change ID."},"2950":{"id":"/technical-details/architecture-35","page_id":"/technical-details/architecture","tags":[],"type":"text","url":"/technical-details/architecture#gitbackend","content":"Because we use the Git Object ID as commit ID, two commits that differ only in\ntheir change ID, for example, will get the same commit ID, so we error out when\ntrying to write the second one of them."},"2951":{"id":"/technical-details/architecture-36","page_id":"/technical-details/architecture","tags":[],"type":"text","url":"/technical-details/architecture#simplebackend","content":"The SimpleBackend is just a proof of concept. It stores objects addressed by\ntheir hash, with one file per object."},"2952":{"id":"/technical-details/architecture-37","page_id":"/technical-details/architecture","tags":[],"type":"text","url":"/technical-details/architecture#store","content":"The Store type wraps the Backend and returns wrapped types for commits and\ntrees to make them easier to use. The wrapped objects have a reference to\nthe Store itself, so you can do e.g. commit.parents() without having to\nprovide the Store as an argument."},"2953":{"id":"/technical-details/architecture-38","page_id":"/technical-details/architecture","tags":[],"type":"text","url":"/technical-details/architecture#store","content":"The Store type also provides caching of commits and trees."},"2954":{"id":"/technical-details/architecture-39","page_id":"/technical-details/architecture","tags":[],"type":"text","url":"/technical-details/architecture#readonlyrepo","content":"A ReadonlyRepo represents the state of a repo at a specific operation. It\nkeeps the view object associated with that operation."},"2955":{"id":"/technical-details/architecture-40","page_id":"/technical-details/architecture","tags":[],"type":"text","url":"/technical-details/architecture#readonlyrepo","content":"The repository doesn't know where on disk any working copies live. It knows, via\nthe view object, which commit is supposed to be the current working-copy commit\nin each workspace."},"2956":{"id":"/technical-details/architecture-41","page_id":"/technical-details/architecture","tags":[],"type":"text","url":"/technical-details/architecture#mutablerepo","content":"A MutableRepo is a mutable version of ReadonlyRepo. It has a reference to\nits base ReadonlyRepo, but it has its own copy of the view object and lets the\ncaller modify it."},"2957":{"id":"/technical-details/architecture-42","page_id":"/technical-details/architecture","tags":[],"type":"text","url":"/technical-details/architecture#transaction","content":"The Transaction object has a MutableRepo and metadata that will go into the\noperation log. When the transaction commits, the MutableRepo becomes a view\nobject in the operation log on disk, and the Transaction object becomes an\noperation object. In memory, Transaction::commit() returns a\nnew ReadonlyRepo."},"2958":{"id":"/technical-details/architecture-43","page_id":"/technical-details/architecture","tags":[],"type":"text","url":"/technical-details/architecture#repoloader","content":"The RepoLoader represents a repository at an unspecified operation. You can\nthink of as a pointer to the .jj/repo/ directory. It can create\na ReadonlyRepo given an operation ID."},"2959":{"id":"/technical-details/architecture-44","page_id":"/technical-details/architecture","tags":[],"type":"text","url":"/technical-details/architecture#treestate","content":"The TreeState type represents the state of the files in a working copy. It\nkeep track of the mtime and size for each tracked file. It knows the TreeId\nthat the working copy represents. It has a snapshot() method that will use the\nrecorded mtimes and sizes and detect changes in the working copy. If anything\nchanged, it will return a new TreeId. It also has checkout() for updating\nthe files on disk to match a requested TreeId."},"2960":{"id":"/technical-details/architecture-45","page_id":"/technical-details/architecture","tags":[],"type":"text","url":"/technical-details/architecture#treestate","content":"The TreeState type supports sparse checkouts. In fact, all working copies are\nsparse; they simply track the full repo in most cases."},"2961":{"id":"/technical-details/architecture-46","page_id":"/technical-details/architecture","tags":[],"type":"text","url":"/technical-details/architecture#workingcopy","content":"The WorkingCopy type has a TreeState but also knows which WorkspaceName it\nhas and at which operation it was most recently updated."},"2962":{"id":"/technical-details/architecture-47","page_id":"/technical-details/architecture","tags":[],"type":"text","url":"/technical-details/architecture#workspace","content":"The Workspace type represents the combination of a repo and a working copy (\nlike Git's 'worktree' concept)."},"2963":{"id":"/technical-details/architecture-48","page_id":"/technical-details/architecture","tags":[],"type":"text","url":"/technical-details/architecture#workspace","content":"The repo view at the current operation determines the desired working-copy\ncommit in each workspace. The WorkingCopy determines what is actually in the\nworking copy. The working copy can become stale if the working-copy commit was\nchanged from another workspace (or if the process updating the working copy\ncrashed, for example)."},"2964":{"id":"/technical-details/architecture-49","page_id":"/technical-details/architecture","tags":[],"type":"text","url":"/technical-details/architecture#git","content":"The git module contains functionality for interoperating with a Git repo, at a\nhigher level than the GitBackend. The GitBackend is restricted by\nthe Backend trait; the git module is specifically for Git-backed repos. It\nhas functionality for importing refs from the Git repo and for exporting to refs\nin the Git repo. It also has functionality for pushing and pulling to/from Git\nremotes."},"2965":{"id":"/technical-details/architecture-50","page_id":"/technical-details/architecture","tags":[],"type":"text","url":"/technical-details/architecture#revsets","content":"A user-provided revset expression string goes through a few different stages to\nbe evaluated:"},"2966":{"id":"/technical-details/architecture-51","page_id":"/technical-details/architecture","tags":[],"type":"text","url":"/technical-details/architecture#revsets","content":"Parse the expression into a RevsetExpression, which is close to an AST"},"2967":{"id":"/technical-details/architecture-52","page_id":"/technical-details/architecture","tags":[],"type":"text","url":"/technical-details/architecture#revsets","content":"Resolve symbols and functions like tags() into specific commits. After\nthis stage, the expression is still a RevsetExpression, but it won't have\nany CommitRef variants in it."},"2968":{"id":"/technical-details/architecture-53","page_id":"/technical-details/architecture","tags":[],"type":"text","url":"/technical-details/architecture#revsets","content":"Resolve visibility. This stage resolves visible_heads() and all() and\nproduces a ResolvedExpression."},"2969":{"id":"/technical-details/architecture-54","page_id":"/technical-details/architecture","tags":[],"type":"text","url":"/technical-details/architecture#revsets","content":"Evaluate the ResolvedExpression into a Revset."},"2970":{"id":"/technical-details/architecture-55","page_id":"/technical-details/architecture","tags":[],"type":"text","url":"/technical-details/architecture#revsets","content":"This evaluation step is performed by Index::evaluate_revset(), allowing\nthe Revset implementation to leverage the specifics of a custom index\nimplementation. The first three steps are independent of the index\nimplementation."},"2971":{"id":"/technical-details/architecture-56","page_id":"/technical-details/architecture","tags":[],"type":"text","url":"/technical-details/architecture#stackedtable","content":"StackedTable (actually ReadonlyTable and MutableTable) is a simple disk\nformat for storing key-value pairs sorted by key. The keys have to have the same\nsize but the values can have different sizes. We use our own format because we\nwant lock-free concurrency and there doesn't seem to be an\nexisting key-value store we could use."},"2972":{"id":"/technical-details/architecture-57","page_id":"/technical-details/architecture","tags":[],"type":"text","url":"/technical-details/architecture#stackedtable","content":"The file format contains a lookup table followed by concatenated values. The\nlookup table is a sorted list of keys, where each key is followed by the\nassociated value's offset in the concatenated values."},"2973":{"id":"/technical-details/architecture-58","page_id":"/technical-details/architecture","tags":[],"type":"text","url":"/technical-details/architecture#stackedtable","content":"A table can have a parent table. When looking up a key, if it's not found in the\ncurrent table, the parent table is searched. We never update a table in place.\nIf the number of new entries to write is less than half the number of entries in\nthe parent table, we create a new table with the new entries and a pointer to\nthe parent. Otherwise, we copy the entries from the parent table and the new\nentries into a new table with the grandparent as the parent. We do that\nrecursively so parent tables are at least 2 times as large as child tables. This\nresults in O(log N) amortized insertion time and lookup time."},"2974":{"id":"/technical-details/architecture-59","page_id":"/technical-details/architecture","tags":[],"type":"text","url":"/technical-details/architecture#stackedtable","content":"There's no garbage collection of unreachable tables yet."},"2975":{"id":"/technical-details/architecture-60","page_id":"/technical-details/architecture","tags":[],"type":"text","url":"/technical-details/architecture#stackedtable","content":"The tables are named by their hash. We keep a separate directory of pointers to\nthe current leaf tables, in the same way as we\ndo for the operation log."},"2976":{"id":"/technical-details/architecture-61","page_id":"/technical-details/architecture","tags":[],"type":"text","url":"/technical-details/architecture#templates","content":"The concept is copied from Mercurial, but the syntax is different. The main\ndifference is that the top-level expression is a template expression, not a\nstring like in Mercurial. There is also no string interpolation (e.g.\n\"Commit ID: {node}\" in Mercurial)."},"2977":{"id":"/technical-details/architecture-62","page_id":"/technical-details/architecture","tags":[],"type":"text","url":"/technical-details/architecture#diff-editing","content":"Diff-editing works by creating two very sparse working copies, containing only\nthe files we want the user to edit. We then let the user edit the right-hand\nside of the diff. Then we simply snapshot that working copy to create the new\ntree."},"2978":{"id":"/technical-details/concurrency","page_id":"/technical-details/concurrency","type":"page","content":"Concurrency","tags":[],"url":"/technical-details/concurrency"},"2979":{"id":"/technical-details/concurrency-0","page_id":"/technical-details/concurrency","type":"heading","tags":[],"url":"/technical-details/concurrency#introduction","content":"Introduction"},"2980":{"id":"/technical-details/concurrency-1","page_id":"/technical-details/concurrency","type":"heading","tags":[],"url":"/technical-details/concurrency#syncing-with-rsync-nfs-dropbox-etc","content":"Syncing with rsync, NFS, Dropbox, etc"},"2981":{"id":"/technical-details/concurrency-2","page_id":"/technical-details/concurrency","type":"heading","tags":[],"url":"/technical-details/concurrency#operation-log","content":"Operation log"},"2982":{"id":"/technical-details/concurrency-3","page_id":"/technical-details/concurrency","type":"heading","tags":[],"url":"/technical-details/concurrency#merging-divergent-operations","content":"Merging divergent operations"},"2983":{"id":"/technical-details/concurrency-4","page_id":"/technical-details/concurrency","type":"heading","tags":[],"url":"/technical-details/concurrency#storage","content":"Storage"},"2984":{"id":"/technical-details/concurrency-5","page_id":"/technical-details/concurrency","tags":[],"type":"text","url":"/technical-details/concurrency#introduction","content":"Concurrent editing is a key feature of DVCSs -- that's why they're called\nDistributed Version Control Systems. A DVCS that didn't let users edit files\nand create commits on separate machines at the same time wouldn't be much\nof a distributed VCS."},"2985":{"id":"/technical-details/concurrency-6","page_id":"/technical-details/concurrency","tags":[],"type":"text","url":"/technical-details/concurrency#introduction","content":"When conflicting changes are made in different clones, a DVCS will have to deal\nwith that when you push or pull. For example, when using Mercurial, if the\nremote has updated a bookmark called main (Mercurial's bookmarks are similar\nto a Git's branches) and you had updated the same bookmark locally but made it\npoint to a different target, Mercurial would add a bookmark called main@origin\nto indicate the conflict. Git instead prevents the conflict by renaming pulled\nbranches to origin/main whether or not there was a conflict. However, most\nDVCSs treat local concurrency quite differently, typically by using lock files\nto prevent concurrent edits. Unlike those DVCSs, Jujutsu treats concurrent edits\nthe same whether they're made locally or remotely."},"2986":{"id":"/technical-details/concurrency-7","page_id":"/technical-details/concurrency","tags":[],"type":"text","url":"/technical-details/concurrency#introduction","content":"One problem with using lock files is that they don't work when the clone is in a\ndistributed file system. Most clones are of course not stored in distributed\nfile systems, but it is a big problem when they are (Mercurial repos\nfrequently get corrupted, for example)."},"2987":{"id":"/technical-details/concurrency-8","page_id":"/technical-details/concurrency","tags":[],"type":"text","url":"/technical-details/concurrency#introduction","content":"Another problem with using lock files is related to complexity of\nimplementation. The simplest way of using lock files is to take coarse-grained\nlocks early: every command that may modify the repo takes a lock at the very\nbeginning. However, that means that operations that wouldn't actually conflict\nwould still have to wait for each other. The user experience can be improved by\nusing finer-grained locks and/or taking the locks later. The drawback of that is\ncomplexity. For example, you need to verify that any assumptions you made before\nlocking are still valid after you take the lock."},"2988":{"id":"/technical-details/concurrency-9","page_id":"/technical-details/concurrency","tags":[],"type":"text","url":"/technical-details/concurrency#introduction","content":"To avoid depending on lock files, Jujutsu takes a different approach by\naccepting that concurrent changes can always happen. It instead exposes any\nconflicting changes to the user, much like other DVCSs do for conflicting\nchanges made remotely."},"2989":{"id":"/technical-details/concurrency-10","page_id":"/technical-details/concurrency","tags":[],"type":"text","url":"/technical-details/concurrency#syncing-with-rsync-nfs-dropbox-etc","content":"Jujutsu's lock-free concurrency means that it's possible to update copies of the\nclone on different machines and then let rsync (or Dropbox, or NFS, etc.)\nmerge them. The working copy may mismatch what's supposed to be checked out, but\nno changes to the repo will be lost (added commits, moved bookmarks, etc.). If\nconflicting changes were made, they will appear as conflicts. For example, if a\nbookmark was moved to two different locations, they will appear in jj log in\nboth locations but with a \"?\" after the name, and jj status will also inform\nthe user about the conflict."},"2990":{"id":"/technical-details/concurrency-11","page_id":"/technical-details/concurrency","tags":[],"type":"text","url":"/technical-details/concurrency#syncing-with-rsync-nfs-dropbox-etc","content":"Note that, for now, there are known bugs in this area. Most notably, with the\nGit backend, repository corruption is possible because the backend is not\nentirely lock-free. If you know\nabout the bug, it is relatively easy to recover from."},"2991":{"id":"/technical-details/concurrency-12","page_id":"/technical-details/concurrency","tags":[],"type":"text","url":"/technical-details/concurrency#syncing-with-rsync-nfs-dropbox-etc","content":"Moreover, such use of Jujutsu is not currently thoroughly tested,\nespecially in the context of colocated\nrepositories. While the contents of commits\nshould be safe, concurrent modification of a repository from different computers\nmight conceivably lose some bookmark pointers. Note that, unlike in pure\nGit, losing a bookmark pointer does not lead to losing commits."},"2992":{"id":"/technical-details/concurrency-13","page_id":"/technical-details/concurrency","tags":[],"type":"text","url":"/technical-details/concurrency#operation-log","content":"The most important piece in the lock-free design is the \"operation log\". That is\nwhat allows us to detect and merge divergent operations."},"2993":{"id":"/technical-details/concurrency-14","page_id":"/technical-details/concurrency","tags":[],"type":"text","url":"/technical-details/concurrency#operation-log","content":"The operation log is similar to a commit DAG (such as in\nGit's object model),\nbut each commit object is instead an \"operation\" and each tree object is instead\na \"view\". The view object contains the set of visible head commits, bookmarks,\ntags, and the working-copy commit in each workspace. The operation object\ncontains a pointer to the view object (like how commit objects point to tree\nobjects), pointers to parent operation(s) (like how commit objects point to\nparent commit(s)), and metadata about the operation. These types are defined\nin op_store.proto The operation log is normally linear.\nIt becomes non-linear if there are divergent operations."},"2994":{"id":"/technical-details/concurrency-15","page_id":"/technical-details/concurrency","tags":[],"type":"text","url":"/technical-details/concurrency#operation-log","content":"When a command starts, it loads the repo at the latest operation. Because the\nassociated view object completely defines the repo state, the running command\nwill not see any changes made by other processes thereafter. When the operation\ncompletes, it is written with the start operation as parent. The operation\ncannot fail to commit (except for disk failures and such). It is left for the\nnext command to notice if there were divergent operations. It will have to be\nable to do that anyway since the concurrent operation could have arrived via a\ndistributed file system. This model -- where each operation sees a consistent\nview of the repo and is guaranteed to be able to commit their changes -- greatly\nsimplifies the implementation of commands."},"2995":{"id":"/technical-details/concurrency-16","page_id":"/technical-details/concurrency","tags":[],"type":"text","url":"/technical-details/concurrency#operation-log","content":"It is possible to load the repo at a particular operation with\njj --at-operation=<operation ID> <command>. If the command is mutational, that\nwill result in a fork in the operation log. That works exactly the same as if\nany later operations had not existed when the command started. In other words,\nrunning commands on a repo loaded at an earlier operation works the same way as\nif the operations had been concurrent. This can be useful for simulating\ndivergent operations."},"2996":{"id":"/technical-details/concurrency-17","page_id":"/technical-details/concurrency","tags":[],"type":"text","url":"/technical-details/concurrency#merging-divergent-operations","content":"If Jujutsu tries to load the repo and finds multiple heads in the operation log,\nit will do a 3-way merge of the view objects based on their common ancestor\n(possibly several 3-way merges if there were more than two heads). Conflicts\nare recorded in the resulting view object. For example, if bookmark main was\nmoved from commit A to commit B in one operation and moved to commit C in a\nconcurrent operation, then main will be recorded as \"moved from A to B or C\".\nSee the RefTarget definition in op_store.proto."},"2997":{"id":"/technical-details/concurrency-18","page_id":"/technical-details/concurrency","tags":[],"type":"text","url":"/technical-details/concurrency#merging-divergent-operations","content":"Because we allow bookmarks (etc.) to be in a conflicted state rather than just\nerroring out when there are multiple heads, the user can continue to use the\nrepo, including performing further operations on the repo. Of course, some\ncommands will fail when using a conflicted bookmark. For example,\njj new main when main is in a conflicted state will result in an error\ntelling you that main resolved to multiple revisions."},"2998":{"id":"/technical-details/concurrency-19","page_id":"/technical-details/concurrency","tags":[],"type":"text","url":"/technical-details/concurrency#storage","content":"The operation objects and view objects are stored in content-addressed storage\njust like Git commits are. That makes them safe to write without locking."},"2999":{"id":"/technical-details/concurrency-20","page_id":"/technical-details/concurrency","tags":[],"type":"text","url":"/technical-details/concurrency#storage","content":"We also need a way of finding the current head of the operation log. We do that\nby keeping the ID of the current head(s) as a file in a directory. The ID is the\nname of the file; it has no contents. When an operation completes, we add a file\npointing to the new operation and then remove the file pointing to the old\noperation. Writing the new file is what makes the operation visible (if the old\nfile didn't get properly deleted, then future readers will take care of that).\nThis scheme ensures that transactions are atomic."},"3000":{"id":"/technical-details/conflicts","page_id":"/technical-details/conflicts","type":"page","content":"Conflicts","tags":[],"url":"/technical-details/conflicts"},"3001":{"id":"/technical-details/conflicts-0","page_id":"/technical-details/conflicts","type":"heading","tags":[],"url":"/technical-details/conflicts#introduction","content":"Introduction"},"3002":{"id":"/technical-details/conflicts-1","page_id":"/technical-details/conflicts","type":"heading","tags":[],"url":"/technical-details/conflicts#data-model","content":"Data model"},"3003":{"id":"/technical-details/conflicts-2","page_id":"/technical-details/conflicts","type":"heading","tags":[],"url":"/technical-details/conflicts#conflict-simplification","content":"Conflict simplification"},"3004":{"id":"/technical-details/conflicts-3","page_id":"/technical-details/conflicts","type":"heading","tags":[],"url":"/technical-details/conflicts#same-change-rule","content":"Same-change rule"},"3005":{"id":"/technical-details/conflicts-4","page_id":"/technical-details/conflicts","tags":[],"type":"text","url":"/technical-details/conflicts#introduction","content":"Conflicts can happen when two changes are applied to some state. This document\nis about conflicts between changes to files (not about conflicts between\nchanges to bookmark targets, for example)."},"3006":{"id":"/technical-details/conflicts-5","page_id":"/technical-details/conflicts","tags":[],"type":"text","url":"/technical-details/conflicts#introduction","content":"For example, if you merge two branches in a repo, there may be conflicting\nchanges between the two branches. Most DVCSs require you to resolve those\nconflicts before you can finish the merge operation. Jujutsu instead records\nthe conflicts in the commit and lets you resolve the conflict when you feel like\nit."},"3007":{"id":"/technical-details/conflicts-6","page_id":"/technical-details/conflicts","tags":[],"type":"text","url":"/technical-details/conflicts#data-model","content":"When a merge conflict happens, it is recorded as an ordered list of tree objects\nlinked from the commit (instead of the usual single tree per commit). There will\nalways be an odd number of trees linked from the commit. You can think of the\nfirst tree as a start tree, and the subsequent pairs of trees to apply the diff\nbetween onto the start. Examples:"},"3008":{"id":"/technical-details/conflicts-7","page_id":"/technical-details/conflicts","tags":[],"type":"text","url":"/technical-details/conflicts#data-model","content":"If the commit has trees A, B, C, D, and E it means that the contents should be\ncalculated as A+(C-B)+(E-D)."},"3009":{"id":"/technical-details/conflicts-8","page_id":"/technical-details/conflicts","tags":[],"type":"text","url":"/technical-details/conflicts#data-model","content":"A three-way merge between A and C with B as base can be represented as a\ncommit with trees A, B, and C, also known as A+(C-B)."},"3010":{"id":"/technical-details/conflicts-9","page_id":"/technical-details/conflicts","tags":[],"type":"text","url":"/technical-details/conflicts#data-model","content":"The resulting tree contents is calculated on demand. Note that we often don't\nneed to merge the entire tree. For example, when checking out a commit in the\nworking copy, we only need to merge parts of the tree that differs from the\ntree that was previously checked out in the working copy. As another example,\nwhen listing paths with conflicts, we only need to traverse parts of the tree\nthat cannot be trivially resolved; if only one side modified lib/, then we\ndon't need to look for conflicts in that sub-tree."},"3011":{"id":"/technical-details/conflicts-10","page_id":"/technical-details/conflicts","tags":[],"type":"text","url":"/technical-details/conflicts#data-model","content":"When merging trees, if we can't resolve a sub-tree conflict trivially by looking\nat just the tree id, we recurse into the sub-tree. Similarly, if we can't\nresolve a file conflict trivially by looking at just the id, we recursive into\nthe hunks within the file."},"3012":{"id":"/technical-details/conflicts-11","page_id":"/technical-details/conflicts","tags":[],"type":"text","url":"/technical-details/conflicts#data-model","content":"See here for how conflicts are\nstored when using the Git commit backend."},"3013":{"id":"/technical-details/conflicts-12","page_id":"/technical-details/conflicts","tags":[],"type":"text","url":"/technical-details/conflicts#conflict-simplification","content":"Remember that a 3-way merge can be written A+C-B. If one of those states is\nitself a conflict, then we simply insert the conflict expression there. Then we\nsimplify by removing canceling terms. These two steps are implemented in\nMerge::flatten() and Merge::simplify() in merge.rs."},"3014":{"id":"/technical-details/conflicts-13","page_id":"/technical-details/conflicts","tags":[],"type":"text","url":"/technical-details/conflicts#conflict-simplification","content":"For example, let's say commit B is based on A and is rebased to C, where it\nresults in conflicts (C+(B-A)), which the user leaves unresolved. If the\ncommit is then rebased to D, the result will be D+((C+(B-A))-C). That expression\ncan be simplified to D+(B-A), which is a regular 3-way merge between D and B\nwith A as base (no trace of C). This is what lets the user keep old commits\nrebased to head without resolving conflicts and still not get messy recursive\nconflicts."},"3015":{"id":"/technical-details/conflicts-14","page_id":"/technical-details/conflicts","tags":[],"type":"text","url":"/technical-details/conflicts#conflict-simplification","content":"As another example, let's go through what happens when you back out a conflicted\ncommit. Let's say we have the usual E = C+(B-A) conflict on top of\nnon-conflict state C. We then revert that change. Reverting a change means\napplying its reverse diff -(E-C), so the result is E+(C-E) =\n(C+(B-A))+(C-(C+(B-A))), which we can simplify to just C (i.e. no conflict)."},"3016":{"id":"/technical-details/conflicts-15","page_id":"/technical-details/conflicts","tags":[],"type":"text","url":"/technical-details/conflicts#same-change-rule","content":"When all sides of a conflict make the same change,\nwe automatically consider it resolved to that value. We call this\n\"the same-change rule\". This behavior matches what Git and Mercurial do.\nDarcs, on the other hand, considers it a conflict. The automatic conflict\nresolution we do is lossy in terms of conflict algebra; it means that rebasing\na commit onto a commit that has the same changes (or a subset thereof) and then\nrebasing it back will lose changes (for a real-life example see bug #6369).\nWe do it because it is more user-friendly in the vast majority of cases. We\nmay at some point experiment with a config option to disable the same-change\nrule."},"3017":{"id":"/technical-details/core-tenets","page_id":"/technical-details/core-tenets","type":"page","content":"Core tenets","tags":[],"url":"/technical-details/core-tenets"},"3018":{"id":"/technical-details/core-tenets-0","page_id":"/technical-details/core-tenets","tags":[],"type":"text","url":"/technical-details/core-tenets","content":"Separation of logic and UI: It should be as easy to create new UIs (CLIs,\nGUIs, TUIs, servers) without having to duplicate logic."},"3019":{"id":"/technical-details/core-tenets-1","page_id":"/technical-details/core-tenets","tags":[],"type":"text","url":"/technical-details/core-tenets","content":"Easy-to-use APIs: It should be easy to create new commands. For example,\neach command should not have to worry about concurrency, working-copy state,\nand rebasing descendants of rewritten commits."},"3020":{"id":"/technical-details/core-tenets-2","page_id":"/technical-details/core-tenets","tags":[],"type":"text","url":"/technical-details/core-tenets","content":"User-friendliness: Making the working copy a commit is simpler. This is\nhow the project started."},"3021":{"id":"/technical-details/core-tenets-3","page_id":"/technical-details/core-tenets","tags":[],"type":"text","url":"/technical-details/core-tenets","content":"The repository is the source of truth: Most commands should operate on the\ncommit graph. The working copy is just one way of editing commits."},"3022":{"id":"/technical-details/core-tenets-4","page_id":"/technical-details/core-tenets","tags":[],"type":"text","url":"/technical-details/core-tenets","content":"Pluggable storage: Must be easy to integrate with different commit storage,\nvirtual file systems and more."},"3023":{"id":"/technical-details/core-tenets-5","page_id":"/technical-details/core-tenets","tags":[],"type":"text","url":"/technical-details/core-tenets","content":"Git-interop: Git is everywhere. We need to have good interop to be adopted."},"3024":{"id":"/technical-details/core-tenets-6","page_id":"/technical-details/core-tenets","tags":[],"type":"text","url":"/technical-details/core-tenets","content":"All operations must be able to scale to Google-scale repos (lots of commits,\nlots of files): Laziness is important, must avoid accessing data\nunnecessarily."},"3025":{"id":"/technical-details/core-tenets-7","page_id":"/technical-details/core-tenets","tags":[],"type":"text","url":"/technical-details/core-tenets","content":"Having as few states as possible."},"3026":{"id":"/technical-details/core-tenets-8","page_id":"/technical-details/core-tenets","tags":[],"type":"text","url":"/technical-details/core-tenets","content":"Make it incredibly hard to lose work in your repository."},"3027":{"id":"/technical-details/core-tenets-9","page_id":"/technical-details/core-tenets","tags":[],"type":"text","url":"/technical-details/core-tenets","content":"Concurrent modifications to the repo should be safe."},"3028":{"id":"/technical-details/core-tenets-10","page_id":"/technical-details/core-tenets","tags":[],"type":"text","url":"/technical-details/core-tenets","content":"Allow concurrent edits on any commit, pending or finished."},"3029":{"id":"/technical-details/core-tenets-11","page_id":"/technical-details/core-tenets","tags":[],"type":"text","url":"/technical-details/core-tenets","content":"Make a \"stacked diffs\" workflow as easy as possible."},"3030":{"id":"/changelog","page_id":"/changelog","type":"page","content":"Changelog","tags":[],"url":"/changelog"},"3031":{"id":"/changelog-0","page_id":"/changelog","type":"heading","tags":[],"url":"/changelog#unreleased","content":"[Unreleased]"},"3032":{"id":"/changelog-1","page_id":"/changelog","type":"heading","tags":[],"url":"/changelog#breaking-changes","content":"Breaking changes"},"3033":{"id":"/changelog-2","page_id":"/changelog","type":"heading","tags":[],"url":"/changelog#deprecations","content":"Deprecations"},"3034":{"id":"/changelog-3","page_id":"/changelog","type":"heading","tags":[],"url":"/changelog#new-features","content":"New features"},"3035":{"id":"/changelog-4","page_id":"/changelog","type":"heading","tags":[],"url":"/changelog#fixed-bugs","content":"Fixed bugs"},"3036":{"id":"/changelog-5","page_id":"/changelog","type":"heading","tags":[],"url":"/changelog#0330---2025-09-03","content":"[0.33.0] - 2025-09-03"},"3037":{"id":"/changelog-6","page_id":"/changelog","type":"heading","tags":[],"url":"/changelog#release-highlights","content":"Release highlights"},"3038":{"id":"/changelog-7","page_id":"/changelog","type":"heading","tags":[],"url":"/changelog#breaking-changes-1","content":"Breaking changes"},"3039":{"id":"/changelog-8","page_id":"/changelog","type":"heading","tags":[],"url":"/changelog#deprecations-1","content":"Deprecations"},"3040":{"id":"/changelog-9","page_id":"/changelog","type":"heading","tags":[],"url":"/changelog#new-features-1","content":"New features"},"3041":{"id":"/changelog-10","page_id":"/changelog","type":"heading","tags":[],"url":"/changelog#fixed-bugs-1","content":"Fixed bugs"},"3042":{"id":"/changelog-11","page_id":"/changelog","type":"heading","tags":[],"url":"/changelog#packaging-changes","content":"Packaging changes"},"3043":{"id":"/changelog-12","page_id":"/changelog","type":"heading","tags":[],"url":"/changelog#contributors","content":"Contributors"},"3044":{"id":"/changelog-13","page_id":"/changelog","type":"heading","tags":[],"url":"/changelog#0320---2025-08-06","content":"[0.32.0] - 2025-08-06"},"3045":{"id":"/changelog-14","page_id":"/changelog","type":"heading","tags":[],"url":"/changelog#breaking-changes-2","content":"Breaking changes"},"3046":{"id":"/changelog-15","page_id":"/changelog","type":"heading","tags":[],"url":"/changelog#deprecations-2","content":"Deprecations"},"3047":{"id":"/changelog-16","page_id":"/changelog","type":"heading","tags":[],"url":"/changelog#new-features-2","content":"New features"},"3048":{"id":"/changelog-17","page_id":"/changelog","type":"heading","tags":[],"url":"/changelog#fixed-bugs-2","content":"Fixed bugs"},"3049":{"id":"/changelog-18","page_id":"/changelog","type":"heading","tags":[],"url":"/changelog#contributors-1","content":"Contributors"},"3050":{"id":"/changelog-19","page_id":"/changelog","type":"heading","tags":[],"url":"/changelog#0310---2025-07-02","content":"[0.31.0] - 2025-07-02"},"3051":{"id":"/changelog-20","page_id":"/changelog","type":"heading","tags":[],"url":"/changelog#breaking-changes-3","content":"Breaking changes"},"3052":{"id":"/changelog-21","page_id":"/changelog","type":"heading","tags":[],"url":"/changelog#deprecations-3","content":"Deprecations"},"3053":{"id":"/changelog-22","page_id":"/changelog","type":"heading","tags":[],"url":"/changelog#new-features-3","content":"New features"},"3054":{"id":"/changelog-23