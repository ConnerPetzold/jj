isttemplate-type","content":"ListTemplate type"},"2622":{"id":"/reference/templates-22","page_id":"/reference/templates","type":"heading","tags":[],"url":"/reference/templates#operation-type","content":"Operation type"},"2623":{"id":"/reference/templates-23","page_id":"/reference/templates","type":"heading","tags":[],"url":"/reference/templates#operationid-type","content":"OperationId type"},"2624":{"id":"/reference/templates-24","page_id":"/reference/templates","type":"heading","tags":[],"url":"/reference/templates#option-type","content":"Option type"},"2625":{"id":"/reference/templates-25","page_id":"/reference/templates","type":"heading","tags":[],"url":"/reference/templates#refsymbol-type","content":"RefSymbol type"},"2626":{"id":"/reference/templates-26","page_id":"/reference/templates","type":"heading","tags":[],"url":"/reference/templates#repopath-type","content":"RepoPath type"},"2627":{"id":"/reference/templates-27","page_id":"/reference/templates","type":"heading","tags":[],"url":"/reference/templates#serialize-type","content":"Serialize type"},"2628":{"id":"/reference/templates-28","page_id":"/reference/templates","type":"heading","tags":[],"url":"/reference/templates#shortestidprefix-type","content":"ShortestIdPrefix type"},"2629":{"id":"/reference/templates-29","page_id":"/reference/templates","type":"heading","tags":[],"url":"/reference/templates#signature-type","content":"Signature type"},"2630":{"id":"/reference/templates-30","page_id":"/reference/templates","type":"heading","tags":[],"url":"/reference/templates#sizehint-type","content":"SizeHint type"},"2631":{"id":"/reference/templates-31","page_id":"/reference/templates","type":"heading","tags":[],"url":"/reference/templates#string-type","content":"String type"},"2632":{"id":"/reference/templates-32","page_id":"/reference/templates","type":"heading","tags":[],"url":"/reference/templates#string-literals","content":"String literals"},"2633":{"id":"/reference/templates-33","page_id":"/reference/templates","type":"heading","tags":[],"url":"/reference/templates#stringify-type","content":"Stringify type"},"2634":{"id":"/reference/templates-34","page_id":"/reference/templates","type":"heading","tags":[],"url":"/reference/templates#stringpattern-type","content":"StringPattern type"},"2635":{"id":"/reference/templates-35","page_id":"/reference/templates","type":"heading","tags":[],"url":"/reference/templates#template-type","content":"Template type"},"2636":{"id":"/reference/templates-36","page_id":"/reference/templates","type":"heading","tags":[],"url":"/reference/templates#timestamp-type","content":"Timestamp type"},"2637":{"id":"/reference/templates-37","page_id":"/reference/templates","type":"heading","tags":[],"url":"/reference/templates#timestamprange-type","content":"TimestampRange type"},"2638":{"id":"/reference/templates-38","page_id":"/reference/templates","type":"heading","tags":[],"url":"/reference/templates#trailer-type","content":"Trailer type"},"2639":{"id":"/reference/templates-39","page_id":"/reference/templates","type":"heading","tags":[],"url":"/reference/templates#treediff-type","content":"TreeDiff type"},"2640":{"id":"/reference/templates-40","page_id":"/reference/templates","type":"heading","tags":[],"url":"/reference/templates#treediffentry-type","content":"TreeDiffEntry type"},"2641":{"id":"/reference/templates-41","page_id":"/reference/templates","type":"heading","tags":[],"url":"/reference/templates#treeentry-type","content":"TreeEntry type"},"2642":{"id":"/reference/templates-42","page_id":"/reference/templates","type":"heading","tags":[],"url":"/reference/templates#workspaceref-type","content":"WorkspaceRef type"},"2643":{"id":"/reference/templates-43","page_id":"/reference/templates","type":"heading","tags":[],"url":"/reference/templates#color-labels","content":"Color labels"},"2644":{"id":"/reference/templates-44","page_id":"/reference/templates","type":"heading","tags":[],"url":"/reference/templates#configuration","content":"Configuration"},"2645":{"id":"/reference/templates-45","page_id":"/reference/templates","type":"heading","tags":[],"url":"/reference/templates#examples","content":"Examples"},"2646":{"id":"/reference/templates-46","page_id":"/reference/templates","tags":[],"type":"text","url":"/reference/templates","content":"Jujutsu supports a functional language to customize output of commands.\nThe language consists of literals, keywords, operators, functions, and\nmethods."},"2647":{"id":"/reference/templates-47","page_id":"/reference/templates","tags":[],"type":"text","url":"/reference/templates","content":"A couple of jj commands accept a template via -T/--template option."},"2648":{"id":"/reference/templates-48","page_id":"/reference/templates","tags":[],"type":"text","url":"/reference/templates#keywords","content":"Keywords represent objects of different types; the types are described in\na follow-up section. In addition to context-specific keywords, the top-level\nobject can be referenced as self."},"2649":{"id":"/reference/templates-49","page_id":"/reference/templates","tags":[],"type":"text","url":"/reference/templates#commit-keywords","content":"In jj log templates, all 0-argument methods of the Commit\ntype are available as keywords. For example, commit_id is\nequivalent to self.commit_id()."},"2650":{"id":"/reference/templates-50","page_id":"/reference/templates","tags":[],"type":"text","url":"/reference/templates#operation-keywords","content":"In jj op log templates, all 0-argument methods of the Operation\ntype are available as keywords. For example,\ncurrent_operation is equivalent to self.current_operation()."},"2651":{"id":"/reference/templates-51","page_id":"/reference/templates","tags":[],"type":"text","url":"/reference/templates#operators","content":"The following operators are supported."},"2652":{"id":"/reference/templates-52","page_id":"/reference/templates","tags":[],"type":"text","url":"/reference/templates#operators","content":"x.f(): Method call."},"2653":{"id":"/reference/templates-53","page_id":"/reference/templates","tags":[],"type":"text","url":"/reference/templates#operators","content":"-x: Negate integer value."},"2654":{"id":"/reference/templates-54","page_id":"/reference/templates","tags":[],"type":"text","url":"/reference/templates#operators","content":"!x: Logical not."},"2655":{"id":"/reference/templates-55","page_id":"/reference/templates","tags":[],"type":"text","url":"/reference/templates#operators","content":"x * y, x / y, x % y: Multiplication/division/remainder. Operands must\nbe Integers."},"2656":{"id":"/reference/templates-56","page_id":"/reference/templates","tags":[],"type":"text","url":"/reference/templates#operators","content":"x + y, x - y: Addition/subtraction. Operands must be Integers."},"2657":{"id":"/reference/templates-57","page_id":"/reference/templates","tags":[],"type":"text","url":"/reference/templates#operators","content":"x >= y, x > y, x <= y, x < y: Greater than or equal/greater than/\nlesser than or equal/lesser than. Operands must be Integers."},"2658":{"id":"/reference/templates-58","page_id":"/reference/templates","tags":[],"type":"text","url":"/reference/templates#operators","content":"x == y, x != y: Equal/not equal. Operands must be either Boolean,\nInteger, or String."},"2659":{"id":"/reference/templates-59","page_id":"/reference/templates","tags":[],"type":"text","url":"/reference/templates#operators","content":"x && y: Logical and, short-circuiting."},"2660":{"id":"/reference/templates-60","page_id":"/reference/templates","tags":[],"type":"text","url":"/reference/templates#operators","content":"x || y: Logical or, short-circuiting."},"2661":{"id":"/reference/templates-61","page_id":"/reference/templates","tags":[],"type":"text","url":"/reference/templates#operators","content":"x ++ y: Concatenate x and y templates."},"2662":{"id":"/reference/templates-62","page_id":"/reference/templates","tags":[],"type":"text","url":"/reference/templates#operators","content":"(listed in order of binding strengths)"},"2663":{"id":"/reference/templates-63","page_id":"/reference/templates","tags":[],"type":"text","url":"/reference/templates#global-functions","content":"The following functions are defined."},"2664":{"id":"/reference/templates-64","page_id":"/reference/templates","tags":[],"type":"text","url":"/reference/templates#global-functions","content":"fill(width: Integer, content: Template) -> Template: Fill lines at\nthe given width."},"2665":{"id":"/reference/templates-65","page_id":"/reference/templates","tags":[],"type":"text","url":"/reference/templates#global-functions","content":"indent(prefix: Template, content: Template) -> Template: Indent\nnon-empty lines by the given prefix."},"2666":{"id":"/reference/templates-66","page_id":"/reference/templates","tags":[],"type":"text","url":"/reference/templates#global-functions","content":"pad_start(width: Integer, content: Template, [fill_char: Template]): Pad (or\nright-justify) content by adding leading fill characters. The content\nshouldn't have newline character."},"2667":{"id":"/reference/templates-67","page_id":"/reference/templates","tags":[],"type":"text","url":"/reference/templates#global-functions","content":"pad_end(width: Integer, content: Template, [fill_char: Template]): Pad (or\nleft-justify) content by adding trailing fill characters. The content\nshouldn't have newline character."},"2668":{"id":"/reference/templates-68","page_id":"/reference/templates","tags":[],"type":"text","url":"/reference/templates#global-functions","content":"pad_centered(width: Integer, content: Template, [fill_char: Template]): Pad\ncontent by adding both leading and trailing fill characters. If an odd number\nof fill characters are needed, the trailing fill will be one longer than the\nleading fill. The content shouldn't have newline characters."},"2669":{"id":"/reference/templates-69","page_id":"/reference/templates","tags":[],"type":"text","url":"/reference/templates#global-functions","content":"truncate_start(width: Integer, content: Template, [ellipsis: Template]):\nTruncate content by removing leading characters. The content shouldn't\nhave newline character. If ellipsis is provided and content was truncated,\nprepend the ellipsis to the result."},"2670":{"id":"/reference/templates-70","page_id":"/reference/templates","tags":[],"type":"text","url":"/reference/templates#global-functions","content":"truncate_end(width: Integer, content: Template, [ellipsis: Template]):\nTruncate content by removing trailing characters. The content shouldn't\nhave newline character. If ellipsis is provided and content was truncated,\nappend the ellipsis to the result."},"2671":{"id":"/reference/templates-71","page_id":"/reference/templates","tags":[],"type":"text","url":"/reference/templates#global-functions","content":"hash(content: Stringify) -> String:\nHash the input and return a hexadecimal string representation of the digest."},"2672":{"id":"/reference/templates-72","page_id":"/reference/templates","tags":[],"type":"text","url":"/reference/templates#global-functions","content":"label(label: Stringify, content: Template) -> Template: Apply label to\nthe content. The label is evaluated as a space-separated string."},"2673":{"id":"/reference/templates-73","page_id":"/reference/templates","tags":[],"type":"text","url":"/reference/templates#global-functions","content":"raw_escape_sequence(content: Template) -> Template: Preserves any escape\nsequences in content (i.e., bypasses sanitization) and strips labels.\nNote: This function is intended for escape sequences and as such, its output\nis expected to be invisible / of no display width. Outputting content with\nnonzero display width may break wrapping, indentation etc."},"2674":{"id":"/reference/templates-74","page_id":"/reference/templates","tags":[],"type":"text","url":"/reference/templates#global-functions","content":"stringify(content: Stringify) -> String: Format content to string. This\neffectively removes color labels."},"2675":{"id":"/reference/templates-75","page_id":"/reference/templates","tags":[],"type":"text","url":"/reference/templates#global-functions","content":"json(value: Serialize) -> String: Serialize value in JSON format."},"2676":{"id":"/reference/templates-76","page_id":"/reference/templates","tags":[],"type":"text","url":"/reference/templates#global-functions","content":"if(condition: Boolean, then: Template, [else: Template]) -> Template:\nConditionally evaluate then/else template content."},"2677":{"id":"/reference/templates-77","page_id":"/reference/templates","tags":[],"type":"text","url":"/reference/templates#global-functions","content":"coalesce(content: Template...) -> Template: Returns the first non-empty\ncontent."},"2678":{"id":"/reference/templates-78","page_id":"/reference/templates","tags":[],"type":"text","url":"/reference/templates#global-functions","content":"concat(content: Template...) -> Template:\nSame as content_1 ++ ... ++ content_n."},"2679":{"id":"/reference/templates-79","page_id":"/reference/templates","tags":[],"type":"text","url":"/reference/templates#global-functions","content":"separate(separator: Template, content: Template...) -> Template:\nInsert separator between non-empty contents."},"2680":{"id":"/reference/templates-80","page_id":"/reference/templates","tags":[],"type":"text","url":"/reference/templates#global-functions","content":"surround(prefix: Template, suffix: Template, content: Template) -> Template:\nSurround non-empty content with texts such as parentheses."},"2681":{"id":"/reference/templates-81","page_id":"/reference/templates","tags":[],"type":"text","url":"/reference/templates#global-functions","content":"config(name: String) -> ConfigValue: Look up configuration value by name."},"2682":{"id":"/reference/templates-82","page_id":"/reference/templates","tags":[],"type":"text","url":"/reference/templates#built-in-aliases","content":"hyperlink(url, text): Creates a clickable hyperlink using OSC8 escape sequences.\nThe text w