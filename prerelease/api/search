n Zweigbergk (@martinvonz)"},"4312":{"id":"/changelog-1281","page_id":"/changelog","tags":[],"type":"text","url":"/changelog#contributors-20","content":"Matt Stark (@matts1)"},"4313":{"id":"/changelog-1282","page_id":"/changelog","tags":[],"type":"text","url":"/changelog#contributors-20","content":"Michael Pratt (prattmic)"},"4314":{"id":"/changelog-1283","page_id":"/changelog","tags":[],"type":"text","url":"/changelog#contributors-20","content":"Philip Metzger (@PhilipMetzger)"},"4315":{"id":"/changelog-1284","page_id":"/changelog","tags":[],"type":"text","url":"/changelog#contributors-20","content":"Stephen Jennings (@jennings)"},"4316":{"id":"/changelog-1285","page_id":"/changelog","tags":[],"type":"text","url":"/changelog#contributors-20","content":"Valentin Gatien-Baron (@v-gb)"},"4317":{"id":"/changelog-1286","page_id":"/changelog","tags":[],"type":"text","url":"/changelog#contributors-20","content":"vwkd (@vwkd)"},"4318":{"id":"/changelog-1287","page_id":"/changelog","tags":[],"type":"text","url":"/changelog#contributors-20","content":"Yuya Nishihara (@yuja)"},"4319":{"id":"/changelog-1288","page_id":"/changelog","tags":[],"type":"text","url":"/changelog#breaking-changes-21","content":"jj git fetch no longer imports new remote branches as local branches. Set\ngit.auto-local-branch = true to restore the old behavior."},"4320":{"id":"/changelog-1289","page_id":"/changelog","tags":[],"type":"text","url":"/changelog#new-features-21","content":"Information about new and resolved conflicts is now printed by every command."},"4321":{"id":"/changelog-1290","page_id":"/changelog","tags":[],"type":"text","url":"/changelog#new-features-21","content":"jj branch has gained a new rename subcommand that allows changing a branch\nname atomically. jj branch help rename for details."},"4322":{"id":"/changelog-1291","page_id":"/changelog","tags":[],"type":"text","url":"/changelog#fixed-bugs-24","content":"Command aliases can now be loaded from repository config relative to the\ncurrent working directory.\n#2414"},"4323":{"id":"/changelog-1292","page_id":"/changelog","tags":[],"type":"text","url":"/changelog#contributors-21","content":"Thanks to the people who made this release happen!"},"4324":{"id":"/changelog-1293","page_id":"/changelog","tags":[],"type":"text","url":"/changelog#contributors-21","content":"Austin Seipp (@thoughtpolice)"},"4325":{"id":"/changelog-1294","page_id":"/changelog","tags":[],"type":"text","url":"/changelog#contributors-21","content":"Essien Ita Essien (@essiene)"},"4326":{"id":"/changelog-1295","page_id":"/changelog","tags":[],"type":"text","url":"/changelog#contributors-21","content":"Gabriel Scherer (@gasche)"},"4327":{"id":"/changelog-1296","page_id":"/changelog","tags":[],"type":"text","url":"/changelog#contributors-21","content":"Ilya Grigoriev (@ilyagr)"},"4328":{"id":"/changelog-1297","page_id":"/changelog","tags":[],"type":"text","url":"/changelog#contributors-21","content":"Martin von Zweigbergk (@martinvonz)"},"4329":{"id":"/changelog-1298","page_id":"/changelog","tags":[],"type":"text","url":"/changelog#contributors-21","content":"Philip Metzger (@PhilipMetzger)"},"4330":{"id":"/changelog-1299","page_id":"/changelog","tags":[],"type":"text","url":"/changelog#contributors-21","content":"Waleed Khan (@arxanas)"},"4331":{"id":"/changelog-1300","page_id":"/changelog","tags":[],"type":"text","url":"/changelog#contributors-21","content":"Yuya Nishihara (@yuja)"},"4332":{"id":"/changelog-1301","page_id":"/changelog","tags":[],"type":"text","url":"/changelog#breaking-changes-22","content":"The remote_branches() revset no longer includes branches exported to the Git\nrepository (so called Git-tracking branches.)"},"4333":{"id":"/changelog-1302","page_id":"/changelog","tags":[],"type":"text","url":"/changelog#breaking-changes-22","content":"jj branch set no longer creates a new branch. Use jj branch create\ninstead."},"4334":{"id":"/changelog-1303","page_id":"/changelog","tags":[],"type":"text","url":"/changelog#breaking-changes-22","content":"jj init --git in an existing Git repository now errors and exits rather than\ncreating a second Git store."},"4335":{"id":"/changelog-1304","page_id":"/changelog","tags":[],"type":"text","url":"/changelog#new-features-22","content":"jj workspace add can now take multiple --revision arguments, which will\ncreate a new workspace with its working-copy commit on top of all the parents,\nas if you had run jj new r1 r2 r3 ...."},"4336":{"id":"/changelog-1305","page_id":"/changelog","tags":[],"type":"text","url":"/changelog#new-features-22","content":"You can now set git.abandon-unreachable-commits = false to disable the\nusual behavior where commits that became unreachable in the Git repo are\nabandoned (#2504)."},"4337":{"id":"/changelog-1306","page_id":"/changelog","tags":[],"type":"text","url":"/changelog#new-features-22","content":"jj new gained a --no-edit option to prevent editing the newly created\ncommit. For example, jj new a b --no-edit -m Merge creates a merge commit\nwithout affecting the working copy."},"4338":{"id":"/changelog-1307","page_id":"/changelog","tags":[],"type":"text","url":"/changelog#new-features-22","content":"jj rebase now takes the flag --skip-empty, which doesn't copy over commits\nthat would become empty after a rebase."},"4339":{"id":"/changelog-1308","page_id":"/changelog","tags":[],"type":"text","url":"/changelog#new-features-22","content":"There is a new jj util gc command for cleaning up the repository storage.\nFor now, it simply runs git gc on the backing Git repo (when using the Git\nbackend)."},"4340":{"id":"/changelog-1309","page_id":"/changelog","tags":[],"type":"text","url":"/changelog#fixed-bugs-25","content":"Fixed another file conflict resolution issue where jj status would disagree\nwith the actual file content.\n#2654"},"4341":{"id":"/changelog-1310","page_id":"/changelog","tags":[],"type":"text","url":"/changelog#contributors-22","content":"Thanks to the people who made this release happen!"},"4342":{"id":"/changelog-1311","page_id":"/changelog","tags":[],"type":"text","url":"/changelog#contributors-22","content":"Antoine Cezar (@AntoineCezar)"},"4343":{"id":"/changelog-1312","page_id":"/changelog","tags":[],"type":"text","url":"/changelog#contributors-22","content":"Anton Bulakh (@necauqua)"},"4344":{"id":"/changelog-1313","page_id":"/changelog","tags":[],"type":"text","url":"/changelog#contributors-22","content":"Austin Seipp (@thoughtpolice)"},"4345":{"id":"/changelog-1314","page_id":"/changelog","tags":[],"type":"text","url":"/changelog#contributors-22","content":"Benjamin Saunders (@Ralith)"},"4346":{"id":"/changelog-1315","page_id":"/changelog","tags":[],"type":"text","url":"/changelog#contributors-22","content":"Carlos Precioso (@cprecioso)"},"4347":{"id":"/changelog-1316","page_id":"/changelog","tags":[],"type":"text","url":"/changelog#contributors-22","content":"Chris Krycho (@chriskrycho)"},"4348":{"id":"/changelog-1317","page_id":"/changelog","tags":[],"type":"text","url":"/changelog#contributors-22","content":"Ilya Grigoriev (@ilyagr)"},"4349":{"id":"/changelog-1318","page_id":"/changelog","tags":[],"type":"text","url":"/changelog#contributors-22","content":"Jason R. Coombs (@jaraco)"},"4350":{"id":"/changelog-1319","page_id":"/changelog","tags":[],"type":"text","url":"/changelog#contributors-22","content":"Jesse Somerville (@jessesomerville)"},"4351":{"id":"/changelog-1320","page_id":"/changelog","tags":[],"type":"text","url":"/changelog#contributors-22","content":"Łukasz Kurowski (@crackcomm)"},"4352":{"id":"/changelog-1321","page_id":"/changelog","tags":[],"type":"text","url":"/changelog#contributors-22","content":"Martin von Zweigbergk (@martinvonz)"},"4353":{"id":"/changelog-1322","page_id":"/changelog","tags":[],"type":"text","url":"/changelog#contributors-22","content":"mlcui (@mlcui-corp)"},"4354":{"id":"/changelog-1323","page_id":"/changelog","tags":[],"type":"text","url":"/changelog#contributors-22","content":"Philip Metzger (@PhilipMetzger)"},"4355":{"id":"/changelog-1324","page_id":"/changelog","tags":[],"type":"text","url":"/changelog#contributors-22","content":"Waleed Khan (@arxanas)"},"4356":{"id":"/changelog-1325","page_id":"/changelog","tags":[],"type":"text","url":"/changelog#contributors-22","content":"Yuya Nishihara (@yuja)"},"4357":{"id":"/changelog-1326","page_id":"/changelog","tags":[],"type":"text","url":"/changelog#breaking-changes-23","content":"Conflicts are now stored in a different way. Commits written by a new jj\nbinary will not be read correctly by older jj binaries. The new model\nsolves some performance problems with the old model. For example, jj log\nshould be noticeably faster on large repos. You may need to create a new\nclone to see the full speedup."},"4358":{"id":"/changelog-1327","page_id":"/changelog","tags":[],"type":"text","url":"/changelog#breaking-changes-23","content":"The remote_branches() revset now includes branches exported to the Git\nrepository (so called Git-tracking branches.) This change will be reverted\nin 0.12.0."},"4359":{"id":"/changelog-1328","page_id":"/changelog","tags":[],"type":"text","url":"/changelog#breaking-changes-23","content":"Status messages are now printed to stderr."},"4360":{"id":"/changelog-1329","page_id":"/changelog","tags":[],"type":"text","url":"/changelog#breaking-changes-23","content":"jj config set now interprets the value as TOML also if it's a valid TOML\narray or table. For example, jj config set --user 'aliases.n' '[\"new\"]'"},"4361":{"id":"/changelog-1330","page_id":"/changelog","tags":[],"type":"text","url":"/changelog#breaking-changes-23","content":"Remote branches now have tracking or non-tracking flags. The\ngit.auto-local-branch setting is applied only to newly fetched remote\nbranches. Existing remote branches are migrated as follows:"},"4362":{"id":"/changelog-1331","page_id":"/changelog","tags":[],"type":"text","url":"/changelog#breaking-changes-23","content":"If local branch exists, the corresponding remote branches are considered\ntracking branches."},"4363":{"id":"/changelog-1332","page_id":"/changelog","tags":[],"type":"text","url":"/changelog#breaking-changes-23","content":"Otherwise, the remote branches are non-tracking branches."},"4364":{"id":"/changelog-1333","page_id":"/changelog","tags":[],"type":"text","url":"/changelog#breaking-changes-23","content":"If the deduced tracking flags are wrong, use jj branch track/untrack\ncommands to fix them up."},"4365":{"id":"/changelog-1334","page_id":"/changelog","tags":[],"type":"text","url":"/changelog#breaking-changes-23","content":"See automatic local branch creation\nfor details."},"4366":{"id":"/changelog-1335","page_id":"/changelog","tags":[],"type":"text","url":"/changelog#breaking-changes-23","content":"Non-tracking remote branches aren't listed by default. Use jj branch list\n--all to show all local and remote branches."},"4367":{"id":"/changelog-1336","page_id":"/changelog","tags":[],"type":"text","url":"/changelog#breaking-changes-23","content":"It's not allowed to push branches if non-tracking remote branches of the same\nname exist."},"4368":{"id":"/changelog-1337","page_id":"/changelog","tags":[],"type":"text","url":"/changelog#breaking-changes-23","content":"Pushing deleted/moved branches no longer abandons the local commits referenced\nby the remote branches."},"4369":{"id":"/changelog-1338","page_id":"/changelog","tags":[],"type":"text","url":"/changelog#breaking-changes-23","content":"jj git fetch --branch now requires glob: prefix to expand * in branch\nname."},"4370":{"id":"/changelog-1339","page_id":"/changelog","tags":[],"type":"text","url":"/changelog#new-features-23","content":"jj's stable release can now be installed\nwith cargo binstall jj-cli."},"4371":{"id":"/changelog-1340","page_id":"/changelog","tags":[],"type":"text","url":"/changelog#new-features-23","content":"jj workspace add now takes a --revision argument."},"4372":{"id":"/changelog-1341","page_id":"/changelog","tags":[],"type":"text","url":"/changelog#new-features-23","content":"jj workspace forget can now forget multiple workspaces at once."},"4373":{"id":"/changelog-1342","page_id":"/changelog","tags":[],"type":"text","url":"/changelog#new-features-23","content":"branches()/remote_branches()/author()/committer()/description()\nrevsets now support glob matching."},"4374":{"id":"/changelog-1343","page_id":"/changelog","tags":[],"type":"text","url":"/changelog#new-features-23","content":"jj branch delete/forget/list, and jj git push --branch now support\nstring pattern syntax. The --glob option\nis deprecated in favor of glob: pattern."},"4375":{"id":"/changelog-1344","page_id":"/changelog","tags":[],"type":"text","url":"/changelog#new-features-23","content":"The branches/tags/git_refs/git_head template keywords now return a\nlist of RefNames. They were previously pre-formatted strings."},"4376":{"id":"/changelog-1345","page_id":"/changelog","tags":[],"type":"text","url":"/changelog#new-features-23","content":"The new template keywords local_branches/remote_branches are added to show\nonly local/remote branches."},"4377":{"id":"/changelog-1346","page_id":"/changelog","tags":[],"type":"text","url":"/changelog#new-features-23","content":"jj workspace add now preserves all parents of the old working-copy commit\ninstead of just the first one."},"4378":{"id":"/changelog-1347","page_id":"/changelog","tags":[],"type":"text","url":"/changelog#new-features-23","content":"jj rebase -r gained the ability to rebase a revision A onto a descendant\nof A."},"4379":{"id":"/changelog-1348","page_id":"/changelog","tags":[],"type":"text","url":"/changelog#fixed-bugs-26","content":"Updating the working copy to a commit where a file that's currently ignored\nin the working copy no longer leads to a crash\n(#976)."},"4380":{"id":"/changelog-1349","page_id":"/changelog","tags":[],"type":"text","url":"/changelog#fixed-bugs-26","content":"Conflicts in executable files can now be resolved just like conflicts in\nnon-executable files (#1279)."},"4381":{"id":"/changelog-1350","page_id":"/changelog","tags":[],"type":"text","url":"/changelog#fixed-bugs-26","content":"jj new --insert-before and --insert-after now respect immutable revisions\n(#2468)."},"4382":{"id":"/changelog-1351","page_id":"/changelog","tags":[],"type":"text","url":"/changelog#contributors-23","content":"Thanks to the people who made this release happen!"},"4383":{"id":"/changelog-1352","page_id":"/changelog","tags":[],"type":"text","url":"/changelog#contributors-23","content":"Antoine Cezar (@AntoineCezar)"},"4384":{"id":"/changelog-1353","page_id":"/changelog","tags":[],"type":"text","url":"/changelog#contributors-23","content":"Austin Seipp (@thoughtpolice)"},"4385":{"id":"/changelog-1354","page_id":"/changelog","tags":[],"type":"text","url":"/changelog#contributors-23","content":"Benjamin Saunders (@Ralith)"},"4386":{"id":"/changelog-1355","page_id":"/changelog","tags":[],"type":"text","url":"/changelog#contributors-23","content":"Gabriel Scherer (@gasche)"},"4387":{"id":"/changelog-1356","page_id":"/changelog","tags":[],"type":"text","url":"/changelog#contributors-23","content":"Ilya Grigoriev (@ilyagr)"},"4388":{"id":"/changelog-1357","page_id":"/changelog","tags":[],"type":"text","url":"/changelog#contributors-23","content":"Infra (@1011X)"},"4389":{"id":"/changelog-1358","page_id":"/changelog","tags":[],"type":"text","url":"/changelog#contributors-23","content":"Isabella Basso (@isinyaaa)"},"4390":{"id":"/changelog-1359","page_id":"/changelog","tags":[],"type":"text","url":"/changelog#contributors-23","content":"Martin von Zweigbergk (@martinvonz)"},"4391":{"id":"/changelog-1360","page_id":"/changelog","tags":[],"type":"text","url":"/changelog#contributors-23","content":"Tal Pressman (@talpr)"},"4392":{"id":"/changelog-1361","page_id":"/changelog","tags":[],"type":"text","url":"/changelog#contributors-23","content":"Waleed Khan (@arxanas)"},"4393":{"id":"/changelog-1362","page_id":"/changelog","tags":[],"type":"text","url":"/changelog#contributors-23","content":"Yuya Nishihara (@yuja)"},"4394":{"id":"/changelog-1363","page_id":"/changelog","tags":[],"type":"text","url":"/changelog#breaking-changes-24","content":"A default revset-alias function trunk() now exists. If you previously\ndefined\nyour own trunk() alias it will continue to overwrite the built-in one.\nCheck revsets.toml\nand revsets.md\nto understand how the function can be adapted."},"4395":{"id":"/changelog-1364","page_id":"/changelog","tags":[],"type":"text","url":"/changelog#new-features-24","content":"The ancestors() revset function now takes an optional depth argument\nto limit the depth of the ancestor set. For example, use jj log -r\n'ancestors(@, 5) to view the last 5 commits."},"4396":{"id":"/changelog-1365","page_id":"/changelog","tags":[],"type":"text","url":"/changelog#new-features-24","content":"Support for the Watchman filesystem monitor is now bundled by default. Set\ncore.fsmonitor = \"watchman\" in your repo to enable."},"4397":{"id":"/changelog-1366","page_id":"/changelog","tags":[],"type":"text","url":"/changelog#new-features-24","content":"You can now configure the set of immutable commits via\nrevset-aliases.immutable_heads(). For example, set it to\n\"remote_branches() | tags()\" to prevent rewriting those those. Their\nancestors are implicitly also immutable."},"4398":{"id":"/changelog-1367","page_id":"/changelog","tags":[],"type":"text","url":"/changelog#new-features-24","content":"jj op log now supports --no-graph."},"4399":{"id":"/changelog-1368","page_id":"/changelog","tags":[],"type":"text","url":"/changelog#new-features-24","content":"Templates now support an additional escape: \\0. This will output a literal\nnull byte. This may be useful for e.g.\njj log -T 'description ++ \"\\0\"' --no-graph to output descriptions only, but\nbe able to tell where the boundaries are"},"4400":{"id":"/changelog-1369","page_id":"/changelog","tags":[],"type":"text","url":"/changelog#new-features-24","content":"jj now bundles a TUI tool to use as the default diff and merge editors. (The\nprevious default was meld.)"},"4401":{"id":"/changelog-1370","page_id":"/changelog","tags":[],"type":"text","url":"/changelog#new-features-24","content":"jj split supports the --interactive flag. (This is already the default if\nno paths are provided.)"},"4402":{"id":"/changelog-1371","page_id":"/changelog","tags":[],"type":"text","url":"/changelog#new-features-24","content":"jj commit accepts an optional list of paths indicating a subset of files to\ninclude in the first commit"},"4403":{"id":"/changelog-1372","page_id":"/changelog","tags":[],"type":"text","url":"/changelog#new-features-24","content":"jj commit accepts the --interactive flag."},"4404":{"id":"/changelog-1373","page_id":"/changelog","tags":[],"type":"text","url":"/changelog#contributors-24","content":"Thanks to the people who made this release happen!"},"4405":{"id":"/changelog-1374","page_id":"/changelog","tags":[],"type":"text","url":"/changelog#contributors-24","content":"Austin Seipp (@thoughtpolice)"},"4406":{"id":"/changelog-1375","page_id":"/changelog","tags":[],"type":"text","url":"/changelog#contributors-24","content":"Emily Kyle Fox (@emilykfox)"},"4407":{"id":"/changelog-1376","page_id":"/changelog","tags":[],"type":"text","url":"/changelog#contributors-24","content":"glencbz (@glencbz)"},"4408":{"id":"/changelog-1377","page_id":"/changelog","tags":[],"type":"text","url":"/changelog#contributors-24","content":"Hong Shin (@honglooker)"},"4409":{"id":"/changelog-1378","page_id":"/changelog","tags":[],"type":"text","url":"/changelog#contributors-24","content":"Ilya Grigoriev (@ilyagr)"},"4410":{"id":"/changelog-1379","page_id":"/changelog","tags":[],"type":"text","url":"/changelog#contributors-24","content":"James Sully (@sullyj3)"},"4411":{"id":"/changelog-1380","page_id":"/changelog","tags":[],"type":"text","url":"/changelog#contributors-24","content":"Martin von Zweigbergk (@martinvonz)"},"4412":{"id":"/changelog-1381","page_id":"/changelog","tags":[],"type":"text","url":"/changelog#contributors-24","content":"Philip Metzger (@PhilipMetzger)"},"4413":{"id":"/changelog-1382","page_id":"/changelog","tags":[],"type":"text","url":"/changelog#contributors-24","content":"Ruben Slabbert (@rslabbert)"},"4414":{"id":"/changelog-1383","page_id":"/changelog","tags":[],"type":"text","url":"/changelog#contributors-24","content":"Vamsi Avula (@avamsi)"},"4415":{"id":"/changelog-1384","page_id":"/changelog","tags":[],"type":"text","url":"/changelog#contributors-24","content":"Waleed Khan (@arxanas)"},"4416":{"id":"/changelog-1385","page_id":"/changelog","tags":[],"type":"text","url":"/changelog#contributors-24","content":"Willian Mori (@wmrmrx))"},"4417":{"id":"/changelog-1386","page_id":"/changelog","tags":[],"type":"text","url":"/changelog#contributors-24","content":"Yuya Nishihara (@yuja)"},"4418":{"id":"/changelog-1387","page_id":"/changelog","tags":[],"type":"text","url":"/changelog#contributors-24","content":"Zachary Dremann (@Dr-Emann)"},"4419":{"id":"/changelog-1388","page_id":"/changelog","tags":[],"type":"text","url":"/changelog#breaking-changes-25","content":"The minimum supported Rust version (MSRV) is now 1.71.0."},"4420":{"id":"/changelog-1389","page_id":"/changelog","tags":[],"type":"text","url":"/changelog#breaking-changes-25","content":"The storage format of branches, tags, and git refs has changed. Newly-stored\nrepository data will no longer be loadable by older binaries."},"4421":{"id":"/changelog-1390","page_id":"/changelog","tags":[],"type":"text","url":"/changelog#breaking-changes-25","content":"The : revset operator is deprecated. Use :: instead. We plan to delete the\n: form in jj 0.15+."},"4422":{"id":"/changelog-1391","page_id":"/changelog","tags":[],"type":"text","url":"/changelog#breaking-changes-25","content":"The --allow-large-revsets flag for jj rebase and jj new was replaced by\na all: before the revset. For example, use jj rebase -d 'all:foo-'\ninstead of jj rebase --allow-large-revsets -d 'foo-'."},"4423":{"id":"/changelog-1392","page_id":"/changelog","tags":[],"type":"text","url":"/changelog#breaking-changes-25","content":"The --allow-large-revsets flag for jj rebase and jj new can no longer be\nused for allowing duplicate destinations. Include the potential duplicates\nin a single expression instead (e.g. jj new 'all:x|y')."},"4424":{"id":"/changelog-1393","page_id":"/changelog","tags":[],"type":"text","url":"/changelog#breaking-changes-25","content":"The push.branch-prefix option was renamed to git.push-branch-prefix."},"4425":{"id":"/changelog-1394","page_id":"/changelog","tags":[],"type":"text","url":"/changelog#breaking-changes-25","content":"The default editor on Windows is now Notepad instead of pico."},"4426":{"id":"/changelog-1395","page_id":"/changelog","tags":[],"type":"text","url":"/changelog#breaking-changes-25","content":"jj will fail attempts to snapshot new files larger than 1MiB by default.\nThis behavior\ncan be customized with the snapshot.max-new-file-size config option."},"4427":{"id":"/changelog-1396","page_id":"/changelog","tags":[],"type":"text","url":"/changelog#breaking-changes-25","content":"Author and committer signatures now use empty strings to represent unset\nnames and email addresses. The author/committer template keywords and\nmethods also return empty strings.\nOlder binaries may not warn user when attempting to git push commits\nwith such signatures."},"4428":{"id":"/changelog-1397","page_id":"/changelog","tags":[],"type":"text","url":"/changelog#breaking-changes-25","content":"In revsets, the working-copy or remote symbols (such as @, workspace_id@,\nand branch@remote) can no longer be quoted as a unit. If a workspace or\nbranch name contains whitespace, quote the name like \"branch name\"@remote.\nAlso, these symbols will not be resolved as revset aliases or function\nparameters. For example, author(foo@) is now an error, and the revset alias\n'revset-aliases.foo@' = '@' will be failed to parse."},"4429":{"id":"/changelog-1398","page_id":"/changelog","tags":[],"type":"text","url":"/changelog#breaking-changes-25","content":"The root revset symbol has been converted to function root()."},"4430":{"id":"/changelog-1399","page_id":"/changelog","tags":[],"type":"text","url":"/changelog#breaking-changes-25","content":"The ..x revset is now evaluated to root()..x, which means the root commit\nis no longer included."},"4431":{"id":"/changelog-1400","page_id":"/changelog","tags":[],"type":"text","url":"/changelog#breaking-changes-25","content":"jj git push will now push all branches in the range remote_branches()..@\ninstead of only branches pointing to @ or @-."},"4432":{"id":"/changelog-1401","page_id":"/changelog","tags":[],"type":"text","url":"/changelog#breaking-changes-25","content":"It's no longer allowed to create a Git remote named \"git\". Use jj git remote\nrename to rename the existing remote.\n#1690"},"4433":{"id":"/changelog-1402","page_id":"/changelog","tags":[],"type":"text","url":"/changelog#breaking-changes-25","content":"Revset expression like origin/main will no longer resolve to a\nremote-tracking branch. Use main@origin instead."},"4434":{"id":"/changelog-1403","page_id":"/changelog","tags":[],"type":"text","url":"/changelog#new-features-25","content":"Default template for jj log now does not show irrelevant information\n(timestamp, empty, message placeholder etc.) about the root commit."},"4435":{"id":"/changelog-1404","page_id":"/changelog","tags":[],"type":"text","url":"/changelog#new-features-25","content":"Commit templates now support the root keyword, which is true for the root\ncommit and false for every other commit."},"4436":{"id":"/changelog-1405","page_id":"/changelog","tags":[],"type":"text","url":"/changelog#new-features-25","content":"jj init --git-repo now works with bare repositories."},"4437":{"id":"/changelog-1406","page_id":"/changelog","tags":[],"type":"text","url":"/changelog#new-features-25","content":"jj config edit --user and jj config set --user will now pick a default\nconfig location if no existing file is found, potentially creating parent\ndirectories."},"4438":{"id":"/changelog-1407","page_id":"/changelog","tags":[],"type":"text","url":"/changelog#new-features-25","content":"jj log output is now topologically grouped.\n#242"},"4439":{"id":"/changelog-1408","page_id":"/changelog","tags":[],"type":"text","url":"/changelog#new-features-25","content":"jj git clone now supports the --colocate flag to create the git repo\nin the same directory as the jj repo."},"4440":{"id":"/changelog-1409","page_id":"/changelog","tags":[],"type":"text","url":"/changelog#new-features-25","content":"jj restore gained a new option --changes-in to restore files\nfrom a merge revision's parents. This undoes the changes that jj diff -r\nwould show."},"4441":{"id":"/changelog-1410","page_id":"/changelog","tags":[],"type":"text","url":"/changelog#new-features-25","content":"jj diff/log now supports --tool <name> option to generate diffs by\nexternal program. For configuration, see the documentation.\n#1886"},"4442":{"id":"/changelog-1411","page_id":"/changelog","tags":[],"type":"text","url":"/changelog#new-features-25","content":"A new experimental diff editor meld-3 is introduced that sets up Meld to\nallow you to see both sides of the original diff while editing. This can be\nused with jj split, jj move -i, etc."},"4443":{"id":"/changelog-1412","page_id":"/changelog","tags":[],"type":"text","url":"/changelog#new-features-25","content":"jj log/obslog/op log now supports --limit N option to show the first\nN entries."},"4444":{"id":"/changelog-1413","page_id":"/changelog","tags":[],"type":"text","url":"/changelog#new-features-25","content":"Added the ui.paginate option to enable/disable pager usage in commands"},"4445":{"id":"/changelog-1414","page_id":"/changelog","tags":[],"type":"text","url":"/changelog#new-features-25","content":"jj checkout/jj describe/jj commit/jj new/jj squash can take repeated\n-m/--message arguments. Each passed message will be combined into paragraphs\n(separated by a blank line)"},"4446":{"id":"/changelog-1415","page_id":"/changelog","tags":[],"type":"text","url":"/changelog#new-features-25","content":"It is now possible to set a default description using the new\nui.default-description option, to use when describing changes with an empty\ndescription."},"4447":{"id":"/changelog-1416","page_id":"/changelog","tags":[],"type":"text","url":"/changelog#new-features-25","content":"jj split will now leave the description empty on the second part if the\ndescription was empty on the input commit."},"4448":{"id":"/changelog-1417","page_id":"/changelog","tags":[],"type":"text","url":"/changelog#new-features-25","content":"branches()/remote_branches()/author()/committer()/description()\nrevsets now support exact matching. For example, branch(exact:main)\nselects the branch named \"main\", but not \"maint\". description(exact:\"\")\nselects commits whose description is empty."},"4449":{"id":"/changelog-1418","page_id":"/changelog","tags":[],"type":"text","url":"/changelog#new-features-25","content":"Revsets gained a new function mine() that\naliases author(exact:\"your_email\")."},"4450":{"id":"/changelog-1419","page_id":"/changelog","tags":[],"type":"text","url":"/changelog#new-features-25","content":"Added support for :: and .. revset operators with both left and right\noperands omitted. These expressions are equivalent to all() and ~root()\nrespectively."},"4451":{"id":"/changelog-1420","page_id":"/changelog","tags":[],"type":"text","url":"/changelog#new-features-25","content":"jj log timestamp format now accepts .utc() to convert a timestamp to UTC."},"4452":{"id":"/changelog-1421","page_id":"/changelog","tags":[],"type":"text","url":"/changelog#new-features-25","content":"templates now support additional string\nmethods .starts_with(x), .ends_with(x)\n.remove_prefix(x), .remove_suffix(x), and .substr(start, end)."},"4453":{"id":"/changelog-1422","page_id":"/changelog","tags":[],"type":"text","url":"/changelog#new-features-25","content":"jj next and jj prev are added, these allow you to traverse the history\nin a linear style. For people coming from Sapling and git-branchles\nsee #2126 for\nfurther pending improvements."},"4454":{"id":"/changelog-1423","page_id":"/changelog","tags":[],"type":"text","url":"/changelog#new-features-25","content":"jj diff --stat has been implemented. It shows a histogram of the changes,\nsame as git diff --stat.\nFixes #2066"},"4455":{"id":"/changelog-1424","page_id":"/changelog","tags":[],"type":"text","url":"/changelog#new-features-25","content":"jj git fetch --all-remotes has been implemented. It fetches all remotes\ninstead of just the default remote"},"4456":{"id":"/changelog-1425","page_id":"/changelog","tags":[],"type":"text","url":"/changelog#fixed-bugs-28","content":"Fix issues related to .gitignore handling of untracked directories\n#2051."},"4457":{"id":"/changelog-1426","page_id":"/changelog","tags":[],"type":"text","url":"/changelog#fixed-bugs-28","content":"jj config set --user and jj config edit --user can now be used outside of\nany repository."},"4458":{"id":"/changelog-1427","page_id":"/changelog","tags":[],"type":"text","url":"/changelog#fixed-bugs-28","content":"SSH authentication could hang when ssh-agent couldn't be reached\n#1970"},"4459":{"id":"/changelog-1428","page_id":"/changelog","tags":[],"type":"text","url":"/changelog#fixed-bugs-28","content":"SSH authentication can now use ed25519 and ed25519-sk keys. They still need\nto be password-less."},"4460":{"id":"/changelog-1429","page_id":"/changelog","tags":[],"type":"text","url":"/changelog#fixed-bugs-28","content":"Git repository managed by the repo tool can now be detected as a \"colocated\"\nrepository.\n#2011"},"4461":{"id":"/changelog-1430","page_id":"/changelog","tags":[],"type":"text","url":"/changelog#contributors-25","content":"Thanks to the people who made this release happen!"},"4462":{"id":"/changelog-1431","page_id":"/changelog","tags":[],"type":"text","url":"/changelog#contributors-25","content":"Alexander Potashev (@aspotashev)"},"4463":{"id":"/changelog-1432","page_id":"/changelog","tags":[],"type":"text","url":"/changelog#contributors-25","content":"Anton Bulakh (@necauqua)"},"4464":{"id":"/changelog-1433","page_id":"/changelog","tags":[],"type":"text","url":"/changelog#contributors-25","content":"Austin Seipp (@thoughtpolice)"},"4465":{"id":"/changelog-1434","page_id":"/changelog","tags":[],"type":"text","url":"/changelog#contributors-25","content":"Benjamin Brittain (@benbrittain)"},"4466":{"id":"/changelog-1435","page_id":"/changelog","tags":[],"type":"text","url":"/changelog#contributors-25","content":"Benjamin Saunders (@Ralith)"},"4467":{"id":"/changelog-1436","page_id":"/changelog","tags":[],"type":"text","url":"/changelog#contributors-25","content":"Christophe Poucet (@poucet)"},"4468":{"id":"/changelog-1437","page_id":"/changelog","tags":[],"type":"text","url":"/changelog#contributors-25","content":"Emily Kyle Fox (@emilykfox)"},"4469":{"id":"/changelog-1438","page_id":"/changelog","tags":[],"type":"text","url":"/changelog#contributors-25","content":"Glen Choo (@chooglen)"},"4470":{"id":"/changelog-1439","page_id":"/changelog","tags":[],"type":"text","url":"/changelog#contributors-25","content":"Ilya Grigoriev (@ilyagr)"},"4471":{"id":"/changelog-1440","page_id":"/changelog","tags":[],"type":"text","url":"/changelog#contributors-25","content":"Kevin Liao (@kevincliao)"},"4472":{"id":"/changelog-1441","page_id":"/changelog","tags":[],"type":"text","url":"/changelog#contributors-25","content":"Linus Arver (@listx)"},"4473":{"id":"/changelog-1442","page_id":"/changelog","tags":[],"type":"text","url":"/changelog#contributors-25","content":"Martin Clausen (@maacl)"},"4474":{"id":"/changelog-1443","page_id":"/changelog","tags":[],"type":"text","url":"/changelog#contributors-25","content":"Martin von Zweigbergk (@martinvonz)"},"4475":{"id":"/changelog-1444","page_id":"/changelog","tags":[],"type":"text","url":"/changelog#contributors-25","content":"Matt Freitas-Stavola (@mbStavola)"},"4476":{"id":"/changelog-1445","page_id":"/changelog","tags":[],"type":"text","url":"/changelog#contributors-25","content":"Oscar Bonilla (@ob)"},"4477":{"id":"/changelog-1446","page_id":"/changelog","tags":[],"type":"text","url":"/changelog#contributors-25","content":"Philip Metzger (@PhilipMetzger)"},"4478":{"id":"/changelog-1447","page_id":"/changelog","tags":[],"type":"text","url":"/changelog#contributors-25","content":"Piotr Kufel (@qfel)"},"4479":{"id":"/changelog-1448","page_id":"/changelog","tags":[],"type":"text","url":"/changelog#contributors-25","content":"Preston Van Loon (@prestonvanloon)"},"4480":{"id":"/changelog-1449","page_id":"/changelog","tags":[],"type":"text","url":"/changelog#contributors-25","content":"Tal Pressman (@talpr)"},"4481":{"id":"/changelog-1450","page_id":"/changelog","tags":[],"type":"text","url":"/changelog#contributors-25","content":"Vamsi Avula (@avamsi)"},"4482":{"id":"/changelog-1451","page_id":"/changelog","tags":[],"type":"text","url":"/changelog#contributors-25","content":"Vincent Breitmoser (@Valodim)"},"4483":{"id":"/changelog-1452","page_id":"/changelog","tags":[],"type":"text","url":"/changelog#contributors-25","content":"Vladimir (@0xdeafbeef)"},"4484":{"id":"/changelog-1453","page_id":"/changelog","tags":[],"type":"text","url":"/changelog#contributors-25","content":"Waleed Khan (@arxanas)"},"4485":{"id":"/changelog-1454","page_id":"/changelog","tags":[],"type":"text","url":"/changelog#contributors-25","content":"Yuya Nishihara (@yuja)"},"4486":{"id":"/changelog-1455","page_id":"/changelog","tags":[],"type":"text","url":"/changelog#contributors-25","content":"Zachary Dremann (@Dr-Emann)"},"4487":{"id":"/changelog-1456","page_id":"/changelog","tags":[],"type":"text","url":"/changelog#breaking-changes-26","content":"The jujutsu and jujutsu-lib crates were renamed to jj-cli and jj-lib,\nrespectively."},"4488":{"id":"/changelog-1457","page_id":"/changelog","tags":[],"type":"text","url":"/changelog#breaking-changes-26","content":"The ui.oplog-relative-timestamps option has been removed. Use the\nformat_time_range() template alias instead. For details, see\nthe documentation."},"4489":{"id":"/changelog-1458","page_id":"/changelog","tags":[],"type":"text","url":"/changelog#breaking-changes-26","content":"Implicit concatenation of template expressions has been disabled. Use\n++ operator, concat(), or separate() function instead.\nExample: description ++ \"\\n\""},"4490":{"id":"/changelog-1459","page_id":"/changelog","tags":[],"type":"text","url":"/changelog#breaking-changes-26","content":"jj git push will consider pushing the parent commit only when the\ncurrent commit has no content and no description, such as right after\na jj squash."},"4491":{"id":"/changelog-1460","page_id":"/changelog","tags":[],"type":"text","url":"/changelog#breaking-changes-26","content":"The minimum supported Rust version (MSRV) is now 1.64.0."},"4492":{"id":"/changelog-1461","page_id":"/changelog","tags":[],"type":"text","url":"/changelog#breaking-changes-26","content":"The heads() revset function was split up into two functions. heads()\nwithout arguments is now called visible_heads(). heads() with one argument\nis unchanged."},"4493":{"id":"/changelog-1462","page_id":"/changelog","tags":[],"type":"text","url":"/changelog#breaking-changes-26","content":"The ui.default-revset config was renamed to revsets.log."},"4494":{"id":"/changelog-1463","page_id":"/changelog","tags":[],"type":"text","url":"/changelog#breaking-changes-26","content":"The jj sparse command was split up into jj sparse list and\njj sparse set."},"4495":{"id":"/changelog-1464","page_id":"/changelog","tags":[],"type":"text","url":"/changelog#breaking-changes-26","content":"jj hide (alias for jj abandon) is no longer available. Use jj abandon\ninstead."},"4496":{"id":"/changelog-1465","page_id":"/changelog","tags":[],"type":"text","url":"/changelog#breaking-changes-26","content":"jj debug completion, jj debug mangen and jj debug config-schema have\nbeen moved from jj debug to jj util."},"4497":{"id":"/changelog-1466","page_id":"/changelog","tags":[],"type":"text","url":"/changelog#breaking-changes-26","content":"jj will no longer parse br as a git_ref refs/heads/br when a branch br\ndoes not exist but the git_ref does (this is rare). Use br@git instead."},"4498":{"id":"/changelog-1467","page_id":"/changelog","tags":[],"type":"text","url":"/changelog#breaking-changes-26","content":"jj git fetch will no longer import unrelated branches from the underlying\nGit repo."},"4499":{"id":"/changelog-1468","page_id":"/changelog","tags":[],"type":"text","url":"/changelog#new-features-26","content":"jj git push --deleted will remove all locally deleted branches from the\nremote."},"4500":{"id":"/changelog-1469","page_id":"/changelog","tags":[],"type":"text","url":"/changelog#new-features-26","content":"jj restore without --from works correctly even if @ is a merge\ncommit."},"4501":{"id":"/changelog-1470","page_id":"/changelog","tags":[],"type":"text","url":"/changelog#new-features-26","content":"jj rebase now accepts multiple -s and -b arguments. Revsets with\nmultiple commits are allowed with --allow-large-revsets."},"4502":{"id":"/changelog-1471","page_id":"/changelog","tags":[],"type":"text","url":"/changelog#new-features-26","content":"jj git fetch now supports a --branch argument to fetch some of the\nbranches only."},"4503":{"id":"/changelog-1472","page_id":"/changelog","tags":[],"type":"text","url":"/changelog#new-features-26","content":"jj config get command allows retrieving config values for use in scripting."},"4504":{"id":"/changelog-1473","page_id":"/changelog","tags":[],"type":"text","url":"/changelog#new-features-26","content":"jj config set command allows simple config edits like\njj config set --repo user.email \"somebody@example.com\""},"4505":{"id":"/changelog-1474","page_id":"/changelog","tags":[],"type":"text","url":"/changelog#new-features-26","content":"Added ui.log-word-wrap option to wrap jj log/obslog/op log content\nbased on terminal width. #1043"},"4506":{"id":"/changelog-1475","page_id":"/changelog","tags":[],"type":"text","url":"/changelog#new-features-26","content":"Nodes in the (text-based) graphical log output now use a ◉ symbol instead\nof the letter o. The ASCII-based graph styles still use o."},"4507":{"id":"/changelog-1476","page_id":"/changelog","tags":[],"type":"text","url":"/changelog#new-features-26","content":"Commands that accept a diff format (jj diff, jj interdiff, jj show,\njj log, and jj obslog) now accept --types to show only the type of file\nbefore and after."},"4508":{"id":"/changelog-1477","page_id":"/changelog","tags":[],"type":"text","url":"/changelog#new-features-26","content":"jj describe now supports --reset-author for resetting a commit's author\nto the configured user. jj describe also gained a --no-edit option to\navoid opening the editor."},"4509":{"id":"/changelog-1478","page_id":"/changelog","tags":[],"type":"text","url":"/changelog#new-features-26","content":"Added latest(x[, n]) revset function to select the latest n commits."},"4510":{"id":"/changelog-1479","page_id":"/changelog","tags":[],"type":"text","url":"/changelog#new-features-26","content":"Added conflict() revset function to select commits with conflicts."},"4511":{"id":"/changelog-1480","page_id":"/changelog","tags":[],"type":"text","url":"/changelog#new-features-26","content":"jj squash AKA jj amend now accepts a --message option to set the\ndescription of the squashed commit on the command-line."},"4512":{"id":"/changelog-1481","page_id":"/changelog","tags":[],"type":"text","url":"/changelog#new-features-26","content":"The progress display on jj git clone/fetch now includes the downloaded size."},"4513":{"id":"/changelog-1482","page_id":"/changelog","tags":[],"type":"text","url":"/changelog#new-features-26","content":"The formatter now supports a \"default\" color that can override another color\ndefined by a parent style."},"4514":{"id":"/changelog-1483","page_id":"/changelog","tags":[],"type":"text","url":"/changelog#new-features-26","content":"jj obslog and jj log now show abandoned commits as hidden."},"4515":{"id":"/changelog-1484","page_id":"/changelog","tags":[],"type":"text","url":"/changelog#new-features-26","content":"jj git fetch and jj git push will now use the single defined remote even\nif it is not named \"origin\"."},"4516":{"id":"/changelog-1485","page_id":"/changelog","tags":[],"type":"text","url":"/changelog#new-features-26","content":"jj git push now accepts --branch and --change arguments together."},"4517":{"id":"/changelog-1486","page_id":"/changelog","tags":[],"type":"text","url":"/changelog#new-features-26","content":"jj git push now accepts a -r/--revisions flag to specify revisions to\npush. All branches pointing to any of the specified revisions will be pushed.\nThe flag can be used together with --branch and --change."},"4518":{"id":"/changelog-1487","page_id":"/changelog","tags":[],"type":"text","url":"/changelog#new-features-26","content":"jj with no subcommand now defaults to jj log instead of showing help. This\ncommand can be overridden by setting ui.default-command."},"4519":{"id":"/changelog-1488","page_id":"/changelog","tags":[],"type":"text","url":"/changelog#new-features-26","content":"Description tempfiles created via jj describe now have the file extension\n.jjdescription to help external tooling detect a unique filetype."},"4520":{"id":"/changelog-1489","page_id":"/changelog","tags":[],"type":"text","url":"/changelog#new-features-26","content":"The shortest unique change ID prefixes and commit ID prefixes in jj log are\nnow shorter within the default log revset. You can override the default by\nsetting the revsets.short-prefixes config to a different revset."},"4521":{"id":"/changelog-1490","page_id":"/changelog","tags":[],"type":"text","url":"/changelog#new-features-26","content":"The last seen state of branches in the underlying git repo is now presented by\njj branch list/jj log as a remote called git (e.g. main@git). They can\nalso be referenced in revsets. Such branches exist in colocated repos or if\nyou use jj git export."},"4522":{"id":"/changelog-1491","page_id":"/changelog","tags":[],"type":"text","url":"/changelog#new-features-26","content":"The new jj chmod command allows setting or removing the executable bit on\npaths. Unlike the POSIX chmod, it works on Windows, on conflicted files, and\non arbitrary revisions. Bits other than the executable bit are not planned to\nbe supported."},"4523":{"id":"/changelog-1492","page_id":"/changelog","tags":[],"type":"text","url":"/changelog#new-features-26","content":"jj sparse set now accepts an --edit flag which brings up the $EDITOR to\nedit sparse patterns."},"4524":{"id":"/changelog-1493","page_id":"/changelog","tags":[],"type":"text","url":"/changelog#new-features-26","content":"jj branch list can now be filtered by revset."},"4525":{"id":"/changelog-1494","page_id":"/changelog","tags":[],"type":"text","url":"/changelog#new-features-26","content":"Initial support for the Watchman filesystem monitor. Set\ncore.fsmonitor = \"watchman\" in your repo to enable."},"4526":{"id":"/changelog-1495","page_id":"/changelog","tags":[],"type":"text","url":"/changelog#fixed-bugs-29","content":"Modify/delete conflicts now include context lines\n#1244."},"4527":{"id":"/changelog-1496","page_id":"/changelog","tags":[],"type":"text","url":"/changelog#fixed-bugs-29","content":"It is now possible to modify either side of a modify/delete conflict (any\nchange used to be considered a resolution)."},"4528":{"id":"/changelog-1497","page_id":"/changelog","tags":[],"type":"text","url":"/changelog#fixed-bugs-29","content":"Fixed a bug that could get partially resolved conflicts to be interpreted\nincorrectly."},"4529":{"id":"/changelog-1498","page_id":"/changelog","tags":[],"type":"text","url":"/changelog#fixed-bugs-29","content":"jj git fetch: when re-adding a remote repository that had been previously\nremoved, in some situations the remote branches were not recreated."},"4530":{"id":"/changelog-1499","page_id":"/changelog","tags":[],"type":"text","url":"/changelog#fixed-bugs-29","content":"jj git remote rename: the git remote references were not rewritten with\nthe new name. If a new remote with the old name and containing the same\nbranches was added, the remote branches may not be recreated in some cases."},"4531":{"id":"/changelog-1500","page_id":"/changelog","tags":[],"type":"text","url":"/changelog#fixed-bugs-29","content":"jj workspace update-stale now snapshots the working-copy changes before\nupdating to the new working-copy commit."},"4532":{"id":"/changelog-1501","page_id":"/changelog","tags":[],"type":"text","url":"/changelog#fixed-bugs-29","content":"It is no longer allowed to create branches at the root commit."},"4533":{"id":"/changelog-1502","page_id":"/changelog","tags":[],"type":"text","url":"/changelog#fixed-bugs-29","content":"git checkout (without using jj) in colocated repo no longer abandons\nthe previously checked-out anonymous branch.\n#1042."},"4534":{"id":"/changelog-1503","page_id":"/changelog","tags":[],"type":"text","url":"/changelog#fixed-bugs-29","content":"jj git fetch in a colocated repo now abandons branches deleted on the\nremote, just like in a non-colocated repo.\n#864"},"4535":{"id":"/changelog-1504","page_id":"/changelog","tags":[],"type":"text","url":"/changelog#fixed-bugs-29","content":"jj git fetch can now fetch forgotten branches even if they didn't move on\nthe remote.\n#1714\n#1771"},"4536":{"id":"/changelog-1505","page_id":"/changelog","tags":[],"type":"text","url":"/changelog#fixed-bugs-29","content":"It is now possible to jj branch forget deleted branches.\n#1537"},"4537":{"id":"/changelog-1506","page_id":"/changelog","tags":[],"type":"text","url":"/changelog#fixed-bugs-29","content":"Fixed race condition when assigning change id to Git commit. If you've\nalready had unreachable change ids, run jj debug reindex.\n#924"},"4538":{"id":"/changelog-1507","page_id":"/changelog","tags":[],"type":"text","url":"/changelog#fixed-bugs-29","content":"Fixed false divergence on racy working-copy snapshots.\n#697,\n#1608"},"4539":{"id":"/changelog-1508","page_id":"/changelog","tags":[],"type":"text","url":"/changelog#fixed-bugs-29","content":"In colocated repos, a bug causing conflicts when undoing branch moves (#922)\nhas been fixed. Some surprising behaviors related to undoing jj git push or\njj git fetch remain."},"4540":{"id":"/changelog-1509","page_id":"/changelog","tags":[],"type":"text","url":"/changelog#contributors-26","content":"Thanks to the people who made this release happen!"},"4541":{"id":"/changelog-1510","page_id":"/changelog","tags":[],"type":"text","url":"/changelog#contributors-26","content":"Aaron Bull Schaefer (@elasticdog)"},"4542":{"id":"/changelog-1511","page_id":"/changelog","tags":[],"type":"text","url":"/changelog#contributors-26","content":"Anton Bulakh (@necauqua)"},"4543":{"id":"/changelog-1512","page_id":"/changelog","tags":[],"type":"text","url":"/changelog#contributors-26","content":"Austin Seipp (@thoughtpolice)"},"4544":{"id":"/changelog-1513","page_id":"/changelog","tags":[],"type":"text","url":"/changelog#contributors-26","content":"Benjamin Saunders (@Ralith)"},"4545":{"id":"/changelog-1514","page_id":"/changelog","tags":[],"type":"text","url":"/changelog#contributors-26","content":"B Wilson (@xelxebar)"},"4546":{"id":"/changelog-1515","page_id":"/changelog","tags":[],"type":"text","url":"/changelog#contributors-26","content":"Christophe Poucet (@poucet)"},"4547":{"id":"/changelog-1516","page_id":"/changelog","tags":[],"type":"text","url":"/changelog#contributors-26","content":"David Barnett (@dbarnett)"},"4548":{"id":"/changelog-1517","page_id":"/changelog","tags":[],"type":"text","url":"/changelog#contributors-26","content":"Glen Choo (@chooglen)"},"4549":{"id":"/changelog-1518","page_id":"/changelog","tags":[],"type":"text","url":"/changelog#contributors-26","content":"Grégoire Geis (@71)"},"4550":{"id":"/changelog-1519","page_id":"/changelog","tags":[],"type":"text","url":"/changelog#contributors-26","content":"Ilya Grigoriev (@ilyagr)"},"4551":{"id":"/changelog-1520","page_id":"/changelog","tags":[],"type":"text","url":"/changelog#contributors-26","content":"Isabella Basso (@isinyaaa)"},"4552":{"id":"/changelog-1521","page_id":"/changelog","tags":[],"type":"text","url":"/changelog#contributors-26","content":"Kevin Liao (@kevincliao)"},"4553":{"id":"/changelog-1522","page_id":"/changelog","tags":[],"type":"text","url":"/changelog#contributors-26","content":"Martin von Zweigbergk (@martinvonz)"},"4554":{"id":"/changelog-1523","page_id":"/changelog","tags":[],"type":"text","url":"/changelog#contributors-26","content":"mlcui (@mlcui-corp)"},"4555":{"id":"/changelog-1524","page_id":"/changelog","tags":[],"type":"text","url":"/changelog#contributors-26","content":"Samuel Tardieu (@samueltardieu)"},"4556":{"id":"/changelog-1525","page_id":"/changelog","tags":[],"type":"text","url":"/changelog#contributors-26","content":"Tal Pressman (@talpr)"},"4557":{"id":"/changelog-1526","page_id":"/changelog","tags":[],"type":"text","url":"/changelog#contributors-26","content":"Vamsi Avula (@avamsi)"},"4558":{"id":"/changelog-1527","page_id":"/changelog","tags":[],"type":"text","url":"/changelog#contributors-26","content":"Waleed Khan (@arxanas)"},"4559":{"id":"/changelog-1528","page_id":"/changelog","tags":[],"type":"text","url":"/changelog#contributors-26","content":"Yuya Nishihara (@yuja)"},"4560":{"id":"/changelog-1529","page_id":"/changelog","tags":[],"type":"text","url":"/changelog#breaking-changes-27","content":"The minimum supported Rust version (MSRV) is now 1.61.0."},"4561":{"id":"/changelog-1530","page_id":"/changelog","tags":[],"type":"text","url":"/changelog#breaking-changes-27","content":"The jj touchup command was renamed to jj diffedit."},"4562":{"id":"/changelog-1531","page_id":"/changelog","tags":[],"type":"text","url":"/changelog#breaking-changes-27","content":"The -i option to jj restore was removed in favor of new --from/--to\noptions to jj diffedit."},"4563":{"id":"/changelog-1532","page_id":"/changelog","tags":[],"type":"text","url":"/changelog#breaking-changes-27","content":"To report the situation when a change id corresponds to multiple visible\ncommits, jj log now prints the change id in red and puts ?? after it.\nPreviously, it printed the word \"divergent\"."},"4564":{"id":"/changelog-1533","page_id":"/changelog","tags":[],"type":"text","url":"/changelog#breaking-changes-27","content":"jj log prefixes commit descriptions with \"(empty)\" when they contain no\nchange compared to their parents."},"4565":{"id":"/changelog-1534","page_id":"/changelog","tags":[],"type":"text","url":"/changelog#breaking-changes-27","content":"The author/committer templates now display both name and email. Use\nauthor.name()/committer.name() to extract the name."},"4566":{"id":"/changelog-1535","page_id":"/changelog","tags":[],"type":"text","url":"/changelog#breaking-changes-27","content":"Storage of the \"HEAD@git\" reference changed and can now have conflicts.\nOperations written by a new jj binary will have a \"HEAD@git\" reference that\nis not visible to older binaries."},"4567":{"id":"/changelog-1536","page_id":"/changelog","tags":[],"type":"text","url":"/changelog#breaking-changes-27","content":"The description template keyword is now empty if no description set.\nUse if(description, description, \"(no description set)\\n\") to get back\nthe previous behavior."},"4568":{"id":"/changelog-1537","page_id":"/changelog","tags":[],"type":"text","url":"/changelog#breaking-changes-27","content":"The template.log.graph and template.commit_summary config keys were\nrenamed to templates.log and templates.commit_summary respectively."},"4569":{"id":"/changelog-1538","page_id":"/changelog","tags":[],"type":"text","url":"/changelog#breaking-changes-27","content":"If a custom templates.log template is set, working-copy commit will\nno longer be highlighted automatically. Wrap your template with\nlabel(if(current_working_copy, \"working_copy\"), ...) to label the\nworking-copy entry."},"4570":{"id":"/changelog-1539","page_id":"/changelog","tags":[],"type":"text","url":"/changelog#breaking-changes-27","content":"The ui.relative-timestamps option has been removed. Use the\nformat_timestamp() template alias instead. For details on showing relative\ntimestamps in jj log and jj show, see the documentation."},"4571":{"id":"/changelog-1540","page_id":"/changelog","tags":[],"type":"text","url":"/changelog#breaking-changes-27","content":"jj op log now shows relative timestamps by default. To disable, set\nui.oplog-relative-timestamps to false."},"4572":{"id":"/changelog-1541","page_id":"/changelog","tags":[],"type":"text","url":"/changelog#breaking-changes-27","content":"The global --no-commit-working-copy is now called --ignore-working-copy."},"4573":{"id":"/changelog-1542","page_id":"/changelog","tags":[],"type":"text","url":"/changelog#breaking-changes-27","content":"The diff.format config option is now called ui.diff.format. The old name\nis still supported for now."},"4574":{"id":"/changelog-1543","page_id":"/changelog","tags":[],"type":"text","url":"/changelog#breaking-changes-27","content":"merge-tools.<name>.edit-args now requires $left/$right parameters.\nThe default is edit-args = [\"$left\", \"$right\"]."},"4575":{"id":"/changelog-1544","page_id":"/changelog","tags":[],"type":"text","url":"/changelog#breaking-changes-27","content":"The builtin jj update and jj up aliases for jj checkout have been\ndeleted."},"4576":{"id":"/changelog-1545","page_id":"/changelog","tags":[],"type":"text","url":"/changelog#breaking-changes-27","content":"Change IDs are now rendered using letters from the end of the alphabet (from\n'z' through 'k') instead of the usual hex digits ('0' through '9' and 'a'\nthrough 'f'). This is to clarify the distinction between change IDs and commit\nIDs, and to allow more efficient lookup of unique prefixes. This change\ndoesn't affect the storage format; existing repositories will remain usable."},"4577":{"id":"/changelog-1546","page_id":"/changelog","tags":[],"type":"text","url":"/changelog#new-features-27","content":"The default log format now uses the committer timestamp instead of the author\ntimestamp."},"4578":{"id":"/changelog-1547","page_id":"/changelog","tags":[],"type":"text","url":"/changelog#new-features-27","content":"jj log --summary --patch now shows both summary and diff outputs."},"4579":{"id":"/changelog-1548","page_id":"/changelog","tags":[],"type":"text","url":"/changelog#new-features-27","content":"jj git push now accepts multiple --branch/--change arguments"},"4580":{"id":"/changelog-1549","page_id":"/changelog","tags":[],"type":"text","url":"/changelog#new-features-27","content":"jj config list command prints values from config and config edit opens\nthe config in an editor."},"4581":{"id":"/changelog-1550","page_id":"/changelog","tags":[],"type":"text","url":"/changelog#new-features-27","content":"jj debug config-schema command prints out JSON schema for the jj TOML config\nfile format."},"4582":{"id":"/changelog-1551","page_id":"/changelog","tags":[],"type":"text","url":"/changelog#new-features-27","content":"jj resolve --list can now describe the complexity of conflicts."},"4583":{"id":"/changelog-1552","page_id":"/changelog","tags":[],"type":"text","url":"/changelog#new-features-27","content":"jj resolve now notifies the user of remaining conflicts, if any, on success.\nThis can be prevented by the new --quiet option."},"4584":{"id":"/changelog-1553","page_id":"/changelog","tags":[],"type":"text","url":"/changelog#new-features-27","content":"Per-repository configuration is now read from .jj/repo/config.toml."},"4585":{"id":"/changelog-1554","page_id":"/changelog","tags":[],"type":"text","url":"/changelog#new-features-27","content":"Background colors, bold text, and underlining are now supported. You can set\ne.g. colors.error = { bg = \"red\", bold = true, underline = true } in your\n~/.jjconfig.toml."},"4586":{"id":"/changelog-1555","page_id":"/changelog","tags":[],"type":"text","url":"/changelog#new-features-27","content":"The empty condition in templates is true when the commit makes no change to\nthe three compared to its parents."},"4587":{"id":"/changelog-1556","page_id":"/changelog","tags":[],"type":"text","url":"/changelog#new-features-27","content":"branches([needle]) revset function now takes needle as an optional\nargument and matches just the branches whose name contains needle."},"4588":{"id":"/changelog-1557","page_id":"/changelog","tags":[],"type":"text","url":"/changelog#new-features-27","content":"remote_branches([branch_needle[, remote_needle]]) now takes branch_needle\nand remote_needle as optional arguments and matches just the branches whose\nname contains branch_needle and remote contains remote_needle."},"4589":{"id":"/changelog-1558","page_id":"/changelog","tags":[],"type":"text","url":"/changelog#new-features-27","content":"jj git fetch accepts repeated --remote arguments."},"4590":{"id":"/changelog-1559","page_id":"/changelog","tags":[],"type":"text","url":"/changelog#new-features-27","content":"Default remotes can be configured for the jj git fetch and jj git push\noperations (\"origin\" by default) using the git.fetch and git.push\nconfiguration entries. git.fetch can be a list if multiple remotes must\nbe fetched from."},"4591":{"id":"/changelog-1560","page_id":"/changelog","tags":[],"type":"text","url":"/changelog#new-features-27","content":"jj duplicate can now duplicate multiple changes in one go. This preserves\nany parent-child relationships between them. For example, the entire tree of\ndescendants of abc can be duplicated with jj duplicate abc:."},"4592":{"id":"/changelog-1561","page_id":"/changelog","tags":[],"type":"text","url":"/changelog#new-features-27","content":"jj log now highlights the shortest unique prefix of every commit and change\nid and shows the rest in gray. To customize the length and style, use the\nformat_short_id() template alias. For details, see\nthe documentation."},"4593":{"id":"/changelog-1562","page_id":"/changelog","tags":[],"type":"text","url":"/changelog#new-features-27","content":"jj print was renamed to jj cat. jj print remains as an alias."},"4594":{"id":"/changelog-1563","page_id":"/changelog","tags":[],"type":"text","url":"/changelog#new-features-27","content":"In content that goes to the terminal, the ANSI escape byte (0x1b) is replaced\nby a \"␛\" character. That prevents them from interfering with the ANSI escapes\njj itself writes."},"4595":{"id":"/changelog-1564","page_id":"/changelog","tags":[],"type":"text","url":"/changelog#new-features-27","content":"jj workspace root prints the root path of the current workspace."},"4596":{"id":"/changelog-1565","page_id":"/changelog","tags":[],"type":"text","url":"/changelog#new-features-27","content":"The [alias] config section was renamed to [aliases]. The old name is\nstill accepted for backwards compatibility for some time."},"4597":{"id":"/changelog-1566","page_id":"/changelog","tags":[],"type":"text","url":"/changelog#new-features-27","content":"Commands that draw an ASCII graph (jj log, jj op log, jj obslog) now\nhave different styles available by setting e.g. ui.graph.style = \"curved\"."},"4598":{"id":"/changelog-1567","page_id":"/changelog","tags":[],"type":"text","url":"/changelog#new-features-27","content":"jj split accepts creating empty commits when given a path. jj split .\ninserts an empty commit between the target commit and its children if any,\nand jj split any-non-existent-path inserts an empty commit between the\ntarget commit and its parents."},"4599":{"id":"/changelog-1568","page_id":"/changelog","tags":[],"type":"text","url":"/changelog#new-features-27","content":"Command arguments to ui.diff-editor/ui.merge-editor can now be specified\ninline without referring to [merge-tools] table."},"4600":{"id":"/changelog-1569","page_id":"/changelog","tags":[],"type":"text","url":"/changelog#new-features-27","content":"jj rebase now accepts a new --allow-large-revsets argument that allows the\nrevset in the -d argument to expand to several revisions. For example,\njj rebase -s B -d B- -d C now works even if B is a merge commit."},"4601":{"id":"/changelog-1570","page_id":"/changelog","tags":[],"type":"text","url":"/changelog#new-features-27","content":"jj new now also accepts a --allow-large-revsets argument that behaves\nsimilarly to jj rebase --allow-large-revsets."},"4602":{"id":"/changelog-1571","page_id":"/changelog","tags":[],"type":"text","url":"/changelog#new-features-27","content":"jj new --insert-before inserts the new commit between the target commit and\nits parents."},"4603":{"id":"/changelog-1572","page_id":"/changelog","tags":[],"type":"text","url":"/changelog#new-features-27","content":"jj new --insert-after inserts the new commit between the target commit and\nits children."},"4604":{"id":"/changelog-1573","page_id":"/changelog","tags":[],"type":"text","url":"/changelog#new-features-27","content":"author/committer templates now support .username(), which leaves out the\ndomain information of .email()."},"4605":{"id":"/changelog-1574","page_id":"/changelog","tags":[],"type":"text","url":"/changelog#new-features-27","content":"It is now possible to change the author format of jj log with the\nformat_short_signature() template alias. For details, see\nthe documentation."},"4606":{"id":"/changelog-1575","page_id":"/changelog","tags":[],"type":"text","url":"/changelog#new-features-27","content":"Added support for template aliases. New symbols and functions can be\nconfigured by template-aliases.<name> = <expression>. Be aware that\nthe template syntax isn't documented yet and is likely to change."},"4607":{"id":"/changelog-1576","page_id":"/changelog","tags":[],"type":"text","url":"/changelog#new-features-27","content":"The ui.diff-instructions config setting can be set to false to inhibit the\ncreation of the JJ-INSTRUCTIONS file as part of diff editing."},"4608":{"id":"/changelog-1577","page_id":"/changelog","tags":[],"type":"text","url":"/changelog#fixed-bugs-30","content":"When sharing the working copy with a Git repo, we used to forget to export\nbranches to Git when only the working copy had changed. That's now fixed."},"4609":{"id":"/changelog-1578","page_id":"/changelog","tags":[],"type":"text","url":"/changelog#fixed-bugs-30","content":"Commit description set by -m/--message is now terminated with a newline\ncharacter, just like descriptions set by editor are."},"4610":{"id":"/changelog-1579","page_id":"/changelog","tags":[],"type":"text","url":"/changelog#fixed-bugs-30","content":"The -R/--repository path must be a valid workspace directory. Its\nancestor directories are no longer searched."},"4611":{"id":"/changelog-1580","page_id":"/changelog","tags":[],"type":"text","url":"/changelog#fixed-bugs-30","content":"Fixed a crash when trying to access a commit that's never been imported into\nthe jj repo from a Git repo. They will now be considered as non-existent if\nreferenced explicitly instead of crashing."},"4612":{"id":"/changelog-1581","page_id":"/changelog","tags":[],"type":"text","url":"/changelog#fixed-bugs-30","content":"Fixed handling of escaped characters in .gitignore (only keep trailing spaces\nif escaped properly)."},"4613":{"id":"/changelog-1582","page_id":"/changelog","tags":[],"type":"text","url":"/changelog#fixed-bugs-30","content":"jj undo now works after jj duplicate."},"4614":{"id":"/changelog-1583","page_id":"/changelog","tags":[],"type":"text","url":"/changelog#fixed-bugs-30","content":"jj duplicate followed by jj rebase of a tree containing both the original\nand duplicate commit no longer crashes. The fix should also resolve any\nremaining\ninstances of https://github.com/jj-vcs/jj/issues/27."},"4615":{"id":"/changelog-1584","page_id":"/changelog","tags":[],"type":"text","url":"/changelog#fixed-bugs-30","content":"Fix the output of jj debug completion --help by reversing fish and zsh text."},"4616":{"id":"/changelog-1585","page_id":"/changelog","tags":[],"type":"text","url":"/changelog#fixed-bugs-30","content":"Fixed edge case in jj git fetch when a pruned branch is a prefix of another\nbranch."},"4617":{"id":"/changelog-1586","page_id":"/changelog","tags":[],"type":"text","url":"/changelog#contributors-27","content":"Thanks to the people who made this release happen!"},"4618":{"id":"/changelog-1587","page_id":"/changelog","tags":[],"type":"text","url":"/changelog#contributors-27","content":"Aleksandr Mikhailov (@AM5800)"},"4619":{"id":"/changelog-1588","page_id":"/changelog","tags":[],"type":"text","url":"/changelog#contributors-27","content":"Augie Fackler (@durin42)"},"4620":{"id":"/changelog-1589","page_id":"/changelog","tags":[],"type":"text","url":"/changelog#contributors-27","content":"Benjamin Saunders (@Ralith)"},"4621":{"id":"/changelog-1590","page_id":"/changelog","tags":[],"type":"text","url":"/changelog#contributors-27","content":"Daniel Ploch (@torquestomp)"},"4622":{"id":"/changelog-1591","page_id":"/changelog","tags":[],"type":"text","url":"/changelog#contributors-27","content":"Danny Hooper (@hooper)"},"4623":{"id":"/changelog-1592","page_id":"/changelog","tags":[],"type":"text","url":"/changelog#contributors-27","content":"David Barnett (@dbarnett)"},"4624":{"id":"/changelog-1593","page_id":"/changelog","tags":[],"type":"text","url":"/changelog#contributors-27","content":"Glen Choo (@chooglen)"},"4625":{"id":"/changelog-1594","page_id":"/changelog","tags":[],"type":"text","url":"/changelog#contributors-27","content":"Herby Gillot (@herbygillot)"},"4626":{"id":"/changelog-1595","page_id":"/changelog","tags":[],"type":"text","url":"/changelog#contributors-27","content":"Ilya Grigoriev (@ilyagr)"},"4627":{"id":"/changelog-1596","page_id":"/changelog","tags":[],"type":"text","url":"/changelog#contributors-27","content":"Luke Granger-Brown (@lukegb)"},"4628":{"id":"/changelog-1597","page_id":"/changelog","tags":[],"type":"text","url":"/changelog#contributors-27","content":"Martin von Zweigbergk (@martinvonz)"},"4629":{"id":"/changelog-1598","page_id":"/changelog","tags":[],"type":"text","url":"/changelog#contributors-27","content":"Michael Forster (@MForster)"},"4630":{"id":"/changelog-1599","page_id":"/changelog","tags":[],"type":"text","url":"/changelog#contributors-27","content":"Philip Metzger (@PhilipMetzger)"},"4631":{"id":"/changelog-1600","page_id":"/changelog","tags":[],"type":"text","url":"/changelog#contributors-27","content":"Ruben Slabbert (@rslabbert)"},"4632":{"id":"/changelog-1601","page_id":"/changelog","tags":[],"type":"text","url":"/changelog#contributors-27","content":"Samuel Tardieu (@samueltardieu)"},"4633":{"id":"/changelog-1602","page_id":"/changelog","tags":[],"type":"text","url":"/changelog#contributors-27","content":"Tal Pressman (@talpr)"},"4634":{"id":"/changelog-1603","page_id":"/changelog","tags":[],"type":"text","url":"/changelog#contributors-27","content":"Vamsi Avula (@avamsi)"},"4635":{"id":"/changelog-1604","page_id":"/changelog","tags":[],"type":"text","url":"/changelog#contributors-27","content":"Waleed Khan (@arxanas)"},"4636":{"id":"/changelog-1605","page_id":"/changelog","tags":[],"type":"text","url":"/changelog#contributors-27","content":"Yuya Nishihara (@yuja)"},"4637":{"id":"/changelog-1606","page_id":"/changelog","tags":[],"type":"text","url":"/changelog#061---2022-12-05","content":"No changes, only changed to a released version of the thrift crate dependency."},"4638":{"id":"/changelog-1607","page_id":"/changelog","tags":[],"type":"text","url":"/changelog#breaking-changes-28","content":"Dropped candidates set argument from description(needle), author(needle),\ncommitter(needle), merges() revsets. Use x & description(needle)\ninstead."},"4639":{"id":"/changelog-1608","page_id":"/changelog","tags":[],"type":"text","url":"/changelog#breaking-changes-28","content":"Adjusted precedence of revset union/intersection/difference operators.\nx | y & z is now equivalent to x | (y & z)."},"4640":{"id":"/changelog-1609","page_id":"/changelog","tags":[],"type":"text","url":"/changelog#breaking-changes-28","content":"Support for open commits has been dropped. The ui.enable-open-commits config\nthat was added in 0.5.0 is no longer respected. The jj open/close commands\nhave been deleted."},"4641":{"id":"/changelog-1610","page_id":"/changelog","tags":[],"type":"text","url":"/changelog#breaking-changes-28","content":"jj commit is now a separate command from jj close (which no longer\nexists). The behavior has changed slightly. It now always asks for a\ndescription, even if there already was a description set. It now also only\nworks on the working-copy commit (there's no -r argument)."},"4642":{"id":"/changelog-1611","page_id":"/changelog","tags":[],"type":"text","url":"/changelog#breaking-changes-28","content":"If a workspace's working-copy commit has been updated from another workspace,\nmost commands in that workspace will now fail. Use the new\njj workspace update-stale command to update the workspace to the new\nworking-copy commit. (The old behavior was to automatically update the\nworkspace.)"},"4643":{"id":"/changelog-1612","page_id":"/changelog","tags":[],"type":"text","url":"/changelog#new-features-28","content":"Commands with long output are paginated.\n#9"},"4644":{"id":"/changelog-1613","page_id":"/changelog","tags":[],"type":"text","url":"/changelog#new-features-28","content":"The new jj git remote rename command allows git remotes to be renamed\nin-place."},"4645":{"id":"/changelog-1614","page_id":"/changelog","tags":[],"type":"text","url":"/changelog#new-features-28","content":"The new jj resolve command allows resolving simple conflicts with\nan external 3-way-merge tool."},"4646":{"id":"/changelog-1615","page_id":"/changelog","tags":[],"type":"text","url":"/changelog#new-features-28","content":"jj git push will search @- for branches to push if @ has none."},"4647":{"id":"/changelog-1616","page_id":"/changelog","tags":[],"type":"text","url":"/changelog#new-features-28","content":"The new revset function file(pattern..) finds commits modifying the\npaths specified by the pattern..."},"4648":{"id":"/changelog-1617","page_id":"/changelog","tags":[],"type":"text","url":"/changelog#new-features-28","content":"The new revset function empty() finds commits modifying no files."},"4649":{"id":"/changelog-1618","page_id":"/changelog","tags":[],"type":"text","url":"/changelog#new-features-28","content":"Added support for revset aliases. New symbols and functions can be configured\nby revset-aliases.<name> = <expression>."},"4650":{"id":"/changelog-1619","page_id":"/changelog","tags":[],"type":"text","url":"/changelog#new-features-28","content":"It is now possible to specify configuration options on the command line\nwith the new --config-toml global option."},"4651":{"id":"/changelog-1620","page_id":"/changelog","tags":[],"type":"text","url":"/changelog#new-features-28","content":"jj git subcommands will prompt for credentials when required for HTTPS\nremotes rather than failing.\n#469"},"4652":{"id":"/changelog-1621","page_id":"/changelog","tags":[],"type":"text","url":"/changelog#new-features-28","content":"Branches that have a different target on some remote than they do locally are\nnow indicated by an asterisk suffix (e.g. main*) in jj log.\n#254"},"4653":{"id":"/changelog-1622","page_id":"/changelog","tags":[],"type":"text","url":"/changelog#new-features-28","content":"The commit ID was moved from first on the line in jj log output to close to\nthe end. The goal is to encourage users to use the change ID instead, since\nthat is generally more convenient, and it reduces the risk of creating\ndivergent commits."},"4654":{"id":"/changelog-1623","page_id":"/changelog","tags":[],"type":"text","url":"/changelog#new-features-28","content":"The username and hostname that appear in the operation log are now\nconfigurable via config options operation.username and operation.hostname."},"4655":{"id":"/changelog-1624","page_id":"/changelog","tags":[],"type":"text","url":"/changelog#new-features-28","content":"jj git subcommands now support credential helpers."},"4656":{"id":"/changelog-1625","page_id":"/changelog","tags":[],"type":"text","url":"/changelog#new-features-28","content":"jj log will warn if it appears that the provided path was meant to be a\nrevset."},"4657":{"id":"/changelog-1626","page_id":"/changelog","tags":[],"type":"text","url":"/changelog#new-features-28","content":"The new global flag -v/--verbose will turn on debug logging to give\nsome additional insight into what is happening behind the scenes.\nNote: This is not comprehensively supported by all operations yet."},"4658":{"id":"/changelog-1627","page_id":"/changelog","tags":[],"type":"text","url":"/changelog#new-features-28","content":"jj log, jj show, and jj obslog now all support showing relative\ntimestamps by setting ui.relative-timestamps = true in the config file."},"4659":{"id":"/changelog-1628","page_id":"/changelog","tags":[],"type":"text","url":"/changelog#fixed-bugs-31","content":"A bug in the export of branches to Git caused spurious conflicted branches.\nThis typically occurred when running in a working copy colocated with Git\n(created by running jj init --git-dir=.).\n#463"},"4660":{"id":"/changelog-1629","page_id":"/changelog","tags":[],"type":"text","url":"/changelog#fixed-bugs-31","content":"When exporting branches to Git, we used to fail if some branches could not be\nexported (e.g. because Git doesn't allow a branch called main and another\nbranch called main/sub). We now print a warning about these branches\ninstead.\n#493"},"4661":{"id":"/changelog-1630","page_id":"/changelog","tags":[],"type":"text","url":"/changelog#fixed-bugs-31","content":"If you had modified branches in jj and also modified branches in conflicting\nways in Git, jj git export used to overwrite the changes you made in Git.\nWe now print a warning about these branches instead."},"4662":{"id":"/changelog-1631","page_id":"/changelog","tags":[],"type":"text","url":"/changelog#fixed-bugs-31","content":"jj edit root now fails gracefully."},"4663":{"id":"/changelog-1632","page_id":"/changelog","tags":[],"type":"text","url":"/changelog#fixed-bugs-31","content":"jj git import used to abandon a commit if Git branches and tags referring\nto it were removed. We now keep it if a detached HEAD refers to it."},"4664":{"id":"/changelog-1633","page_id":"/changelog","tags":[],"type":"text","url":"/changelog#fixed-bugs-31","content":"jj git import no longer crashes when all Git refs are removed."},"4665":{"id":"/changelog-1634","page_id":"/changelog","tags":[],"type":"text","url":"/changelog#fixed-bugs-31","content":"Git submodules are now ignored completely. Earlier, files present in the\nsubmodule directory in the working copy would become added (tracked), and\nlater removed if you checked out another commit. You can now use git to\npopulate the submodule directory and jj will leave it alone."},"4666":{"id":"/changelog-1635","page_id":"/changelog","tags":[],"type":"text","url":"/changelog#fixed-bugs-31","content":"Git's GC could remove commits that were referenced from jj in some cases. We\nare now better at adding Git refs to prevent that.\n#815"},"4667":{"id":"/changelog-1636","page_id":"/changelog","tags":[],"type":"text","url":"/changelog#fixed-bugs-31","content":"When the working-copy commit was a merge, jj status would list only the\nfirst parent, and the diff summary would be against that parent. The output\nnow lists all parents and the diff summary is against the auto-merged parents."},"4668":{"id":"/changelog-1637","page_id":"/changelog","tags":[],"type":"text","url":"/changelog#contributors-28","content":"Thanks to the people who made this release happen!"},"4669":{"id":"/changelog-1638","page_id":"/changelog","tags":[],"type":"text","url":"/changelog#contributors-28","content":"Martin von Zweigbergk (@martinvonz)"},"4670":{"id":"/changelog-1639","page_id":"/changelog","tags":[],"type":"text","url":"/changelog#contributors-28","content":"Benjamin Saunders (@Ralith)"},"4671":{"id":"/changelog-1640","page_id":"/changelog","tags":[],"type":"text","url":"/changelog#contributors-28","content":"Yuya Nishihara (@yuja)"},"4672":{"id":"/changelog-1641","page_id":"/changelog","tags":[],"type":"text","url":"/changelog#contributors-28","content":"Glen Choo (@chooglen)"},"4673":{"id":"/changelog-1642","page_id":"/changelog","tags":[],"type":"text","url":"/changelog#contributors-28","content":"Ilya Grigoriev (@ilyagr)"},"4674":{"id":"/changelog-1643","page_id":"/changelog","tags":[],"type":"text","url":"/changelog#contributors-28","content":"Ruben Slabbert (@rslabbert)"},"4675":{"id":"/changelog-1644","page_id":"/changelog","tags":[],"type":"text","url":"/changelog#contributors-28","content":"Waleed Khan (@arxanas)"},"4676":{"id":"/changelog-1645","page_id":"/changelog","tags":[],"type":"text","url":"/changelog#contributors-28","content":"Sean E. Russell (@xxxserxxx)"},"4677":{"id":"/changelog-1646","page_id":"/changelog","tags":[],"type":"text","url":"/changelog#contributors-28","content":"Pranay Sashank (@pranaysashank)"},"4678":{"id":"/changelog-1647","page_id":"/changelog","tags":[],"type":"text","url":"/changelog#contributors-28","content":"Luke Granger-Brown (@lukegb)"},"4679":{"id":"/changelog-1648","page_id":"/changelog","tags":[],"type":"text","url":"/changelog#051---2022-10-17","content":"No changes (just trying to get automated GitHub release to work)."},"4680":{"id":"/changelog-1649","page_id":"/changelog","tags":[],"type":"text","url":"/changelog#breaking-changes-29","content":"Open commits are now disabled by default. That means that jj checkout will\nalways create a new change on top of the specified commit and will let you\nedit that in the working copy. Set ui.enable-open-commits = true to restore\nthe old behavior and let us know that you did so we know how many people\nprefer the workflow with open commits."},"4681":{"id":"/changelog-1650","page_id":"/changelog","tags":[],"type":"text","url":"/changelog#breaking-changes-29","content":"jj [op] undo and jj op restore used to take the operation to undo or\nrestore to as an argument to -o/--operation. It is now a positional\nargument instead (i.e. jj undo -o abc123 is now written jj undo abc123)."},"4682":{"id":"/changelog-1651","page_id":"/changelog","tags":[],"type":"text","url":"/changelog#breaking-changes-29","content":"An alias that is not configured as a string list (e.g. my-status = \"status\"\ninstead of my-status = [\"status\"]) is now an error instead of a warning."},"4683":{"id":"/changelog-1652","page_id":"/changelog","tags":[],"type":"text","url":"/changelog#breaking-changes-29","content":"jj log now defaults to showing only commits that are not on any remote\nbranches (plus their closest commit on the remote branch for context). This\nset of commits can be overridden by setting ui.default-revset. Use\njj log -r 'all()' for the old behavior. Read more about revsets\nhere.\n#250"},"4684":{"id":"/changelog-1653","page_id":"/changelog","tags":[],"type":"text","url":"/changelog#breaking-changes-29","content":"jj new now always checks out the new commit (used to be only if the parent\nwas @)."},"4685":{"id":"/changelog-1654","page_id":"/changelog","tags":[],"type":"text","url":"/changelog#breaking-changes-29","content":"jj merge now checks out the new commit. The command now behaves exactly\nlike jj new, except that it requires at least two arguments."},"4686":{"id":"/changelog-1655","page_id":"/changelog","tags":[],"type":"text","url":"/changelog#breaking-changes-29","content":"When the working-copy commit is abandoned by jj abandon and the parent\ncommit is open, a new working-copy commit will be created on top (the open\nparent commit used to get checked out)."},"4687":{"id":"/changelog-1656","page_id":"/changelog","tags":[],"type":"text","url":"/changelog#breaking-changes-29","content":"jj branch now uses subcommands like jj branch create and\njj branch forget instead of options like jj branch --forget.\n#330"},"4688":{"id":"/changelog-1657","page_id":"/changelog","tags":[],"type":"text","url":"/changelog#breaking-changes-29","content":"The $NO_COLOR environment variable no longer\noverrides the ui.color configuration if explicitly set."},"4689":{"id":"/changelog-1658","page_id":"/changelog","tags":[],"type":"text","url":"/changelog#breaking-changes-29","content":"jj edit has been renamed to jj touchup, and jj edit is now a new command\nwith different behavior. The new jj edit lets you edit a commit in the\nworking copy, even if the specified commit is closed."},"4690":{"id":"/changelog-1659","page_id":"/changelog","tags":[],"type":"text","url":"/changelog#breaking-changes-29","content":"jj git push no longer aborts if you attempt to push an open commit (but it\nnow aborts if a commit does not have a description)."},"4691":{"id":"/changelog-1660","page_id":"/changelog","tags":[],"type":"text","url":"/changelog#breaking-changes-29","content":"jj git push now pushes only branches pointing to the @ by default. Use\n--all to push all branches."},"4692":{"id":"/changelog-1661","page_id":"/changelog","tags":[],"type":"text","url":"/changelog#breaking-changes-29","content":"The checkouts template keyword is now called working_copies, and\ncurrent_checkout is called current_working_copy."},"4693":{"id":"/changelog-1662","page_id":"/changelog","tags":[],"type":"text","url":"/changelog#new-features-29","content":"The new jj interdiff command compares the changes in commits, ignoring\nchanges from intervening commits."},"4694":{"id":"/changelog-1663","page_id":"/changelog","tags":[],"type":"text","url":"/changelog#new-features-29","content":"jj rebase now accepts a --branch/-b <revision> argument, which can be used\ninstead of -r or -s to specify which commits to rebase. It will rebase the\nwhole branch, relative to the destination. The default mode has changed from\n-r @ to -b @."},"4695":{"id":"/changelog-1664","page_id":"/changelog","tags":[],"type":"text","url":"/changelog#new-features-29","content":"The new jj print command prints the contents of a file in a revision."},"4696":{"id":"/changelog-1665","page_id":"/changelog","tags":[],"type":"text","url":"/changelog#new-features-29","content":"The new jj git remotes list command lists the configured remotes and their\nURLs.\n#243"},"4697":{"id":"/changelog-1666","page_id":"/changelog","tags":[],"type":"text","url":"/changelog#new-features-29","content":"jj move and jj squash now lets you limit the set of changes to move by\nspecifying paths on the command line (in addition to the --interactive\nmode). For example, use jj move --to @-- foo to move the changes to file\n(or directory) foo in the working copy to the grandparent commit."},"4698":{"id":"/changelog-1667","page_id":"/changelog","tags":[],"type":"text","url":"/changelog#new-features-29","content":"When jj move/squash/unsquash abandons the source commit because it became\nempty and both the source and the destination commits have non-empty\ndescriptions, it now asks for a combined description. If either description\nwas empty, it uses the other without asking."},"4699":{"id":"/changelog-1668","page_id":"/changelog","tags":[],"type":"text","url":"/changelog#new-features-29","content":"jj split now lets you specify on the CLI which paths to include in the first\ncommit. The interactive diff-editing is not started when you do that."},"4700":{"id":"/changelog-1669","page_id":"/changelog","tags":[],"type":"text","url":"/changelog#new-features-29","content":"Sparse checkouts are now supported. In fact, all working copies are now\n\"sparse\", only to different degrees. Use the jj sparse command to manage\nthe paths included in the sparse checkout."},"4701":{"id":"/changelog-1670","page_id":"/changelog","tags":[],"type":"text","url":"/changelog#new-features-29","content":"Configuration is now also read from ~/.jjconfig.toml."},"4702":{"id":"/changelog-1671","page_id":"/changelog","tags":[],"type":"text","url":"/changelog#new-features-29","content":"The $JJ_CONFIG environment variable can now point to a directory. If it\ndoes, all files in the directory will be read, in alphabetical order."},"4703":{"id":"/changelog-1672","page_id":"/changelog","tags":[],"type":"text","url":"/changelog#new-features-29","content":"The $VISUAL environment is now respected and overrides $EDITOR. The new\nui.editor config has higher priority than both of them. There is also a new\n$JJ_EDITOR environment variable, which has even higher priority than the\nconfig."},"4704":{"id":"/changelog-1673","page_id":"/changelog","tags":[],"type":"text","url":"/changelog#new-features-29","content":"You can now use - and + in revset symbols. You used to have to quote\nbranch names like my-feature in nested quotes (outer layer for your shell)\nlike jj co '\"my-feature\"'. The quoting is no longer needed."},"4705":{"id":"/changelog-1674","page_id":"/changelog","tags":[],"type":"text","url":"/changelog#new-features-29","content":"The new revset function connected(x) is the same as x:x."},"4706":{"id":"/changelog-1675","page_id":"/changelog","tags":[],"type":"text","url":"/changelog#new-features-29","content":"The new revset function roots(x) finds commits in the set that are not\ndescendants of other commits in the set."},"4707":{"id":"/changelog-1676","page_id":"/changelog","tags":[],"type":"text","url":"/changelog#new-features-29","content":"ssh-agent is now detected even if $SSH_AGENT_PID is not set (as long as\n$SSH_AUTH_SOCK is set). This should help at least macOS users where\nssh-agent is launched by default and only $SSH_AUTH_SOCK is set."},"4708":{"id":"/changelog-1677","page_id":"/changelog","tags":[],"type":"text","url":"/changelog#new-features-29","content":"When importing from a git, any commits that are no longer referenced on the\ngit side will now be abandoned on the jj side as well. That means that\njj git fetch will now abandon unreferenced commits and rebase any local\nchanges you had on top."},"4709":{"id":"/changelog-1678","page_id":"/changelog","tags":[],"type":"text","url":"/changelog#new-features-29","content":"jj git push gained a --change <revision> argument. When that's used, it\nwill create a branch named after the revision's change ID, so you don't have\nto create a branch yourself. By default, the branch name will start with\npush-, but this can be overridden by the push.branch-prefix config\nsetting."},"4710":{"id":"/changelog-1679","page_id":"/changelog","tags":[],"type":"text","url":"/changelog#new-features-29","content":"jj git push now aborts if you attempt to push a commit without a\ndescription or with the placeholder \"(no name/email configured)\" values for\nauthor/committer."},"4711":{"id":"/changelog-1680","page_id":"/changelog","tags":[],"type":"text","url":"/changelog#new-features-29","content":"Diff editor command arguments can now be specified by config file.\nExample:"},"4712":{"id":"/changelog-1681","page_id":"/changelog","tags":[],"type":"text","url":"/changelog#new-features-29","content":"jj branch can accept any number of branches to update, rather than just one."},"4713":{"id":"/changelog-1682","page_id":"/changelog","tags":[],"type":"text","url":"/changelog#new-features-29","content":"Aliases can now call other aliases."},"4714":{"id":"/changelog-1683","page_id":"/changelog","tags":[],"type":"text","url":"/changelog#new-features-29","content":"jj log now accepts a --reversed option, which will show older commits\nfirst."},"4715":{"id":"/changelog-1684","page_id":"/changelog","tags":[],"type":"text","url":"/changelog#new-features-29","content":"jj log now accepts file paths."},"4716":{"id":"/changelog-1685","page_id":"/changelog","tags":[],"type":"text","url":"/changelog#new-features-29","content":"jj obslog now accepts -p/--patch option, which will show the diff\ncompared to the previous version of the change."},"4717":{"id":"/changelog-1686","page_id":"/changelog","tags":[],"type":"text","url":"/changelog#new-features-29","content":"The \"(no name/email configured)\" placeholder value for name/email will now be\nreplaced if once you modify a commit after having configured your name/email."},"4718":{"id":"/changelog-1687","page_id":"/changelog","tags":[],"type":"text","url":"/changelog#new-features-29","content":"Color setting can now be overridden by --color=always|never|auto option."},"4719":{"id":"/changelog-1688","page_id":"/changelog","tags":[],"type":"text","url":"/changelog#new-features-29","content":"jj checkout now lets you specify a description with --message/-m."},"4720":{"id":"/changelog-1689","page_id":"/changelog","tags":[],"type":"text","url":"/changelog#new-features-29","content":"jj new can now be used for creating merge commits. If you pass more than\none argument to it, the new commit will have all of them as parents."},"4721":{"id":"/changelog-1690","page_id":"/changelog","tags":[],"type":"text","url":"/changelog#fixed-bugs-32","content":"When rebasing a conflict where one side modified a file and the other side\ndeleted it, we no longer automatically resolve it in favor of the modified\ncontent (this was a regression from commit c0ae4b16e8c4)."},"4722":{"id":"/changelog-1691","page_id":"/changelog","tags":[],"type":"text","url":"/changelog#fixed-bugs-32","content":"Errors are now printed to stderr (they used to be printed to stdout)."},"4723":{"id":"/changelog-1692","page_id":"/changelog","tags":[],"type":"text","url":"/changelog#fixed-bugs-32","content":"Updating the working copy to a commit where a file's executable bit changed\nbut the contents was the same used to lead to a crash. That has now been\nfixed."},"4724":{"id":"/changelog-1693","page_id":"/changelog","tags":[],"type":"text","url":"/changelog#fixed-bugs-32","content":"If one side of a merge modified a directory and the other side deleted it, it\nused to be considered a conflict. The same was true if both sides added a\ndirectory with different files in. They are now merged as if the missing\ndirectory had been empty."},"4725":{"id":"/changelog-1694","page_id":"/changelog","tags":[],"type":"text","url":"/changelog#fixed-bugs-32","content":"When using jj move to move part of a commit into an ancestor, any branches\npointing to the source commit used to be left on a hidden intermediate commit.\nThey are now correctly updated."},"4726":{"id":"/changelog-1695","page_id":"/changelog","tags":[],"type":"text","url":"/changelog#fixed-bugs-32","content":"jj untrack now requires at least one path (allowing no arguments was a UX\nbug)."},"4727":{"id":"/changelog-1696","page_id":"/changelog","tags":[],"type":"text","url":"/changelog#fixed-bugs-32","content":"jj rebase now requires at least one destination (allowing no arguments was a\nUX bug)."},"4728":{"id":"/changelog-1697","page_id":"/changelog","tags":[],"type":"text","url":"/changelog#fixed-bugs-32","content":"jj restore --to <rev> now restores from the working copy (it used to restore\nfrom the working copy's parent)."},"4729":{"id":"/changelog-1698","page_id":"/changelog","tags":[],"type":"text","url":"/changelog#fixed-bugs-32","content":"You now get a proper error message instead of a crash when $EDITOR doesn't\nexist or exits with an error."},"4730":{"id":"/changelog-1699","page_id":"/changelog","tags":[],"type":"text","url":"/changelog#fixed-bugs-32","content":"Global arguments, such as --at-op=<operation>, can now be passed before\nan alias."},"4731":{"id":"/changelog-1700","page_id":"/changelog","tags":[],"type":"text","url":"/changelog#fixed-bugs-32","content":"Fixed relative path to the current directory in output to be . instead of\nempty string."},"4732":{"id":"/changelog-1701","page_id":"/changelog","tags":[],"type":"text","url":"/changelog#fixed-bugs-32","content":"When adding a new workspace, the parent of the current workspace's current\ncheckout will be checked out. That was always the intent, but the root commit\nwas accidentally checked out instead."},"4733":{"id":"/changelog-1702","page_id":"/changelog","tags":[],"type":"text","url":"/changelog#fixed-bugs-32","content":"When checking out a commit, the previous commit is no longer abandoned if it\nhas a non-empty description."},"4734":{"id":"/changelog-1703","page_id":"/changelog","tags":[],"type":"text","url":"/changelog#fixed-bugs-32","content":"All commands now consistently snapshot the working copy (it was missing from\ne.g. jj undo and jj merge before)."},"4735":{"id":"/changelog-1704","page_id":"/changelog","tags":[],"type":"text","url":"/changelog#breaking-changes-30","content":"Dropped support for config in ~/.jjconfig. Your configuration is now read\nfrom <config dir>/jj/config.toml, where <config dir> is\n${XDG_CONFIG_HOME} or ~/.config/ on Linux,\n~/Library/Application Support/ on macOS, and ~\\AppData\\Roaming\\ on\nWindows."},"4736":{"id":"/changelog-1705","page_id":"/changelog","tags":[],"type":"text","url":"/changelog#new-features-30","content":"You can now set an environment variable called $JJ_CONFIG to a path to a\nconfig file. That will then be read instead of your regular config file. This\nis mostly intended for testing and scripts."},"4737":{"id":"/changelog-1706","page_id":"/changelog","tags":[],"type":"text","url":"/changelog#new-features-30","content":"The standard $NO_COLOR environment variable is now\nrespected."},"4738":{"id":"/changelog-1707","page_id":"/changelog","tags":[],"type":"text","url":"/changelog#new-features-30","content":"jj new now lets you specify a description with --message/-m."},"4739":{"id":"/changelog-1708","page_id":"/changelog","tags":[],"type":"text","url":"/changelog#new-features-30","content":"When you check out a commit, the old commit no longer automatically gets\nabandoned if it's empty and has descendants, it only gets abandoned if it's\nempty and does not have descendants."},"4740":{"id":"/changelog-1709","page_id":"/changelog","tags":[],"type":"text","url":"/changelog#new-features-30","content":"When undoing an earlier operation, any new commits on top of commits from the\nundone operation will be rebased away. For example, let's say you rebase\ncommit A so it becomes a new commit A', and then you create commit B on top of\nA'. If you now undo the rebase operation, commit B will be rebased to be on\ntop of A instead. The same logic is used if the repo was modified by\nconcurrent operations (so if one operation added B on top of A, and one\noperation rebased A as A', then B would be automatically rebased on top of\nA'). See #111 for more examples.\n#111"},"4741":{"id":"/changelog-1710","page_id":"/changelog","tags":[],"type":"text","url":"/changelog#new-features-30","content":"jj log now accepts -p/--patch option."},"4742":{"id":"/changelog-1711","page_id":"/changelog","tags":[],"type":"text","url":"/changelog#fixed-bugs-33","content":"Fixed crash on jj init --git-repo=. (it almost always crashed)."},"4743":{"id":"/changelog-1712","page_id":"/changelog","tags":[],"type":"text","url":"/changelog#fixed-bugs-33","content":"When sharing the working copy with a Git repo, the automatic importing and\nexporting (sometimes?) didn't happen on Windows."},"4744":{"id":"/changelog-1713","page_id":"/changelog","tags":[],"type":"text","url":"/changelog#033---2022-03-16","content":"No changes, only trying to get the automated build to work."},"4745":{"id":"/changelog-1714","page_id":"/changelog","tags":[],"type":"text","url":"/changelog#032---2022-03-16","content":"No changes, only trying to get the automated build to work."},"4746":{"id":"/changelog-1715","page_id":"/changelog","tags":[],"type":"text","url":"/changelog#fixed-bugs-34","content":"Fixed crash when core.excludesFile pointed to nonexistent file, and made\nleading ~/ in that config expand to $HOME/\n#131"},"4747":{"id":"/changelog-1716","page_id":"/changelog","tags":[],"type":"text","url":"/changelog#030---2022-03-12","content":"Last release before this changelog started."},"4748":{"id":"/contributing/governance","page_id":"/contributing/governance","type":"page","content":"Jujutsu Governance","tags":[],"url":"/contributing/governance"},"4749":{"id":"/contributing/governance-0","page_id":"/contributing/governance","type":"heading","tags":[],"url":"/contributing/governance#overview","content":"Overview"},"4750":{"id":"/contributing/governance-1","page_id":"/contributing/governance","type":"heading","tags":[],"url":"/contributing/governance#project-roles","content":"Project roles"},"4751":{"id":"/contributing/governance-2","page_id":"/contributing/governance","type":"heading","tags":[],"url":"/contributing/governance#maintainers","content":"Maintainers"},"4752":{"id":"/contributing/governance-3","page_id":"/contributing/governance","type":"heading","tags":[],"url":"/contributing/governance#current-list-of-maintainers","content":"Current list of Maintainers"},"4753":{"id":"/contributing/governance-4","page_id":"/contributing/governance","type":"heading","tags":[],"url":"/contributing/governance#contributors","content":"Contributors"},"4754":{"id":"/contributing/governance-5","page_id":"/contributing/governance","type":"heading","tags":[],"url":"/contributing/governance#processes","content":"Processes"},"4755":{"id":"/contributing/governance-6","page_id":"/contributing/governance","type":"heading","tags":[],"url":"/contributing/governance#decision-making","content":"Decision-Making"},"4756":{"id":"/contributing/governance-7","page_id":"/contributing/governance","type":"heading","tags":[],"url":"/contributing/governance#adding-and-removing-maintainers","content":"Adding and Removing Maintainers"},"4757":{"id":"/contributing/governance-8","page_id":"/contributing/governance","type":"heading","tags":[],"url":"/contributing/governance#single-company-influence","content":"Single-Company Influence"},"4758":{"id":"/contributing/governance-9","page_id":"/contributing/governance","tags":[],"type":"text","url":"/contributing/governance#overview","content":"Jujutsu is an open source project, led, maintained and designed for a worldwide\ncommunity. Anyone who is interested can join, contribute, and participate in the\ndecision-making process. This document is intended to help you understand how\nyou can do that."},"4759":{"id":"/contributing/governance-10","page_id":"/contributing/governance","tags":[],"type":"text","url":"/contributing/governance#project-roles","content":"We greatly appreciate everyone's contributions, and Jujutsu has benefited\ngreatly from people who shared a single idea, change, or a suggestion, without\never becoming a regular contributor. We also want everybody to feel welcome to\nshare their suggestions for the project (as long as you follow the Community\nGuidelines)."},"4760":{"id":"/contributing/governance-11","page_id":"/contributing/governance","tags":[],"type":"text","url":"/contributing/governance#project-roles","content":"There are two special roles for participants in the Jujutsu projects:\nMaintainers and Contributors."},"4761":{"id":"/contributing/governance-12","page_id":"/contributing/governance","tags":[],"type":"text","url":"/contributing/governance#project-roles","content":"The role of the Maintainer is formally defined. These are the people empowered\nto collectively make final decisions about most aspects of the project. They are\nexpected to take community's input seriously and to aim for the benefit of the\nentire community."},"4762":{"id":"/contributing/governance-13","page_id":"/contributing/governance","tags":[],"type":"text","url":"/contributing/governance#project-roles","content":"The role of a Contributor is less formal. In situations where opinions become\nnumerous or contentious, it is acceptable for the maintainers to assign more\nweight to the voices of the more established Contributors."},"4763":{"id":"/contributing/governance-14","page_id":"/contributing/governance","tags":[],"type":"text","url":"/contributing/governance#maintainers","content":"Maintainers are the people who contribute, review, guide, and collectively\nmake decisions about the direction and scope of the project (see:\nDecision Making). Maintainers are elected by a\nvoting process."},"4764":{"id":"/contributing/governance-15","page_id":"/contributing/governance","tags":[],"type":"text","url":"/contributing/governance#maintainers","content":"A typical Maintainer is not only someone who has made \"large\" contributions, but\nsomeone who has shown they are continuously committed to the project and its\ncommunity. Some expected responsibilities of maintainers include (but are not\nexclusively limited to):"},"4765":{"id":"/contributing/governance-16","page_id":"/contributing/governance","tags":[],"type":"text","url":"/contributing/governance#maintainers","content":"Displaying a high level of commitment to the project and its community, and\nbeing a role model for others."},"4766":{"id":"/contributing/governance-17","page_id":"/contributing/governance","tags":[],"type":"text","url":"/contributing/governance#maintainers","content":"Writing patches — a lot of patches, especially \"glue code\" or \"grunt\nwork\" or general \"housekeeping\"; fixing bugs, ensuring documentation is always\nhigh quality, consistent UX design, improving processes, making judgments on\ndependencies, handling security vulnerabilities, and so on and so forth."},"4767":{"id":"/contributing/governance-18","page_id":"/contributing/governance","tags":[],"type":"text","url":"/contributing/governance#maintainers","content":"Reviewing code submitted by others — with an eye to maintainability,\nperformance, code quality, and \"style\" (fitting in with the project)."},"4768":{"id":"/contributing/governance-19","page_id":"/contributing/governance","tags":[],"type":"text","url":"/contributing/governance#maintainers","content":"Participating in design discussions, especially with regards to architecture\nor long-term vision."},"4769":{"id":"/contributing/governance-20","page_id":"/contributing/governance","tags":[],"type":"text","url":"/contributing/governance#maintainers","content":"Ensuring the community remains a warm and welcoming place, to new and veteran\nmembers alike."},"4770":{"id":"/contributing/governance-21","page_id":"/contributing/governance","tags":[],"type":"text","url":"/contributing/governance#maintainers","content":"This is not an exhaustive list, nor is it intended that every Maintainer does\neach and every one of these individual tasks to equal amounts. Rather this is\nonly a guideline for what Maintainers are expected to conceptually do."},"4771":{"id":"/contributing/governance-22","page_id":"/contributing/governance","tags":[],"type":"text","url":"/contributing/governance#maintainers","content":"In short, Maintainers are the outwardly visible stewards of the project."},"4772":{"id":"/contributing/governance-23","page_id":"/contributing/governance","tags":[],"type":"text","url":"/contributing/governance#current-list-of-maintainers","content":"The current list of Maintainers:"},"4773":{"id":"/contributing/governance-24","page_id":"/contributing/governance","tags":[],"type":"text","url":"/contributing/governance#current-list-of-maintainers","content":"Austin Seipp (@thoughtpolice)"},"4774":{"id":"/contributing/governance-25","page_id":"/contributing/governance","tags":[],"type":"text","url":"/contributing/governance#current-list-of-maintainers","content":"Benjamin Tan (@bnjmnt4n)"},"4775":{"id":"/contributing/governance-26","page_id":"/contributing/governance","tags":[],"type":"text","url":"/contributing/governance#current-list-of-maintainers","content":"Ilya Grigoriev (@ilyagr)"},"4776":{"id":"/contributing/governance-27","page_id":"/contributing/governance","tags":[],"type":"text","url":"/contributing/governance#current-list-of-maintainers","content":"Martin von Zweigbergk (@martinvonz)"},"4777":{"id":"/contributing/governance-28","page_id":"/contributing/governance","tags":[],"type":"text","url":"/contributing/governance#current-list-of-maintainers","content":"Scott Taylor (@scott2000)"},"4778":{"id":"/contributing/governance-29","page_id":"/contributing/governance","tags":[],"type":"text","url":"/contributing/governance#current-list-of-maintainers","content":"Waleed Khan (@arxanas)"},"4779":{"id":"/contributing/governance-30","page_id":"/contributing/governance","tags":[],"type":"text","url":"/contributing/governance#current-list-of-maintainers","content":"Yuya Nishihara (@yuja)"},"4780":{"id":"/contributing/governance-31","page_id":"/contributing/governance","tags":[],"type":"text","url":"/contributing/governance#contributors","content":"We consider contributors to be active participants in the project and community\nwho are not maintainers. These are people who might:"},"4781":{"id":"/contributing/governance-32","page_id":"/contributing/governance","tags":[],"type":"text","url":"/contributing/governance#contributors","content":"Help users by answering questions"},"4782":{"id":"/contributing/governance-33","page_id":"/contributing/governance","tags":[],"type":"text","url":"/contributing/governance#contributors","content":"Participating in lively and respectful discussions across various channels"},"4783":{"id":"/contributing/governance-34","page_id":"/contributing/governance","tags":[],"type":"text","url":"/contributing/governance#contributors","content":"Submit high-quality bug reports, reproduce reported bugs, and verifying fixes"},"4784":{"id":"/contributing/governance-35","page_id":"/contributing/governance","tags":[],"type":"text","url":"/contributing/governance#contributors","content":"Submit patches or pull requests"},"4785":{"id":"/contributing/governance-36","page_id":"/contributing/governance","tags":[],"type":"text","url":"/contributing/governance#contributors","content":"Provide reviews and input on others' pull requests"},"4786":{"id":"/contributing/governance-37","page_id":"/contributing/governance","tags":[],"type":"text","url":"/contributing/governance#contributors","content":"Help with testing and quality assurance"},"4787":{"id":"/contributing/governance-38","page_id":"/contributing/governance","tags":[],"type":"text","url":"/contributing/governance#contributors","content":"Submit feedback about planned features, use cases, or bugs"},"4788":{"id":"/contributing/governance-39","page_id":"/contributing/governance","tags":[],"type":"text","url":"/contributing/governance#contributors","content":"We essentially define them as people who actively participate in the\nproject. Examples of things that would not make you a contributor are:"},"4789":{"id":"/contributing/governance-40","page_id":"/contributing/governance","tags":[],"type":"text","url":"/contributing/governance#contributors","content":"Submitting a single bug report and never returning"},"4790":{"id":"/contributing/governance-41","page_id":"/contributing/governance","tags":[],"type":"text","url":"/contributing/governance#contributors","content":"Writing blog posts or other evangelism"},"4791":{"id":"/contributing/governance-42","page_id":"/contributing/governance","tags":[],"type":"text","url":"/contributing/governance#contributors","content":"Using the software in production"},"4792":{"id":"/contributing/governance-43","page_id":"/contributing/governance","tags":[],"type":"text","url":"/contributing/governance#contributors","content":"Forking the project and maintaining your own version"},"4793":{"id":"/contributing/governance-44","page_id":"/contributing/governance","tags":[],"type":"text","url":"/contributing/governance#contributors","content":"Writing a third-party tool or add-on"},"4794":{"id":"/contributing/governance-45","page_id":"/contributing/governance","tags":[],"type":"text","url":"/contributing/governance#contributors","content":"While these are all generally quite valuable, we don't consider these ongoing\ncontributions to the codebase or project itself, and on their own do not\nconstitute \"active participation\"."},"4795":{"id":"/contributing/governance-46","page_id":"/contributing/governance","tags":[],"type":"text","url":"/contributing/governance#processes","content":"For the purposes of making decisions across the project, the following processes\nare defined."},"4796":{"id":"/contributing/governance-47","page_id":"/contributing/governance","tags":[],"type":"text","url":"/contributing/governance#decision-making","content":"The person proposing a decision to be made (i.e. technical, project direction,\netc.) can offer a proposal, along with a 2-to-4 week deadline for discussion.\nDuring this time, Maintainers may participate with a vote of:"},"4797":{"id":"/contributing/governance-48","page_id":"/contributing/governance","tags":[],"type":"text","url":"/contributing/governance#decision-making","content":"A) Support B) Reject C) Abstain"},"4798":{"id":"/contributing/governance-49","page_id":"/contributing/governance","tags":[],"type":"text","url":"/contributing/governance#decision-making","content":"Each Maintainer gets one vote. The total number of \"participating votes\" is the\nnumber of Maintainer votes which are not Abstain. The proposal is accepted when\nmore than half of the participating votes are Support."},"4799":{"id":"/contributing/governance-50","page_id":"/contributing/governance","tags":[],"type":"text","url":"/contributing/governance#decision-making","content":"In the event that a decision is reached before the proposed timeline, said\nproposal can move on and be accepted immediately. In the event no consensus is\nreached, a proposal may be re-submitted later on."},"4800":{"id":"/contributing/governance-51","page_id":"/contributing/governance","tags":[],"type":"text","url":"/contributing/governance#decision-making","content":"This document itself is subject to the Decision-Making process by the existing\nset of Maintainers."},"4801":{"id":"/contributing/governance-52","page_id":"/contributing/governance","tags":[],"type":"text","url":"/contributing/governance#adding-and-removing-maintainers","content":"An active Contributor may, at any given time, nominate themselves or another\nContributor to become a Maintainer. This process is purely optional and no\nContributor is expected to do so; however, self-nomination is encouraged for\nactive participants. A vote and discussion by the existing Maintainers will be\nused to decide the outcome."},"4802":{"id":"/contributing/governance-53","page_id":"/contributing/governance","tags":[],"type":"text","url":"/contributing/governance#adding-and-removing-maintainers","content":"Note that Contributors should demonstrate a high standard of continuous\nparticipation to become a Maintainer; the upper limit on the number of\nMaintainers is practically bounded, and so rejection should be considered as a\nreal possibility. As the scope of the project changes, this limit may increase,\nbut it is fundamentally fluid. (If you are unsure, you are free to privately ask\nexisting Maintainers before self-nominating if there is room.)"},"4803":{"id":"/contributing/governance-54","page_id":"/contributing/governance","tags":[],"type":"text","url":"/contributing/governance#adding-and-removing-maintainers","content":"A Maintainer may, at any time, cede their responsibility and step down without a\nvote."},"4804":{"id":"/contributing/governance-55","page_id":"/contributing/governance","tags":[],"type":"text","url":"/contributing/governance#adding-and-removing-maintainers","content":"A Maintainer can be removed by other Maintainers, subject to a vote of at-least\na 2/3rds majority from the existing Maintainer group (excluding the vote of the\nMaintainer in question). This can be due to lack of participation or conduct\nviolations, among other things. Note that Maintainers are subject to a higher\nset of behavioral and communicative standards than average contributor or\nparticipant."},"4805":{"id":"/contributing/governance-56","page_id":"/contributing/governance","tags":[],"type":"text","url":"/contributing/governance#single-company-influence","content":"At most 1/3 of the maintainers may be paid for their contributions by a single\ncompany. This is to reduce the risk of a single company controlling the\nproject's direction. If the 1/3 limit gets exceeded because an existing\nmaintainer gets hired by the same company as some other existing maintainer(s),\nthen the maintainers will have to decide how to resolve the situation. The\nmaintainer in question gets to vote, as long as this doesn't mean the company\nin question has half the votes (usually meaning there are at least 5 maintainers\ntotal)."}},"count":4805},"sorting":{"language":"english","sortableProperties":["content","page_id","type","url"],"sortablePropertiesWithTypes":{"content":"string","page_id":"string","type":"string","url":"string"},"sorts":{"content":{"docs":{"1":935,"2":1235,"3":1613,"4":1815,"5":2565,"6":2530,"7":2618,"8":2669,"9":4475,"10":4477,"11":2631,"12":3484,"13":1446,"14":2749,"15":1236,"16":1434,"17":1614,"18":1435,"19":1816,"20":1436,"21":826,"22":1437,"23":4210,"24":1438,"25":2619,"26":1439,"27":2670,"28":1440,"29":4479,"30":1441,"31":4478,"32":1442,"33":2570,"34":1443,"35":3485,"36":1444,"37":4724,"38":1575,"39":4626,"40":1822,"41":4617,"42":4552,"43":1795,"44":820,"45":3519,"46":2363,"47":821,"48":819,"49":2080,"50":1796,"51":1794,"52":1819,"53":3626,"54":3627,"55":3628,"56":3629,"57":1801,"58":4625,"59":1802,"60":1798,"61":1797,"62":1799,"63":1826,"64":1824,"65":1925,"66":4297,"67":2322,"68":4430,"69":4429,"70":2081,"71":1886,"72":1859,"73":3479,"74":191,"75":1534,"76":3097,"77":4319,"78":4414,"79":4061,"80":4253,"81":501,"82":4102,"83":872,"84":4747,"85":4336,"86":3829,"87":2065,"88":1874,"89":2607,"90":1905,"91":2032,"92":1893,"93":4