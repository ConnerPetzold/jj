ngelog","type":"heading","tags":[],"url":"/changelog#new-features-29","content":"New features"},"3222":{"id":"/changelog-191","page_id":"/changelog","type":"heading","tags":[],"url":"/changelog#fixed-bugs-32","content":"Fixed bugs"},"3223":{"id":"/changelog-192","page_id":"/changelog","type":"heading","tags":[],"url":"/changelog#040---2022-04-02","content":"[0.4.0] - 2022-04-02"},"3224":{"id":"/changelog-193","page_id":"/changelog","type":"heading","tags":[],"url":"/changelog#breaking-changes-30","content":"Breaking changes"},"3225":{"id":"/changelog-194","page_id":"/changelog","type":"heading","tags":[],"url":"/changelog#new-features-30","content":"New features"},"3226":{"id":"/changelog-195","page_id":"/changelog","type":"heading","tags":[],"url":"/changelog#fixed-bugs-33","content":"Fixed bugs"},"3227":{"id":"/changelog-196","page_id":"/changelog","type":"heading","tags":[],"url":"/changelog#033---2022-03-16","content":"[0.3.3] - 2022-03-16"},"3228":{"id":"/changelog-197","page_id":"/changelog","type":"heading","tags":[],"url":"/changelog#032---2022-03-16","content":"[0.3.2] - 2022-03-16"},"3229":{"id":"/changelog-198","page_id":"/changelog","type":"heading","tags":[],"url":"/changelog#031---2022-03-13","content":"[0.3.1] - 2022-03-13"},"3230":{"id":"/changelog-199","page_id":"/changelog","type":"heading","tags":[],"url":"/changelog#fixed-bugs-34","content":"Fixed bugs"},"3231":{"id":"/changelog-200","page_id":"/changelog","type":"heading","tags":[],"url":"/changelog#030---2022-03-12","content":"[0.3.0] - 2022-03-12"},"3232":{"id":"/changelog-201","page_id":"/changelog","tags":[],"type":"text","url":"/changelog","content":"All notable changes to this project will be documented in this file."},"3233":{"id":"/changelog-202","page_id":"/changelog","tags":[],"type":"text","url":"/changelog","content":"The format is based on Keep a Changelog,\nand this project adheres\nto Semantic Versioning."},"3234":{"id":"/changelog-203","page_id":"/changelog","tags":[],"type":"text","url":"/changelog#breaking-changes","content":"Git repositories are now colocated by default. Configure\ngit.colocate = false to keep the previous behavior."},"3235":{"id":"/changelog-204","page_id":"/changelog","tags":[],"type":"text","url":"/changelog#breaking-changes","content":"Conflicts written by jj < 0.11 are no longer supported. They will now appear\nas regular files with a .jjconflict suffix and JSON contents."},"3236":{"id":"/changelog-205","page_id":"/changelog","tags":[],"type":"text","url":"/changelog#deprecations","content":"Various flags on jj describe and jj commit have been deprecated in favor\nof jj metaedit. They are:"},"3237":{"id":"/changelog-206","page_id":"/changelog","tags":[],"type":"text","url":"/changelog#deprecations","content":"describe: --author, --reset-author, --no-edit"},"3238":{"id":"/changelog-207","page_id":"/changelog","tags":[],"type":"text","url":"/changelog#deprecations","content":"commit: --author, --reset-author"},"3239":{"id":"/changelog-208","page_id":"/changelog","tags":[],"type":"text","url":"/changelog#new-features","content":"The new command jj bisect run uses binary search to find a commit that\nintroduced a bug."},"3240":{"id":"/changelog-209","page_id":"/changelog","tags":[],"type":"text","url":"/changelog#new-features","content":"The default editor on Unix is now nano instead of pico."},"3241":{"id":"/changelog-210","page_id":"/changelog","tags":[],"type":"text","url":"/changelog#new-features","content":"New config option merge.hunk-level = \"word\" to enable word-level merging."},"3242":{"id":"/changelog-211","page_id":"/changelog","tags":[],"type":"text","url":"/changelog#new-features","content":"A new builtin hyperlink(url, text) template alias creates clickable\nhyperlinks using OSC8 escape sequences for terminals that support them."},"3243":{"id":"/changelog-212","page_id":"/changelog","tags":[],"type":"text","url":"/changelog#release-highlights","content":"jj undo is now sequential: invoking it multiple times in sequence\nrepeatedly undoes actions in the operation log. Previously, jj undo would\nonly undo the most recent operation in the operation log. As a result, a new\njj redo command has been added."},"3244":{"id":"/changelog-213","page_id":"/changelog","tags":[],"type":"text","url":"/changelog#release-highlights","content":"Experimental support for improving query performance over filesets and file\nqueries (like jj log path/to/file.txt) has been added. This is not enabled\nby default. To enable this, you must use the jj debug index-changed-paths\ncommand."},"3245":{"id":"/changelog-214","page_id":"/changelog","tags":[],"type":"text","url":"/changelog#breaking-changes-1","content":"jj evolog templates now accept CommitEvolutionEntry as context type. To\nget Commit properties, use commit.<method>(). To customize the default\noutput, set templates.evolog instead of templates.log."},"3246":{"id":"/changelog-215","page_id":"/changelog","tags":[],"type":"text","url":"/changelog#breaking-changes-1","content":"jj op show now uses templates.op_show configuration for its default template\ninstead of templates.op_log."},"3247":{"id":"/changelog-216","page_id":"/changelog","tags":[],"type":"text","url":"/changelog#breaking-changes-1","content":"The deprecated config option git.auto-local-branch has been removed. Use\ngit.auto-local-bookmark instead."},"3248":{"id":"/changelog-217","page_id":"/changelog","tags":[],"type":"text","url":"/changelog#breaking-changes-1","content":"The deprecated Signature.username() template method has been removed. Use\nSignature.email().local() instead."},"3249":{"id":"/changelog-218","page_id":"/changelog","tags":[],"type":"text","url":"/changelog#breaking-changes-1","content":"The deprecated --config-toml flag has been removed. Use\n--config=NAME=VALUE or --config-file=PATH instead."},"3250":{"id":"/changelog-219","page_id":"/changelog","tags":[],"type":"text","url":"/changelog#breaking-changes-1","content":"jj undo can now undo multiple operations progressively by calling it\nrepeatedly, whereas previously, running jj undo twice was previously a no-op\n(it only undid the last change)."},"3251":{"id":"/changelog-220","page_id":"/changelog","tags":[],"type":"text","url":"/changelog#breaking-changes-1","content":"jj git fetch will now only fetch the refspec patterns configured on remotes\nwhen the --bookmark option is omitted. Only simple refspec patterns are\ncurrently supported, and anything else (like refspecs which rename branches)\nwill be ignored."},"3252":{"id":"/changelog-221","page_id":"/changelog","tags":[],"type":"text","url":"/changelog#breaking-changes-1","content":"The conflict label used for coloring log graph nodes was renamed to\nconflicted."},"3253":{"id":"/changelog-222","page_id":"/changelog","tags":[],"type":"text","url":"/changelog#deprecations-1","content":"The on-disk index format has changed. jj will write index files in both old\nand new formats, so old jj versions should be able to read these index\nfiles. This compatibility layer will be removed in a future release."},"3254":{"id":"/changelog-223","page_id":"/changelog","tags":[],"type":"text","url":"/changelog#deprecations-1","content":"jj op undo is deprecated in favor of jj op revert. (jj undo is still\navailable, but with new semantics. See also the breaking changes above.)"},"3255":{"id":"/changelog-224","page_id":"/changelog","tags":[],"type":"text","url":"/changelog#deprecations-1","content":"The argument <operation> of jj undo is deprecated in favor of\njj op revert <operation>."},"3256":{"id":"/changelog-225","page_id":"/changelog","tags":[],"type":"text","url":"/changelog#deprecations-1","content":"The --what flag on jj undo is deprecated. Consider using\njj op restore --what instead."},"3257":{"id":"/changelog-226","page_id":"/changelog","tags":[],"type":"text","url":"/changelog#new-features-1","content":"The new command jj redo can progressively redo operations that were\npreviously undone by multiple calls to jj undo."},"3258":{"id":"/changelog-227","page_id":"/changelog","tags":[],"type":"text","url":"/changelog#new-features-1","content":"Templates now support any() and all() methods on lists to check whether\nany or all elements satisfy a predicate. Example: parents.any(|c| c.mine())\nreturns true if any parent commit is authored by the user."},"3259":{"id":"/changelog-228","page_id":"/changelog","tags":[],"type":"text","url":"/changelog#new-features-1","content":"Add experimental support for indexing changed paths, which will speed up jj\nlog PATH query, jj file annotate, etc. The changed-path index can be\nenabled by jj debug index-changed-paths command. Indexing may take tens of\nminutes depending on the number of merge commits. The indexing command UI is\nsubject to change. #4674"},"3260":{"id":"/changelog-229","page_id":"/changelog","tags":[],"type":"text","url":"/changelog#new-features-1","content":"jj config list now supports -T'json(self) ++ \"\\n\"' serialization output."},"3261":{"id":"/changelog-230","page_id":"/changelog","tags":[],"type":"text","url":"/changelog#new-features-1","content":"jj file show now accepts -T/--template option to insert file metadata."},"3262":{"id":"/changelog-231","page_id":"/changelog","tags":[],"type":"text","url":"/changelog#new-features-1","content":"The template language now allows arbitrary whitespace between any operators."},"3263":{"id":"/changelog-232","page_id":"/changelog","tags":[],"type":"text","url":"/changelog#new-features-1","content":"The new configuration option git.colocate=boolean controls whether or not\nGit repositories are colocated by default."},"3264":{"id":"/changelog-233","page_id":"/changelog","tags":[],"type":"text","url":"/changelog#new-features-1","content":"Both jj git clone and jj git init now take a --no-colocate flag to\ndisable colocation (in case git.colocate is set to true.)"},"3265":{"id":"/changelog-234","page_id":"/changelog","tags":[],"type":"text","url":"/changelog#new-features-1","content":"jj git remote add and jj git clone now support --fetch-tags to control\nwhen tags are fetched for all subsequent fetches."},"3266":{"id":"/changelog-235","page_id":"/changelog","tags":[],"type":"text","url":"/changelog#new-features-1","content":"jj git fetch now supports --tracked to fetch only tracked bookmarks."},"3267":{"id":"/changelog-236","page_id":"/changelog","tags":[],"type":"text","url":"/changelog#new-features-1","content":"jj diff --stat now shows the change in size to binary files."},"3268":{"id":"/changelog-237","page_id":"/changelog","tags":[],"type":"text","url":"/changelog#new-features-1","content":"jj interdiff, jj evolog -p, and jj op log -p now show diff of commit\ndescriptions."},"3269":{"id":"/changelog-238","page_id":"/changelog","tags":[],"type":"text","url":"/changelog#new-features-1","content":"jj log and jj op log output can now be anonymized with the\nbuiltin_log_redacted and builtin_op_log_redacted templates."},"3270":{"id":"/changelog-239","page_id":"/changelog","tags":[],"type":"text","url":"/changelog#new-features-1","content":"jj git init now checks for an upstream remote in addition to origin when\nsetting the repository-level trunk() alias. The upstream remote takes\nprecedence over origin if both exist."},"3271":{"id":"/changelog-240","page_id":"/changelog","tags":[],"type":"text","url":"/changelog#new-features-1","content":"Add the jj metaedit command, which modifies a revision's metadata. This can\nbe used to generate a new change-id, which may help resolve some divergences.\nIt also has options to modify author name, email and timestamp, as well as to\nmodify committer timestamp."},"3272":{"id":"/changelog-241","page_id":"/changelog","tags":[],"type":"text","url":"/changelog#new-features-1","content":"Filesets now support case-insensitive glob patterns with the glob-i:,\ncwd-glob-i:, and root-glob-i: pattern kinds. For example, glob-i:\"*.rs\"\nwill match both file.rs and FILE.RS."},"3273":{"id":"/changelog-242","page_id":"/changelog","tags":[],"type":"text","url":"/changelog#new-features-1","content":"jj op show now accepts -T/--template option to customize the operation\noutput using template expressions, similar to jj op log. Also added\n--no-op-diff flag to suppress the operation diff."},"3274":{"id":"/changelog-243","page_id":"/changelog","tags":[],"type":"text","url":"/changelog#new-features-1","content":"A nearly identical string pattern system as revsets is now supported in the\ntemplate language, and is exposed as string.match(pattern)."},"3275":{"id":"/changelog-244","page_id":"/changelog","tags":[],"type":"text","url":"/changelog#fixed-bugs-1","content":"jj git clone now correctly fetches all tags, unless --fetch-tags is\nexplicitly specified, in which case the specified option will apply for both\nthe initial clone and subsequent fetches."},"3276":{"id":"/changelog-245","page_id":"/changelog","tags":[],"type":"text","url":"/changelog#fixed-bugs-1","content":"Operation and working-copy state files are now synchronized to disk on save.\nThis will mitigate data corruption on system crash.\n#4423"},"3277":{"id":"/changelog-246","page_id":"/changelog","tags":[],"type":"text","url":"/changelog#packaging-changes","content":"The test suite no longer optionally uses Taplo CLI or jq, and packagers can\nremove them as dependencies if present."},"3278":{"id":"/changelog-247","page_id":"/changelog","tags":[],"type":"text","url":"/changelog#contributors","content":"Austin Seipp (@thoughtpolice)"},"3279":{"id":"/changelog-248","page_id":"/changelog","tags":[],"type":"text","url":"/changelog#contributors","content":"Benjamin Tan (@bnjmnt4n)"},"3280":{"id":"/changelog-249","page_id":"/changelog","tags":[],"type":"text","url":"/changelog#contributors","content":"Christian Hufnagel (@OvidiusCicero)"},"3281":{"id":"/changelog-250","page_id":"/changelog","tags":[],"type":"text","url":"/changelog#contributors","content":"Clément (@drawbu)"},"3282":{"id":"/changelog-251","page_id":"/changelog","tags":[],"type":"text","url":"/changelog#contributors","content":"Daniel Luz (@mernen)"},"3283":{"id":"/changelog-252","page_id":"/changelog","tags":[],"type":"text","url":"/changelog#contributors","content":"Emily (@emilazy)"},"3284":{"id":"/changelog-253","page_id":"/changelog","tags":[],"type":"text","url":"/changelog#contributors","content":"Evan Martin (@evmar)"},"3285":{"id":"/changelog-254","page_id":"/changelog","tags":[],"type":"text","url":"/changelog#contributors","content":"Gaëtan Lehmann (@glehmann)"},"3286":{"id":"/changelog-255","page_id":"/changelog","tags":[],"type":"text","url":"/changelog#contributors","content":"George Christou (@gechr)"},"3287":{"id":"/changelog-256","page_id":"/changelog","tags":[],"type":"text","url":"/changelog#contributors","content":"Graham Christensen (@grahamc)"},"3288":{"id":"/changelog-257","page_id":"/changelog","tags":[],"type":"text","url":"/changelog#contributors","content":"Hegui Dai (@Natural-selection1)"},"3289":{"id":"/changelog-258","page_id":"/changelog","tags":[],"type":"text","url":"/changelog#contributors","content":"Ian Wrzesinski (@isuffix)"},"3290":{"id":"/changelog-259","page_id":"/changelog","tags":[],"type":"text","url":"/changelog#contributors","content":"Ilya Grigoriev (@ilyagr)"},"3291":{"id":"/changelog-260","page_id":"/changelog","tags":[],"type":"text","url":"/changelog#contributors","content":"Isaac Corbrey (@icorbrey)"},"3292":{"id":"/changelog-261","page_id":"/changelog","tags":[],"type":"text","url":"/changelog#contributors","content":"Ivan Petkov (@ipetkov)"},"3293":{"id":"/changelog-262","page_id":"/changelog","tags":[],"type":"text","url":"/changelog#contributors","content":"Joaquín Triñanes (@JoaquinTrinanes)"},"3294":{"id":"/changelog-263","page_id":"/changelog","tags":[],"type":"text","url":"/changelog#contributors","content":"Kaiyi Li (@06393993)"},"3295":{"id":"/changelog-264","page_id":"/changelog","tags":[],"type":"text","url":"/changelog#contributors","content":"Martin von Zweigbergk (@martinvonz)"},"3296":{"id":"/changelog-265","page_id":"/changelog","tags":[],"type":"text","url":"/changelog#contributors","content":"Nigthknight (@nigthknight)"},"3297":{"id":"/changelog-266","page_id":"/changelog","tags":[],"type":"text","url":"/changelog#contributors","content":"Nikhil Marathe (@nikhilm)"},"3298":{"id":"/changelog-267","page_id":"/changelog","tags":[],"type":"text","url":"/changelog#contributors","content":"Remo Senekowitsch (@senekor)"},"3299":{"id":"/changelog-268","page_id":"/changelog","tags":[],"type":"text","url":"/changelog#contributors","content":"Tijs-B (@Tijs-B)"},"3300":{"id":"/changelog-269","page_id":"/changelog","tags":[],"type":"text","url":"/changelog#contributors","content":"Yuya Nishihara (@yuja)"},"3301":{"id":"/changelog-270","page_id":"/changelog","tags":[],"type":"text","url":"/changelog#breaking-changes-2","content":"In revsets, symbol expressions (such as change ID prefix) no longer resolve to\nmultiple revisions, and error out if resolved to more than one revisions. Use\nchange_id(prefix) or bookmarks(exact:name) to query divergent changes or\nconflicted bookmarks. Commands like jj rebase no longer require all: to\nspecify multiple destination revisions."},"3302":{"id":"/changelog-271","page_id":"/changelog","tags":[],"type":"text","url":"/changelog#breaking-changes-2","content":"jj op abandon now discards previous versions of a change (or predecessors)\nif they become unreachable from the operation history. The evolution history\nis truncated accordingly."},"3303":{"id":"/changelog-272","page_id":"/changelog","tags":[],"type":"text","url":"/changelog#breaking-changes-2","content":"Once jj op abandon and jj util gc are run in a repository, old versions of\njj might get \"commit not found\" error on jj evolog."},"3304":{"id":"/changelog-273","page_id":"/changelog","tags":[],"type":"text","url":"/changelog#breaking-changes-2","content":"commit.working_copies() template method now returns List<WorkspaceRef>"},"3305":{"id":"/changelog-274","page_id":"/changelog","tags":[],"type":"text","url":"/changelog#breaking-changes-2","content":"The previously predefined amend alias has been removed. You can restore it\nby setting the config aliases.amend = [\"squash\"]."},"3306":{"id":"/changelog-275","page_id":"/changelog","tags":[],"type":"text","url":"/changelog#deprecations-2","content":"The all: revset modifier and ui.always-allow-large-revsets setting is\nplanned to be removed in a future release.\n#6016"},"3307":{"id":"/changelog-276","page_id":"/changelog","tags":[],"type":"text","url":"/changelog#deprecations-2","content":"Rename the core.fsmonitor and core.watchman settings to\nfsmonitor.backend, and fsmonitor.watchman respectively."},"3308":{"id":"/changelog-277","page_id":"/changelog","tags":[],"type":"text","url":"/changelog#new-features-2","content":"jj workspace list now accepts -T/--template option to customize its\noutput via templates."},"3309":{"id":"/changelog-278","page_id":"/changelog","tags":[],"type":"text","url":"/changelog#new-features-2","content":"Added templates.workspace_list template to customize the output of\njj workspace list."},"3310":{"id":"/changelog-279","page_id":"/changelog","tags":[],"type":"text","url":"/changelog#new-features-2","content":"jj fix now buffers the standard error stream from subprocesses and emits\nthe output from each all at once. The file name is printed before the output."},"3311":{"id":"/changelog-280","page_id":"/changelog","tags":[],"type":"text","url":"/changelog#new-features-2","content":"jj status now collapses fully untracked directories into one line.\nIt still fully traverses them while snapshotting but they won't clutter up\nthe output with all of their contents."},"3312":{"id":"/changelog-281","page_id":"/changelog","tags":[],"type":"text","url":"/changelog#new-features-2","content":"Add the working-copy.eol-conversion config which is similar to the git\ncore.autocrlf config. A heuristics is used to detect if a file is a binary\nfile to prevent the EOL conversion from changing binary files unexpectedly."},"3313":{"id":"/changelog-282","page_id":"/changelog","tags":[],"type":"text","url":"/changelog#new-features-2","content":"Add a .parents() method to the\nOperation type in the templating\nlanguage."},"3314":{"id":"/changelog-283","page_id":"/changelog","tags":[],"type":"text","url":"/changelog#new-features-2","content":"Merge tools config can now explicitly forbid using them as diff editors or\ndiff formatters. Built-in tools that do not function well as diff editing\ntools or as diff formatters will now report an error when used as such."},"3315":{"id":"/changelog-284","page_id":"/changelog","tags":[],"type":"text","url":"/changelog#new-features-2","content":"jj diffedit now accepts filesets to edit only the specified paths."},"3316":{"id":"/changelog-285","page_id":"/changelog","tags":[],"type":"text","url":"/changelog#new-features-2","content":"AnnotationLine objects in templates now have a original_line_number() ->\nInteger method."},"3317":{"id":"/changelog-286","page_id":"/changelog","tags":[],"type":"text","url":"/changelog#new-features-2","content":"Commit templates now support .files() to list all existing files at that\nrevision."},"3318":{"id":"/changelog-287","page_id":"/changelog","tags":[],"type":"text","url":"/changelog#new-features-2","content":"Glob patterns now support {foo,bar} syntax. There may be subtle behavior\nchanges as we use the globset library now."},"3319":{"id":"/changelog-288","page_id":"/changelog","tags":[],"type":"text","url":"/changelog#new-features-2","content":"The new bisect(x) revset function can help bisect a range of commits to\nfind when a bug was introduced."},"3320":{"id":"/changelog-289","page_id":"/changelog","tags":[],"type":"text","url":"/changelog#new-features-2","content":"New first_parent() and first_ancestors() revset functions which are\nsimilar to parents() and ancestors(), but only traverse the first parent\nof each commit (similar to Git's --first-parent option)."},"3321":{"id":"/changelog-290","page_id":"/changelog","tags":[],"type":"text","url":"/changelog#new-features-2","content":"New signing.backends.ssh.revocation-list config for specifying a list of revoked\npublic keys for commit signature verification."},"3322":{"id":"/changelog-291","page_id":"/changelog","tags":[],"type":"text","url":"/changelog#new-features-2","content":"jj fix commands now replace $root with the workspace's root path. This is\nuseful for tools stored inside the workspace."},"3323":{"id":"/changelog-292","page_id":"/changelog","tags":[],"type":"text","url":"/changelog#fixed-bugs-2","content":"Fixed an error in jj util gc caused by the empty blob being missing from\nthe Git store. #7062"},"3324":{"id":"/changelog-293","page_id":"/changelog","tags":[],"type":"text","url":"/changelog#fixed-bugs-2","content":"jj op diff -p and jj op log -p now show content diffs from the first\npredecessor only. #7090"},"3325":{"id":"/changelog-294","page_id":"/changelog","tags":[],"type":"text","url":"/changelog#fixed-bugs-2","content":"jj git fetch no longer shows NaN% progress when connecting to slow remotes.\n#7155"},"3326":{"id":"/changelog-295","page_id":"/changelog","tags":[],"type":"text","url":"/changelog#contributors-1","content":"Thanks to the people who made this release happen!"},"3327":{"id":"/changelog-296","page_id":"/changelog","tags":[],"type":"text","url":"/changelog#contributors-1","content":"adamnemecek (@adamnemecek)"},"3328":{"id":"/changelog-297","page_id":"/changelog","tags":[],"type":"text","url":"/changelog#contributors-1","content":"Alexander Kobjolke (@jakalx)"},"3329":{"id":"/changelog-298","page_id":"/changelog","tags":[],"type":"text","url":"/changelog#contributors-1","content":"Apromixately (@Apromixately)"},"3330":{"id":"/changelog-299","page_id":"/changelog","tags":[],"type":"text","url":"/changelog#contributors-1","content":"Austin Seipp (@thoughtpolice)"},"3331":{"id":"/changelog-300","page_id":"/changelog","tags":[],"type":"text","url":"/changelog#contributors-1","content":"Bryce Berger (@bryceberger)"},"3332":{"id":"/changelog-301","page_id":"/changelog","tags":[],"type":"text","url":"/changelog#contributors-1","content":"Daniel Danner (@dnnr)"},"3333":{"id":"/changelog-302","page_id":"/changelog","tags":[],"type":"text","url":"/changelog#contributors-1","content":"Daniel Luz (@mernen)"},"3334":{"id":"/changelog-303","page_id":"/changelog","tags":[],"type":"text","url":"/changelog#contributors-1","content":"Evan Martin (@evmar)"},"3335":{"id":"/changelog-304","page_id":"/changelog","tags":[],"type":"text","url":"/changelog#contributors-1","content":"George Christou (@gechr)"},"3336":{"id":"/changelog-305","page_id":"/changelog","tags":[],"type":"text","url":"/changelog#contributors-1","content":"George Elliott-Hunter (@george-palmsens)"},"3337":{"id":"/changelog-306","page_id":"/changelog","tags":[],"type":"text","url":"/changelog#contributors-1","content":"Hubert Głuchowski (@afishhh)"},"3338":{"id":"/changelog-307","page_id":"/changelog","tags":[],"type":"text","url":"/changelog#contributors-1","content":"Ilya Grigoriev (@ilyagr)"},"3339":{"id":"/changelog-308","page_id":"/changelog","tags":[],"type":"text","url":"/changelog#contributors-1","content":"Jade Lovelace (@lf-)"},"3340":{"id":"/changelog-309","page_id":"/changelog","tags":[],"type":"text","url":"/changelog#contributors-1","content":"Jake Martin (@jake-m-commits)"},"3341":{"id":"/changelog-310","page_id":"/changelog","tags":[],"type":"text","url":"/changelog#contributors-1","content":"Jan Klass (@Kissaki)"},"3342":{"id":"/changelog-311","page_id":"/changelog","tags":[],"type":"text","url":"/changelog#contributors-1","content":"Joaquín Triñanes (@JoaquinTrinanes)"},"3343":{"id":"/changelog-312","page_id":"/changelog","tags":[],"type":"text","url":"/changelog#contributors-1","content":"Josh Steadmon (@steadmon)"},"3344":{"id":"/changelog-313","page_id":"/changelog","tags":[],"type":"text","url":"