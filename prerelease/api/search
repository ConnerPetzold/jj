e"},"371":{"id":"/comparisons/git-command-table-123","page_id":"/comparisons/git-command-table","tags":[],"type":"text","url":"/comparisons/git-command-table","content":"git add -p; git commit --amend"},"372":{"id":"/comparisons/git-command-table-124","page_id":"/comparisons/git-command-table","tags":[],"type":"text","url":"/comparisons/git-command-table","content":"jj squash -i"},"373":{"id":"/comparisons/git-command-table-125","page_id":"/comparisons/git-command-table","tags":[],"type":"text","url":"/comparisons/git-command-table","content":"Move the diff in the working copy into an ancestor"},"374":{"id":"/comparisons/git-command-table-126","page_id":"/comparisons/git-command-table","tags":[],"type":"text","url":"/comparisons/git-command-table","content":"git commit --fixup=X; git rebase -i --autosquash X^"},"375":{"id":"/comparisons/git-command-table-127","page_id":"/comparisons/git-command-table","tags":[],"type":"text","url":"/comparisons/git-command-table","content":"jj squash --into X"},"376":{"id":"/comparisons/git-command-table-128","page_id":"/comparisons/git-command-table","tags":[],"type":"text","url":"/comparisons/git-command-table","content":"Interactively move part of the diff in an arbitrary change to another arbitrary change"},"377":{"id":"/comparisons/git-command-table-129","page_id":"/comparisons/git-command-table","tags":[],"type":"text","url":"/comparisons/git-command-table","content":"Not supported"},"378":{"id":"/comparisons/git-command-table-130","page_id":"/comparisons/git-command-table","tags":[],"type":"text","url":"/comparisons/git-command-table","content":"jj squash -i --from X --into Y"},"379":{"id":"/comparisons/git-command-table-131","page_id":"/comparisons/git-command-table","tags":[],"type":"text","url":"/comparisons/git-command-table","content":"Interactively split the changes in the working copy in two"},"380":{"id":"/comparisons/git-command-table-132","page_id":"/comparisons/git-command-table","tags":[],"type":"text","url":"/comparisons/git-command-table","content":"git commit -p"},"381":{"id":"/comparisons/git-command-table-133","page_id":"/comparisons/git-command-table","tags":[],"type":"text","url":"/comparisons/git-command-table","content":"jj split"},"382":{"id":"/comparisons/git-command-table-134","page_id":"/comparisons/git-command-table","tags":[],"type":"text","url":"/comparisons/git-command-table","content":"Interactively split an arbitrary change in two"},"383":{"id":"/comparisons/git-command-table-135","page_id":"/comparisons/git-command-table","tags":[],"type":"text","url":"/comparisons/git-command-table","content":"Not supported (can be emulated with the \"edit\" action in git rebase -i)"},"384":{"id":"/comparisons/git-command-table-136","page_id":"/comparisons/git-command-table","tags":[],"type":"text","url":"/comparisons/git-command-table","content":"jj split -r <revision>"},"385":{"id":"/comparisons/git-command-table-137","page_id":"/comparisons/git-command-table","tags":[],"type":"text","url":"/comparisons/git-command-table","content":"Interactively edit the diff in a given change"},"386":{"id":"/comparisons/git-command-table-138","page_id":"/comparisons/git-command-table","tags":[],"type":"text","url":"/comparisons/git-command-table","content":"Not supported (can be emulated with the \"edit\" action in git rebase -i)"},"387":{"id":"/comparisons/git-command-table-139","page_id":"/comparisons/git-command-table","tags":[],"type":"text","url":"/comparisons/git-command-table","content":"jj diffedit -r <revision>"},"388":{"id":"/comparisons/git-command-table-140","page_id":"/comparisons/git-command-table","tags":[],"type":"text","url":"/comparisons/git-command-table","content":"Resolve conflicts and continue interrupted operation"},"389":{"id":"/comparisons/git-command-table-141","page_id":"/comparisons/git-command-table","tags":[],"type":"text","url":"/comparisons/git-command-table","content":"echo resolved > filename; git add filename; git rebase/merge/cherry-pick --continue"},"390":{"id":"/comparisons/git-command-table-142","page_id":"/comparisons/git-command-table","tags":[],"type":"text","url":"/comparisons/git-command-table","content":"echo resolved > filename; jj squash"},"391":{"id":"/comparisons/git-command-table-143","page_id":"/comparisons/git-command-table","tags":[],"type":"text","url":"/comparisons/git-command-table","content":"Operations don't get interrupted, so no need to continue."},"392":{"id":"/comparisons/git-command-table-144","page_id":"/comparisons/git-command-table","tags":[],"type":"text","url":"/comparisons/git-command-table","content":"Create a copy of a commit on top of another commit"},"393":{"id":"/comparisons/git-command-table-145","page_id":"/comparisons/git-command-table","tags":[],"type":"text","url":"/comparisons/git-command-table","content":"git co <destination>; git cherry-pick <source>"},"394":{"id":"/comparisons/git-command-table-146","page_id":"/comparisons/git-command-table","tags":[],"type":"text","url":"/comparisons/git-command-table","content":"jj duplicate <source> -d <destination>"},"395":{"id":"/comparisons/git-command-table-147","page_id":"/comparisons/git-command-table","tags":[],"type":"text","url":"/comparisons/git-command-table","content":"Find the root of the working copy (or check if in a repo)"},"396":{"id":"/comparisons/git-command-table-148","page_id":"/comparisons/git-command-table","tags":[],"type":"text","url":"/comparisons/git-command-table","content":"git rev-parse --show-toplevel"},"397":{"id":"/comparisons/git-command-table-149","page_id":"/comparisons/git-command-table","tags":[],"type":"text","url":"/comparisons/git-command-table","content":"jj workspace root"},"398":{"id":"/comparisons/git-command-table-150","page_id":"/comparisons/git-command-table","tags":[],"type":"text","url":"/comparisons/git-command-table","content":"List bookmarks/branches"},"399":{"id":"/comparisons/git-command-table-151","page_id":"/comparisons/git-command-table","tags":[],"type":"text","url":"/comparisons/git-command-table","content":"git branch"},"400":{"id":"/comparisons/git-command-table-152","page_id":"/comparisons/git-command-table","tags":[],"type":"text","url":"/comparisons/git-command-table","content":"jj bookmark list or jj b l for short"},"401":{"id":"/comparisons/git-command-table-153","page_id":"/comparisons/git-command-table","tags":[],"type":"text","url":"/comparisons/git-command-table","content":"Create a bookmark/branch"},"402":{"id":"/comparisons/git-command-table-154","page_id":"/comparisons/git-command-table","tags":[],"type":"text","url":"/comparisons/git-command-table","content":"git branch <name> <revision>"},"403":{"id":"/comparisons/git-command-table-155","page_id":"/comparisons/git-command-table","tags":[],"type":"text","url":"/comparisons/git-command-table","content":"jj bookmark create <name> -r <revision>"},"404":{"id":"/comparisons/git-command-table-156","page_id":"/comparisons/git-command-table","tags":[],"type":"text","url":"/comparisons/git-command-table","content":"Move a bookmark/branch forward"},"405":{"id":"/comparisons/git-command-table-157","page_id":"/comparisons/git-command-table","tags":[],"type":"text","url":"/comparisons/git-command-table","content":"git branch -f <name> <revision>"},"406":{"id":"/comparisons/git-command-table-158","page_id":"/comparisons/git-command-table","tags":[],"type":"text","url":"/comparisons/git-command-table","content":"jj bookmark move <name> --to <revision> or jj b m <name> --to <revision> for short"},"407":{"id":"/comparisons/git-command-table-159","page_id":"/comparisons/git-command-table","tags":[],"type":"text","url":"/comparisons/git-command-table","content":"Move a bookmark/branch backward or sideways"},"408":{"id":"/comparisons/git-command-table-160","page_id":"/comparisons/git-command-table","tags":[],"type":"text","url":"/comparisons/git-command-table","content":"git branch -f <name> <revision>"},"409":{"id":"/comparisons/git-command-table-161","page_id":"/comparisons/git-command-table","tags":[],"type":"text","url":"/comparisons/git-command-table","content":"jj bookmark move <name> --to <revision> --allow-backwards"},"410":{"id":"/comparisons/git-command-table-162","page_id":"/comparisons/git-command-table","tags":[],"type":"text","url":"/comparisons/git-command-table","content":"Delete a bookmark/branch"},"411":{"id":"/comparisons/git-command-table-163","page_id":"/comparisons/git-command-table","tags":[],"type":"text","url":"/comparisons/git-command-table","content":"git branch --delete <name>"},"412":{"id":"/comparisons/git-command-table-164","page_id":"/comparisons/git-command-table","tags":[],"type":"text","url":"/comparisons/git-command-table","content":"jj bookmark delete <name>"},"413":{"id":"/comparisons/git-command-table-165","page_id":"/comparisons/git-command-table","tags":[],"type":"text","url":"/comparisons/git-command-table","content":"See log of operations performed on the repo"},"414":{"id":"/comparisons/git-command-table-166","page_id":"/comparisons/git-command-table","tags":[],"type":"text","url":"/comparisons/git-command-table","content":"Not supported"},"415":{"id":"/comparisons/git-command-table-167","page_id":"/comparisons/git-command-table","tags":[],"type":"text","url":"/comparisons/git-command-table","content":"jj op log"},"416":{"id":"/comparisons/git-command-table-168","page_id":"/comparisons/git-command-table","tags":[],"type":"text","url":"/comparisons/git-command-table","content":"Undo an earlier operation"},"417":{"id":"/comparisons/git-command-table-169","page_id":"/comparisons/git-command-table","tags":[],"type":"text","url":"/comparisons/git-command-table","content":"Not supported"},"418":{"id":"/comparisons/git-command-table-170","page_id":"/comparisons/git-command-table","tags":[],"type":"text","url":"/comparisons/git-command-table","content":"jj undo"},"419":{"id":"/comparisons/git-command-table-171","page_id":"/comparisons/git-command-table","tags":[],"type":"text","url":"/comparisons/git-command-table","content":"A matching jj redo command exists as well."},"420":{"id":"/comparisons/git-command-table-172","page_id":"/comparisons/git-command-table","tags":[],"type":"text","url":"/comparisons/git-command-table","content":"Create a commit that cancels out a previous commit"},"421":{"id":"/comparisons/git-command-table-173","page_id":"/comparisons/git-command-table","tags":[],"type":"text","url":"/comparisons/git-command-table","content":"git revert <revision>"},"422":{"id":"/comparisons/git-command-table-174","page_id":"/comparisons/git-command-table","tags":[],"type":"text","url":"/comparisons/git-command-table","content":"jj revert -r <revision> -B @"},"423":{"id":"/comparisons/git-command-table-175","page_id":"/comparisons/git-command-table","tags":[],"type":"text","url":"/comparisons/git-command-table","content":"Show what revision and author last modified each line of a file"},"424":{"id":"/comparisons/git-command-table-176","page_id":"/comparisons/git-command-table","tags":[],"type":"text","url":"/comparisons/git-command-table","content":"git blame <file>"},"425":{"id":"/comparisons/git-command-table-177","page_id":"/comparisons/git-command-table","tags":[],"type":"text","url":"/comparisons/git-command-table","content":"jj file annotate <path>"},"426":{"id":"/comparisons/git-compatibility","page_id":"/comparisons/git-compatibility","type":"page","content":"Git compatibility","tags":[],"url":"/comparisons/git-compatibility"},"427":{"id":"/comparisons/git-compatibility-0","page_id":"/comparisons/git-compatibility","type":"heading","tags":[],"url":"/comparisons/git-compatibility#supported-features","content":"Supported features"},"428":{"id":"/comparisons/git-compatibility-1","page_id":"/comparisons/git-compatibility","type":"heading","tags":[],"url":"/comparisons/git-compatibility#creating-an-empty-repo","content":"Creating an empty repo"},"429":{"id":"/comparisons/git-compatibility-2","page_id":"/comparisons/git-compatibility","type":"heading","tags":[],"url":"/comparisons/git-compatibility#creating-a-repo-backed-by-an-existing-git-repo","content":"Creating a repo backed by an existing Git repo"},"430":{"id":"/comparisons/git-compatibility-3","page_id":"/comparisons/git-compatibility","type":"heading","tags":[],"url":"/comparisons/git-compatibility#creating-a-repo-by-cloning-a-git-repo","content":"Creating a repo by cloning a Git repo"},"431":{"id":"/comparisons/git-compatibility-4","page_id":"/comparisons/git-compatibility","type":"heading","tags":[],"url":"/comparisons/git-compatibility#colocated-jujutsugit-repos","content":"Colocated Jujutsu/Git repos"},"432":{"id":"/comparisons/git-compatibility-5","page_id":"/comparisons/git-compatibility","type":"heading","tags":[],"url":"/comparisons/git-compatibility#converting-a-repo-into-a-colocated-repo","content":"Converting a repo into a colocated repo"},"433":{"id":"/comparisons/git-compatibility-6","page_id":"/comparisons/git-compatibility","type":"heading","tags":[],"url":"/comparisons/git-compatibility#branches","content":"Branches"},"434":{"id":"/comparisons/git-compatibility-7","page_id":"/comparisons/git-compatibility","type":"heading","tags":[],"url":"/comparisons/git-compatibility#format-mapping-details","content":"Format mapping details"},"435":{"id":"/comparisons/git-compatibility-8","page_id":"/comparisons/git-compatibility","tags":[],"type":"text","url":"/comparisons/git-compatibility","content":"Jujutsu has two backends for storing commits. One of them uses a regular Git\nrepo, which means that you can collaborate with Git users without them even\nknowing that you're not using the git CLI."},"436":{"id":"/comparisons/git-compatibility-9","page_id":"/comparisons/git-compatibility","tags":[],"type":"text","url":"/comparisons/git-compatibility","content":"See jj help git for help about the jj git family of commands, and e.g.\njj help git push for help about a specific command (use jj git push -h for\nbriefer help)."},"437":{"id":"/comparisons/git-compatibility-10","page_id":"/comparisons/git-compatibility","tags":[],"type":"text","url":"/comparisons/git-compatibility#supported-features","content":"The following list describes which Git features Jujutsu is compatible with. For\na comparison with Git, including how workflows are different, see the\nGit-comparison doc."},"438":{"id":"/comparisons/git-compatibility-11","page_id":"/comparisons/git-compatibility","tags":[],"type":"text","url":"/comparisons/git-compatibility#supported-features","content":"Configuration: Partial. The only configuration from Git (e.g. in\n~/.gitconfig) that's respected is the following. Feel free to file a bug if\nyou miss any particular configuration options."},"439":{"id":"/comparisons/git-compatibility-12","page_id":"/comparisons/git-compatibility","tags":[],"type":"text","url":"/comparisons/git-compatibility#supported-features","content":"The configuration of remotes ([remote \"<name>\"]). Only the names and URLs\nare respected (simple fetch refspecs are respected when branches are not\nexplicitly specified on the CLI, and only the last\npushurl is respected)."},"440":{"id":"/comparisons/git-compatibility-13","page_id":"/comparisons/git-compatibility","tags":[],"type":"text","url":"/comparisons/git-compatibility#supported-features","content":"core.excludesFile"},"441":{"id":"/comparisons/git-compatibility-14","page_id":"/comparisons/git-compatibility","tags":[],"type":"text","url":"/comparisons/git-compatibility#supported-features","content":"Authentication: Yes. git is used for remote operations under the hood."},"442":{"id":"/comparisons/git-compatibility-15","page_id":"/comparisons/git-compatibility","tags":[],"type":"text","url":"/comparisons/git-compatibility#supported-features","content":"Branches: Yes. You can read more about\nhow branches work in Jujutsu\nand how they interoperate with Git."},"443":{"id":"/comparisons/git-compatibility-16","page_id":"/comparisons/git-compatibility","tags":[],"type":"text","url":"/comparisons/git-compatibility#supported-features","content":"Tags: Partial. You can check out tagged commits by name (pointed to be\neither annotated or lightweight tags), but you cannot create new tags."},"444":{"id":"/comparisons/git-compatibility-17","page_id":"/comparisons/git-compatibility","tags":[],"type":"text","url":"/comparisons/git-compatibility#supported-features","content":".gitignore: Yes. Patterns in .gitignore files are supported. So are\nignores in .git/info/exclude or configured via Git's core.excludesfile\nconfig. Since working-copy files are snapshotted by every jj command, you\nmight need to run jj file untrack to exclude newly ignored files from the\nworking-copy commit. It's recommended to set up the ignore patterns earlier.\nThe .gitignore support uses a native implementation, so please report a bug\nif you notice any difference compared to git."},"445":{"id":"/comparisons/git-compatibility-18","page_id":"/comparisons/git-compatibility","tags":[],"type":"text","url":"/comparisons/git-compatibility#supported-features","content":".gitattributes: No. There's #53\nabout adding support for at least the eol attribute."},"446":{"id":"/comparisons/git-compatibility-19","page_id":"/comparisons/git-compatibility","tags":[],"type":"text","url":"/comparisons/git-compatibility#supported-features","content":"Hooks: No. There's #405\nspecifically for providing the checks from https://pre-commit.com."},"447":{"id":"/comparisons/git-compatibility-20","page_id":"/comparisons/git-compatibility","tags":[],"type":"text","url":"/comparisons/git-compatibility#supported-features","content":"Merge commits: Yes. Octopus merges (i.e. with more than 2 parents) are\nalso supported."},"448":{"id":"/comparisons/git-compatibility-21","page_id":"/comparisons/git-compatibility","tags":[],"type":"text","url":"/comparisons/git-compatibility#supported-features","content":"Detached HEAD: Yes. Jujutsu supports anonymous branches, so this is a\nnatural state."},"449":{"id":"/comparisons/git-compatibility-22","page_id":"/comparisons/git-compatibility","tags":[],"type":"text","url":"/comparisons/git-compatibility#supported-features","content":"Orphan branch: Yes. Jujutsu has a virtual root commit that appears as\nparent of all commits Git would call \"root commits\"."},"450":{"id":"/comparisons/git-compatibility-23","page_id":"/comparisons/git-compatibility","tags":[],"type":"text","url":"/comparisons/git-compatibility#supported-features","content":"Staging area: Kind of. The staging area will be ignored. For example,\njj diff will show a diff from the Git HEAD to the working copy. There are\nways of fulfilling your use cases without a staging\narea."},"451":{"id":"/comparisons/git-compatibility-24","page_id":"/comparisons/git-compatibility","tags":[],"type":"text","url":"/comparisons/git-compatibility#supported-features","content":"Garbage collection: Yes. It should be safe to run git gc in the Git\nrepo, but it's not tested, so it's probably a good idea to make a backup of\nthe whole workspace first. There's no garbage collection and repacking of\nJujutsu's own data structures yet,\nhowever."},"452":{"id":"/comparisons/git-compatibility-25","page_id":"/comparisons/git-compatibility","tags":[],"type":"text","url":"/comparisons/git-compatibility#supported-features","content":"Bare repositories: Yes. You can use jj git init --git-repo=<path> to\ncreate a repo backed by a bare Git repo."},"453":{"id":"/comparisons/git-compatibility-26","page_id":"/comparisons/git-compatibility","tags":[],"type":"text","url":"/comparisons/git-compatibility#supported-features","content":"Submodules: No. They will not show up in the working copy, but they will\nnot be lost either."},"454":{"id":"/comparisons/git-compatibility-27","page_id":"/comparisons/git-compatibility","tags":[],"type":"text","url":"/comparisons/git-compatibility#supported-features","content":"Partial clones: No."},"455":{"id":"/comparisons/git-compatibility-28","page_id":"/comparisons/git-compatibility","tags":[],"type":"text","url":"/comparisons/git-compatibility#supported-features","content":"Shallow clones: Kind of. Shallow commits all have the virtual root commit as\ntheir parent. However, deepening or fully unshallowing a repository is currently not yet\nsupported and will cause issues."},"456":{"id":"/comparisons/git-compatibility-29","page_id":"/comparisons/git-compatibility","tags":[],"type":"text","url":"/comparisons/git-compatibility#supported-features","content":"git-worktree: No. However, there's native support for multiple working\ncopies backed by a single repo. See the jj workspace family of commands."},"457":{"id":"/comparisons/git-compatibility-30","page_id":"/comparisons/git-compatibility","tags":[],"type":"text","url":"/comparisons/git-compatibility#supported-features","content":"Sparse checkouts: No. However, there's native support for sparse\ncheckouts. See the jj sparse command."},"458":{"id":"/comparisons/git-compatibility-31","page_id":"/comparisons/git-compatibility","tags":[],"type":"text","url":"/comparisons/git-compatibility#supported-features","content":"Signed commits: Yes.\nYou can sign commits automatically by configuration,\nor use the jj sign command."},"459":{"id":"/comparisons/git-compatibility-32","page_id":"/comparisons/git-compatibility","tags":[],"type":"text","url":"/comparisons/git-compatibility#supported-features","content":"Git LFS: No. (#80)"},"460":{"id":"/comparisons/git-compatibility-33","page_id":"/comparisons/git-compatibility","tags":[],"type":"text","url":"/comparisons/git-compatibility#creating-an-empty-repo","content":"To create an empty repo using the Git backend, use jj init --git <name>. Since\nthe command creates a Jujutsu repo, it will have a .jj/ directory. The\nunderlying Git repo will be inside of that directory (currently in\n.jj/repo/store/git/)."},"461":{"id":"/comparisons/git-compatibility-34","page_id":"/comparisons/git-compatibility","tags":[],"type":"text","url":"/comparisons/git-compatibility#creating-a-repo-backed-by-an-existing-git-repo","content":"To create a Jujutsu repo backed by a Git repo you already have on disk, use\njj git init --git-repo=<path to Git repo> <name>. The repo will work similar\nto a Git worktree, meaning that the\nworking copies files and the record of the working-copy commit will be separate,\nbut the commits will be accessible in both repos. Use jj git import to update\nthe Jujutsu repo with changes made in the Git repo. Use jj git export to\nupdate the Git repo with changes made in the Jujutsu repo."},"462":{"id":"/comparisons/git-compatibility-35","page_id":"/comparisons/git-compatibility","tags":[],"type":"text","url":"/comparisons/git-compatibility#creating-a-repo-by-cloning-a-git-repo","content":"To create a Jujutsu repo from a remote Git URL, use jj git clone <URL>\n[<destination>]. For example, jj git clone\nhttps://github.com/octocat/Hello-World will clone GitHub's \"Hello-World\" repo\ninto a directory by the same name."},"463":{"id":"/comparisons/git-compatibility-36","page_id":"/comparisons/git-compatibility","tags":[],"type":"text","url":"/comparisons/git-compatibility#creating-a-repo-by-cloning-a-git-repo","content":"By default, the remote repository will be named origin. You can use\na name of your choice by adding --remote <remote name> to the jj\ngit clone command."},"464":{"id":"/comparisons/git-compatibility-37","page_id":"/comparisons/git-compatibility","tags":[],"type":"text","url":"/comparisons/git-compatibility#colocated-jujutsugit-repos","content":"A colocated Jujutsu repo is a hybrid Jujutsu/Git repo. This is the default\nfor Git-backed repositories created with jj git init or jj git clone.\nThe Git repo and the Jujutsu repo then share the same working copy. Jujutsu will\nimport and export from and to the Git repo on every jj command automatically."},"465":{"id":"/comparisons/git-compatibility-38","page_id":"/comparisons/git-compatibility","tags":[],"type":"text","url":"/comparisons/git-compatibility#colocated-jujutsugit-repos","content":"This mode is very convenient when tools (e.g. build tools) expect a Git repo to\nbe present."},"466":{"id":"/comparisons/git-compatibility-39","page_id":"/comparisons/git-compatibility","tags":[],"type":"text","url":"/comparisons/git-compatibility#colocated-jujutsugit-repos","content":"It is allowed to mix jj and git commands in such a repo in any order.\nHowever, it may be easier to keep track of what is going on if you mostly use\nread-only git commands and use jj to make changes to the repo. One reason\nfor this (see below for more) is that jj commands will usually put the git\nrepo in a \"detached HEAD\" state, since in jj there is not concept of a\n\"currently tracked branch\". Before doing mutating Git commands, you may need to\ntell Git what the current branch should be with a git switch command."},"467":{"id":"/comparisons/git-compatibility-40","page_id":"/comparisons/git-compatibility","tags":[],"type":"text","url":"/comparisons/git-compatibility#colocated-jujutsugit-repos","content":"You can undo the results of mutating git commands using jj undo and jj op\nrestore. Inside jj op log, changes by git will be represented as an \"import\ngit refs\" operation."},"468":{"id":"/comparisons/git-compatibility-41","page_id":"/comparisons/git-compatibility","tags":[],"type":"text","url":"/comparisons/git-compatibility#colocated-jujutsugit-repos","content":"There are a few downsides to this mode of operation. Generally, using colocated\nrepos may require you to deal with more involved Jujutsu and Git concepts.\nYou can disable colocation with the --no-colocate flag on the commands\njj git init and jj git clone or by setting the configuration\ngit.colocate = false."},"469":{"id":"/comparisons/git-compatibility-42","page_id":"/comparisons/git-compatibility","tags":[],"type":"text","url":"/comparisons/git-compatibility#colocated-jujutsugit-repos","content":"Interleaving jj and git commands increases the chance of confusing branch\nconflicts or conflicted (AKA divergent) change\nids. These never lose data, but can be\nannoying."},"470":{"id":"/comparisons/git-compatibility-43","page_id":"/comparisons/git-compatibility","tags":[],"type":"text","url":"/comparisons/git-compatibility#colocated-jujutsugit-repos","content":"Such interleaving can happen unknowingly. For example, some IDEs can cause\nit because they automatically run git fetch in the background from time to\ntime."},"471":{"id":"/comparisons/git-compatibility-44","page_id":"/comparisons/git-compatibility","tags":[],"type":"text","url":"/comparisons/git-compatibility#colocated-jujutsugit-repos","content":"In colocated repos with a very large number of branches or other refs, jj\ncommands can get noticeably slower because of the automatic jj git import\nexecuted on each command. This can be mitigated by occasionally running jj util\ngc to speed up the import (that command includes packing the Git refs)."},"472":{"id":"/comparisons/git-compatibility-45","page_id":"/comparisons/git-compatibility","tags":[],"type":"text","url":"/comparisons/git-compatibility#colocated-jujutsugit-repos","content":"Git tools will have trouble with revisions that contain conflicted files. While\njj renders these files with conflict markers in the working copy, they are\nstored in a non-human-readable fashion inside the repo. Git tools will often\nsee this non-human-readable representation."},"473":{"id":"/comparisons/git-compatibility-46","page_id":"/comparisons/git-compatibility","tags":[],"type":"text","url":"/comparisons/git-compatibility#colocated-jujutsugit-repos","content":"When a jj branch is conflicted, the position of the branch in the Git repo\nwill disagree with one or more of the conflicted positions. The state of that\nbranch in git will be labeled as though it belongs to a remote named \"git\",\ne.g. branch@git."},"474":{"id":"/comparisons/git-compatibility-47","page_id":"/comparisons/git-compatibility","tags":[],"type":"text","url":"/comparisons/git-compatibility#colocated-jujutsugit-repos","content":"Jujutsu will ignore Git's staging area. It will not understand merge conflicts\nas Git represents them, unfinished git rebase states, as well as other less\ncommon states a Git repository can be in."},"475":{"id":"/comparisons/git-compatibility-48","page_id":"/comparisons/git-compatibility","tags":[],"type":"text","url":"/comparisons/git-compatibility#colocated-jujutsugit-repos","content":"Colocated repositories are less resilient to\nconcurrency\nissues if you share the repo using an NFS filesystem or Dropbox. In general,\nsuch use of Jujutsu is not currently thoroughly tested."},"476":{"id":"/comparisons/git-compatibility-49","page_id":"/comparisons/git-compatibility","tags":[],"type":"text","url":"/comparisons/git-compatibility#colocated-jujutsugit-repos","content":"There may still be bugs when interleaving mutating jj and git commands,\nusually having to do with a branch pointer ending up in the wrong place. We\nare working on the known ones, and are not aware of any major ones. Please\nreport any new ones you find, or if any of the known bugs are less minor than\nthey appear."},"477":{"id":"/comparisons/git-compatibility-50","page_id":"/comparisons/git-compatibility","tags":[],"type":"text","url":"/comparisons/git-compatibility#converting-a-repo-into-a-colocated-repo","content":"A Jujutsu repo backed by a Git repo has a full Git repo inside, so it is\ntechnically possible (though not officially supported) to convert it into a\ncolocated repo like so:"},"478":{"id":"/comparisons/git-compatibility-51","page_id":"/comparisons/git-compatibility","tags":[],"type":"text","url":"/comparisons/git-compatibility#converting-a-repo-into-a-colocated-repo","content":"type: warning"},"479":{"id":"/comparisons/git-compatibility-52","page_id":"/comparisons/git-compatibility","tags":[],"type":"text","url":"/comparisons/git-compatibility#converting-a-repo-into-a-colocated-repo","content":"On Windows, the echo command will append line endings and cause jj\nto complain about the contents of git_target."},"480":{"id":"/comparisons/git-compatibility-53","page_id":"/comparisons/git-compatibility","tags":[],"type":"text","url":"/comparisons/git-compatibility#converting-a-repo-into-a-colocated-repo","content":"Instead of the echo -n ... line, use:\nSet-Content -Path .jj/repo/store/git_target -Value ../../../.git -NoNewLine"},"481":{"id":"/comparisons/git-compatibility-54","page_id":"/comparisons/git-compatibility","tags":[],"type":"text","url":"/comparisons/git-compatibility#converting-a-repo-into-a-colocated-repo","content":"We may officially support this in the future. If you try this, we would\nappreciate feedback and bug reports."},"482":{"id":"/comparisons/git-compatibility-55","page_id":"/comparisons/git-compatibility","tags":[],"type":"text","url":"/comparisons/git-compatibility#branches","content":"TODO: Describe how branches are mapped"},"483":{"id":"/comparisons/git-compatibility-56","page_id":"/comparisons/git-compatibility","tags":[],"type":"text","url":"/comparisons/git-compatibility#format-mapping-details","content":"Paths are assumed to be UTF-8. I have no current plans to support paths with\nother encodings."},"484":{"id":"/comparisons/git-compatibility-57","page_id":"/comparisons/git-compatibility","tags":[],"type":"text","url":"/comparisons/git-compatibility#format-mapping-details","content":"Commits created by jj have a ref starting with refs/jj/ to prevent GC."},"485":{"id":"/comparisons/git-compatibility-58","page_id":"/comparisons/git-compatibility","tags":[],"type":"text","url":"/comparisons/git-compatibility#format-mapping-details","content":"Commit metadata that cannot be represented in Git commits (such as the Change\nID and information about conflicts) is stored outside of the Git repo (currently\nin .jj/store/extra/)."},"486":{"id":"/comparisons/git-compatibility-59","page_id":"/comparisons/git-compatibility","tags":[],"type":"text","url":"/comparisons/git-compatibility#format-mapping-details","content":"Commits with conflicts cannot be represented in Git. They appear in the Git\ncommit as as root directories called.jjconflict-base-*/ and\n.jjconflict-side-*/. Note that the purpose of this representation is only to\nprevent GC of the relevant trees; the authoritative information is in the\nGit-external storage mentioned in the paragraph above. As long as you use jj\ncommands to work with them, you won't notice those paths. If, on the other hand,\nyou use e.g. git switch to check one of them out, you will see those\ndirectories in your working copy. If you then run e.g. jj status, the\nresulting snapshot will contain those directories, making it look like they\nreplaced all the other paths in your repo. You will probably want to run\njj abandon to get back to the state with the unresolved conflicts."},"487":{"id":"/comparisons/git-compatibility-60","page_id":"/comparisons/git-compatibility","tags":[],"type":"text","url":"/comparisons/git-compatibility#format-mapping-details","content":"Change IDs are stored in git commit headers as reverse hex encodings. These is\na non-standard header and is not preserved by all git tooling. For example,\nthe header is preserved by a git commit --amend, but is not preserved through\na rebase operation. GitHub and other major forges seem to preserve them for the\nmost part. This functionality is currently behind a git.write-change-id-header\nflag."},"488":{"id":"/comparisons/git","page_id":"/comparisons/git","type":"page","content":"Comparison with Git","tags":[],"url":"/comparisons/git"},"489":{"id":"/comparisons/git-0","page_id":"/comparisons/git","type":"heading","tags":[],"url":"/comparisons/git#introduction","content":"Introduction"},"490":{"id":"/comparisons/git-1","page_id":"/comparisons/git","type":"heading","tags":[],"url":"/comparisons/git#overview","content":"Overview"},"491":{"id":"/comparisons/git-2","page_id":"/comparisons/git","type":"heading","tags":[],"url":"/comparisons/git#the-index","content":"The index"},"492":{"id":"/comparisons/git-3","page_id":"/comparisons/git","tags":[],"type":"text","url":"/comparisons/git#introduction","content":"This document attempts to describe how Jujutsu is different from Git. See\nthe Git-compatibility doc for information about how\nthe jj command interoperates with Git repos. See\nthe Git command table for a table of similar commands."},"493":{"id":"/comparisons/git-4","page_id":"/comparisons/git","tags":[],"type":"text","url":"/comparisons/git#overview","content":"Here is a list of conceptual differences between Jujutsu and Git, along with\nlinks to more details where applicable and available. There's a\ntable explaining how to achieve various use cases."},"494":{"id":"/comparisons/git-5","page_id":"/comparisons/git","tags":[],"type":"text","url":"/comparisons/git#overview","content":"The working copy is automatically committed. That results in a simpler and\nmore consistent CLI because the working copy is now treated like any other\ncommit. Details."},"495":{"id":"/comparisons/git-6","page_id":"/comparisons/git","tags":[],"type":"text","url":"/comparisons/git#overview","content":"There's no index (staging area). Because the working copy is automatically\ncommitted, an index-like concept doesn't make sense. The index is very similar\nto an intermediate commit between HEAD and the working copy, so workflows\nthat depend on it can be modeled using proper commits instead. Jujutsu has\nexcellent support for moving changes between commits. Details."},"496":{"id":"/comparisons/git-7","page_id":"/comparisons/git","tags":[],"type":"text","url":"/comparisons/git#overview","content":"No need for branch names (but they are supported as\nbookmarks). Git lets you check out a commit without\nattaching a branch to it. It calls this state \"detached HEAD\". This is the\nnormal state in Jujutsu (there's actually no way -- yet, at least -- to have\nan active branch/bookmark). However, Jujutsu keeps track of all visible heads\n(leaves) of the commit graph, so the commits won't get lost or\ngarbage-collected."},"497":{"id":"/comparisons/git-8","page_id":"/comparisons/git","tags":[],"type":"text","url":"/comparisons/git#overview","content":"No current branch. Git lets you check out a branch, making it the 'current\nbranch', and new commits will automatically update the branch. This is\nnecessary in Git because Git might otherwise lose track of the new commits."},"498":{"id":"/comparisons/git-9","page_id":"/comparisons/git","tags":[],"type":"text","url":"/comparisons/git#overview","content":"Jujutsu does not have a corresponding concept of a 'current bookmark';\ninstead, you update bookmarks manually. For example, if you start work on top\nof a commit with a bookmark, new commits are created on top of the bookmark,\nthen you issue a later command to update the bookmark."},"499":{"id":"/comparisons/git-10","page_id":"/comparisons/git","tags":[],"type":"text","url":"/comparisons/git#overview","content":"Conflicts can be committed. No commands fail because of merge conflicts.\nThe conflicts are instead recorded in commits and you can resolve them later.\nDetails."},"500":{"id":"/comparisons/git-11","page_id":"/comparisons/git","tags":[],"type":"text","url":"/comparisons/git#overview","content":"Descendant commits are automatically rebased. Whenever you rewrite a\ncommit (e.g. by running jj rebase), all its descendants commits will\nautomatically be rebased on top. Branches pointing to it will also get\nupdated, and so will the working copy if it points to any of the rebased\ncommits."},"501":{"id":"/comparisons/git-12","page_id":"/comparisons/git","tags":[],"type":"text","url":"/comparisons/git#overview","content":"Bookmarks/branches are identified by their names (across remotes). For\nexample, if you pull from a remote that has a main branch, you'll get a\nbookmark by that name in your local repo. If you then move it and push back to\nthe remote, the main branch on the remote will be updated.\nDetails."},"502":{"id":"/comparisons/git-13","page_id":"/comparisons/git","tags":[],"type":"text","url":"/comparisons/git#overview","content":"The operation log replaces reflogs. The operation log is similar to\nreflogs, but is much more powerful. It keeps track of atomic updates to all\nrefs at once (Jujutsu thus improves on Git's per-ref history much in the same\nway that Subversion improved on RCS's per-file history). The operation log\npowers e.g. the undo functionality. Details."},"503":{"id":"/comparisons/git-14","page_id":"/comparisons/git","tags":[],"type":"text","url":"/comparisons/git#overview","content":"There's a single, virtual root commit. Like Mercurial, Jujutsu has a\nvirtual commit (with a hash consisting of only zeros) called the \"root commit\"\n(called the \"null revision\" in Mercurial). This commit is a common ancestor of\nall commits. That removes the awkward state Git calls the \"unborn branch\"\nstate (which is the state a newly initialized Git repo is in), and related\ncommand-line flags (e.g. git rebase --root, git checkout --orphan)."},"504":{"id":"/comparisons/git-15","page_id":"/comparisons/git","tags":[],"type":"text","url":"/comparisons/git#the-index","content":"Git's \"index\" has\nmultiple roles. One role is as a cache of file system information. Jujutsu has\nsomething similar. Unfortunately, Git exposes the index to the user, which makes\nthe CLI unnecessarily complicated (learning what the different flavors of\ngit reset do, especially when combined with commits and/or paths, usually\ntakes a while). Jujutsu, like Mercurial, doesn't make that mistake."},"505":{"id":"/comparisons/git-16","page_id":"/comparisons/git","tags":[],"type":"text","url":"/comparisons/git#the-index","content":"As a Git power-user, you may think that you need the power of the index to\ncommit only part of the working copy. However, Jujutsu provides commands for\nmore directly achieving most use cases you're used to using Git's index for. For\nexample, to create a commit from part of the changes in the working copy, you\nmight be used to using git add -p; git commit. With Jujutsu, you'd instead\nuse jj split to split the working-copy commit into two commits. To add more\nchanges into the parent commit, which you might normally use\ngit add -p; git commit --amend for, you can instead use jj squash -i to\nchoose which changes to move into the parent commit, or jj squash <file> to\nmove a specific file."},"506":{"id":"/comparisons/related-work","page_id":"/comparisons/related-work","type":"page","content":"Related work","tags":[],"url":"/comparisons/related-work"},"507":{"id":"/comparisons/related-work-0","page_id":"/comparisons/related-work","tags":[],"type":"text","url":"/comparisons/related-work","content":"Similar tools:"},"508":{"id":"/comparisons/related-work-1","page_id":"/comparisons/related-work","tags":[],"type":"text","url":"/comparisons/related-work","content":"git-branchless: Helps you use a\nbranchless workflow in your Git repo. Supports anonymous branching, undo,\nand faster rebase (git move). Under heavy development and quickly gaining\nnew features."},"509":{"id":"/comparisons/related-work-2","page_id":"/comparisons/related-work","tags":[],"type":"text","url":"/comparisons/related-work","content":"Sapling: A heavily modified fork of\nMercurial developed and used at Meta. It\nis compatible with Git, has undo functionality, and\na graphical interface.\nSee how it is different from Jujutsu."},"510":{"id":"/comparisons/related-work-3","page_id":"/comparisons/related-work","tags":[],"type":"text","url":"/comparisons/related-work","content":"GitUp: A Mac-only GUI for Git. Like Jujutsu, supports\nundo and restoring the repo to an earlier snapshot. Backed by its\nGitUpKit library."},"511":{"id":"/comparisons/related-work-4","page_id":"/comparisons/related-work","tags":[],"type":"text","url":"/comparisons/related-work","content":"Gitless: Another attempt at providing a simpler\ninterface for Git. Like Jujutsu, does not have an \"index\"/\"staging area\"\nconcept. Also doesn't move the working-copy changes between branches (which\nwe do simply as a consequence of making the working copy a commit)."},"512":{"id":"/comparisons/related-work-5","page_id":"/comparisons/related-work","tags":[],"type":"text","url":"/comparisons/related-work","content":"Breezy: Another VCS that's similar in that it\nhas multiple storage backends, including its own format as well as .git\nsupport."},"513":{"id":"/comparisons/related-work-6","page_id":"/comparisons/related-work","tags":[],"type":"text","url":"/comparisons/related-work","content":"GitButler: A Git client that works with multiple\nvirtual branches simultaneously, first-class conflicts, and operations history."},"514":{"id":"/comparisons/sapling","page_id":"/comparisons/sapling","type":"page","content":"Comparison with Sapling","tags":[],"url":"/comparisons/sapling"},"515":{"id":"/comparisons/sapling-0","page_id":"/comparisons/sapling","type":"heading","tags":[],"url":"/comparisons/sapling#introduction","content":"Introduction"},"516":{"id":"/comparisons/sapling-1","page_id":"/comparisons/sapling","type":"heading","tags":[],"url":"/comparisons/sapling#differences","content":"Differences"},"517":{"id":"/comparisons/sapling-2","page_id":"/comparisons/sapling","tags":[],"type":"text","url":"/comparisons/sapling#introduction","content":"This document attempts to describe how jj is different\nfrom Sapling. Sapling is a VCS developed by Meta. It\nwas announced about 3 years after development started on jj. It is a heavily\nmodified fork of Mercurial. Because jj has\ncopied many ideas from Mercurial, there are many similarities between the two\ntools, such as:"},"518":{"id":"/comparisons/sapling-3","page_id":"/comparisons/sapling","tags":[],"type":"text","url":"/comparisons/sapling#introduction","content":"A user-friendly CLI"},"519":{"id":"/comparisons/sapling-4","page_id":"/comparisons/sapling","tags":[],"type":"text","url":"/comparisons/sapling#introduction","content":"A \"revset\" language for selecting revisions"},"520":{"id":"/comparisons/sapling-5","page_id":"/comparisons/sapling","tags":[],"type":"text","url":"/comparisons/sapling#introduction","content":"Good support for working with stacked commits, including tracking \"anonymous\nheads\" (no \"detached HEAD\" state like in Git) and split commands, and\nautomatically rebasing descendant commits when you amend a commit."},"521":{"id":"/comparisons/sapling-6","page_id":"/comparisons/sapling","tags":[],"type":"text","url":"/comparisons/sapling#introduction","content":"Flexible customization of output using templates"},"522":{"id":"/comparisons/sapling-7","page_id":"/comparisons/sapling","tags":[],"type":"text","url":"/comparisons/sapling#differences","content":"Here is a list of some differences between jj and Sapling."},"523":{"id":"/comparisons/sapling-8","page_id":"/comparisons/sapling","tags":[],"type":"text","url":"/comparisons/sapling#differences","content":"Working copy: When using Sapling (like most VCSs), the\nuser explicitly tells the tool when to create a commit and which files to\ninclude. When using jj, the working copy\nis automatically snapshotted by every command. New files\nare automatically tracked and deleted files are automatically untracked. This\nhas several advantages:"},"524":{"id":"/comparisons/sapling-9","page_id":"/comparisons/sapling","tags":[],"type":"text","url":"/comparisons/sapling#differences","content":"The working copy is effectively backed up every time you run a command."},"525":{"id":"/comparisons/sapling-10","page_id":"/comparisons/sapling","tags":[],"type":"text","url":"/comparisons/sapling#differences","content":"No commands fail because you have changes in the working copy (\"abort: 1\nconflicting file changes: ...\"). No need for sl shelve."},"526":{"id":"/comparisons/sapling-11","page_id":"/comparisons/sapling","tags":[],"type":"text","url":"/comparisons/sapling#differences","content":"Simpler and more consistent CLI because the working copy is treated like any\nother commit."},"527":{"id":"/comparisons/sapling-12","page_id":"/comparisons/sapling","tags":[],"type":"text","url":"/comparisons/sapling#differences","content":"Conflicts: Like most VCSs, Sapling requires the user to\nresolve conflicts before committing. jj lets\nyou commit conflicts. Note that it's a representation of the\nconflict that's committed, not conflict markers (<<<<<<< etc.). This also\nhas several advantages:"},"528":{"id":"/comparisons/sapling-13","page_id":"/comparisons/sapling","tags":[],"type":"text","url":"/comparisons/sapling#differences","content":"Merge conflicts won't prevent you from checking out another commit."},"529":{"id":"/comparisons/sapling-14","page_id":"/comparisons/sapling","tags":[],"type":"text","url":"/comparisons/sapling#differences","content":"You can resolve the conflicts when you feel like it."},"530":{"id":"/comparisons/sapling-15","page_id":"/comparisons/sapling","tags":[],"type":"text","url":"/comparisons/sapling#differences","content":"Rebasing descendants always succeeds. Like jj, Sapling automatically\nrebases, but it will fail if there are conflicts."},"531":{"id":"/comparisons/sapling-16","page_id":"/comparisons/sapling","tags":[],"type":"text","url":"/comparisons/sapling#differences","content":"Merge commits can be rebased correctly (Sapling sometimes fails)."},"532":{"id":"/comparisons/sapling-17","page_id":"/comparisons/sapling","tags":[],"type":"text","url":"/comparisons/sapling#differences","content":"You can rebase conflicts and conflict resolutions."},"533":{"id":"/comparisons/sapling-18","page_id":"/comparisons/sapling","tags":[],"type":"text","url":"/comparisons/sapling#differences","content":"Undo: jj's undo is powered by the operation log, which\nrecords how the repo has changed over time. Sapling has a similar feature\nwith its MetaLog.\nThey seem to provide similar functionality, but jj also exposes the log to the\nuser via jj op log, so you can tell how far back you want to go back.\nSapling has sl debugmetalog, but that seems to show the history of a single\ncommit, not the whole repo's history. Thanks to jj snapshotting the working\ncopy, it's possible to undo changes to the working copy. For example, if\nyou jj undo a  jj commit, jj diff will show the same changes as\nbefore jj commit, but if you sl undo a sl commit, the working copy will\nbe clean."},"534":{"id":"/comparisons/sapling-19","page_id":"/comparisons/sapling","tags":[],"type":"text","url":"/comparisons/sapling#differences","content":"Git interop: Sapling supports cloning, pushing, and pulling from a remote\nGit repo. jj also does, and it also supports sharing a working copy with a Git\nrepo, so you can use jj and git interchangeably in the same repo."},"535":{"id":"/comparisons/sapling-20","page_id":"/comparisons/sapling","tags":[],"type":"text","url":"/comparisons/sapling#differences","content":"Polish: Sapling is more polished and feature-complete. Sapling has very\nnice built-in web UI called\nInteractive Smartlog, which lets\nyou drag and drop commits to rebase them, among other things."},"536":{"id":"/comparisons/sapling-21","page_id":"/comparisons/sapling","tags":[],"type":"text","url":"/comparisons/sapling#differences","content":"Forge workflow: Sapling has sl pr submit --stack, which lets you\npush a stack of commits as separate GitHub PRs, including setting the base\nbranch. It only supports GitHub. jj doesn't have any direct integration with\nGitHub or any other forge. However, it has jj git push --change for\nautomatically creating branches for specified commits. You have to specify\neach commit you want to create a branch for by using\njj git push --change X --change Y ..., and you have to manually set up any\nbase branches in GitHub's UI (or GitLab's or ...). On subsequent pushes, you\ncan update all at once by specifying something like jj git push -r main..@\n(to push all branches on the current stack of commits from where it forked\nfrom main)."},"537":{"id":"/concepts/bookmarks","page_id":"/concepts/bookmarks","type":"page","content":"Bookmarks","tags":[],"url":"/concepts/bookmarks"},"538":{"id":"/concepts/bookmarks-0","page_id":"/concepts/bookmarks","type":"heading","tags":[],"url":"/concepts/bookmarks#introduction","content":"Introduction"},"539":{"id":"/concepts/bookmarks-1","page_id":"/concepts/bookmarks","type":"heading","tags":[],"url":"/concepts/bookmarks#mapping-to-git-branches","content":"Mapping to Git branches"},"540":{"id":"/concepts/bookmarks-2","page_id":"/concepts/bookmarks","type":"heading","tags":[],"url":"/concepts/bookmarks#remotes-and-tracked-bookmarks","content":"Remotes and tracked bookmarks"},"541":{"id":"/concepts/bookmarks-3","page_id":"/concepts/bookmarks","type":"heading","tags":[],"url":"/concepts/bookmarks#terminology-summary","content":"Terminology summary"},"542":{"id":"/concepts/bookmarks-4","page_id":"/concepts/bookmarks","type":"heading","tags":[],"url":"/concepts/bookmarks#manually-tracking-a-bookmark","content":"Manually tracking a bookmark"},"543":{"id":"/concepts/bookmarks-5","page_id":"/concepts/bookmarks","type":"heading","tags":[],"url":"/concepts/bookmarks#untracking-a-bookmark","content":"Untracking a bookmark"},"544":{"id":"/concepts/bookmarks-6","page_id":"/concepts/bookmarks","type":"heading","tags":[],"url":"/concepts/bookmarks#listing-tracked-bookmarks","content":"Listing tracked bookmarks"},"545":{"id":"/concepts/bookmarks-7","page_id":"/concepts/bookmarks","type":"heading","tags":[],"url":"/concepts/bookmarks#automatic-tracking-of-bookmarks--gitauto-local-bookmark-option","content":"Automatic tracking of bookmarks & git.auto-local-bookmark option"},"546":{"id":"/concepts/bookmarks-8","page_id":"/concepts/bookmarks","type":"heading","tags":[],"url":"/concepts/bookmarks#bookmark-movement","content":"Bookmark movement"},"547":{"id":"/concepts/bookmarks-9","page_id":"/concepts/bookmarks","type":"heading","tags":[],"url":"/concepts/bookmarks#pushing-bookmarks-safety-checks","content":"Pushing bookmarks: Safety checks"},"548":{"id":"/concepts/bookmarks-10","page_id":"/concepts/bookmarks","type":"heading","tags":[],"url":"/concepts/bookmarks#conflicts","content":"Conflicts"},"549":{"id":"/concepts/bookmarks-11","page_id":"/concepts/bookmarks","type":"heading","tags":[],"url":"/concepts/bookmarks#ease-of-use","content":"Ease of use"},"550":{"id":"/concepts/bookmarks-12","page_id":"/concepts/bookmarks","tags":[],"type":"text","url":"/concepts/bookmarks#introduction","content":"Bookmarks are named pointers to revisions (just like branches are in Git). You\ncan move them without affecting the target revision's identity. Bookmarks\nautomatically move when revisions are rewritten (e.g. by jj rebase). You can\npass a bookmark's name to commands that want a revision as argument. For example,\njj new main will create a new revision on top of the main bookmark. Use\njj bookmark list to list bookmarks and jj bookmark <subcommand> to create,\nmove, or delete bookmarks. There is currently no concept of an\nactive/current/checked-out bookmark."},"551":{"id":"/concepts/bookmarks-13","page_id":"/concepts/bookmarks","tags":[],"type":"text","url":"/concepts/bookmarks#mapping-to-git-branches","content":"Jujutsu maps its bookmarks to Git branches when interacting with Git repos. For\nexample, jj git push --bookmark foo will push the state of the foo bookmark\nto the foo branch on the Git remote. Similarly, if you create a bar branch\nin the backing Git repo, then a subsequent jj git import will create a bar\nbookmark (reminder: that import happens automatically in\ncolocated repos)."},"552":{"id":"/concepts/bookmarks-14","page_id":"/concepts/bookmarks","tags":[],"type":"text","url":"/concepts/bookmarks#remotes-and-tracked-bookmarks","content":"Jujutsu records the last seen position of a bookmark on each remote (just like\nGit's remote-tracking branches). This record is updated on every jj git fetch\nand jj git push of the bookmark. You can refer to the remembered remote bookmark\npositions with <bookmark name>@<remote name>, such as jj new main@origin. jj\ndoes not provide a way to manually edit these recorded positions."},"553":{"id":"/concepts/bookmarks-15","page_id":"/concepts/bookmarks","tags":[],"type":"text","url":"/concepts/bookmarks#remotes-and-tracked-bookmarks","content":"A remote bookmark can be associated with a local bookmark of the same name. This\nis called a tracked remote bookmark (which maps to a Git remote branch when\nusing the Git backend). When you pull a tracked bookmark from a remote, any\nchanges compared to the current record of the remote's state will be propagated\nto the corresponding local bookmark, which will be created if it doesn't exist\nalready."},"554":{"id":"/concepts/bookmarks-16","page_id":"/concepts/bookmarks","tags":[],"type":"text","url":"/concepts/bookmarks#remotes-and-tracked-bookmarks","content":"title: Details: how `fetch` pulls bookmarks"},"555":{"id":"/concepts/bookmarks-17","page_id":"/concepts/bookmarks","tags":[],"type":"text","url":"/concepts/bookmarks#remotes-and-tracked-bookmarks","content":"Let's say you run jj git fetch --remote origin and, during the fetch, jj\ndetermines that the remote's main bookmark has been moved so that its target is\nnow ahead of the local record in main@origin."},"556":{"id":"/concepts/bookmarks-18","page_id":"/concepts/bookmarks","tags":[],"type":"text","url":"/concepts/bookmarks#remotes-and-tracked-bookmarks","content":"jj will then update main@origin to the new target. If main@origin is\ntracked, jj will also apply the change to the local bookmark main. If the\nlocal target has also been moved compared to main@origin (probably because you\nran jj bookmark set main), then the two updates will be merged. If one is ahead\nof the other, then that target will become the new target. Otherwise, the local\nbookmark will become conflicted (see the \"Conflicts\" section below\nfor details)."},"557":{"id":"/concepts/bookmarks-19","page_id":"/concepts/bookmarks","tags":[],"type":"text","url":"/concepts/bookmarks#remotes-and-tracked-bookmarks","content":"Most commands don't show the tracked remote bookmark if it has the same target as\nthe local bookmark. The local bookmark (without @<remote name>) is considered the\nbookmark's desired target. Consequently, if you want to update a bookmark on a\nremote, you first update the bookmark locally and then push the update to the\nremote. If a local bookmark also exists on some remote but points to a different\ntarget there, jj log will show the bookmark name with an asterisk suffix (e.g.\nmain*). That is meant to remind you that you may want to push the bookmark to\nsome remote."},"558":{"id":"/concepts/bookmarks-20","page_id":"/concepts/bookmarks","tags":[],"type":"text","url":"/concepts/bookmarks#remotes-and-tracked-bookmarks","content":"If you want to know the internals of bookmark tracking, consult the\nDesign Doc."},"559":{"id":"/concepts/bookmarks-21","page_id":"/concepts/bookmarks","tags":[],"type":"text","url":"/concepts/bookmarks#terminology-summary","content":"A remote bookmark is a bookmark ref on the remote. jj can find out its\nactual state only when it's actively communicating with the remote. However,\njj does store the last-seen position of the remote bookmark; this is the\ncommit jj show <bookmark name>@<remote name> would show. This notion is\ncompletely analogous to Git's \"remote-tracking branches\"."},"560":{"id":"/concepts/bookmarks-22","page_id":"/concepts/bookmarks","tags":[],"type":"text","url":"/concepts/bookmarks#terminology-summary","content":"A tracked (remote) bookmark is defined above. You can make a remote bookmark\ntracked with the jj bookmark track command, for\nexample."},"561":{"id":"/concepts/bookmarks-23","page_id":"/concepts/bookmarks","tags":[],"type":"text","url":"/concepts/bookmarks#terminology-summary","content":"A tracking (local) bookmark is the local bookmark that jj tries to keep in\nsync with the tracked remote bookmark. For example, after jj bookmark track\nmybookmark@origin, there will be a local bookmark mybookmark that's tracking the\nremote mybookmark@origin bookmark. A local bookmark can track a bookmark of the same\nname on 0 or more remotes."},"562":{"id":"/concepts/bookmarks-24","page_id":"/concepts/bookmarks","tags":[],"type":"text","url":"/concepts/bookmarks#terminology-summary","content":"The notion of tracked bookmarks serves a similar function to the Git notion of an\n\"upstream branch\". Unlike Git, a single local bookmark can be tracking remote\nbookmarks on multiple remotes, and the names of the local and remote bookmarks\nmust match."},"563":{"id":"/concepts/bookmarks-25","page_id":"/concepts/bookmarks","tags":[],"type":"text","url":"/concepts/bookmarks#manually-tracking-a-bookmark","content":"To track a bookmark permanently use jj bookmark track <bookmark name>@<remote name>.\nIt will now be imported as a local bookmark until you untrack it or it is deleted\non the remote."},"564":{"id":"/concepts/bookmarks-26","page_id":"/concepts/bookmarks","tags":[],"type":"text","url":"/concepts/bookmarks#manually-tracking-a-bookmark","content":"Example:"},"565":{"id":"/concepts/bookmarks-27","page_id":"/concepts/bookmarks","tags":[],"type":"text","url":"/concepts/bookmarks#untracking-a-bookmark","content":"To stop following a remote bookmark, you can jj bookmark untrack it. After that,\nsubsequent fetches of that remote will no longer move the local bookmark to match\nthe position of the remote bookmark."},"566":{"id":"/concepts/bookmarks-28","page_id":"/concepts/bookmarks","tags":[],"type":"text","url":"/concepts/bookmarks#untracking-a-bookmark","content":"Example:"},"567":{"id":"/concepts/bookmarks-29","page_id":"/concepts/bookmarks","tags":[],"type":"text","url":"/concepts/bookmarks#listing-tracked-bookmarks","content":"To list tracked bookmarks, you can jj bookmark list --tracked or jj bookmark list -t.\nThis command omits local Git-tracking bookmarks by default."},"568":{"id":"/concepts/bookmarks-30","page_id":"/concepts/bookmarks","tags":[],"type":"text","url":"/concepts/bookmarks#listing-tracked-bookmarks","content":"You can see if a specific bookmark is tracked with jj bookmark list --tracked <bookmark name>."},"569":{"id":"/concepts/bookmarks-31","page_id":"/concepts/bookmarks","tags":[],"type":"text","url":"/concepts/bookmarks#automatic-tracking-of-bookmarks--gitauto-local-bookmark-option","content":"There are two situations where jj tracks bookmarks automatically. jj git\nclone automatically sets up the default remote bookmark (e.g. main@origin) as\ntracked. When you push a local bookmark, the newly created bookmark on the remote is\nmarked as tracked."},"570":{"id":"/concepts/bookmarks-32","page_id":"/concepts/bookmarks","tags":[],"type":"text","url":"/concepts/bookmarks#automatic-tracking-of-bookmarks--gitauto-local-bookmark-option","content":"By default, every other remote bookmark is marked as \"not tracked\" when it's\nfetched. If desired, you need to manually jj bookmark track them. This works\nwell for repositories where multiple people work on a large number of bookmarks."},"571":{"id":"/concepts/bookmarks-33","page_id":"/concepts/bookmarks","tags":[],"type":"text","url":"/concepts/bookmarks#automatic-tracking-of-bookmarks--gitauto-local-bookmark-option","content":"The default can be changed by setting the config git.auto-local-bookmark = true.\nThen, jj git fetch tracks every newly fetched bookmark with a local bookmark.\nBranches that already existed before the jj git fetch are not affected. This\nis similar to Mercurial, which fetches all its bookmarks (equivalent to Git's\nbranches) by default."},"572":{"id":"/concepts/bookmarks-34","page_id":"/concepts/bookmarks","tags":[],"type":"text","url":"/concepts/bookmarks#bookmark-movement","content":"Currently Jujutsu automatically moves local bookmarks when these conditions are\nmet:"},"573":{"id":"/concepts/bookmarks-35","page_id":"/concepts/bookmarks","tags":[],"type":"text","url":"/concepts/bookmarks#bookmark-movement","content":"When a commit has been rewritten (e.g, when you rebase) bookmarks and the\nworking-copy will move along with it."},"574":{"id":"/concepts/bookmarks-36","page_id":"/concepts/bookmarks","tags":[],"type":"text","url":"/concepts/bookmarks#bookmark-movement","content":"When a commit has been abandoned, all associated bookmarks will be moved\nto its parent(s). If a working copy was pointing to the abandoned commit,\nthen a new working-copy commit will be created on top of the parent(s)."},"575":{"id":"/concepts/bookmarks-37","page_id":"/concepts/bookmarks","tags":[],"type":"text","url":"/concepts/bookmarks#bookmark-movement","content":"You could describe the movement as following along the change-id of the\ncurrent bookmark commit, even if it isn't entirely accurate."},"576":{"id":"/concepts/bookmarks-38","page_id":"/concepts/bookmarks","tags":[],"type":"text","url":"/concepts/bookmarks#pushing-bookmarks-safety-checks","content":"Before jj git push actually moves, creates, or deletes a remote bookmark, it\nmakes several safety checks."},"577":{"id":"/concepts/bookmarks-39","page_id":"/concepts/bookmarks","tags":[],"type":"text","url":"/concepts/bookmarks#pushing-bookmarks-safety-checks","content":"jj will contact the remote and check that the actual state of the remote\nbookmark matches jj's record of its last known position. If there is a\nconflict, jj will refuse to push the bookmark. In this case, you need to run\njj git fetch --remote <remote name> and resolve the resulting bookmark\nconflict. Then, you can try jj git push again."},"578":{"id":"/concepts/bookmarks-40","page_id":"/concepts/bookmarks","tags":[],"type":"text","url":"/concepts/bookmarks#pushing-bookmarks-safety-checks","content":"If you are familiar with Git, this makes jj git push similar to git\npush --force-with-lease."},"579":{"id":"/concepts/bookmarks-41","page_id":"/concepts/bookmarks","tags":[],"type":"text","url":"/concepts/bookmarks#pushing-bookmarks-safety-checks","content":"There are a few cases where jj git push will succeed even though the remote\nbookmark is in an unexpected location. These are the cases where jj git fetch\nwould not create a bookmark conflict and would not move the local bookmark, e.g.\nif the unexpected location is identical to the local position of the bookmark."},"580":{"id":"/concepts/bookmarks-42","page_id":"/concepts/bookmarks","tags":[],"type":"text","url":"/concepts/bookmarks#pushing-bookmarks-safety-checks","content":"The local bookmark must not be conflicted. If it is, you would\nneed to use jj bookmark move, for example, to resolve the conflict."},"581":{"id":"/concepts/bookmarks-43","page_id":"/concepts/bookmarks","tags":[],"type":"text","url":"/concepts/bookmarks#pushing-bookmarks-safety-checks","content":"This makes jj git push safe even if jj git fetch is performed on a timer\nin the background (this situation is a known issue with some\nforms of git push --force-with-lease). If the bookmark moves on a remote in a\nproblematic way, jj git fetch will create a conflict. This should ensure\nthat the user becomes aware of the conflict before they can jj git push and\noverride the bookmark on the remote."},"582":{"id":"/concepts/bookmarks-44","page_id":"/concepts/bookmarks","tags":[],"type":"text","url":"/concepts/bookmarks#pushing-bookmarks-safety-checks","content":"If the remote bookmark already exists on the remote, it must be\ntracked. If the bookmark does not already\nexist on the remote, there is no problem; jj git push --allow-new will\ncreate the remote bookmark and mark it as tracked."},"583":{"id":"/concepts/bookmarks-45","page_id":"/concepts/bookmarks","tags":[],"type":"text","url":"/concepts/bookmarks#pushing-bookmarks-safety-checks","content":"See \"A general note on safety\" in\nhttps://git-scm.com/docs/git-push#Documentation/git-push.txt---no-force-with-lease"},"584":{"id":"/concepts/bookmarks-46","page_id":"/concepts/bookmarks","tags":[],"type":"text","url":"/concepts/bookmarks#conflicts","content":"Bookmarks can end up in a conflicted state. When that happens, jj status will\ninclude information about the conflicted bookmarks (and instructions for how to\nmitigate it). jj bookmark list will have details. jj log will show the bookmark\nname with a double question mark suffix (e.g. main??) on each of the\nconflicted bookmark's potential target revisions. Using the bookmark name to look up\na revision will resolve to all potential targets. That means that jj new main\nwill error out, complaining that the revset resolved to multiple revisions."},"585":{"id":"/concepts/bookmarks-47","page_id":"/concepts/bookmarks","tags":[],"type":"text","url":"/concepts/bookmarks#conflicts","content":"Both local bookmarks (e.g. main) and the remote bookmark (e.g. main@origin) can\nhave conflicts. Both can end up in that state if concurrent operations were run\nin the repo. The local bookmark more typically becomes conflicted because it was\nupdated both locally and on a remote."},"586":{"id":"/concepts/bookmarks-48","page_id":"/concepts/bookmarks","tags":[],"type":"text","url":"/concepts/bookmarks#conflicts","content":"To resolve a conflicted state in a local bookmark (e.g. main), you can move the\nbookmark to the desired target with jj bookmark move. You may want to first either\nmerge the conflicted targets with jj new (e.g. jj new 'all:main'), or you may\nwant to rebase one side on top of the other with jj rebase."},"587":{"id":"/concepts/bookmarks-49","page_id":"/concepts/bookmarks","tags":[],"type":"text","url":"/concepts/bookmarks#conflicts","content":"To resolve a conflicted state in a remote bookmark (e.g. main@origin), simply\npull from the remote (e.g. jj git fetch). The conflict resolution will also\npropagate to the local bookmark (which was presumably also conflicted)."},"588":{"id":"/concepts/bookmarks-50","page_id":"/concepts/bookmarks","tags":[],"type":"text","url":"/concepts/bookmarks#ease-of-use","content":"The use of bookmarks is frequent in some workflows, for example, when\ninteracting with Git repositories containing branches. To this end,\none-letter shortcuts have been implemented, both for the jj bookmark\ncommand itself through an alias (as jj b), and for its subcommands.\nFor example, jj bookmark create BOOKMARK-NAME -r@ can be abbreviated as\njj b c BOOKMARK-NAME -r@."},"589":{"id":"/concepts/conflicts","page_id":"/concepts/conflicts","type":"page","content":"Conflicts","tags":[],"url":"/concepts/conflicts"},"590":{"id":"/concepts/conflicts-0","page_id":"/concepts/conflicts","type":"heading","tags":[],"url":"/concepts/conflicts#introduction","content":"Introduction"},"591":{"id":"/concepts/conflicts-1","page_id":"/concepts/conflicts","type":"heading","tags":[],"url":"/concepts/conflicts#advantages","content":"Advantages"},"592":{"id":"/concepts/conflicts-2","page_id":"/concepts/conflicts","type":"heading","tags":[],"url":"/concepts/conflicts#conflict-markers","content":"Conflict markers"},"593":{"id":"/concepts/conflicts-3","page_id":"/concepts/conflicts","type":"heading","tags":[],"url":"/concepts/conflicts#alternative-conflict-marker-styles","content":"Alternative conflict marker styles"},"594":{"id":"/concepts/conflicts-4","page_id":"/concepts/conflicts","type":"heading","tags":[],"url":"/concepts/conflicts#long-conflict-markers","content":"Long conflict markers"},"595":{"id":"/concepts/conflicts-5","page_id":"/concepts/conflicts","type":"heading","tags":[],"url":"/concepts/conflicts#conflicts-with-missing-terminating-newline","content":"Conflicts with missing terminating newline"},"596":{"id":"/concepts/conflicts-6","page_id":"/concepts/conflicts","tags":[],"type":"text","url":"/concepts/conflicts#introduction","content":"Conflicts happen when Jujutsu can't figure out how to merge different changes\nmade to the same file. For instance, this can happen if two people are working\non the same file and make different changes to the same part of the file, and\nthen their commits are merged together with jj new (or one is rebased onto the\nother with jj rebase)."},"597":{"id":"/concepts/conflicts-7","page_id":"/concepts/conflicts","tags":[],"type":"text","url":"/concepts/conflicts#introduction","content":"Unlike most other VCSs, Jujutsu can record conflicted states in commits. For\nexample, if you rebase a commit and it results in a conflict, the conflict will\nbe recorded in the rebased commit and the rebase operation will succeed. You can\nthen resolve the conflict whenever you want. Conflicted states can be further\nrebased, merged, or backed out. Note that what's stored in the commit is a\nlogical representation of the conflict, not conflict markers; rebasing a\nconflict doesn't result in a nested conflict markers (see\ntechnical doc for how this works)."},"598":{"id":"/concepts/conflicts-8","page_id":"/concepts/conflicts","tags":[],"type":"text","url":"/concepts/conflicts#advantages","content":"The deeper understanding of conflicts has many advantages:"},"599":{"id":"/concepts/conflicts-9","page_id":"/concepts/conflicts","tags":[],"type":"text","url":"/concepts/conflicts#advantages","content":"Removes the need for things like\ngit rebase/merge/cherry-pick/etc --continue. Instead, you get a single\nworkflow for resolving conflicts: check out the conflicted commit, resolve\nconflicts, and amend."},"600":{"id":"/concepts/conflicts-10","page_id":"/concepts/conflicts","tags":[],"type":"text","url":"/concepts/conflicts#advantages","content":"Enables the \"auto-rebase\" feature, where descendants of rewritten commits\nautomatically get rewritten. This feature mostly replaces Mercurial's\nChangeset Evolution."},"601":{"id":"/concepts/conflicts-11","page_id":"/concepts/conflicts","tags":[],"type":"text","url":"/concepts/conflicts#advantages","content":"Lets us define the change in a merge commit as being compared to the merged\nparents. That way, we can rebase merge commits correctly (unlike both Git and\nMercurial). That includes conflict resolutions done in the merge commit,\naddressing a common use case for\ngit rerere.\nSince the changes in a merge commit are displayed and rebased as expected,\nevil merges\nare arguably not as evil anymore."},"602":{"id":"/concepts/conflicts-12","page_id":"/concepts/conflicts","tags":[],"type":"text","url":"/concepts/conflicts#advantages","content":"Allows you to postpone conflict resolution until you're ready for it. You\ncan easily keep all your work-in-progress commits rebased onto upstream's head\nif you like."},"603":{"id":"/concepts/conflicts-13","page_id":"/concepts/conflicts","tags":[],"type":"text","url":"/concepts/conflicts#advantages","content":"Criss-cross merges\nand octopus merges\nbecome trivial (implementation-wise); some cases that Git can't currently\nhandle, or that would result in nested conflict markers, can be automatically\nresolved."},"604":{"id":"/concepts/conflicts-14","page_id":"/concepts/conflicts","tags":[],"type":"text","url":"/concepts/conflicts#advantages","content":"Enables collaborative conflict resolution. (This assumes that you can share\nthe conflicts with others, which you probably shouldn't do if some people\ninteract with your project using Git.)"},"605":{"id":"/concepts/conflicts-15","page_id":"/concepts/conflicts","tags":[],"type":"text","url":"/concepts/conflicts#advantages","content":"For information about how conflicts are handled in the working copy, see\nhere."},"606":{"id":"/concepts/conflicts-16","page_id":"/concepts/conflicts","tags":[],"type":"text","url":"/concepts/conflicts#conflict-markers","content":"Conflicts are \"materialized\" using conflict markers in various contexts. For\nexample, when you run jj new or jj edit on a commit with a conflict, it will\nbe materialized in the working copy. Conflicts are also materialized when they\nare part of diff output (e.g. jj show on a commit that introduces or resolves\na conflict)."},"607":{"id":"/concepts/conflicts-17","page_id":"/concepts/conflicts","tags":[],"type":"text","url":"/concepts/conflicts#conflict-markers","content":"As an example, imagine that you have a file which contains the following text,\nall in lowercase:"},"608":{"id":"/concepts/conflicts-18","page_id":"/concepts/conflicts","tags":[],"type":"text","url":"/concepts/conflicts#conflict-markers","content":"One person replaces the word \"grape\" with \"grapefruit\" in commit A, while\nanother person changes every line to uppercase in commit B. If you merge the\nchanges together with jj new A B, the resulting commit will have a conflict\nsince Jujutsu can't figure out how to combine these changes. Therefore, Jujutsu\nwill materialize the conflict in the working copy using conflict markers, which\nwould look like this:"},"609":{"id":"/concepts/conflicts-19","page_id":"/concepts/conflicts","tags":[],"type":"text","url":"/concepts/conflicts#conflict-markers","content":"The markers <<<<<<< and >>>>>>> indicate the start and end of a conflict\nrespectively. The marker +++++++ indicates the start of a snapshot, while the\nmarker %%%%%%% indicates the start of a diff to apply to the snapshot.\nTherefore, to resolve this conflict, you would apply the diff (changing \"grape\"\nto \"grapefruit\") to the snapshot (the side with every line in uppercase),\nediting the file to look like this:"},"610":{"id":"/concepts/conflicts-20","page_id":"/concepts/conflicts","tags":[],"type":"text","url":"/concepts/conflicts#conflict-markers","content":"In practice, conflicts are usually 2-sided, meaning that there's only 2\nconflicting changes being merged together at a time, but Jujutsu supports\nconflicts with arbitrarily many sides, which can happen when merging 3 or more\ncommits at once. In that case, you would see a single snapshot section and\nmultiple diff sections."},"611":{"id":"/concepts/conflicts-21","page_id":"/concepts/conflicts","tags":[],"type":"text","url":"/concepts/conflicts#conflict-markers","content":"Compared to just showing the content of each side of the conflict, the main\nbenefit of Jujutsu's style of conflict markers is that you don't need to spend\ntime manually comparing the sides to spot the differences between them. This is\nespecially beneficial for many-sided conflicts, since resolving them just\nrequires applying each diff to the snapshot one-by-one."},"612":{"id":"/concepts/conflicts-22","page_id":"/concepts/conflicts","tags":[],"type":"text","url":"/concepts/conflicts#alternative-conflict-marker-styles","content":"If you prefer to just see the contents of each side of the conflict without the\ndiff, Jujutsu also supports a \"snapshot\" style, which can be enabled by setting\nthe ui.conflict-marker-style config option to \"snapshot\":"},"613":{"id":"/concepts/conflicts-23","page_id":"/concepts/conflicts","tags":[],"type":"text","url":"/concepts/conflicts#alternative-conflict-marker-styles","content":"Some tools expect Git-style conflict markers, so Jujutsu also supports Git's\n\"diff3\" style\nconflict markers by setting the ui.conflict-marker-style config option to\n\"git\":"},"614":{"id":"/concepts/conflicts-24","page_id":"/concepts/conflicts","tags":[],"type":"text","url":"/concepts/conflicts#alternative-conflict-marker-styles","content":"This conflict marker style only supports 2-sided conflicts though, so it falls\nback to the similar \"snapshot\" conflict markers if there are more than 2 sides\nto the conflict."},"615":{"id":"/concepts/conflicts-25","page_id":"/concepts/conflicts","tags":[],"type":"text","url":"/concepts/conflicts#long-conflict-markers","content":"Some files may contain lines which could be confused for conflict markers. For\ninstance, a line could start with =======, which looks like a Git-style\nconflict marker. To ensure that it's always unambiguous which lines are conflict\nmarkers and which are just part of the file contents, jj sometimes uses\nconflict markers which are longer than normal:"},"616":{"id":"/concepts/conflicts-26","page_id":"/concepts/conflicts","tags":[],"type":"text","url":"/concepts/conflicts#conflicts-with-missing-terminating-newline","content":"When materializing conflicts, jj outputs them in a line-based format. This\nformat is easiest to interpret for text files that consist of a series of lines,\nwith each line terminated by a newline character (\\n). This means that a text\nfile should either be empty, or it should end with a newline character."},"617":{"id":"/concepts/conflicts-27","page_id":"/concepts/conflicts","tags":[],"type":"text","url":"/concepts/conflicts#conflicts-with-missing-terminating-newline","content":"While most text files follow this convention, some do not. When jj encounters\na missing terminating newline character in a conflict, it will add a comment to\nthe conflict markers to make the conflict easier to interpret. If you don't care\nabout whether your file ends with a terminating newline character, you can\ngenerally ignore this comment and resolve the conflict normally."},"618":{"id":"/concepts/conflicts-28","page_id":"/concepts/conflicts","tags":[],"type":"text","url":"/concepts/conflicts#conflicts-with-missing-terminating-newline","content":"For instance, if a file originally contained grape with no terminating newline\ncharacter, and one person changed grape to grapefruit, while another person\nadded the missing newline character to make grape\\n, the resulting conflict\nwould look like this:"},"619":{"id":"/concepts/conflicts-29","page_id":"/concepts/conflicts","tags":[],"type":"text","url":"/concepts/conflicts#conflicts-with-missing-terminating-newline","content":"Therefore, a resolution of this conflict could be grapefruit\\n, with the\nterminating newline character added."},"620":{"id":"/concepts/glossary","page_id":"/concepts/glossary","type":"page","content":"Glossary","tags":[],"url":"/concepts/glossary"},"621":{"id":"/concepts/glossary-0","page_id":"/concepts/glossary","type":"heading","tags":[],"url":"/concepts/glossary#anonymous-branch","content":"Anonymous branch"},"622":{"id":"/concepts/glossary-1","page_id":"/concepts/glossary","type":"heading","tags":[],"url":"/concepts/glossary#backend","content":"Backend"},"623":{"id":"/concepts/glossary-2","page_id":"/concepts/glossary","type":"heading","tags":[],"url":"/concepts/glossary#bookmark","content":"Bookmark"},"624":{"id":"/concepts/glossary-3","page_id":"/concepts/glossary","type":"heading","tags":[],"url":"/concepts/glossary#branch","content":"Branch"},"625":{"id":"/concepts/glossary-4","page_id":"/concepts/glossary","type":"heading","tags":[],"url":"/concepts/glossary#change","content":"Change"},"626":{"id":"/concepts/glossary-5","page_id":"/concepts/glossary","type":"heading","tags":[],"url":"/concepts/glossary#change-id","content":"Change ID"},"627":{"id":"/concepts/glossary-6","page_id":"/concepts/glossary","type":"heading","tags":[],"url":"/concepts/glossary#commit","content":"Commit"},"628":{"id":"/concepts/glossary-7","page_id":"/concepts/glossary","type":"heading","tags":[],"url":"/concepts/glossary#commit-id","content":"Commit ID"},"629":{"id":"/concepts/glossary-8","page_id":"/concepts/glossary","type":"heading","tags":[],"url":"/concepts/glossary#colocated-repos","content":"Colocated repos"},"630":{"id":"/concepts/glossary-9","page_id":"/concepts/glossary","type":"heading","tags":[],"url":"/concepts/glossary#conflict","content":"Conflict"},"631":{"id":"/concepts/glossary-10","page_id":"/concepts/glossary","type":"heading","tags":[],"url":"/concepts/glossary#divergent-change","content":"Divergent change"},"632":{"id":"/concepts/glossary-11","page_id":"/concepts/glossary","type":"heading","tags":[],"url":"/concepts/glossary#head","content":"Head"},"633":{"id":"/concepts/glossary-12","page_id":"/concepts/glossary","type":"heading","tags":[],"url":"/concepts/glossary#hidden-commits-abandoned-commits","content":"Hidden commits, abandoned commits"},"634":{"id":"/concepts/glossary-13","page_id":"/concepts/glossary","type":"heading","tags":[],"url":"/concepts/glossary#operation","content":"Operation"},"635":{"id":"/concepts/glossary-14","page_id":"/concepts/glossary","type":"heading","tags":[],"url":"/concepts/glossary#operation-log","content":"Operation log"},"636":{"id":"/concepts/glossary-15","page_id":"/concepts/glossary","type":"heading","tags":[],"url":"/concepts/glossary#repository","content":"Repository"},"637":{"id":"/concepts/glossary-16","page_id":"/concepts/glossary","type":"heading","tags":[],"url":"/concepts/glossary#remote","content":"Remote"},"638":{"id":"/concepts/glossary-17","page_id":"/concepts/glossary","type":"heading","tags":[],"url":"/concepts/glossary#revision","content":"Revision"},"639":{"id":"/concepts/glossary-18","page_id":"/concepts/glossary","type":"heading","tags":[],"url":"/concepts/glossary#revset","content":"Revset"},"640":{"id":"/concepts/glossary-19","page_id":"/concepts/glossary","type":"heading","tags":[],"url":"/concepts/glossary#rewrite","content":"Rewrite"},"641":{"id":"/concepts/glossary-20","page_id":"/concepts/glossary","type":"heading","tags":[],"url":"/concepts/glossary#root-commit","content":"Root commit"},"642":{"id":"/concepts/glossary-21","page_id":"/concepts/glossary","type":"heading","tags":[],"url":"/concepts/glossary#tree","content":"Tree"},"643":{"id":"/concepts/glossary-22","page_id":"/concepts/glossary","type":"heading","tags":[],"url":"/concepts/glossary#tracked-bookmarks-and-tracking-bookmarks","content":"Tracked bookmarks and tracking bookmarks"},"644":{"id":"/concepts/glossary-23","page_id":"/concepts/glossary","type":"heading","tags":[],"url":"/concepts/glossary#visible-commits","content":"Visible commits"},"645":{"id":"/concepts/glossary-24","page_id":"/concepts/glossary","type":"heading","tags":[],"url":"/concepts/glossary#view","content":"View"},"646":{"id":"/concepts/glossary-25","page_id":"/concepts/glossary","type":"heading","tags":[],"url":"/concepts/glossary#workspace","content":"Workspace"},"647":{"id":"/concepts/glossary-26","page_id":"/concepts/glossary","type":"heading","tags":[],"url":"/concepts/glossary#working-copy","content":"Working copy"},"648":{"id":"/concepts/glossary-27","page_id":"/concepts/glossary","type":"heading","tags":[],"url":"/concepts/glossary#working-copy-commit","content":"Working-copy commit"},"649":{"id":"/concepts/glossary-28","page_id":"/concepts/glossary","tags":[],"type":"text","url":"/concepts/glossary#anonymous-branch","content":"An anonymous branch is a chain of commits that doesn't necessarily have any\nbookmarks pointing to it or to any of its descendants. Unlike Git,\nJujutsu keeps commits on anonymous branches around until they are explicitly\nabandoned. Visible anonymous branches are tracked by the view, which\nstores a list of heads of such branches."},"650":{"id":"/concepts/glossary-29","page_id":"/concepts/glossary","tags":[],"type":"text","url":"/concepts/glossary#backend","content":"A backend is an implementation of the storage layer. There is currently only one\nproduction-ready builtin commit backend: the Git backend. The Git backend stores\ncommits in a Git repository. There are several backends used for testing. Google\nalso has its own cloud-based backend."},"651":{"id":"/concepts/glossary-30","page_id":"/concepts/glossary","tags":[],"type":"text","url":"/concepts/glossary#backend","content":"There are also pluggable backends for storing other information than commits,\nsuch as the \"operation store backend\" for storing\nthe operation log."},"652":{"id":"/concepts/glossary-31","page_id":"/concepts/glossary","tags":[],"type":"text","url":"/concepts/glossary#bookmark","content":"A bookmark is a named pointer to a commit. They are similar to Git's\nbranches and even more similar to Mercurial's\nbookmarks. See here\nfor details."},"653":{"id":"/concepts/glossary-32","page_id":"/concepts/glossary","tags":[],"type":"text","url":"/concepts/glossary#bookmark","content":"Unlike in Git, there is no concept of a \"current bookmark\"; bookmarks do not\nmove when you create a new commit. Bookmarks do automatically follow the\ncommit if it gets rewritten."},"654":{"id":"/concepts/glossary-33","page_id":"/concepts/glossary","tags":[],"type":"text","url":"/concepts/glossary#branch","content":"In the context of jj, the work \"branch\" usually refers to an anonymous\nbranch or, less formally, a branch of the commit \"tree\"\n(which is itself an informal way to refer to the commit graph, parts of which\nmight resemble a tree even when it's not mathematically a tree)."},"655":{"id":"/concepts/glossary-34","page_id":"/concepts/glossary","tags":[],"type":"text","url":"/concepts/glossary#branch","content":"We also sometimes discuss Git's branches and branches on Git remotes. Locally,\nthese correspond to bookmarks. In a colocated repository, each\nlocal Git branch corresponds to a jj bookmark."},"656":{"id":"/concepts/glossary-35","page_id":"/concepts/glossary","tags":[],"type":"text","url":"/concepts/glossary#change","content":"A change is a commit as it evolves over time. Changes themselves\ndon't exist as an object in the data model; only the change ID does. The change\nID is a property of a commit."},"657":{"id":"/concepts/glossary-36","page_id":"/concepts/glossary","tags":[],"type":"text","url":"/concepts/glossary#change-id","content":"A change ID is a unique identifier for a change. They are typically\n16 bytes long and are often randomly generated. By default, jj log presents\nthem as a sequence of 12 letters in the k-z range, at the beginning of a line.\nThese are actually hexadecimal numbers that use \"digits\" z-k instead of 0-9a-f."},"658":{"id":"/concepts/glossary-37","page_id":"/concepts/glossary","tags":[],"type":"text","url":"/concepts/glossary#commit","content":"A snapshot of the files in the repository at a given point in time (technically\na tree object), together with some metadata. The metadata includes the\nauthor, the date, and pointers to the commit's parents. Through the pointers to\nthe parents, the commits form a\nDirected Acyclic Graph (DAG)\n."},"659":{"id":"/concepts/glossary-38","page_id":"/concepts/glossary","tags":[],"type":"text","url":"/concepts/glossary#commit","content":"Note that even though commits are stored as snapshots, they are often treated\nas differences between snapshots, namely compared to their parent's snapshot. If\nthey have more than one parent, then the difference is computed against the\nresult of merging the parents. For example, jj diff will show the differences\nintroduced by a commit compared to its parent(s), and jj rebase will apply\nthose changes onto another base commit."},"660":{"id":"/concepts/glossary-39","page_id":"/concepts/glossary","tags":[],"type":"text","url":"/concepts/glossary#commit","content":"The word \"revision\" is used as a synonym for \"commit\"."},"661":{"id":"/concepts/glossary-40","page_id":"/concepts/glossary","tags":[],"type":"text","url":"/concepts/glossary#commit-id","content":"A commit ID is a unique identifier for a commit. They are 20 bytes\nlong when using the Git backend. They are presented in regular hexadecimal\nformat at the end of the line in jj log, using 12 hexadecimal digits by\ndefault. When using the Git backend, the commit ID is the Git commit ID."},"662":{"id":"/concepts/glossary-41","page_id":"/concepts/glossary","tags":[],"type":"text","url":"/concepts/glossary#colocated-repos","content":"When using the Git backend and the backing Git repository's .git/\ndirectory is a sibling of .jj/, we call the repository colocated. Most\ntools designed for Git can be easily used on such repositories. jj and git\ncommands can be used interchangeably."},"663":{"id":"/concepts/glossary-42","page_id":"/concepts/glossary","tags":[],"type":"text","url":"/concepts/glossary#colocated-repos","content":"See here for details."},"664":{"id":"/concepts/glossary-43","page_id":"/concepts/glossary","tags":[],"type":"text","url":"/concepts/glossary#conflict","content":"Conflicts can occur in many places. The most common type is conflicts in files.\nThose are the conflicts that users coming from other VCSs are usually familiar\nwith. You can see them in jj status and in jj log (the red \"conflict\"\nlabel at the end of the line). See here for details."},"665":{"id":"/concepts/glossary-44","page_id":"/concepts/glossary","tags":[],"type":"text","url":"/concepts/glossary#conflict","content":"Conflicts can also occur in bookmarks. For example, if you moved a\nbookmark locally, and it was also moved on the remote, then the bookmark will be\nin a conflicted state after you pull from the remote.\nSee here for details."},"666":{"id":"/concepts/glossary-45","page_id":"/concepts/glossary","tags":[],"type":"text","url":"/concepts/glossary#conflict","content":"Similar to a bookmark conflict, when a change is rewritten locally\nand remotely, for example, then the change will be in a conflicted state. We\ncall that a divergent change."},"667":{"id":"/concepts/glossary-46","page_id":"/concepts/glossary","tags":[],"type":"text","url":"/concepts/glossary#divergent-change","content":"A divergent change is a change that has more than one\nvisible commit."},"668":{"id":"/concepts/glossary-47","page_id":"/concepts/glossary","tags":[],"type":"text","url":"/concepts/glossary#head","content":"A head is a commit with no descendants. The context in which it has no\ndescendants varies. For example, the heads(X)\nrevset function returns commits that have no descendants\nwithin the set X itself. The view records which\nanonymous heads (heads without a bookmark pointing to them) are visible at a\ngiven operation. Note that this is quite different from Git's\nHEAD."},"669":{"id":"/concepts/glossary-48","page_id":"/concepts/glossary","tags":[],"type":"text","url":"/concepts/glossary#hidden-commits-abandoned-commits","content":"See visible commits."},"670":{"id":"/concepts/glossary-49","page_id":"/concepts/glossary","tags":[],"type":"text","url":"/concepts/glossary#operation","content":"A snapshot of the visible commits and bookmarks\nat a given point in time (technically a view object), together with\nsome metadata. The metadata includes the username, hostname, timestamps, and\npointers to the operation's parents."},"671":{"id":"/concepts/glossary-50","page_id":"/concepts/glossary","tags":[],"type":"text","url":"/concepts/glossary#operation-log","content":"The operation log is the\nDAG formed by\noperation objects, much in the same way that commits form a DAG,\nwhich is sometimes called the \"commit history\". When operations happen in\nsequence, they form a single line in the graph. Operations that happen\nconcurrently from jj's perspective result in forks and merges in the DAG."},"672":{"id":"/concepts/glossary-51","page_id":"/concepts/glossary","tags":[],"type":"text","url":"/concepts/glossary#repository","content":"Basically everything under .jj/, i.e. the full set of operations\nand commits."},"673":{"id":"/concepts/glossary-52","page_id":"/concepts/glossary","tags":[],"type":"text","url":"/concepts/glossary#remote","content":"A remote is a reference to a copy of your repository. The most common case is\nthat the remote is hosted on the internet or another network, but local remotes\nare also possible. Remotes are useful when working on a project with multiple\ncollaborators. As Jujutsu is compatible with Git you can use all popular\nproviders that are also available for Git. For example\nGitHub, GitLab or\nCodeberg."},"674":{"id":"/concepts/glossary-53","page_id":"/concepts/glossary","tags":[],"type":"text","url":"/concepts/glossary#revision","content":"A synonym for Commit."},"675":{"id":"/concepts/glossary-54","page_id":"/concepts/glossary","tags":[],"type":"text","url":"/concepts/glossary#revset","content":"Jujutsu supports a functional language for selecting a set of revisions.\nExpressions in this language are called \"revsets\". See here for\ndetails. We also often use the term \"revset\" for the set of revisions selected\nby a revset."},"676":{"id":"/concepts/glossary-55","page_id":"/concepts/glossary","tags":[],"type":"text","url":"/concepts/glossary#rewrite","content":"To \"rewrite\" a commit means to create a new version of that commit with\ndifferent contents, metadata (including parent pointers), or both. Rewriting a\ncommit results in a new commit, and thus a new commit ID, but the\nchange ID generally remains the same. Some examples of rewriting a\ncommit would be changing its description or rebasing it. Modifying the working\ncopy rewrites the working copy commit."},"677":{"id":"/concepts/glossary-56","page_id":"/concepts/glossary","tags":[],"type":"text","url":"/concepts/glossary#root-commit","content":"The root commit is a virtual commit at the root of every repository. It has a\ncommit ID consisting of all '0's (00000000...) and a change ID consisting of\nall 'z's (zzzzzzzz...). It can be referred to in revsets by the\nfunction root(). Note that our definition of \"root commit\" is different from\nGit's; Git's \"root commits\" are the first commit(s) in the repository, i.e. the\ncommits jj log -r 'root()+' will show."},"678":{"id":"/concepts/glossary-57","page_id":"/concepts/glossary","tags":[],"type":"text","url":"/concepts/glossary#tree","content":"A tree object represents a snapshot of a directory in the repository. Tree\nobjects are defined recursively; each tree object only has the files and\ndirectories contained directly in the directory it represents."},"679":{"id":"/concepts/glossary-58","page_id":"/concepts/glossary","tags":[],"type":"text","url":"/concepts/glossary#tracked-bookmarks-and-tracking-bookmarks","content":"A remote bookmark can be made \"tracked\" with the jj bookmark track command. This\nresults in a \"tracking\" local bookmark that tracks the remote bookmark."},"680":{"id":"/concepts/glossary-59","page_id":"/concepts/glossary","tags":[],"type":"text","url":"/concepts/glossary#tracked-bookmarks-and-tracking-bookmarks","content":"See the bookmarks documentation for a more\ndetailed definition of these terms."},"681":{"id":"/concepts/glossary-60","page_id":"/concepts/glossary","tags":[],"type":"text","url":"/concepts/glossary#visible-commits","content":"Visible commits are the commits you see in jj log -r 'all()'. They are the\ncommits that are reachable from an anonymous head in the view.\nAncestors of a visible commit are implicitly visible."},"682":{"id":"/concepts/glossary-61","page_id":"/concepts/glossary","tags":[],"type":"text","url":"/concepts/glossary#visible-commits","content":"Intuitively, visible commits are the \"latest versions\" of a revision with a\ngiven change id. A commit that's abandoned or\nrewritten stops being visible and is labeled as \"hidden\". Such\ncommits are no longer accessible using a change id, but they are still\naccessible by their commit id."},"683":{"id":"/concepts/glossary-62","page_id":"/concepts/glossary","tags":[],"type":"text","url":"/concepts/glossary#view","content":"A view is a snapshot of bookmarks and their targets, anonymous heads,\nand working-copy commits. The anonymous heads define which commits\nare visible."},"684":{"id":"/concepts/glossary-63","page_id":"/concepts/glossary","tags":[],"type":"text","url":"/concepts/glossary#view","content":"A view object is similar to a tree object in that it represents a\nsnapshot without history, and an operation object is similar to a\ncommit object in that it adds metadata and history."},"685":{"id":"/concepts/glossary-64","page_id":"/concepts/glossary","tags":[],"type":"text","url":"/concepts/glossary#workspace","content":"A workspace is a working copy and an\nassociated repository. There can be multiple workspaces for a\nsingle repository. Each workspace has a .jj/ directory, but the\ncommits and operations will be stored in the initial\nworkspace; the other workspaces will have pointers to the initial workspace. See\nhere for details."},"686":{"id":"/concepts/glossary-65","page_id":"/concepts/glossary","tags":[],"type":"text","url":"/concepts/glossary#workspace","content":"This is what Git calls a \"worktree\"."},"687":{"id":"/concepts/glossary-66","page_id":"/concepts/glossary","tags":[],"type":"text","url":"/concepts/glossary#working-copy","content":"The working copy contains the files you're currently working on. It is\nautomatically snapshot at the beginning of almost every jj command, thus\ncreating a new working-copy commit if any changes had\nbeen made in the working copy. Conversely, the working copy is automatically\nupdated to the state of the working-copy commit at the end of almost every jj\ncommand. See here for details."},"688":{"id":"/concepts/glossary-67","page_id":"/concepts/glossary","tags":[],"type":"text","url":"/concepts/glossary#working-copy","content":"This is what Git calls a \"working tree\"."},"689":{"id":"/concepts/glossary-68","page_id":"/concepts/glossary","tags":[],"type":"text","url":"/concepts/glossary#working-copy-commit","content":"A commit that corresponds to the current state of the working copy. There is\none working-copy commit per workspace. The current working-copy\ncommits are tracked in the operation log."},"690":{"id":"/concepts/operation-log","page_id":"/concepts/operation-log","type":"page","content":"Operation log","tags":[],"url":"/concepts/operation-log"},"691":{"id":"/concepts/operation-log-0","page_id":"/concepts/operation-log","type":"heading","tags":[],"url":"/concepts/operation-log#introduction","content":"Introduction"},"692":{"id":"/concepts/operation-log-1","page_id":"/concepts/operation-log","type":"heading","tags":[],"url":"/concepts/operation-log#divergent-operations","content":"Divergent operations"},"693":{"id":"/concepts/operation-log-2","page_id":"/concepts/operation-log","type":"heading","tags":[],"url":"/concepts/operation-log#loading-an-old-version-of-the-repo","content":"Loading an old version of the repo"},"694":{"id":"/concepts/operation-log-3","page_id":"/concepts/operation-log","tags":[],"type":"text","url":"/concepts/operation-log#introduction","content":"Jujutsu records each operation that modifies the repo in the \"operation log\".\nYou can see the log with jj op log. Each operation object contains a snapshot\nof how the repo looked at the end of the operation. We call this snapshot a\n\"view\" object. The view contains information about where each bookmark, tag, and\nGit ref (in Git-backed repos) pointed, as well as the set of heads in the repo,\nand the current working-copy commit in each workspace. The operation object also\n(in addition to the view) contains pointers to the operation(s) immediately\nbefore it, as well as metadata about the operation, such as timestamps,\nusername, hostname, description."},"695":{"id":"/concepts/operation-log-4","page_id":"/concepts/operation-log","tags":[],"type":"text","url":"/concepts/operation-log#introduction","content":"The operation log allows you to undo operations one-by-one (jj undo) or even\nrevert a specific one which isn't the most recent operation (jj op revert). It\nalso lets you restore the entire repo to the way it looked at an earlier point\n(jj op restore)."},"696":{"id":"/concepts/operation-log-5","page_id":"/concepts/operation-log","tags":[],"type":"text","url":"/concepts/operation-log#introduction","content":"When referring to operations, you can use @ to represent the current\noperation."},"697":{"id":"/concepts/operation-log-6","page_id":"/concepts/operation-log","tags":[],"type":"text","url":"/concepts/operation-log#introduction","content":"The following operators are supported:"},"698":{"id":"/concepts/operation-log-7","page_id":"/concepts/operation-log","tags":[],"type":"text","url":"/concepts/operation-log#introduction","content":"x-: Parents of x (e.g. @-)"},"699":{"id":"/concepts/operation-log-8","page_id":"/concepts/operation-log","tags":[],"type":"text","url":"/concepts/operation-log#introduction","content":"x+: Children of x"},"700":{"id":"/concepts/operation-log-9","page_id":"/concepts/operation-log","tags":[],"type":"text","url":"/concepts/operation-log#divergent-operations","content":"One benefit of the operation log (and the reason for its creation) is that it\nallows lock-free concurrency -- you can run concurrent jj commands without\ncorrupting the repo, even if you run the commands on different machines that\naccess the repo via a distributed file system (as long as the file system\nguarantees that a write is only visible once previous writes are visible). When\nyou run a jj command, it will start by loading the repo at the latest\noperation. It will not see any changes written by concurrent commands. If there\nare conflicts, you will be informed of them by subsequent jj st and/or\njj log commands."},"701":{"id":"/concepts/operation-log-10","page_id":"/concepts/operation-log","tags":[],"type":"text","url":"/concepts/operation-log#divergent-operations","content":"As an example, let's say you had started editing the description of a change and\nthen also update the contents of the change (maybe because you had forgotten the\neditor). When you eventually close your editor, the command will succeed and\ne.g. jj log will indicate that the change has diverged."},"702":{"id":"/concepts/operation-log-11","page_id":"/concepts/operation-log","tags":[],"type":"text","url":"/concepts/operation-log#loading-an-old-version-of-the-repo","content":"The top-level --at-operation/--at-op option allows you to load the repo at a\nspecific operation. This can be useful for understanding how your repo got into\nthe current state. It can be even more useful for understanding why someone\nelse's repo got into its current state."},"703":{"id":"/concepts/operation-log-12","page_id":"/concepts/operation-log","tags":[],"type":"text","url":"/concepts/operation-log#loading-an-old-version-of-the-repo","content":"When you use --at-op, the automatic snapshotting of the working copy will not\ntake place. When referring to a revision with the @ symbol (as many commands\ndo by default), that will resolve to the working-copy commit recorded in the\noperation's view (which is actually how it always works -- it's just the\nsnapshotting that's skipped with --at-op)."},"704":{"id":"/concepts/operation-log-13","page_id":"/concepts/operation-log","tags":[],"type":"text","url":"/concepts/operation-log#loading-an-old-version-of-the-repo","content":"As a top-level option, --at-op can be passed to any command. However, you\nwill typically only want to run read-only commands. For example, jj log,\njj st, and jj diff all make sense. It's still possible to run e.g.\njj --at-op=<some operation ID> describe. That's equivalent to having started\njj describe back when the specified operation was the most recent operation\nand then let it run until now (which can be done for that particular command by\nnot closing the editor). There's practically no good reason to do that other\nthan to simulate concurrent commands."},"705":{"id":"/concepts/working-copy","page_id":"/concepts/working-copy","type":"page","content":"Working copy","tags":[],"url":"/concepts/working-copy"},"706":{"id":"/concepts/working-copy-0","page_id":"/concepts/working-copy","type":"heading","tags":[],"url":"/concepts/working-copy#introduction","content":"Introduction"},"707":{"id":"/concepts/working-copy-1","page_id":"/concepts/working-copy","type":"heading","tags":[],"url":"/concepts/working-copy#conflicts","content":"Conflicts"},"708":{"id":"/concepts/working-copy-2","page_id":"/concepts/working-copy","type":"heading","tags":[],"url":"/concepts/working-copy#ignored-files","content":"Ignored files"},"709":{"id":"/concepts/working-copy-3","page_id":"/concepts/working-copy","type":"heading","tags":[],"url":"/concepts/working-copy#workspaces","content":"Workspaces"},"710":{"id":"/concepts/working-copy-4","page_id":"/concepts/working-copy","type":"heading","tags":[],"url":"/concepts/working-copy#stale-working-copy","content":"Stale working copy"},"711":{"id":"/concepts/working-copy-5","page_id":"/concepts/working-copy","tags":[],"type":"text","url":"/concepts/working-copy#introduction","content":"The working copy is where the current working-copy commit's files are written so\nyou can interact with them. It is also where files are read from in order to\ncreate new commits (though there are many other ways of creating new commits)."},"712":{"id":"/concepts/working-copy-6","page_id":"/concepts/working-copy","tags":[],"type":"text","url":"/concepts/working-copy#introduction","content":"Unlike most other VCSs, Jujutsu will automatically create commits from the\nworking-copy contents when they have changed. Most jj commands you run will\ncommit the working-copy changes if they have changed. The resulting revision\nwill replace the previous working-copy revision."},"713":{"id":"/concepts/working-copy-7","page_id":"/concepts/working-copy","tags":[],"type":"text","url":"/concepts/working-copy#introduction","content":"Also unlike most other VCSs, added files are implicitly tracked by default. That\nmeans that if you add a new file to the working copy, it will be automatically\ncommitted once you run e.g. jj st. Similarly, if you remove a file from the\nworking copy, it will implicitly be untracked."},"714":{"id":"/concepts/working-copy-8","page_id":"/concepts/working-copy","tags":[],"type":"text","url":"/concepts/working-copy#introduction","content":"The snapshot.auto-track config option controls which paths get automatically\ntracked when they're added to the working copy. See the\nfileset documentation for the syntax. Files with paths matching\nignore files are never tracked automatically."},"715":{"id":"/concepts/working-copy-9","page_id":"/concepts/working-copy","tags":[],"type":"text","url":"/concepts/working-copy#introduction","content":"If you set snapshot.auto-track to a non-default value, untracked files can be\ntracked with jj file track."},"716":{"id":"/concepts/working-copy-10","page_id":"/concepts/working-copy","tags":[],"type":"text","url":"/concepts/working-copy#introduction","content":"You can use jj file untrack to untrack a file while keeping it in the working\ncopy. However, first ignore them or remove them from the\nsnapshot.auto-track patterns; otherwise they will be immediately tracked again."},"717":{"id":"/concepts/working-copy-11","page_id":"/concepts/working-copy","tags":[],"type":"text","url":"/concepts/working-copy#conflicts","content":"When you check out a commit with conflicts, those conflicts need to be\nrepresented in the working copy somehow. However, the file system doesn't\nunderstand conflicts. Jujutsu's solution is to add conflict markers to\nconflicted files when it writes them to the working copy. It also keeps track of\nthe (typically 3) different parts involved in the conflict. Whenever it scans\nthe working copy thereafter, it parses the conflict markers and recreates the\nconflict state from them. You can resolve conflicts by replacing the conflict\nmarkers by the resolved text. You don't need to resolve all conflicts at once.\nYou can even resolve part of a conflict by updating the different parts of the\nconflict marker."},"718":{"id":"/concepts/working-copy-12","page_id":"/concepts/working-copy","tags":[],"type":"text","url":"/concepts/working-copy#conflicts","content":"To resolve conflicts in a commit, use jj new <commit> to create a working-copy\ncommit on top. You would then have the same conflicts in the working-copy\ncommit. Once you have resolved the conflicts, you can inspect the conflict\nresolutions with jj diff. Then run jj squash to move the conflict\nresolutions into the conflicted commit. Alternatively, you can edit the commit\nwith conflicts directly in the working copy by using jj edit <commit>. The\nmain disadvantage of that is that it's harder to inspect the conflict\nresolutions."},"719":{"id":"/concepts/working-copy-13","page_id":"/concepts/working-copy","tags":[],"type":"text","url":"/concepts/working-copy#conflicts","content":"With the jj resolve command, you can use an external merge tool to resolve\nconflicts that have 2 sides and a base. There is not yet a good way of\nresolving conflicts between directories, files, and symlinks\n(https://github.com/jj-vcs/jj/issues/19). You can use jj restore to choose\none side of the conflict, but there's no way to even see where the involved\nparts came from."},"720":{"id":"/concepts/working-copy-14","page_id":"/concepts/working-copy","tags":[],"type":"text","url":"/concepts/working-copy#ignored-files","content":"You probably don't want build outputs and temporary files to be under version\ncontrol. You can tell Jujutsu to not automatically track certain files by using\n.gitignore files (there's no such thing as .jjignore yet). See\nhttps://git-scm.com/docs/gitignore for details about the format. .gitignore\nfiles are supported in any directory in the working copy, as well as in\n$XDG_CONFIG_HOME/git/ignore and $GIT_DIR/info/exclude."},"721":{"id":"/concepts/working-copy-15","page_id":"/concepts/working-copy","tags":[],"type":"text","url":"/concepts/working-copy#ignored-files","content":"Ignored files are never tracked automatically (regardless of the value of\nsnapshot.auto-track), but files that were already tracked will remain tracked\neven if they match ignore patterns. You can untrack such files with the\njj file untrack command."},"722":{"id":"/concepts/working-copy-16","page_id":"/concepts/working-copy","tags":[],"type":"text","url":"/concepts/working-copy#workspaces","content":"You can have multiple working copies backed by a single repo. Use\njj workspace add to create a new working copy. The working copy will have a\n.jj/ directory linked to the main repo. The working copy and the .jj/\ndirectory together is called a \"workspace\". Each workspace can have a different\ncommit checked out."},"723":{"id":"/concepts/working-copy-17","page_id":"/concepts/working-copy","tags":[],"type":"text","url":"/concepts/working-copy#workspaces","content":"Having multiple workspaces can be useful for running long-running tests in a one\nwhile you continue developing in another, for example. If needed,\njj workspace root prints the root path of the current workspace."},"724":{"id":"/concepts/working-copy-18","page_id":"/concepts/working-copy","tags":[],"type":"text","url":"/concepts/working-copy#workspaces","content":"When you're done using a workspace, use jj workspace forget to make the repo\nforget about it. The files can be deleted from disk separately (either before or\nafter)."},"725":{"id":"/concepts/working-copy-19","page_id":"/concepts/working-copy","tags":[],"type":"text","url":"/concepts/working-copy#stale-working-copy","content":"Almost all commands go through three main steps:"},"726":{"id":"/concepts/working-copy-20","page_id":"/concepts/working-copy","tags":[],"type":"text","url":"/concepts/working-copy#stale-working-copy","content":"Snapshot the working copy (which gets recorded as an operation)"},"727":{"id":"/concepts/working-copy-21","page_id":"/concepts/working-copy","tags":[],"type":"text","url":"/concepts/working-copy#stale-working-copy","content":"Create new commits etc. \"in memory\" and record that as a new operation"},"728":{"id":"/concepts/working-copy-22","page_id":"/concepts/working-copy","tags":[],"type":"text","url":"/concepts/working-copy#stale-working-copy","content":"Update the working copy to match the new operation, i.e. to the commit that\nthe operation says that @ should point to"},"729":{"id":"/concepts/working-copy-23","page_id":"/concepts/working-copy","tags":[],"type":"text","url":"/concepts/working-copy#stale-working-copy","content":"If step 3 doesn't happen for some reason, the working copy is considered\n\"stale\". We can detect that because the working copy (.jj/working_copy/)\nkeeps track of which operation it was last updated to. When the working copy is\nstale, use jj workspace update-stale to update the files in the working copy."},"730":{"id":"/concepts/working-copy-24","page_id":"/concepts/working-copy","tags":[],"type":"text","url":"/concepts/working-copy#stale-working-copy","content":"A common reason that step 3 doesn't happen for a working copy is that you\nrewrote the commit from another workspace. When you modify workspace A's\nworking-copy commit from workspace B, workspace A's working copy will become\nstale."},"731":{"id":"/concepts/working-copy-25","page_id":"/concepts/working-copy","tags":[],"type":"text","url":"/concepts/working-copy#stale-working-copy","content":"A working copy can also become stale because some error, such as ^C prevented\nstep 3 from completing. It's also possible that it was successfully updated in\nstep 3 but the operation has then been lost (e.g. by jj op abandon or\n\"spontaneously\" by certain storage backends). If the operation has been lost,\nthen jj workspace update-stale will create a recovery commit with the\ncontents of the working copy but parented to the current operation's\nworking-copy commit."},"732":{"id":"/contributing/code-of-conduct","page_id":"/contributing/code-of-conduct","type":"page","content":"Contributor Covenant Code of Conduct","tags":[],"url":"/contributing/code-of-conduct"},"733":{"id":"/contributing/code-of-conduct-0","page_id":"/contributing/code-of-conduct","type":"heading","tags":[],"url":"/contributing/code-of-conduct#our-pledge","content":"Our Pledge"},"734":{"id":"/contributing/code-of-conduct-1","page_id":"/contributing/code-of-conduct","type":"heading","tags":[],"url":"/contributing/code-of-conduct#our-standards","content":"Our Standards"},"735":{"id":"/contributing/code-of-conduct-2","page_id":"/contributing/code-of-conduct","type":"heading","tags":[],"url":"/contributing/code-of-conduct#enforcement-responsibilities","content":"Enforcement Responsibilities"},"736":{"id":"/contributing/code-of-conduct-3","page_id":"/contributing/code-of-conduct","type":"heading","tags":[],"url":"/contributing/code-of-conduct#scope","content":"Scope"},"737":{"id":"/contributing/code-of-conduct-4","page_id":"/contributing/code-of-conduct","type":"heading","tags":[],"url":"/contributing/code-of-conduct#enforcement","content":"Enforcement"},"738":{"id":"/contributing/code-of-conduct-5","page_id":"/contributing/code-of-conduct","type":"heading","tags":[],"url":"/contributing/code-of-conduct#enforcement-guidelines","content":"Enforcement Guidelines"},"739":{"id":"/contributing/code-of-conduct-6","page_id":"/contributing/code-of-conduct","type":"heading","tags":[],"url":"/contributing/code-of-conduct#1-correction","content":"1. Correction"},"740":{"id":"/contributing/code-of-conduct-7","page_id":"/contributing/code-of-conduct","type":"heading","tags":[],"url":"/contributing/code-of-conduct#2-warning","content":"2. Warning"},"741":{"id":"/contributing/code-of-conduct-8","page_id":"/contributing/code-of-conduct","type":"heading","tags":[],"url":"/contributing/code-of-conduct#3-temporary-ban","content":"3. Temporary Ban"},"742":{"id":"/contributing/code-of-conduct-9","page_id":"/contributing/code-of-conduct","type":"heading","tags":[],"url":"/contributing/code-of-conduct#4-permanent-ban","content":"4. Permanent Ban"},"743":{"id":"/contributing/code-of-conduct-10","page_id":"/contributing/code-of-conduct","type":"heading","tags":[],"url":"/contributing/code-of-conduct#attribution","content":"Attribution"},"744":{"id":"/contributing/code-of-conduct-11","page_id":"/contributing/code-of-conduct","tags":[],"type":"text","url":"/contributing/code-of-conduct#our-pledge","content":"We as members, contributors, and leaders pledge to make participation in our\ncommunity a harassment-free experience for everyone, regardless of age, body\nsize, visible or invisible disability, ethnicity, sex characteristics, gender\nidentity and expression, level of experience, education, socioeconomic status,\nnationality, personal appearance, race, caste, color, religion, or sexual\nidentity and orientation."},"745":{"id":"/contributing/code-of-conduct-12","page_id":"/contributing/code-of-conduct","tags":[],"type":"text","url":"/contributing/code-of-conduct#our-pledge","content":"We pledge to act and interact in ways that contribute to an open, welcoming,\ndiverse, inclusive, and healthy community."},"746":{"id":"/contributing/code-of-conduct-13","page_id":"/contributing/code-of-conduct","tags":[],"type":"text","url":"/contributing/code-of-conduct#our-standards","content":"Examples of behavior that contributes to a positive environment for our\ncommunity include:"},"747":{"id":"/contributing/code-of-conduct-14","page_id":"/contributing/code-of-conduct","tags":[],"type":"text","url":"/contributing/code-of-conduct#our-standards","content":"Demonstrating empathy and kindness toward other people"},"748":{"id":"/contributing/code-of-conduct-15","page_id":"/contributing/code-of-conduct","tags":[],"type":"text","url":"/contributing/code-of-conduct#our-standards","content":"Being respectful of differing opinions, viewpoints, and experiences"},"749":{"id":"/contributing/code-of-conduct-16","page_id":"/contributing/code-of-conduct","tags":[],"type":"text","url":"/contributing/code-of-conduct#our-standards","content":"Giving and gracefully accepting constructive feedback"},"750":{"id":"/contributing/code-of-conduct-17","page_id":"/contributing/code-of-conduct","tags":[],"type":"text","url":"/contributing/code-of-conduct#our-standards","content":"Accepting responsibility and apologizing to those affected by our mistakes,\nand learning from the experience"},"751":{"id":"/contributing/code-of-conduct-18","page_id":"/contributing/code-of-conduct","tags":[],"type":"text","url":"/contributing/code-of-conduct#our-standards","content":"Focusing on what is best not just for us as individuals, but for the overall\ncommunity"},"752":{"id":"/contributing/code-of-conduct-19","page_id":"/contributing/code-of-conduct","tags":[],"type":"text","url":"/contributing/code-of-conduct#our-standards","content":"Examples of unacceptable behavior include:"},"753":{"id":"/contributing/code-of-conduct-20","page_id":"/contributing/code-of-conduct","tags":[],"type":"text","url":"/contributing/code-of-conduct#our-standards","content":"The use of sexualized language or imagery, and sexual attention or advances of\nany kind"},"754":{"id":"/contributing/code-of-conduct-21","page_id":"/contributing/code-of-conduct","tags":[],"type":"text","url":"/contributing/code-of-conduct#our-standards","content":"Trolling, insulting or derogatory comments, and personal or political attacks"},"755":{"id":"/contributing/code-of-conduct-22","page_id":"/contributing/code-of-conduct","tags":[],"type":"text","url":"/contributing/code-of-conduct#our-standards","content":"Public or private harassment"},"756":{"id":"/contributing/code-of-conduct-23","page_id":"/contributing/code-of-conduct","tags":[],"type":"text","url":"/contributing/code-of-conduct#our-standards","content":"Publishing others' private information, such as a physical or email address,\nwithout their explicit permission"},"757":{"id":"/contributing/code-of-conduct-24","page_id":"/contributing/code-of-conduct","tags":[],"type":"text","url":"/contributing/code-of-conduct#our-standards","content":"Other conduct which could reasonably be considered inappropriate in a\nprofessional setting"},"758":{"id":"/contributing/code-of-conduct-25","page_id":"/contributing/code-of-conduct","tags":[],"type":"text","url":"/contributing/code-of-conduct#enforcement-responsibilities","content":"Community leaders are responsible for clarifying and enforcing our standards of\nacceptable behavior and will take appropriate and fair corrective action in\nresponse to any behavior that they deem inappropriate, threatening, offensive,\nor harmful."},"759":{"id":"/contributing/code-of-conduct-26","page_id":"/contributing/code-of-conduct","tags":[],"type":"text","url":"/contributing/code-of-conduct#enforcement-responsibilities","content":"Community leaders have the right and responsibility to remove, edit, or reject\ncomments, commits, code, wiki edits, issues, and other contributions that are\nnot aligned to this Code of Conduct, and will communicate reasons for moderation\ndecisions when appropriate."},"760":{"id":"/contributing/code-of-conduct-27","page_id":"/contributing/code-of-conduct","tags":[],"type":"text","url":"/contributing/code-of-conduct#scope","content":"This Code of Conduct applies within all community spaces, and also applies when\nan individual is officially representing the community in public spaces.\nExamples of representing our community include using an official e-mail address,\nposting via an official social media account, or acting as an appointed\nrepresentative at an online or offline event."},"761":{"id":"/contributing/code-of-conduct-28","page_id":"/contributing/code-of-conduct","tags":[],"type":"text","url":"/contributing/code-of-conduct#enforcement","content":"Instances of abusive, harassing, or otherwise unacceptable behavior may be\nreported to the community leaders responsible for enforcement at\ntwo or more of jaraco@jaraco.com, icorbrey@gmail.com, me@waleedkhan.name, and opensource@google.com.\nAll complaints will be reviewed and investigated promptly and fairly."},"762":{"id":"/contributing/code-of-conduct-29","page_id":"/contributing/code-of-conduct","tags":[],"type":"text","url":"/contributing/code-of-conduct#enforcement","content":"All community leaders are obligated to respect the privacy and security of the\nreporter of any incident."},"763":{"id":"/contributing/code-of-conduct-30","page_id":"/contributing/code-of-conduct","tags":[],"type":"text","url":"/contributing/code-of-conduct#enforcement-guidelines","content":"Community leaders will follow these Community Impact Guidelines in determining\nthe consequences for any action they deem in violation of this Code of Conduct:"},"764":{"id":"/contributing/code-of-conduct-31","page_id":"/contributing/code-of-conduct","tags":[],"type":"text","url":"/contributing/code-of-conduct#1-correction","content":"Community Impact: Use of inappropriate language or other behavior deemed\nunprofessional or unwelcome in the community."},"765":{"id":"/contributing/code-of-conduct-32","page_id":"/contributing/code-of-conduct","tags":[],"type":"text","url":"/contributing/code-of-conduct#1-correction","content":"Consequence: A private, written warning from community leaders, providing\nclarity around the nature of the violation and an explanation of why the\nbehavior was inappropriate. A public apology may be requested."},"766":{"id":"/contributing/code-of-conduct-33","page_id":"/contributing/code-of-conduct","tags":[],"type":"text","url":"/contributing/code-of-conduct#2-warning","content":"Community Impact: A violation through a single incident or series of\nactions."},"767":{"id":"/contributing/code-of-conduct-34","page_id":"/contributing/code-of-conduct","tags":[],"type":"text","url":"/contributing/code-of-conduct#2-warning","content":"Consequence: A warning with consequences for continued behavior. No\ninteraction with the people involved, including unsolicited interaction with\nthose enforcing the Code of Conduct, for a specified period of time. This\nincludes avoiding interactions in community spaces as well as external channels\nlike social media. Violating these terms may lead to a temporary or permanent\nban."},"768":{"id":"/contributing/code-of-conduct-35","page_id":"/contributing/code-of-conduct","tags":[],"type":"text","url":"/contributing/code-of-conduct#3-temporary-ban","content":"Community Impact: A serious violation of community standards, including\nsustained inappropriate behavior."},"769":{"id":"/contributing/code-of-conduct-36","page_id":"/contributing/code-of-conduct","tags":[],"type":"text","url":"/contributing/code-of-conduct#3-temporary-ban","content":"Consequence: A temporary ban from any sort of interaction or public\ncommunication with the community for a specified period of time. No public or\nprivate interaction with the people involved, including unsolicited interaction\nwith those enforcing the Code of Conduct, is allowed during this period.\nViolating these terms may lead to a permanent ban."},"770":{"id":"/contributing/code-of-conduct-37","page_id":"/contributing/code-of-conduct","tags":[],"type":"text","url":"/contributing/code-of-conduct#4-permanent-ban","content":"Community Impact: Demonstrating a pattern of violation of community\nstandards, including sustained inappropriate behavior, harassment of an\nindividual, or aggression toward or disparagement of classes of individuals."},"771":{"id":"/contributing/code-of-conduct-38","page_id":"/contributing/code-of-conduct","tags":[],"type":"text","url":"/contributing/code-of-conduct#4-permanent-ban","content":"Consequence: A permanent ban from any sort of public interaction within the\ncommunity."},"772":{"id":"/contributing/code-of-conduct-39","page_id":"/contributing/code-of-conduct","tags":[],"type":"text","url":"/contributing/code-of-conduct#attribution","content":"This Code of Conduct is adapted from the Contributor Covenant,\nversion 2.1, available at\nhttps://www.contributor-covenant.org/version/2/1/code_of_conduct.html."},"773":{"id":"/contributing/code-of-conduct-40","page_id":"/contributing/code-of-conduct","tags":[],"type":"text","url":"/contributing/code-of-conduct#attribution","content":"Community Impact Guidelines were inspired by\nMozilla's code of conduct enforcement ladder."},"774":{"id":"/contributing/code-of-conduct-41","page_id":"/contributing/code-of-conduct","tags":[],"type":"text","url":"/contributing/code-of-conduct#attribution","content":"For answers to common questions about this code of conduct, see the FAQ at\nhttps://www.contributor-covenant.org/faq. Translations are available at\nhttps://www.contributor-covenant.org/translations."},"775":{"id":"/contributing/design-doc-blueprint","page_id":"/contributing/design-doc-blueprint","type":"page","content":"Title","tags":[],"url":"/contributing/design-doc-blueprint"},"776":{"id":"/contributing/design-doc-blueprint-0","page_id":"/contributing/design-doc-blueprint","type":"heading","tags":[],"url":"/contributing/design-doc-blueprint#summary","content":"Summary"},"777":{"id":"/contributing/design-doc-blueprint-1","page_id":"/contributing/design-doc-blueprint","type":"heading","tags":[],"url":"/contributing/design-doc-blueprint#state-of-the-feature-as-of-version-optional","content":"State of the Feature as of $VERSION (optional)"},"778":{"id":"/contributing/design-doc-blueprint-2","page_id":"/contributing/design-doc-blueprint","type":"heading","tags":[],"url":"/contributing/design-doc-blueprint#prior-work-optional","content":"Prior work (optional)"},"779":{"id":"/contributing/design-doc-blueprint-3","page_id":"/contributing/design-doc-blueprint","type":"heading","tags":[],"url":"/contributing/design-doc-blueprint#goals-and-non-goals","content":"Goals and non-goals"},"780":{"id":"/contributing/design-doc-blueprint-4","page_id":"/contributing/design-doc-blueprint","type":"heading","tags":[],"url":"/contributing/design-doc-blueprint#overview","content":"Overview"},"781":{"id":"/contributing/design-doc-blueprint-5","page_id":"/contributing/design-doc-blueprint","type":"heading","tags":[],"url":"/contributing/design-doc-blueprint#detailed-design","content":"Detailed Design"},"782":{"id":"/contributing/design-doc-blueprint-6","page_id":"/contributing/design-doc-blueprint","type":"heading","tags":[],"url":"/contributing/design-doc-blueprint#alternatives-considered-optional","content":"Alternatives considered (optional)"},"783":{"id":"/contributing/design-doc-blueprint-7","page_id":"/contributing/design-doc-blueprint","type":"heading","tags":[],"url":"/contributing/design-doc-blueprint#issues-addressed-optional","content":"Issues addressed (optional)"},"784":{"id":"/contributing/design-doc-blueprint-8","page_id":"/contributing/design-doc-blueprint","type":"heading","tags":[],"url":"/contributing/design-doc-blueprint#related-work-optional","content":"Related Work (optional)"},"785":{"id":"/contributing/design-doc-blueprint-9","page_id":"/contributing/design-doc-blueprint","type":"heading","tags":[],"url":"/contributing/design-doc-blueprint#future-possibilities","content":"Future Possibilities"},"786":{"id":"/contributing/design-doc-blueprint-10","page_id":"/contributing/design-doc-blueprint","tags":[],"type":"text","url":"/contributing/design-doc-blueprint","content":"A cool name for your Project"},"787":{"id":"/contributing/design-doc-blueprint-11","page_id":"/contributing/design-doc-blueprint","tags":[],"type":"text","url":"/contributing/design-doc-blueprint","content":"Author: Your-Name"},"788":{"id":"/contributing/design-doc-blueprint-12","page_id":"/contributing/design-doc-blueprint","tags":[],"type":"text","url":"/contributing/design-doc-blueprint","content":"If there are multiple authors, just list them all"},"789":{"id":"/contributing/design-doc-blueprint-13","page_id":"/contributing/design-doc-blueprint","tags":[],"type":"text","url":"/contributing/design-doc-blueprint#summary","content":"A short summary of your project/re-design/component and what problems it\naddresses in about 3-10 sentences."},"790":{"id":"/contributing/design-doc-blueprint-14","page_id":"/contributing/design-doc-blueprint","tags":[],"type":"text","url":"/contributing/design-doc-blueprint#state-of-the-feature-as-of-version-optional","content":"The state of the feature you want to improve and where it currently falls\nshort. If there's nothing to compare to, leave it out."},"791":{"id":"/contributing/design-doc-blueprint-15","page_id":"/contributing/design-doc-blueprint","tags":[],"type":"text","url":"/contributing/design-doc-blueprint#prior-work-optional","content":"Does this feature exist somewhere else and which tradeoffs it made."},"792":{"id":"/contributing/design-doc-blueprint-16","page_id":"/contributing/design-doc-blueprint","tags":[],"type":"text","url":"/contributing/design-doc-blueprint#prior-work-optional","content":"If there's no prior work, then use the related work section below."},"793":{"id":"/contributing/design-doc-blueprint-17","page_id":"/contributing/design-doc-blueprint","tags":[],"type":"text","url":"/contributing/design-doc-blueprint#goals-and-non-goals","content":"Direct goals of the project and features deemed not worth pursuing."},"794":{"id":"/contributing/design-doc-blueprint-18","page_id":"/contributing/design-doc-blueprint","tags":[],"type":"text","url":"/contributing/design-doc-blueprint#overview","content":"A detailed overview of the project and the improvements it brings."},"795":{"id":"/contributing/design-doc-blueprint-19","page_id":"/contributing/design-doc-blueprint","tags":[],"type":"text","url":"/contributing/design-doc-blueprint#detailed-design","content":"The place to describe all new interfaces and interactions and how it plays into\nthe existing code and behavior. This is the place for all nitty-gritty details\nwhich interact with the system."},"796":{"id":"/contributing/design-doc-blueprint-20","page_id":"/contributing/design-doc-blueprint","tags":[],"type":"text","url":"/contributing/design-doc-blueprint#alternatives-considered-optional","content":"Other alternatives to your suggested approach, and why they fall short."},"797":{"id":"/contributing/design-doc-blueprint-21","page_id":"/contributing/design-doc-blueprint","tags":[],"type":"text","url":"/contributing/design-doc-blueprint#issues-addressed-optional","content":"A list of issues which are addressed by this design."},"798":{"id":"/contributing/design-doc-blueprint-22","page_id":"/contributing/design-doc-blueprint","tags":[],"type":"text","url":"/contributing/design-doc-blueprint#related-work-optional","content":"If there's a feature in another VCS which shares some similarities to your\nproposed work, it belongs here. An example would be Jujutsu sparse workspaces\nand Perforce client workspaces."},"799":{"id":"/contributing/design-doc-blueprint-23","page_id":"/contributing/design-doc-blueprint","tags":[],"type":"text","url":"/contributing/design-doc-blueprint#future-possibilities","content":"The section for things which could be added to it or deemed out of scope during\nthe discussion."},"800":{"id":"/contributing/design-docs","page_id":"/contributing/design-docs","type":"page","content":"Design docs","tags":[],"url":"/contributing/design-docs"},"801":{"id":"/contributing/design-docs-0","page_id":"/contributing/design-docs","type":"heading","tags":[],"url":"/contributing/design-docs#process","content":"Process"},"802":{"id":"/contributing/design-docs-1","page_id":"/contributing/design-docs","type":"heading","tags":[],"url":"/contributing/design-docs#blueprint-template","content":"Blueprint (Template)"},"803":{"id":"/contributing/design-docs-2","page_id":"/contributing/design-docs","tags":[],"type":"text","url":"/contributing/design-docs","content":"Jujutsu uses Design Docs to drive technical decisions on large projects and it\nis the place to discuss your proposed design or new component. It is a very\nthorough process, in which the design doc must be approved before PRs for the\nfeature will be accepted. It shares some similarities with Rust RFCs but\nmostly addresses technical problems and gauges the technical and social\nconcerns of all stakeholders."},"804":{"id":"/contributing/design-docs-3","page_id":"/contributing/design-docs","tags":[],"type":"text","url":"/contributing/design-docs","content":"So if you want to start building a native backend or the server component for\nJujutsu, you'll need to go through this process."},"805":{"id":"/contributing/design-docs-4","page_id":"/contributing/design-docs","tags":[],"type":"text","url":"/contributing/design-docs#process","content":"Add a new markdown document to docs/design, named after your improvement\nor project."},"806":{"id":"/contributing/design-docs-5","page_id":"/contributing/design-docs","tags":[],"type":"text","url":"/contributing/design-docs#process","content":"Describe the current state of the world and the things you want to improve."},"807":{"id":"/contributing/design-docs-6","page_id":"/contributing/design-docs","tags":[],"type":"text","url":"/contributing/design-docs#process","content":"Wait for the Maintainers and Stakeholders to show up."},"808":{"id":"/contributing/design-docs-7","page_id":"/contributing/design-docs","tags":[],"type":"text","url":"/contributing/design-docs#process","content":"Iterate until everyone accepts the change in normal codereview fashion."},"809":{"id":"/contributing/design-docs-8","page_id":"/contributing/design-docs","tags":[],"type":"text","url":"/contributing/design-docs#blueprint-template","content":"You can find the base template of a new Design Doc\nhere."},"810":{"id":"/contributing","page_id":"/contributing","type":"page","content":"Contributing","tags":[],"url":"/contributing"},"811":{"id":"/contributing-0","page_id":"/contributing","type":"heading","tags":[],"url":"/contributing#policies","content":"Policies"},"812":{"id":"/contributing-1","page_id":"/contributing","type":"heading","tags":[],"url":"/contributing#contributor-license-agreement","content":"Contributor License Agreement"},"813":{"id":"/contributing-2","page_id":"/contributing","type":"heading","tags":[],"url":"/contributing#commit-guidelines","content":"Commit guidelines"},"814":{"id":"/contributing-3","page_id":"/contributing","type":"heading","tags":[],"url":"/contributing#code-reviews","content":"Code reviews"},"815":{"id":"/contributing-4","page_id":"/contributing","type":"heading","tags":[],"url":"/contributing#community-guidelines","content":"Community Guidelines"},"816":{"id":"/contributing-5","page_id":"/contributing","type":"heading","tags":[],"url":"/contributing#contributing-large-patches","content":"Contributing large patches"},"817":{"id":"/contributing-6","page_id":"/contributing","type":"heading","tags":[],"url":"/contributing#contributing-to-the-documentation","content":"Contributing to the documentation"},"818":{"id":"/contributing-7","page_id":"/contributing","type":"heading","tags":[],"url":"/contributing#learning-rust","content":"Learning Rust"},"819":{"id":"/contributing-8","page_id":"/contributing","type":"heading","tags":[],"url":"/contributing#style-guide","content":"Style guide"},"820":{"id":"/contributing-9","page_id":"/contributing","type":"heading","tags":[],"url":"/contributing#setting-up-a-development-environment","content":"Setting up a development environment"},"821":{"id":"/contributing-10","page_id":"/contributing","type":"heading","tags":[],"url":"/contributing#summary","content":"Summary"},"822":{"id":"/contributing-11","page_id":"/contributing","type":"heading","tags":[],"url":"/contributing#explanation","content":"Explanation"},"823":{"id":"/contributing-12","page_id":"/contributing","type":"heading","tags":[],"url":"/contributing#configuring-jj-fix-to-run-rustfmt","content":"Configuring jj fix to run rustfmt"},"824":{"id":"/contributing-13","page_id":"/contributing","type":"heading","tags":[],"url":"/contributing#using-mold-for-faster-tests-on-linux","content":"Using mold for faster tests on Linux"},"825":{"id":"/contributing-14","page_id":"/contributing","type":"heading","tags":[],"url":"/contributing#editor-setup","content":"Editor setup"},"826":{"id":"/contributing-15","page_id":"/contributing","type":"heading","tags":[],"url":"/contributing#visual-studio-code","content":"Visual Studio Code"},"827":{"id":"/contributing-16","page_id":"/contributing","type":"heading","tags":[],"url":"/contributing#zed","content":"Zed"},"828":{"id":"/contributing-17","page_id":"/contributing","type":"heading","tags":[],"url":"/contributing#helix","content":"Helix"},"829":{"id":"/contributing-18","page_id":"/contributing","type":"heading","tags":[],"url":"/contributing#alternative-development-setup-with-mise","content":"Alternative development setup with mise"},"830":{"id":"/contributing-19","page_id":"/contributing","type":"heading","tags":[],"url":"/contributing#previewing-the-html-documentation","content":"Previewing the HTML documentation"},"831":{"id":"/contributing-20","page_id":"/contributing","type":"heading","tags":[],"url":"/contributing#install-uv","content":"Install uv"},"832":{"id":"/contributing-21","page_id":"/contributing","type":"heading","tags":[],"url":"/contributing#build-the-docs","content":"Build the docs"},"833":{"id":"/contributing-22","page_id":"/contributing","type":"heading","tags":[],"url":"/contributing#offline-distribution","content":"Offline distribution"},"834":{"id":"/contributing-23","page_id":"/contributing","type":"heading","tags":[],"url":"/contributing#building-the-entire-website","content":"Building the entire website"},"835":{"id":"/contributing-24","page_id":"/contributing","type":"heading","tags":[],"url":"/contributing#explanation-of-the-docs-build-deploy-script","content":"Explanation of the docs-build-deploy script"},"836":{"id":"/contributing-25","page_id":"/contributing","type":"heading","tags":[],"url":"/contributing#modifying-protobuffers-this-is-not-common","content":"Modifying protobuffers (this is not common)"},"837":{"id":"/contributing-26","page_id":"/contributing","type":"heading","tags":[],"url":"/contributing#logging","content":"Logging"},"838":{"id":"/contributing-27","page_id":"/contributing","type":"heading","tags":[],"url":"/contributing#profiling","content":"Profiling"},"839":{"id":"/contributing-28","page_id":"/contributing","tags":[],"type":"text","url":"/contributing#policies","content":"We'd love to accept your patches and contributions to this project. There are\njust a few small guidelines you need to follow."},"840":{"id":"/contributing-29","page_id":"/contributing","tags":[],"type":"text","url":"/contributing#contributor-license-agreement","content":"Contributions to this project must be accompanied by a Contributor License\nAgreement. You (or your employer) retain the copyright to your contribution;\nthis simply gives us permission to use and redistribute your contributions as\npart of the project. Head over to https://cla.developers.google.com/ to see\nyour current agreements on file or to sign a new one."},"841":{"id":"/contributing-30","page_id":"/contributing","tags":[],"type":"text","url":"/contributing#contributor-license-agreement","content":"You generally only need to submit a CLA once, so if you've already submitted one\n(even if it was for a different project), you probably don't need to do it\nagain."},"842":{"id":"/contributing-31","page_id":"/contributing","tags":[],"type":"text","url":"/contributing#commit-guidelines","content":"Unlike many GitHub projects (but like many VCS projects), we care more about the\ncontents of commits than about the contents of PRs. We review each commit\nseparately, and we don't squash-merge the PR (so please manually squash any\nfixup commits before sending for review)."},"843":{"id":"/contributing-32","page_id":"/contributing","tags":[],"type":"text","url":"/contributing#commit-guidelines","content":"Each commit should ideally do one thing. For example, if you need to refactor a\nfunction in order to add a new feature cleanly, put the refactoring in one\ncommit and the new feature in a different commit. If the refactoring itself\nconsists of many parts, try to separate out those into separate commits. You can\nuse jj split to do it if you didn't realize ahead of time how it should be\nsplit up. Include tests and documentation in the same commit as the code they\ntest and document."},"844":{"id":"/contributing-33","page_id":"/contributing","tags":[],"type":"text","url":"/contributing#commit-guidelines","content":"The commit message should describe the changes in the commit;\nthe PR description can even be empty, but feel free to include a personal\nmessage. We start the commit message with <topic>:  and don't use\nconventional commits. This means if\nyou modified a command in the CLI, use its name as the topic, e.g.\nnext/prev: <your-modification> or conflicts: <your-modification>. We don't\ncurrently have a specific guidelines on what to write in the topic field, but\nthe reviewers will help you provide a topic if you have difficulties choosing\nit. How to Write a Git Commit Message is a good\nguide if you're new to writing good commit messages. We are not particularly\nstrict about the style, but please do explain the reason for the change unless\nit's obvious."},"845":{"id":"/contributing-34","page_id":"/contributing","tags":[],"type":"text","url":"/contributing#code-reviews","content":"All submissions, including submissions by project members, require review. We\nuse GitHub pull requests for this purpose. Consult\nGitHub Help for more\ninformation on using pull requests."},"846":{"id":"/contributing-35","page_id":"/contributing","tags":[],"type":"text","url":"/contributing#code-reviews","content":"When you address comments on a PR, don't make the changes in a commit on top (as\nis typical on GitHub). Instead, please make the changes in the appropriate\ncommit. You can do that by creating a new commit on top of the initial commit\n(jj new <commit>) and then squash in the changes when you're done (jj squash).\njj git push\nwill automatically force-push the bookmark."},"847":{"id":"/contributing-36","page_id":"/contributing","tags":[],"type":"text","url":"/contributing#code-reviews","content":"When your first PR has been approved, we typically invite you to the\njj-vcs/contributors team to give you contributor access,\nso you can address any remaining minor comments and then merge the PR yourself\nwhen you're ready. If you realize that some comments require non-trivial\nchanges, please ask your reviewer to take another look."},"848":{"id":"/contributing-37","page_id":"/contributing","tags":[],"type":"text","url":"/contributing#code-reviews","content":"If your employer pays anyone (not necessarily you) to contribute to Jujutsu,\nplease make sure your GitHub username is recorded.\nTo avoid conflicts of interest, please don't merge a PR that has only been\napproved by someone from the same organization. Similarly, as a reviewer, there\nis no need to approve your coworkers' PRs, since the author should await an\napproval from someone else anyway. It is of course still appreciated if you\nreview and comment on their PRs. Also, if the PR seems completely unrelated to\nyour company's interests, do feel free to approve it."},"849":{"id":"/contributing-38","page_id":"/contributing","tags":[],"type":"text","url":"/contributing#community-guidelines","content":"This project follows Google's Open Source Community\nGuidelines."},"850":{"id":"/contributing-39","page_id":"/contributing","tags":[],"type":"text","url":"/contributing#contributing-large-patches","content":"Before sending a PR for a large change which designs/redesigns or reworks an\nexisting component, we require an architecture review from multiple\nstakeholders, which we do with Design Docs, see the\nprocess here."},"851":{"id":"/contributing-40","page_id":"/contributing","tags":[],"type":"text","url":"/contributing#contributing-to-the-documentation","content":"We appreciate bug\nreports\nabout any problems, however small, lurking in our documentation\nwebsite or in the jj help <command> docs.\nIf a part of the bug report template does not apply, you can\njust delete it."},"852":{"id":"/contributing-41","page_id":"/contributing","tags":[],"type":"text","url":"/contributing#contributing-to-the-documentation","content":"Before reporting a problem with the documentation website, we'd appreciate it if\nyou could check that the problem still exists in the \"prerelease\" version of the\ndocumentation (as opposed to the docs for one of the released versions of jj).\nYou can use the version switcher in the top-left of the website to do so."},"853":{"id":"/contributing-42","page_id":"/contributing","tags":[],"type":"text","url":"/contributing#contributing-to-the-documentation","content":"If you are willing to make a PR fixing a documentation problem, even better!"},"854":{"id":"/contributing-43","page_id":"/contributing","tags":[],"type":"text","url":"/contributing#contributing-to-the-documentation","content":"The documentation website sources are Markdown files located in the docs/\ndirectory. You do not need to\nknow Rust to work with them. See below for instructions on how to preview the\nHTML docs as you edit the Markdown files.\nDoing so is optional, but recommended."},"855":{"id":"/contributing-44","page_id":"/contributing","tags":[],"type":"text","url":"/contributing#contributing-to-the-documentation","content":"The jj help docs are sourced from the \"docstring\" comments inside the Rust\nsources, currently from the cli/src/commands\ndirectory. Working\non them requires setting up a Rust development environment, as described\nbelow, and may occasionally require adjusting a test."},"856":{"id":"/contributing-45","page_id":"/contributing","tags":[],"type":"text","url":"/contributing#learning-rust","content":"In addition to the Rust Book and the other\nexcellent resources at https://www.rust-lang.org/learn, we recommend the\n\"Comprehensive Rust\" mini-course\nfor an overview, especially if you are familiar with C++."},"857":{"id":"/contributing-46","page_id":"/contributing","tags":[],"type":"text","url":"/contributing#style-guide","content":"See here."},"858":{"id":"/contributing-47","page_id":"/contributing","tags":[],"type":"text","url":"/contributing#setting-up-a-development-environment","content":"To develop jj, the mandatory steps are simply\nto install Rust (the default\ninstaller options are fine), clone the repository, and use cargo build\n, cargo fmt,\ncargo clippy --workspace --all-targets, and\ncargo test --workspace. If you are preparing a PR, there are some additional\nrecommended steps."},"859":{"id":"/contributing-48","page_id":"/contributing","tags":[],"type":"text","url":"/contributing#summary","content":"One-time setup:"},"860":{"id":"/contributing-49","page_id":"/contributing","tags":[],"type":"text","url":"/contributing#summary","content":"rustup toolchain add nightly  # wanted for 'rustfmt'\nrustup toolchain add 1.85     # also specified in Cargo.toml\ncargo install --locked bacon\ncargo install --locked cargo-insta\ncargo install --locked cargo-nextest"},"861":{"id":"/contributing-50","page_id":"/contributing","tags":[],"type":"text","url":"/contributing#summary","content":"During development (adapt according to your preference):"},"862":{"id":"/contributing-51","page_id":"/contributing","tags":[],"type":"text","url":"/contributing#summary","content":"bacon clippy-all\ncargo +nightly fmt # Occasionally\ncargo nextest run --workspace # Occasionally\ncargo insta test --workspace --test-runner nextest # Occasionally"},"863":{"id":"/contributing-52","page_id":"/contributing","tags":[],"type":"text","url":"/contributing#summary","content":"type: warning"},"864":{"id":"/contributing-53","page_id":"/contributing","tags":[],"type":"text","url":"/contributing#summary","content":"Build artifacts from debug builds and especially from repeated invocations of\ncargo test can quickly take up 10s of GB of disk space. Cargo will happily\nuse up your entire hard drive. If this happens, run cargo clean."},"865":{"id":"/contributing-54","page_id":"/contributing","tags":[],"type":"text","url":"/contributing#explanation","content":"These are listed roughly in order of decreasing importance."},"866":{"id":"/contributing-55","page_id":"/contributing","tags":[],"type":"text","url":"/contributing#explanation","content":"Nearly any change to jj's CLI will require writing or updating snapshot\ntests that use the insta crate. To make this\nconvenient, install the cargo-insta binary.\nUse cargo insta test --workspace to run tests,\nand cargo insta review --workspace to update the snapshot tests.\nThe --workspace flag is needed to run the tests on all crates; by default,\nonly the crate in the current directory is tested."},"867":{"id":"/contributing-56","page_id":"/contributing","tags":[],"type":"text","url":"/contributing#explanation","content":"GitHub CI checks require that the code is formatted with the nightly\nversion of rustfmt. To do this on your computer, install the nightly\ntoolchain and use cargo +nightly fmt."},"868":{"id":"/contributing-57","page_id":"/contributing","tags":[],"type":"text","url":"/contributing#explanation","content":"Your code will be rejected if it cannot be compiled with the minimal\nsupported version of Rust (\"MSRV\"). Currently, jj follows a rather\ncasual MSRV policy: \"The current rustc stable version, minus one.\"\nAs of this writing, that version is 1.85.0."},"869":{"id":"/contributing-58","page_id":"/contributing","tags":[],"type":"text","url":"/contributing#explanation","content":"Your code needs to pass cargo clippy. You can also\nuse cargo +nightly clippy if you wish to see more warnings."},"870":{"id":"/contributing-59","page_id":"/contributing","tags":[],"type":"text","url":"/contributing#explanation","content":"You may also want to install and use bacon,\nto automatically build, check, and / or run tests."},"871":{"id":"/contributing-60","page_id":"/contributing","tags":[],"type":"text","url":"/contributing#explanation","content":"To run tests more quickly, use cargo nextest run --workspace. To\nuse nextest with insta, use cargo insta test --workspace\n--test-runner nextest."},"872":{"id":"/contributing-61","page_id":"/contributing","tags":[],"type":"text","url":"/contributing#explanation","content":"On Linux, you may be able to speed up nextest even further by using\nthe mold linker, as explained below."},"873":{"id":"/contributing-62","page_id":"/contributing","tags":[],"type":"text","url":"/contributing#configuring-jj-fix-to-run-rustfmt","content":"Run this in the jj repo:"},"874":{"id":"/contributing-63","page_id":"/contributing","tags":[],"type":"text","url":"/contributing#configuring-jj-fix-to-run-rustfmt","content":"Note: users of Nix and direnv should drop the \"+nightly\" argument above\nsince the devShell is already configured to pull in a nightly version of\nrustfmt:jj config set --repo fix.tools.rustfmt '{ command = [\"rustfmt\"], patterns = [\"glob:**/*.rs\"] }'"},"875":{"id":"/contributing-64","page_id":"/contributing","tags":[],"type":"text","url":"/contributing#using-mold-for-faster-tests-on-linux","content":"On a machine with a multi-core CPU, one way to speed up\ncargo nextest on Linux is to use the multi-threaded mold\nlinker. This linker may help\nif, currently, your CPU is underused while Rust is linking test\nbinaries. Before proceeding with mold, you can check whether this is\nan issue worth solving using a system monitoring tool such as htop."},"876":{"id":"/contributing-65","page_id":"/contributing","tags":[],"type":"text","url":"/contributing#using-mold-for-faster-tests-on-linux","content":"mold is packaged for many distributions. On Debian, for example,\nsudo apt install mold should just work."},"877":{"id":"/contributing-66","page_id":"/contributing","tags":[],"type":"text","url":"/contributing#using-mold-for-faster-tests-on-linux","content":"A simple way to use mold is via the -run option, e.g.:"},"878":{"id":"/contributing-67","page_id":"/contributing","tags":[],"type":"text","url":"/contributing#using-mold-for-faster-tests-on-linux","content":"There will be no indication that a different linker is used, except for\nhigher CPU usage while linking and, hopefully, faster completion. You\ncan verify that mold was indeed used by running\nreadelf -p .comment target/debug/jj."},"879":{"id":"/contributing-68","page_id":"/contributing","tags":[],"type":"text","url":"/contributing#using-mold-for-faster-tests-on-linux","content":"There are also ways of having Rust use mold by default, see the \"How\nto use\" instructions."},"880":{"id":"/contributing-69","page_id":"/contributing","tags":[],"type":"text","url":"/contributing#using-mold-for-faster-tests-on-linux","content":"On recent versions of MacOS, the default linker Rust uses is already\nmulti-threaded. It should use all the CPU cores without any configuration."},"881":{"id":"/contributing-70","page_id":"/contributing","tags":[],"type":"text","url":"/contributing#visual-studio-code","content":"We recommend at least these settings:"},"882":{"id":"/contributing-71","page_id":"/contributing","tags":[],"type":"text","url":"/contributing#alternative-development-setup-with-mise","content":"An experimental development setup is available using\nmise. If you try it, file bugs,\nPRs, or tell us on Discord/IRC/discussions if you experience problems\nor if this config is too inflexible. If we can make it work for most\nplatforms and most people's needs, including people previously unfamiliar\nwith mise, we may make mise the recommended way to set up a development\nenvironment."},"883":{"id":"/contributing-72","page_id":"/contributing","tags":[],"type":"text","url":"/contributing#alternative-development-setup-with-mise","content":"This tool manages the necessary dependencies for you, eliminating the need for\na separate setup process. mise automatically installs the required tools when\nthey are needed."},"884":{"id":"/contributing-73","page_id":"/contributing","tags":[],"type":"text","url":"/contributing#alternative-development-setup-with-mise","content":"Here are some of the commands you may find yourself using frequently during\ndevelopment:"},"885":{"id":"/contributing-74","page_id":"/contributing","tags":[],"type":"text","url":"/contributing#alternative-development-setup-with-mise","content":"mise test: Runs all tests."},"886":{"id":"/contributing-75","page_id":"/contributing","tags":[],"type":"text","url":"/contributing#alternative-development-setup-with-mise","content":"mise test <string>: Runs tests that contain a specific string. For\nexample, mise test squash would run tests with \"squash\" in their name."},"887":{"id":"/contributing-76","page_id":"/contributing","tags":[],"type":"text","url":"/contributing#alternative-development-setup-with-mise","content":"mise build: Compiles jj."},"888":{"id":"/contributing-77","page_id":"/contributing","tags":[],"type":"text","url":"/contributing#alternative-development-setup-with-mise","content":"mise build:release: Compiles jj in release mode."},"889":{"id":"/contributing-78","page_id":"/contributing","tags":[],"type":"text","url":"/contributing#alternative-development-setup-with-mise","content":"mise build:docs: Builds the documentation for jj."},"890":{"id":"/contributing-79","page_id":"/contributing","tags":[],"type":"text","url":"/contributing#alternative-development-setup-with-mise","content":"For a complete list of all available tasks, you can run mise tasks or review\nthe configuration file at .config/mise.toml."},"891":{"id":"/contributing-80","page_id":"/contributing","tags":[],"type":"text","url":"/contributing#alternative-development-setup-with-mise","content":"You can customize this configuration using\na mise.local.toml file."},"892":{"id":"/contributing-81","page_id":"/contributing","tags":[],"type":"text","url":"/contributing#previewing-the-html-documentation","content":"The documentation for jj is automatically published online at\nhttps://jj-vcs.github.io/jj/."},"893":{"id":"/contributing-82","page_id":"/contributing","tags":[],"type":"text","url":"/contributing#previewing-the-html-documentation","content":"When editing documentation, you should check your changes locally — especially\nif you are adding a new page, or doing a major rewrite."},"894":{"id":"/contributing-83","page_id":"/contributing","tags":[],"type":"text","url":"/contributing#install-uv","content":"The only thing you need is uv (version 0.5.1 or newer)."},"895":{"id":"/contributing-84","page_id":"/contributing","tags":[],"type":"text","url":"/contributing#install-uv","content":"uv is a Python project manager written in Rust. It will fetch the right Python\nversion and the dependencies needed to build the docs. Install it like so:"},"896":{"id":"/contributing-85","page_id":"/contributing","tags":[],"type":"text","url":"/contributing#install-uv","content":"If you don't have ~/.local/bin in your PATH, the installer will\nmodify your shell profile. To avoid it:"},"897":{"id":"/contributing-86","page_id":"/contributing","tags":[],"type":"text","url":"/contributing#install-uv","content":"Directly download the binaries from GitHub: uv releases."},"898":{"id":"/contributing-87","page_id":"/contributing","tags":[],"type":"text","url":"/contributing#install-uv","content":"Even more options: Installing uv."},"899":{"id":"/contributing-88","page_id":"/contributing","tags":[],"type":"text","url":"/contributing#build-the-docs","content":"To build the docs, run while inside the jj repository:"},"900":{"id":"/contributing-89","page_id":"/contributing","tags":[],"type":"text","url":"/contributing#build-the-docs","content":"Open http://127.0.0.1:8000 in your browser to see the docs."},"901":{"id":"/contributing-90","page_id":"/contributing","tags":[],"type":"text","url":"/contributing#build-the-docs","content":"As you edit the .md files in docs/, the website should be rebuilt and\nreloaded in your browser automatically."},"902":{"id":"/contributing-91","page_id":"/contributing","tags":[],"type":"text","url":"/contributing#build-the-docs","content":"title: If the docs are not updating"},"903":{"id":"/contributing-92","page_id":"/contributing","tags":[],"type":"text","url":"/contributing#build-the-docs","content":"Check the terminal from which you ran uv run mkdocs serve for any build\nerrors or warnings. Warnings about \"GET /versions.json HTTP/1.1\" code 404\nare expected and harmless."},"904":{"id":"/contributing-93","page_id":"/contributing","tags":[],"type":"text","url":"/contributing#offline-distribution","content":"To build the rendered docs for offline distribution or to view them from your file\nsystem, run while inside the jj repository:"},"905":{"id":"/contributing-94","page_id":"/contributing","tags":[],"type":"text","url":"/contributing#building-the-entire-website","content":"Building the entire website is not usually necessary. If you are editing\ndocumentation, the previous section is enough."},"906":{"id":"/contributing-95","page_id":"/contributing","tags":[],"type":"text","url":"/contributing#building-the-entire-website","content":"These instructions are relevant if you are working on the versioning of the\ndocumentation that we currently do with mike."},"907":{"id":"/contributing-96","page_id":"/contributing","tags":[],"type":"text","url":"/contributing#building-the-entire-website","content":"The full jj website includes the documentation for several jj versions\n(prerelease, latest release, and the older releases). The top-level\nURL https://jj-vcs.github.io/jj redirects to\nhttps://jj-vcs.github.io/jj/latest, which in turn redirects to\nthe docs for the last stable version."},"908":{"id":"/contributing-97","page_id":"/contributing","tags":[],"type":"text","url":"/contributing#building-the-entire-website","content":"The different versions of documentation are managed and deployed with\nmike, which can be run with\nuv run mike."},"909":{"id":"/contributing-98","page_id":"/contributing","tags":[],"type":"text","url":"/contributing#building-the-entire-website","content":"On a POSIX system or WSL, one way to build the entire website is as follows (on\nWindows, you'll need to understand and adapt the shell script):"},"910":{"id":"/contributing-99","page_id":"/contributing","tags":[],"type":"text","url":"/contributing#building-the-entire-website","content":"Check out jj (jj git clone), cloned from your fork of jj (e.g.\ngithub.com/jjfan/jj). You can also use a pure Git repo if you prefer."},"911":{"id":"/contributing-100","page_id":"/contributing","tags":[],"type":"text","url":"/contributing#building-the-entire-website","content":"Make sure github.com/jjfan/jj includes the gh-pages bookmark of the jj repo\nand run git fetch origin gh-pages."},"912":{"id":"/contributing-101","page_id":"/contributing","tags":[],"type":"text","url":"/contributing#building-the-entire-website","content":"Go to the GitHub repository settings, enable GitHub Pages, and configure them\nto use the gh-pages bookmark (this is usually the default)."},"913":{"id":"/contributing-102","page_id":"/contributing","tags":[],"type":"text","url":"/contributing#building-the-entire-website","content":"Install uv as explained in Previewing the HTML\ndocumentation, and run the same sh script\nthat is used in GitHub CI (details below):"},"914":{"id":"/contributing-103","page_id":"/contributing","tags":[],"type":"text","url":"/contributing#building-the-entire-website","content":"This should build the version of the docs from the current commit,\ndeploy it as a new commit to the gh-pages bookmark,\nand push the gh-pages bookmark to the origin."},"915":{"id":"/contributing-104","page_id":"/contributing","tags":[],"type":"text","url":"/contributing#building-the-entire-website","content":"Now, you should be able to see the full website, including your latest changes\nto the prerelease version, at https://jjfan.github.io/jj/prerelease/."},"916":{"id":"/contributing-105","page_id":"/contributing","tags":[],"type":"text","url":"/contributing#building-the-entire-website","content":"(Optional) The previous steps actually only rebuild\nhttps://jjfan.github.io/jj/prerelease/ and its alias\nhttps://jjfan.github.io/jj/main/. If you'd like to test out version switching\nback and forth, you can also rebuild the docs for the latest release as follows."},"917":{"id":"/contributing-106","page_id":"/contributing","tags":[],"type":"text","url":"/contributing#building-the-entire-website","content":"(Optional) When you are done, you may want to reset the gh-pages bookmark to the\nsame spot as it is upstream. If you configured the \"upstream\" remote,\nthis can be done with:"},"918":{"id":"/contributing-107","page_id":"/contributing","tags":[],"type":"text","url":"/contributing#building-the-entire-website","content":"If you want to preserve some of the changes you made, you can do jj bookmark\n    set my-changes -r gh-pages BEFORE running the above commands."},"919":{"id":"/contributing-108","page_id":"/contributing","tags":[],"type":"text","url":"/contributing#explanation-of-the-docs-build-deploy-script","content":"The script sets up a few environment variables and invokes uv run mike deploy\nwith some default arguments and whatever arguments were passed to\ndocs-build-deploy. Run uv run mike help deploy to find out what the\narguments do."},"920":{"id":"/contributing-109","page_id":"/contributing","tags":[],"type":"text","url":"/contributing#explanation-of-the-docs-build-deploy-script","content":"If you need to do something more complicated, you can use uv run mike\n... commands. You can also edit the gh-pages bookmark directly, but take care\nto avoid files that will be overwritten by future invocations of mike. Then,\nyou can submit a PR based on the gh-pages bookmark of\nhttps://jj-vcs.github.com/jj (instead of the usual main bookmark)."},"921":{"id":"/contributing-110","page_id":"/contributing","tags":[],"type":"text","url":"/contributing#explanation-of-the-docs-build-deploy-script","content":"Previously, the version switcher would not work unless the value of the\nsite_url config in mkdocs.yml matched the actual URL the site is being\nserved from. This bug should now be fixed, but if you are not serving the site\nfrom https://jj-vcs.github.com/jj and something fails weirdly, you might want\nto adjust the site_url to something like https://jjfan.github.io/jj."},"922":{"id":"/contributing-111","page_id":"/contributing","tags":[],"type":"text","url":"/contributing#modifying-protobuffers-this-is-not-common","content":"Occasionally, you may need to change the .proto files that define jj's data\nstorage format. In this case, you will need to add a few steps to the above\nworkflow."},"923":{"id":"/contributing-112","page_id":"/contributing","tags":[],"type":"text","url":"/contributing#modifying-protobuffers-this-is-not-common","content":"Install the protoc compiler. This usually means either apt-get install\nprotobuf-compiler or downloading an official release. The\nprost library docs have additional advice."},"924":{"id":"/contributing-113","page_id":"/contributing","tags":[],"type":"text","url":"/contributing#modifying-protobuffers-this-is-not-common","content":"Run cargo run -p gen-protos regularly (or after every edit to a .proto\nfile). This is the same as running cargo run from lib/gen-protos. The\ngen-protos binary will use the prost-build library to compile the\n.proto files into .rs files."},"925":{"id":"/contributing-114","page_id":"/contributing","tags":[],"type":"text","url":"/contributing#modifying-protobuffers-this-is-not-common","content":"If you are adding a new .proto file, you will need to edit the list of\nthese files in lib/gen-protos/src/main.rs."},"926":{"id":"/contributing-115","page_id":"/contributing","tags":[],"type":"text","url":"/contributing#modifying-protobuffers-this-is-not-common","content":"The .rs files generated from .proto files are included in the repository,\nand there is a GitHub CI check that will complain if they do not match."},"927":{"id":"/contributing-116","page_id":"/contributing","tags":[],"type":"text","url":"/contributing#logging","content":"You can print internal jj logs using JJ_LOG. It acts like the RUST_LOG\nenvironment variable, frequent in Rust codebases, and accepts one or more\ndirectives. You can also run JJ_LOG=debug jj to get debug level logs\nenabled for all targets. You can also use the --debug global option, which\nturns on debug log level for jj-lib and jj-cli only."},"928":{"id":"/contributing-117","page_id":"/contributing","tags":[],"type":"text","url":"/contributing#profiling","content":"One easy-to-use sampling profiler\nis samply. For example:"},"929":{"id":"/contributing-118","page_id":"/contributing","tags":[],"type":"text","url":"/contributing#profiling","content":"Then just open the link it prints."},"930":{"id":"/contributing-119","page_id":"/contributing","tags":[],"type":"text","url":"/contributing#profiling","content":"Another option is to use the instrumentation we've added manually (using\ntracing::instrument) in various places. For example:"},"931":{"id":"/contributing-120","page_id":"/contributing","tags":[],"type":"text","url":"/contributing#profiling","content":"Then go to https://ui.perfetto.dev/ in Chrome and load /tmp/trace.json from\nthere."},"932":{"id":"/contributing/paid-contributors","page_id":"/contributing/paid-contributors","type":"page","content":"Paying employers and their employees","tags":[],"url":"/contributing/paid-contributors"},"933":{"id":"/contributing/paid-contributors-0","page_id":"/contributing/paid-contributors","type":"heading","tags":[],"url":"/contributing/paid-contributors#east-river-source-control","content":"East River Source Control"},"934":{"id":"/contributing/paid-contributors-1","page_id":"/contributing/paid-contributors","type":"heading","tags":[],"url":"/contributing/paid-contributors#google","content":"Google"},"935":{"id":"/contributing/paid-contributors-2","page_id":"/contributing/paid-contributors","tags":[],"type":"text","url":"/contributing/paid-contributors","content":"This is the list of companies paying for contributions to Jujutsu. For each\ncompany, all contributors are listed, whether it's part of their job to\ncontribute or not."},"936":{"id":"/contributing/paid-contributors-3","page_id":"/contributing/paid-contributors","tags":[],"type":"text","url":"/contributing/paid-contributors#east-river-source-control","content":"benbrittain"},"937":{"id":"/contributing/paid-contributors-4","page_id":"/contributing/paid-contributors","tags":[],"type":"text","url":"/contributing/paid-contributors#east-river-source-control","content":"ilyagr"},"938":{"id":"/contributing/paid-contributors-5","page_id":"/contributing/paid-contributors","tags":[],"type":"text","url":"/contributing/paid-contributors#east-river-source-control","content":"thoughtpolice"},"939":{"id":"/contributing/paid-contributors-6","page_id":"/contributing